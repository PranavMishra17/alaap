# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
envs/
.python-version

# ── ML artefacts (never commit weights or audio) ──
*.ckpt
*.pt
*.pth
*.safetensors
*.bin
*.onnx
checkpoints/
models/
weights/

# ── Data & caches (the cache-embeddings-once layer lives here) ──
data/
corpora/
cache/
embeddings/
*.wav
*.mp3
*.flac
*.ogg
*.opus
*.npy
*.npz
*.h5
*.arrow

# ── Experiment outputs ──
experiments/**/out/
experiments/**/renders/
runs/
wandb/
mlruns/
outputs/

# ── Secrets ──
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# ── OS / editor ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── Keep ──
!RESEARCH/**
!docs/**
experiments/*/out/
data/
cache/
demo_out/
demo_out_run.log

# HF access token — never commit
.hf_token

# S4 measurement caches - regenerable, tens of MB
experiments/S4-indic/out/measured_*.npz
experiments/*/out/audio/
experiments/*/out/*.db

# Experiment arm outputs. The earlier rules only matched a directory named
# exactly "out", so E11's per-arm directories (out_adaptive, out_nov0.45, ...)
# slipped through and their live SQLite catalogs were being re-committed on
# every commit while the arm was still writing to them.
experiments/**/out_*/
experiments/**/*_run.log
