---
// Variant 23 "kolam": a red-oxide threshold, rice-flour dots, one line that does not lift.
// Every clip is decoded in the browser and drawn as a sikku chain: dots are time across and
// pitch upward; the line loops around the dot the voice is on, wide when loud, tight when quiet.
import { name, meaning, links, characters, scene, seeds, byCharacter, clipCaveats } from '../../content/alaap';

const who: Record<string, string> = { mentor: 'the mentor', scout: 'the scout', innkeeper: 'the innkeeper' };
const desc = Object.fromEntries(characters.map((c) => [c.id, c.description]));
const mentorSeed = seeds.find((s) => s.character === 'mentor')!;
const scoutSeed = seeds.find((s) => s.character === 'scout')!;
const mentorThree = byCharacter('mentor');
const s1 = (n: number) => n.toFixed(1);

// One dot per section. The header chain loops around each dot as you reach it.
const sections = [
  ['threshold', 'The threshold'], ['voices', 'Three descriptions'], ['scene', 'The scene'], ['who', 'Who it is for'],
  ['how', 'How it works'], ['keep', 'A voice you keep'], ['apart', 'Who and what, apart'], ['norec', 'No recording'],
  ['limits', 'It knows its limits'], ['measured', 'Measured'], ['pacing', 'Pacing'], ['invent', 'Invent or find'],
  ['missing', 'Not there yet'], ['read', 'Read the research'],
];
const hindiLine = 'नमस्ते आप कैसे हैं आज मौसम बहुत अच्छा है';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alaap · आलाप</title>
    <meta name="description" content="Describe a character. Get a voice nobody has recorded. Keep it." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Catamaran:wght@300;400;500;600&family=Gotu&display=swap" rel="stylesheet" />
  </head>
  <body class="no-js">
    <a class="skip" href="#threshold">Skip to content</a>

    <!-- The pulli row: one dot per section, pinned. The line reaches the dot you are reading. -->
    <header class="pulli">
      <a class="brand" href="#threshold"><span lang="hi">{name.devanagari}</span><span class="brand-latin">{name.latin}</span></a>
      <nav class="dotnav" aria-label="Contents, one dot per section">
        <svg class="chain" aria-hidden="true"><path class="chain-line" d="" /></svg>
        <ol>
          {sections.map(([id, title]) => (
            <li><a href={`#${id}`} data-dot={id} title={title}><span class="vh">{title}</span></a></li>
          ))}
        </ol>
      </nav>
      <p class="where"><span class="where-t">{sections[0][1]}</span></p>
    </header>

    <main>
      <!-- 1 · the threshold -->
      <section class="sec threshold" id="threshold" aria-labelledby="h-name">
        <div class="hero">
          <h1 id="h-name"><span lang="hi" class="deva">{name.devanagari}</span><span class="vh">{name.latin}: </span><span class="meaning">{meaning}</span></h1>
          <p class="lede">You describe a character in ordinary language. You get back a voice that has never existed. Then you use that voice for any line of dialogue you write, and it stays the same character every time.</p>
        </div>

        <div class="row hero-row" data-clip={mentorSeed.id} data-src={mentorSeed.src} data-seconds={mentorSeed.seconds} data-cols="34">
          <p class="given">The whole of what the system was given:</p>
          <button class="play" type="button" aria-label={`Play the mentor's seed clip: ${mentorSeed.text}`}>
            <span class="mark" aria-hidden="true"></span>
            <span class="name ex">&ldquo;{desc.mentor}&rdquo;</span>
            <span class="sub">Hear the voice it minted &middot; {s1(mentorSeed.seconds)} s</span>
          </button>
          <div class="floor"><svg class="kolam" aria-hidden="true"></svg></div>
          <p class="words">It says: &ldquo;{mentorSeed.text}&rdquo;</p>
          <audio preload="none" controls src={mentorSeed.src}></audio>
        </div>

        <p class="how-read">A kolam (<span lang="ta">கோலம்</span>): rice flour on a red-oxide threshold, the dots (<span lang="ta">புள்ளி</span>) first, then one line that does not lift. Here the dots are measured from the clip in your browser: time runs across, pitch runs upward, the bottom row is rest. The line loops around the dot the voice is on, wide when loud, tight when quiet. Nothing on this page generates a voice; every clip was rendered on 2026-09-05.<noscript> Scripts are off in this browser, so the dots stay blank; the players still work.</noscript></p>
      </section>

      <!-- 2 · three descriptions, three kolams -->
      <section class="sec" id="voices" aria-labelledby="h-voices">
        <h2 id="h-voices">Three descriptions, three lines through the same dots</h2>
        <p class="intro">Three voices minted from nothing but the words beside each name. The seed clip is the short reference recording the system stores alongside every identity when it is minted. Same sentence, same grid: the line sits at a different height for each.</p>
        <div class="rows">
          {seeds.map((c) => (
            <div class="row" data-clip={c.id} data-src={c.src} data-seconds={c.seconds} data-cols="48">
              <button class="play" type="button" aria-label={`Play ${who[c.character]}: ${c.text}`}>
                <span class="mark" aria-hidden="true"></span>
                <span class="name">{who[c.character]}</span>
                <span class="sub">&ldquo;{desc[c.character]}&rdquo;</span>
              </button>
              <span class="len">{s1(c.seconds)} s</span>
              <div class="floor"><svg class="kolam" aria-hidden="true"></svg></div>
              <p class="words">&ldquo;{c.text}&rdquo;</p>
              <audio preload="none" controls src={c.src}></audio>
            </div>
          ))}
        </div>
        <p class="note">Picking a name replays the demo&rsquo;s pre-rendered seed clip; nothing is generated here. {clipCaveats.watermark}</p>
      </section>

      <!-- 3 · the scene -->
      <section class="sec" id="scene" aria-labelledby="h-scene">
        <h2 id="h-scene">The scene: five lines, three characters, one run</h2>
        <p class="intro">The demo mints the three voices from text, renders this scene, watermarks everything and writes a file a game engine can read, in about four minutes on one laptop GPU. These are that run&rsquo;s clips.</p>
        <div class="actions">
          <button type="button" class="btn" data-seq={scene.map((c) => `scene/${c.id}`).join(',')}>Play the scene in order</button>
          <button type="button" class="btn quiet" data-stop>Stop</button>
        </div>
        <div class="rows">
          {scene.map((c) => (
            <div class="row" data-clip={c.id} data-src={c.src} data-seconds={c.seconds} data-cols="48">
              <button class="play" type="button" aria-label={`Play ${who[c.character]}: ${c.text}`}>
                <span class="mark" aria-hidden="true"></span>
                <span class="name">{who[c.character]}</span>
                {c.experimentalEmotionSetting ? <span class="sub flag">experimental emotion setting, unvalidated</span> : <span class="sub">no direction</span>}
              </button>
              <span class="len">{s1(c.seconds)} s</span>
              <div class="floor"><svg class="kolam" aria-hidden="true"></svg></div>
              <p class="words">&ldquo;{c.text}&rdquo;</p>
              <audio preload="none" controls src={c.src}></audio>
            </div>
          ))}
        </div>
        <ul class="caveats">
          <li>{clipCaveats.watermark}</li>
          <li>{clipCaveats.emotionSetting}</li>
          <li>{clipCaveats.englishOnly}</li>
        </ul>
      </section>

      <!-- 4 · who it is for -->
      <section class="sec" id="who" aria-labelledby="h-who">
        <h2 id="h-who">Who it is for, and why Indian languages</h2>
        <div class="two">
          <p>People making games, animation, audio drama, dubbing, interactive fiction: anyone who needs many distinct speaking characters and cannot hire a cast for each one.</p>
          <div>
            <p>Indic is the stated reason the project exists. The tools that do this well mostly do it in English. Indian-language creators either use a handful of stock voices that everyone else is also using, or they hire actors. This project treats Hindi, Bengali and Tamil as first-class, not as an afterthought port.</p>
            <p>Measured so far in English, Hindi, Bengali and Tamil. The Indian-language engine covers 22 Indian languages; four measured so far. In the project&rsquo;s own measurements the Hindi path scored higher than the English path on all three identity checks.</p>
          </div>
        </div>
      </section>

      <!-- 5 · how it works -->
      <section class="sec" id="how" aria-labelledby="h-how">
        <h2 id="h-how">How it works</h2>
        <ol class="flow" aria-label="The shape of the system">
          <li><span class="node">your description</span><span class="nnote">in ordinary language</span></li>
          <li><span class="node box">the mapper</span><span class="nnote">the only part that learns</span></li>
          <li><span class="node">a voice identity</span><span class="nnote">small, stored, kept</span></li>
          <li><span class="node box ring">the voice engine</span><span class="nnote">never modified, swappable</span></li>
          <li><span class="node">audio</span><span class="nnote">watermarked and logged from the first render, plus a manifest a game engine can read</span></li>
        </ol>
        <div class="two">
          <div>
            <h3>Only one small piece is trained.</h3>
            <p>The speech engine is used as-is and never altered, so a better engine can be swapped in without rebuilding everything.</p>
            <h3>The voice identity is a small, storable thing.</h3>
            <p>That is what makes a character persistent: it can be saved, versioned and handed to someone else. Each one is stored with a short seed clip and the engine version that made it. The identity is who the character is; each line is a separate performance.</p>
          </div>
          <div>
            <h3>Two ways to answer a description, both measured.</h3>
            <p>Invent a new voice, or find the closest match in an existing library. The numbers for the trade-off are under <a href="#invent">invent or find</a>.</p>
            <h3>A separate checker.</h3>
            <p>The system that judges whether two clips are the same person is a separate speaker-recognition system that never sees the engine&rsquo;s internals. Every render is watermarked and logged from the first output.</p>
          </div>
        </div>
      </section>

      <!-- 6–9 · the four things that make it different -->
      <section class="sec" id="keep" aria-labelledby="h-keep">
        <h2 id="h-keep">A voice is a thing you keep, not a setting you re-guess</h2>
        <div class="two">
          <p>Most tools generate a voice each time you ask. Here the character&rsquo;s voice is stored as an identity and re-used. The same character sounds like the same person across every line, every scene, and every session. That consistency is measured, not hoped for.</p>
          <p>Below, the mentor three times: the seed and two lines of the scene, three different sentences through the same dots. The loops change with the words; the line keeps coming back to the same low rows.</p>
        </div>
        <div class="actions">
          <button type="button" class="btn" data-seq={mentorThree.map((c) => `keep/${c.id}`).join(',')}>Play the three in a row</button>
          <button type="button" class="btn quiet" data-stop>Stop</button>
        </div>
        <div class="rows compact">
          {mentorThree.map((c) => (
            <div class="row" data-clip={c.id} data-src={c.src} data-seconds={c.seconds} data-cols="48">
              <button class="play" type="button" aria-label={`Play the mentor: ${c.text}`}>
                <span class="mark" aria-hidden="true"></span>
                <span class="name">{c.kind === 'seed' ? 'the seed' : 'a line of the scene'}</span>
                {c.experimentalEmotionSetting && <span class="sub flag">experimental emotion setting, unvalidated</span>}
              </button>
              <span class="len">{s1(c.seconds)} s</span>
              <div class="floor"><svg class="kolam" aria-hidden="true"></svg></div>
              <p class="words">&ldquo;{c.text}&rdquo;</p>
              <audio preload="none" controls src={c.src}></audio>
            </div>
          ))}
        </div>
      </section>

      <section class="sec" id="apart" aria-labelledby="h-apart">
        <h2 id="h-apart">Who is speaking and what is being said are genuinely separate</h2>
        <div class="two">
          <p>The system holds a character&rsquo;s identity apart from the words. That is why one character can say anything without the voice changing, and why changing the line never changes the person. This was verified rather than assumed: when the same audio content is played through two different identities, the words come out identically. The measured error between them was exactly zero on every line tested.</p>
          <div>
            <p>Two invented voices from two descriptions, saying the same sentence.</p>
            <button type="button" class="btn" data-seq={`voices/${mentorSeed.id},voices/${scoutSeed.id}`}>Play the mentor, then the scout</button>
          </div>
        </div>
      </section>

      <section class="sec" id="norec" aria-labelledby="h-norec">
        <h2 id="h-norec">It does not need a recording of the character</h2>
        <div class="two">
          <p>There is no voice cloning here, and no user uploads their own audio. Voices are created from a written description. That sidesteps the consent and impersonation problem entirely: you cannot accidentally clone a real person if the system never accepts a recording.</p>
          <ul class="rules">
            <li>never accept a user&rsquo;s audio</li>
            <li>watermark from the first render</li>
            <li>store timbre, not performance</li>
            <li>do not start the next stage until this one is measured</li>
          </ul>
        </div>
      </section>

      <section class="sec" id="limits" aria-labelledby="h-limits">
        <h2 id="h-limits">It knows what it does not know</h2>
        <div class="two">
          <p>Every capability is measured against a control, and the honest limits are published alongside the results. Roughly twenty findings in this project were wrong on the first attempt and caught by a check, including one where an entire experiment produced fluent-sounding speech that was saying different words than requested, and nothing errored. That is written up publicly rather than quietly fixed.</p>
          <blockquote>A suspiciously good or suspiciously bad number is a bug report about your setup.</blockquote>
        </div>
      </section>

      <!-- 10 · measured, caveat beside each result -->
      <section class="sec" id="measured" aria-labelledby="h-measured">
        <h2 id="h-measured">What is measured, with the caveat beside it</h2>
        <dl class="ledger">
          <div><dt>It works end to end today</dt><dd>On one laptop GPU, in English, Hindi, Bengali and Tamil. Describe a character, get a voice, render a scene of dialogue, and out comes watermarked audio plus a file a game engine can read.</dd><dd class="cav">Three characters, five lines, about four minutes. The clips above are that run.</dd></div>
          <div><dt>Minting a voice from a description costs nothing in clarity</dt><dd>A described voice is just as intelligible as one taken from a real recording. The measured difference was tiny, leaned slightly in the invented voice&rsquo;s favour, and was smaller than the difference between two real speakers: that gap was six times larger. Read it as no detectable difference, not as invented voices being better.</dd><dd class="cav">The control that had to pass first: every version must come out the same length before any score is read, or the run aborts.</dd></div>
          <div><dt>Invented voices are recognisably distinct people</dt><dd>Verified by a separate speaker-recognition system that has never seen the generator: an independent check, not the system marking its own homework. Each invented voice also sits clearly apart from the nearest real voice the system learned from, so these are new voices, not real people wearing a label.</dd></div>
          <div><dt>A character stays itself more consistently than a real person does</dt><dd>Across different sentences, more consistently than a real person across different recordings, which is unsurprising once you think about it: a stored voice has no bad-throat day, no change of microphone, no mood.</dd></div>
          <div><dt>A native speaker confirmed the Hindi says what it should</dt><dd>A fluent Hindi speaker has confirmed one rendered line says the target sentence. They were told the sentence and asked &ldquo;does it say this?&rdquo;, not &ldquo;does it sound right?&rdquo;. That is the check the earlier faulty audio failed: it sounded fluent and was saying different words.<span class="hindi" lang="hi">{hindiLine}</span><span class="gloss">Our plain translation, not a project claim: &ldquo;Hello, how are you? The weather is very nice today.&rdquo;</span></dd><dd class="cav">Still to be checked: the other three voices and the other two lines. One rendered line, one speaker, so far.</dd></div>
          <div><dt>A blind listening test found and fixed a real problem</dt><dd>A blind listening test with built-in controls found a real problem in how the system judged whether two voices were the same person: pairs the system called different were heard as the same person about half the time. The threshold was raised. That removed 10 duplicate voices from a set of 50 and cost 3 percent of measured variety.</dd><dd class="cav">The test was small, 8 pairs and one listener with every control answered correctly; it found the problem but does not settle the exact threshold, and the English threshold has not had its own listening test.</dd></div>
          <div><dt>Watermarked and logged from the first render</dt><dd>Every render is watermarked and logged, from the first output, not added later. The watermark is AudioSeal. Output includes a manifest a game engine can consume: this is built for a pipeline, not a demo button. The manifest&rsquo;s own line: &ldquo;AI-generated synthetic speech. All audio carries an AudioSeal watermark.&rdquo;</dd><dd class="cav">114 automated checks guard the rules the project learned the hard way.</dd></div>
        </dl>
      </section>

      <!-- 11 · pacing -->
      <section class="sec" id="pacing" aria-labelledby="h-pacing">
        <h2 id="h-pacing">Pacing is controllable within a measured range</h2>
        <div class="two">
          <p>You can slow a character to about two-thirds of normal speed or push them to about 1.4 times, and they stay the same person saying the same words. Outside that range the identity fades gradually rather than breaking. A listener noted the slow extreme starts to sound processed; the range they called clean is narrower, about 0.8 to 1.25 times.</p>
          <figure class="pace">
            <svg viewBox="0 0 560 84" role="img" aria-labelledby="pace-t">
              <title id="pace-t">Pacing scale from about two-thirds to about 1.4 times normal speed. The measured range spans the whole line; the listener's clean range is the brighter span from 0.8 to 1.25.</title>
              <line x1="30" y1="40" x2="530" y2="40" class="p-measured" />
              <line x1="140" y1="40" x2="428" y2="40" class="p-clean" />
              <g class="p-dots"><circle cx="30" cy="40" r="4" /><circle cx="140" cy="40" r="4" /><circle cx="290" cy="40" r="4" /><circle cx="428" cy="40" r="4" /><circle cx="530" cy="40" r="4" /></g>
              <g class="p-text"><text x="30" y="68">0.67×</text><text x="140" y="68">0.8×</text><text x="290" y="68">1×</text><text x="428" y="68">1.25×</text><text x="530" y="68">1.43×</text></g>
              <g class="p-text small"><text x="30" y="22">slower</text><text x="290" y="22">normal</text><text x="530" y="22">faster</text></g>
            </svg>
            <figcaption>Measured range in the dim line, the listener&rsquo;s clean range in the bright one. A bounded illustration: nothing on this page re-times audio.</figcaption>
          </figure>
        </div>
      </section>

      <!-- 12 · invent or find -->
      <section class="sec" id="invent" aria-labelledby="h-invent">
        <h2 id="h-invent">Two ways to answer a description, and the numbers for the trade-off</h2>
        <p class="intro">Invent a new voice, or find the closest match in an existing library of voices. Inventing gives you a character nobody else has; finding gives you higher accuracy and studio quality. Neither is strictly better and the project has numbers for the trade-off.</p>
        <dl class="ledger">
          <div><dt>Finding, on a library of 141 real Hindi voices</dt><dd>Two thirds of descriptions (65.6%) get a voice that matches on every trait named, and 87% land within one step. When the description names only a couple of traits, the way people actually write, 53.8% match exactly on the traits named. Random chance is about 20%. The same method on a library of 2,500 English voices reaches 88.5%. It replicates in Bengali within a point or two.</dd></div>
          <div><dt>Reach</dt><dd>Finding reaches 87% of the variety the library actually holds; inventing reached 37% before two mis-set settings were fixed, and the fix raised the invented catalogue from 14 to 22 distinct Hindi voices and from 23 to 41 English.</dd></div>
          <div><dt>What finding cannot do</dt><dd>Produce a voice the library does not contain. Guarantee a new character is unique: two descriptions can return the same voice. And the library is someone else&rsquo;s, so every character in every project draws from the same shelf.</dd><dd class="cav">The library measured was real recorded speakers standing in for a studio library, and no commercial system has been measured.</dd></div>
        </dl>
      </section>

      <!-- 13 · the unfinished corner: what is not there yet, in full -->
      <section class="sec wet" id="missing" aria-labelledby="h-missing">
        <h2 id="h-missing">The unfinished corner</h2>
        <p class="intro">The line has not reached these dots yet. Stated plainly, because it is the most useful part of the page.</p>
        <ul class="bare">
          <li><strong>Not a product.</strong> This is a working research system, not a product. There is no signup, no hosted service, no API.</li>
          <li><strong>Emotion is not solved.</strong> Emotional performance direction is not solved. You can control pacing within a measured range. You cannot yet say &ldquo;say this line apologetically&rdquo; and have it work. That was tested thoroughly and does not work on the current engine, for reasons the project documented and reported upstream. The engine&rsquo;s documented emotion tags turn out not to be recognised by the engine at all, and a listener heard no difference between four tagged versions of the same line.</li>
          <li><strong>The catalogue is small.</strong> Tens of distinct voices per language so far, not hundreds: about 22 in Hindi and 41 in English by the project&rsquo;s own measure. The limit is understood and measured rather than mysterious: the real speakers the system learned from hold about 38 to 48 distinguishable voices, and the project measured exactly where its own method loses variety.</li>
          <li><strong>Cannot ship as a product, for licensing reasons.</strong> It cannot be shipped as a product in its current form for licensing reasons, which are documented. The Indian-language engine&rsquo;s training chain includes data licensed for non-commercial use, so no model weights and no Indian-language audio leave the repository. It is research-only today, deliberately.</li>
          <li><strong>Very little has been listened to.</strong> Most results are automatic measurements. One listener, a handful of pairs.</li>
          <li><strong>No comparison against a commercial system.</strong> None has been measured.</li>
          <li><strong>The clips on this page are English.</strong> Hindi renders exist and a native speaker has checked one, but the Indian-language engine&rsquo;s licence is research-only, so those clips do not ship, not even here.</li>
          <li><strong>Three of the five demo lines</strong> were rendered with an experimental emotion setting whose effect has not been validated on this engine. They are flagged above. Listen to them as voice samples, not performances.</li>
        </ul>
      </section>

      <!-- 14 · read the research -->
      <section class="sec read" id="read" aria-labelledby="h-read">
        <h2 id="h-read">The line comes home</h2>
        <p class="intro">Here is what we built, here is what we measured, here is what is missing. If a claim here is wrong, an issue with a primary source is more useful than almost anything else.</p>
        <p class="cta"><a class="btn" href={links.repo}>Read the research</a><a class="btn quiet" href={links.issues}>Corrections welcome</a></p>
        <p class="colophon">Research and documentation CC-BY-4.0; code MIT. No model weights and no generated Indian-language audio ship. Research pass 2026-09-02; implementation and measurement 2026-09-05. <a href={links.repo}>github.com/PranavMishra17/alaap</a></p>
      </section>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --oxide: #7a2e1f;
    --wet: #521d13;
    --rice: #f4ecd9;
    --flour: rgba(244, 236, 217, 0.74);
    --dust: rgba(244, 236, 217, 0.34);
    --marigold: #f0a030;
    --display: 'Gotu', 'Nirmala UI', 'Noto Sans Devanagari', 'Segoe UI', sans-serif;
    --body: 'Catamaran', 'Nirmala UI', 'Segoe UI', system-ui, sans-serif;
    --tamil: 'Catamaran', 'Nirmala UI', 'Latha', 'Noto Sans Tamil', sans-serif;
    --pulli-h: 3.75rem;
    --gutter: clamp(1.1rem, 4vw, 3.5rem);
  }
  * { box-sizing: border-box; }
  html { background: var(--oxide); scroll-padding-top: calc(var(--pulli-h) + 1rem); scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--oxide); color: var(--rice); font: 400 17px/1.55 var(--body); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 0.2em; text-decoration-color: var(--flour); }
  a:hover { text-decoration-color: var(--marigold); }
  :focus-visible { outline: 2px solid var(--marigold); outline-offset: 3px; }
  h1, h2, h3 { font-family: var(--display); font-weight: 400; line-height: 1.15; margin: 0; }
  h2 { font-size: clamp(1.5rem, 2.4vw, 2.1rem); max-width: 26ch; margin-bottom: 0.9rem; }
  h3 { font-size: 1.15rem; margin: 1rem 0 0.25rem; }
  h3:first-child { margin-top: 0; }
  p { margin: 0 0 0.9rem; max-width: 64ch; }
  strong { font-weight: 600; }
  button { font: inherit; color: inherit; }
  [lang='hi'] { font-family: var(--display); }
  [lang='ta'] { font-family: var(--tamil); }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .skip { position: absolute; left: 1rem; top: -4rem; z-index: 20; background: var(--rice); color: var(--oxide); padding: 0.5rem 0.8rem; border-radius: 999px; }
