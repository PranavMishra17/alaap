<script>
  document.body.classList.remove('no-js');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  type Pt = [number, number];
  type Dot = { x: number; y: number; r: number };
  const f = (v: number) => v.toFixed(1);

  /* ---- 1. geometry: a sikku chain, one closed line looping around a run of dots ---- */
  const PHI = 36;
  const rad = (d: number) => (d * Math.PI) / 180;
  const at = (d: Dot, deg: number): Pt => [d.x + d.r * Math.cos(rad(deg)), d.y + d.r * Math.sin(rad(deg))];
  const arc = (d: Dot, from: number, to: number, n = 5): Pt[] => Array.from({ length: n }, (_, k) => at(d, from + ((to - from) * k) / (n - 1)));
  // centripetal Catmull-Rom through a closed run of points, as cubic segments
  function closedSpline(p: Pt[]): string[] {
    const n = p.length, segs: string[] = [];
    const dist = (a: Pt, b: Pt) => Math.sqrt(Math.hypot(b[0] - a[0], b[1] - a[1])) || 1e-3;
    for (let i = 0; i < n; i++) {
      const p0 = p[(i - 1 + n) % n], p1 = p[i], p2 = p[(i + 1) % n], p3 = p[(i + 2) % n];
      const d1 = dist(p0, p1), d2 = dist(p1, p2), d3 = dist(p2, p3);
      const k1 = 3 * d1 * (d1 + d2), k2 = 3 * d3 * (d3 + d2);
      const a1 = 2 * d1 * d1 + 3 * d1 * d2 + d2 * d2, a2 = 2 * d3 * d3 + 3 * d3 * d2 + d2 * d2;
      const b1x = (d1 * d1 * p2[0] - d2 * d2 * p0[0] + a1 * p1[0]) / k1, b1y = (d1 * d1 * p2[1] - d2 * d2 * p0[1] + a1 * p1[1]) / k1;
      const b2x = (d3 * d3 * p1[0] - d2 * d2 * p3[0] + a2 * p2[0]) / k2, b2y = (d3 * d3 * p1[1] - d2 * d2 * p3[1] + a2 * p2[1]) / k2;
      segs.push(`C${f(b1x)} ${f(b1y)} ${f(b2x)} ${f(b2y)} ${f(p2[0])} ${f(p2[1])}`);
    }
    return segs;
  }
  // outward pass: over the first dot, under the second, over the third... return pass closes every lobe
  function chain(dots: Dot[]) {
    const n = dots.length, out: Pt[] = [], ret: Pt[] = [];
    for (let i = 0; i < n; i++) {
      const over = i % 2 === 0, d = dots[i];
      if (i > 0) out.push([(dots[i - 1].x + d.x) / 2, (dots[i - 1].y + d.y) / 2]);
      out.push(...(over ? arc(d, 180 + PHI, 360 - PHI) : arc(d, 180 - PHI, PHI)));
    }
    for (let i = n - 1; i >= 0; i--) {
      const over = i % 2 === 0, d = dots[i];
      if (i < n - 1) ret.push([(dots[i + 1].x + d.x) / 2, (dots[i + 1].y + d.y) / 2]);
      ret.push(...(over ? arc(d, PHI, 180 - PHI) : arc(d, -PHI, -180 + PHI)));
    }
    const last = dots[n - 1], lastOver = (n - 1) % 2 === 0;
    const rturn = (lastOver ? arc(last, 360 - PHI, 360 + PHI, 3) : arc(last, PHI, -PHI, 3)).slice(1, -1);
    const lturn = arc(dots[0], 180 - PHI, 180 + PHI, 3).slice(1, -1);
    const pts = [...out, ...rturn, ...ret, ...lturn];
    const segs = closedSpline(pts), cut = out.length - 1;
    const M = (p: Pt) => `M${f(p[0])} ${f(p[1])}`;
    return { dOut: M(pts[0]) + segs.slice(0, cut).join(''), dRet: M(pts[cut]) + segs.slice(cut).join('') };
  }

  /* ---- 2. the pulli row: the chain reaches the section you are reading ---- */
  const nav = document.querySelector<HTMLElement>('.dotnav')!;
  const navSvg = nav.querySelector<SVGSVGElement>('.chain')!;
  const navPath = nav.querySelector<SVGPathElement>('.chain-line')!;
  const navLinks = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[data-dot]'));
  const secEls = navLinks.map((a) => document.getElementById(a.dataset.dot!)!);
  const whereT = document.querySelector<HTMLElement>('.where-t');
  let navDots: Dot[] = [], current = -1;
  function drawNav() {
    if (!navDots.length || current < 0) return;
    const c = chain(navDots.slice(0, current + 1));
    navPath.setAttribute('d', c.dOut + c.dRet.slice(c.dRet.indexOf('C')) + 'Z');
  }
  function layoutNav() {
    const nr = nav.getBoundingClientRect();
    navSvg.setAttribute('viewBox', `0 0 ${f(nr.width)} ${f(nr.height)}`);
    navDots = navLinks.map((a) => { const r = a.getBoundingClientRect(); return { x: r.left - nr.left + r.width / 2, y: r.top - nr.top + r.height / 2, r: Math.min(r.width * 0.36, 9) }; });
    drawNav();
  }
  let ticking = false;
  function updateCurrent() {
    ticking = false;
    const line = innerHeight * 0.38;
    let cur = 0;
    secEls.forEach((s, i) => { if (s.getBoundingClientRect().top <= line) cur = i; });
    if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) cur = secEls.length - 1;
    if (cur === current) return;
    current = cur;
    navLinks.forEach((a, i) => { if (i === cur) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current'); });
    if (whereT) whereT.textContent = navLinks[cur].title;
    drawNav();
  }
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(updateCurrent); } }, { passive: true });
  layoutNav(); updateCurrent();
  if (document.fonts?.ready) document.fonts.ready.then(layoutNav);

  /* ---- 3. measure each clip, lay its dots, draw its line ---- */
  type Frame = { t: number; rms: number; f0: number };
  type Ana = { frames: Frame[]; max: number; dur: number; medRow: number };
  type Row = { el: HTMLElement; audio: HTMLAudioElement; svg: SVGSVGElement; src: string; cols: number; key: string; ana: Ana | null; lenOut: number; lenRet: number; tOut: SVGPathElement | null; tRet: SVGPathElement | null };
  const rows: Row[] = Array.from(document.querySelectorAll<HTMLElement>('.row[data-clip]')).map((el) => ({
    el, audio: el.querySelector('audio')!, svg: el.querySelector<SVGSVGElement>('svg.kolam')!, src: el.dataset.src!, cols: Number(el.dataset.cols) || 40,
    key: `${el.closest('.sec')!.id}/${el.dataset.clip}`, ana: null, lenOut: 0, lenRet: 0, tOut: null, tRet: null,
  }));
  const byKey = new Map(rows.map((r) => [r.key, r]));
  const SR = 12000, FMIN = 65, FMAX = 330, ROWS = 7;
  const pitchRow = (hz: number) => 1 + Math.min(ROWS - 2, Math.floor(Math.max(0, Math.log(hz / FMIN) / Math.log(FMAX / FMIN)) * (ROWS - 1)));

  function analyse(buf: AudioBuffer): Ana {
    // normalised autocorrelation per 512-sample frame at 12 kHz; the voice range is 60 to 450 Hz
    const x = buf.getChannelData(0), W = 512, H = 192, lmin = Math.floor(SR / 450), lmax = Math.ceil(SR / 60);
    const frames: Frame[] = []; let max = 0;
    for (let s = 0; s + W + lmax < x.length; s += H) {
      let e = 0; for (let i = 0; i < W; i++) e += x[s + i] * x[s + i];
      const rms = Math.sqrt(e / W); if (rms > max) max = rms;
      frames.push({ t: (s + W / 2) / SR, rms, f0: 0 });
    }
    frames.forEach((fr, fi) => {
      if (fr.rms < max * 0.08) return;
      const s = fi * H, e0 = fr.rms * fr.rms * W, r: number[] = []; let best = 0, bestLag = 0;
      for (let lag = lmin; lag <= lmax; lag++) {
        let c = 0, e1 = 0;
        for (let i = 0; i < W; i++) { const b = x[s + i + lag]; c += x[s + i] * b; e1 += b * b; }
        const v = c / Math.sqrt(e0 * e1 + 1e-9); r.push(v);
        if (v > best) { best = v; bestLag = lag; }
      }
      if (best < 0.55) return;
      for (let lag = lmin; lag < bestLag; lag++) if (r[lag - lmin] >= best * 0.92) { bestLag = lag; break; }
      fr.f0 = SR / bestLag;
    });
    const voiced = frames.filter((fr) => fr.f0).map((fr) => pitchRow(fr.f0)).sort((a, b) => a - b);
    return { frames, max: max || 1, dur: buf.duration, medRow: voiced.length ? voiced[voiced.length >> 1] : 2 };
  }

  function build(row: Row) {
    const a = row.ana; if (!a) return;
    const W = Math.max(240, row.svg.getBoundingClientRect().width || row.el.clientWidth);
    const sp0 = Math.max(16, W / row.cols), N = Math.max(8, Math.floor(W / sp0));
    const pad = sp0 * 0.55, sp = (W - 2 * pad) / (N - 1), gap = sp * 0.82, Hh = (ROWS - 1) * gap + 2 * pad;
    row.svg.setAttribute('viewBox', `0 0 ${f(W)} ${f(Hh)}`);
    const dr = Math.max(1.6, sp * 0.075); let dd = '';
    for (let r = 0; r < ROWS; r++) for (let c = 0; c < N; c++) {
      const x = pad + c * sp, y = pad + (ROWS - 1 - r) * gap;
      dd += `M${f(x - dr)} ${f(y)}a${f(dr)} ${f(dr)} 0 1 0 ${f(2 * dr)} 0a${f(dr)} ${f(dr)} 0 1 0 ${f(-2 * dr)} 0`;
    }
    // one dot per column: the row is the measured pitch (rest row at the bottom), the loop is the loudness
    const dots: Dot[] = []; let hold = a.medRow;
    for (let c = 0; c < N; c++) {
      const t0 = (c / N) * a.dur, t1 = ((c + 1) / N) * a.dur;
      const inC = a.frames.filter((fr) => fr.t >= t0 && fr.t < t1);
      const loud = inC.length ? Math.max(...inC.map((fr) => fr.rms)) / a.max : 0;
      const v = inC.filter((fr) => fr.f0).map((fr) => fr.f0).sort((p, q) => p - q);
      let ri = 0;
      if (loud > 0.07) { ri = v.length >= 2 ? pitchRow(v[v.length >> 1]) : hold; hold = ri; }
      dots.push({ x: pad + c * sp, y: pad + (ROWS - 1 - ri) * gap, r: sp * (0.17 + 0.29 * Math.pow(loud, 0.7)) });
    }
    const ch = chain(dots);
    row.svg.innerHTML = `<path class="dots" d="${dd}"/><path class="line line-out" d="${ch.dOut}"/><path class="line line-ret" d="${ch.dRet}"/><path class="trace trace-out" d="${ch.dOut}"/><path class="trace trace-ret" d="${ch.dRet}"/>`;
    row.tOut = row.svg.querySelector('.trace-out'); row.tRet = row.svg.querySelector('.trace-ret');
    row.lenOut = row.tOut!.getTotalLength(); row.lenRet = row.tRet!.getTotalLength();
    row.tOut!.style.strokeDasharray = `${row.lenOut}`; row.tRet!.style.strokeDasharray = `${row.lenRet}`;
    setTrace(row, 0); row.tRet!.style.strokeDashoffset = `${row.lenRet}`;
  }
  // the threshold at dawn: the hero line draws itself once, at the pace of the clip, then comes home
  function dawn(row: Row) {
    const o = row.svg.querySelector<SVGPathElement>('.line-out')!, b = row.svg.querySelector<SVGPathElement>('.line-ret')!;
    for (const [p, len, dur, delay] of [[o, row.lenOut, 2.2, 0], [b, row.lenRet, 0.7, 2.2]] as const) {
      p.style.strokeDasharray = `${len}`; p.style.setProperty('--len', `${len}`); p.style.setProperty('--dur', `${dur}s`); p.style.setProperty('--delay', `${delay}s`);
      p.classList.add('drawn');
    }
  }
  async function decodeAll() {
    if (!('OfflineAudioContext' in window)) return;
    const cache = new Map<string, Ana>();
    const hero = rows.find((r) => r.el.classList.contains('hero-row'));
    const order = hero ? [hero, ...rows.filter((r) => r !== hero)] : rows;
    for (const r of order) {
      try {
        let a = cache.get(r.src);
        if (!a) { const buf = await (await fetch(r.src)).arrayBuffer(); a = analyse(await new OfflineAudioContext(1, 1, SR).decodeAudioData(buf)); cache.set(r.src, a); }
        r.ana = a; build(r);
        if (r === hero && !reduced) dawn(r);
      } catch (e) { console.warn('kolam skipped for', r.key, e); }
    }
  }
  decodeAll();
  let rt = 0;
  addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(() => { layoutNav(); rows.forEach(build); }, 150); });

  /* ---- 4. playback: the marigold line traces the clip, then comes home ---- */
  let playing: Row | null = null, queue: string[] = [], raf = 0;
  function setTrace(row: Row, p: number) { if (row.tOut) row.tOut.style.strokeDashoffset = `${row.lenOut * (1 - Math.min(1, Math.max(0, p)))}`; }
  function hideTrace(row: Row) {
    row.el.classList.remove('homing');
    setTimeout(() => { if (playing !== row) { setTrace(row, 0); if (row.tRet) row.tRet.style.strokeDashoffset = `${row.lenRet}`; } }, 350);
  }
  function home(row: Row) {
    if (reduced || !row.tRet) { hideTrace(row); return; }
    row.el.classList.add('homing'); setTrace(row, 1);
    requestAnimationFrame(() => requestAnimationFrame(() => { row.tRet!.style.strokeDashoffset = '0'; }));
    setTimeout(() => hideTrace(row), 1000);
  }
  function stopAll() {
    queue = [];
    if (playing) { const r = playing; playing = null; r.audio.pause(); r.el.classList.remove('is-playing'); hideTrace(r); }
    cancelAnimationFrame(raf);
  }
  function tick() {
    if (!playing) return;
    const a = playing.audio, d = a.duration || Number(playing.el.dataset.seconds) || 1;
    setTrace(playing, a.currentTime / d);
    if (!a.paused && !a.ended) raf = requestAnimationFrame(tick);
  }
  function play(key: string) {
    const row = byKey.get(key); if (!row) return;
    if (playing && playing !== row) { const p = playing; p.audio.pause(); p.el.classList.remove('is-playing'); hideTrace(p); }
    playing = row; row.el.classList.add('is-playing'); row.el.classList.remove('homing');
    setTrace(row, 0); if (row.tRet) row.tRet.style.strokeDashoffset = `${row.lenRet}`;
    row.audio.currentTime = 0;
    row.audio.play().then(() => { if (!reduced) raf = requestAnimationFrame(tick); }).catch(() => { row.el.classList.remove('is-playing'); playing = null; });
  }
  function next() { const k = queue.shift(); if (k) play(k); }
  rows.forEach((r) => {
    r.audio.addEventListener('ended', () => { r.el.classList.remove('is-playing'); if (playing === r) { playing = null; cancelAnimationFrame(raf); home(r); next(); } });
    r.audio.addEventListener('pause', () => { if (playing === r && !r.audio.ended) { r.el.classList.remove('is-playing'); playing = null; cancelAnimationFrame(raf); hideTrace(r); } });
    // reduced motion: no swept line; the trace advances at the audio's own coarse clock
    r.audio.addEventListener('timeupdate', () => { if (reduced && playing === r) setTrace(r, r.audio.currentTime / (r.audio.duration || Number(r.el.dataset.seconds) || 1)); });
    r.el.querySelector<HTMLButtonElement>('.play')!.addEventListener('click', () => { if (playing === r) { stopAll(); return; } queue = []; play(r.key); });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-seq]').forEach((b) => b.addEventListener('click', () => {
    const keys = (b.dataset.seq || '').split(',').filter(Boolean);
    stopAll();
    const first = byKey.get(keys[0]); if (!first) return;
    const rect = first.el.getBoundingClientRect();
    if (rect.top < 0 || rect.bottom > innerHeight) first.el.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
    queue = keys.slice(1); play(keys[0]);
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-stop]').forEach((b) => b.addEventListener('click', stopAll));
</script>
