  .lang { padding: .55rem 1.1rem .5rem; background: transparent; color: var(--chuna); border: 3px solid var(--chuna); font: 600 1.15rem/1 var(--cond); letter-spacing: .04em; cursor: pointer; box-shadow: 3px 3px 0 var(--haldi); }
