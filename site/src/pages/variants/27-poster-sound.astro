---
// Variant 27 — "poster · sound": the hand-painted wall poster, rebuilt around the audio. One
// sticky programme strip, one stage band where the eight clips are a single instrument, the
// languages as an honest switch (Hindi plays, for review), one painted picture of the whole thing,
// and the engineer's map as a second view of the same sheet.
import { name, meaning, links, characters, scene, seeds, clipCaveats } from '../../content/alaap';
import { indicVoices, indicClips, hindiLines, hindiLinesEnglish, indicCaveat } from '../../content/indic-review';
import TechnicalMap from '../../components/TechnicalMap.astro';
const seedOf = (id: string) => seeds.find((s) => s.character === id)!;
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
const hiClip = (voice: string, i: number) => indicClips.find((c) => c.voice === voice && c.lineIndex === i)!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ?? new URL('http://127.0.0.1:4322/');
const canonical = new URL(Astro.url.pathname.replace(/\/$/, ''), site).href;
const ogImage = new URL(`${base}/og/27-poster-sound.png`, site).href;
const title = 'Alaap — a voice from a description';
const description = 'Describe a character in ordinary language. Get back a voice that has never existed, and keep it: the same character for every line you write.';
const ogAlt = 'A hand-painted poster: आलाप in red enamel on yellow, and the line “Describe a character. Get a voice nobody has recorded. Keep it.”';
const favicon = 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" fill="#F2B41E"/><text x="33" y="50" font-family="Yatra One,Nirmala UI,Kohinoor Devanagari,serif" font-size="46" font-weight="700" text-anchor="middle" fill="#C6201A" stroke="#17140F" stroke-width="2.5" paint-order="stroke" style="paint-order:stroke">आ</text></svg>');
const ld = {
  '@context': 'https://schema.org', '@type': 'SoftwareSourceCode', name: 'Alaap', alternateName: 'आलाप',
  description, url: canonical, image: ogImage, codeRepository: links.repo, inLanguage: 'en',
  license: ['https://creativecommons.org/licenses/by/4.0/', 'https://opensource.org/license/mit/'],
  isAccessibleForFree: true,
};
const strip = [['voice', 'The voice'], ['stage', 'The stage'], ['billing', 'Different'], ['measured', 'Measured'], ['how', 'How'], ['fine', 'Not yet'], ['read', 'Read']];
const langs = [['en', 'English', 'en'], ['hi', 'हिन्दी', 'hi'], ['bn', 'বাংলা', 'bn'], ['ta', 'தமிழ்', 'ta']];
// the technical map's own contents, mirrored into the strip when that view is on (ids from the component)
const tmap = [['ctx', 'System'], ['tower', 'Towers'], ['mint', 'Minting'], ['render', 'Rendering'], ['gates', 'Gates'], ['rev', 'Captions'], ['geom', 'Space'], ['axes', 'Axes'], ['backend', 'Engines'], ['codec', 'Split'], ['dir', 'Direction'], ['mods', 'Modules'], ['exp', 'Experiments'], ['stages', 'Status']];
---
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F2B41E" />
    <meta name="robots" content="index,follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Alaap" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Eczar:wght@400;500&family=Khand:wght@500;600;700&family=Yatra+One&family=Hind+Siliguri:wght@600&family=Hind+Madurai:wght@600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)}></script>
    <script is:inline>document.documentElement.classList.remove('no-js');if(/[?&]og(?=&|$)/.test(location.search))document.documentElement.classList.add('og');document.documentElement.classList.toggle('view-tech',/^#(technical|map-)/.test(location.hash));</script>
  </head>
  <body>
    <svg class="defs" aria-hidden="true" width="0" height="0" focusable="false">
      <filter id="brush" x="-5%" y="-60%" width="110%" height="220%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.009 0.09" numOctaves="2" seed="11" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="16" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="brush-soft" x="-4%" y="-8%" width="108%" height="116%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="4" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="3.5" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <main class="poster" id="top">
      <!-- the programme strip: where you are, and what is playing -->
      <nav class="strip" aria-label="Programme">
        <a class="strip-brand" href="#top" lang="hi">{name.devanagari}</a>
        <ol class="strip-list strip-list--land" data-strip="land">
          {strip.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
        </ol>
        <ol class="strip-list strip-list--tech" data-strip="tech" aria-label="Sections of the technical map">
          {tmap.map(([id, label]) => <li><a href={`#map-${id}`}>{label}</a></li>)}
        </ol>
        <div class="strip-view" role="group" aria-label="View">
          <a class="sw sw--land" href="#top">Landing</a>
          <a class="sw sw--tech" href="#technical"><span class="sw-long">Technical map</span><span class="sw-short" aria-hidden="true">Map</span></a>
        </div>
        <div class="strip-now" hidden>
          <a class="strip-now-txt" href="#stage" data-now-txt>Nothing playing</a>
          <button type="button" class="strip-stop" data-stop-all>Stop</button>
        </div>
      </nav>

      <!-- 1 · masthead: the name, and the first voice -->
      <header class="band band--haldi masthead">
        <p class="tagline">Describe a character. Get a voice nobody has recorded. Keep it.</p>
        <div class="mast">
          <h1 class="title">
            <span class="title-dev painted" lang="hi">{name.devanagari}</span>
            <span class="title-lat">{name.latin}</span>
          </h1>
          <div class="mast-text">
            <p class="meaning">“{meaning}”</p>
            <p class="oneliner">You describe a character in ordinary language. You get back a voice that has never existed. Then you use that voice for any line of dialogue you write, and it stays the same character every time.</p>
            <p class="forwhom">For people making games, animation, audio drama, dubbing, interactive fiction: anyone who needs many distinct speaking characters and cannot hire a cast for each one.</p>
          </div>
        </div>
        <div class="example ch-mentor" id="voice" data-player data-kind="seed" data-character="mentor">
          <p class="ex-label">The example. This is all the system was given:</p>
          <p class="ex-desc">“{characters[0].description}”</p>
          <button type="button" class="btn btn--sindoor" data-play aria-pressed="false"><span class="tri" aria-hidden="true"></span><span class="play-txt">Play</span><span class="btn-sub">the voice it minted · {seedOf('mentor').seconds} s</span></button>
          <canvas class="wave" aria-hidden="true"></canvas>
          <p class="words">It says: “{seedOf('mentor').text}” Pre-rendered on 2026-09-05; nothing on this page generates a voice live.</p>
          <audio preload="none" controls src={seedOf('mentor').src}></audio>
        </div>
      </header>

      <!-- 2 · the stage: every clip on the page, as one instrument, behind an honest language switch -->
      <section class="band band--kajal stage" id="stage" aria-labelledby="stage-h">
        <h2 class="bill" id="stage-h"><span class="bill-hi painted" lang="hi">मंच</span><span class="bill-en">The stage · three voices, five lines, one run, in four languages</span></h2>
        <div class="langs" role="tablist" aria-label="Language">
          {langs.map(([code, label, lg]) => <button type="button" role="tab" id={`tab-${code}`} aria-controls={`panel-${code}`} aria-selected={code === 'en' ? 'true' : 'false'} class="lang" data-lang-tab={code} lang={lg}>{label}</button>)}
        </div>

        <div class="panel" id="panel-en" role="tabpanel" aria-labelledby="tab-en" data-lang-panel="en">
          <p class="band-intro">English plays. Three voices minted from a sentence each, then five lines rendered with them: about four minutes on one laptop GPU, out came watermarked audio and a manifest a game engine can read.</p>

          <h3 class="sub"><span class="painted" lang="hi">कलाकार</span> The cast</h3>
          <ul class="cast">
            {characters.map((ch) => { const s = seedOf(ch.id); return (
              <li class={`card ch-${ch.id}`} data-player data-kind="seed" data-character={ch.id}>
                <div class="card-head">
                  <h4 class="card-name">{cap(ch.id)}</h4>
                  <button type="button" class="play" data-play aria-pressed="false" aria-label={`Play the ${ch.id}'s seed clip, ${s.seconds} seconds`}><span class="tri" aria-hidden="true"></span><span class="play-txt" aria-hidden="true">Play</span></button>
                </div>
                <p class="card-desc">Given only: <q>{ch.description}</q></p>
                <canvas class="wave" aria-hidden="true"></canvas>
                <div class="register" hidden aria-hidden="true"><span>low</span><span class="reg-scale"><span class="reg-mark"></span></span><span>high</span></div>
                <p class="words">Seed clip, {s.seconds} s: “{s.text}”</p>
                <audio preload="none" controls src={s.src}></audio>
              </li>
            ); })}
          </ul>
          <p class="note">Bars and the low-to-high mark are drawn in your browser from the clip itself: loudness, and roughly where the voice sits in pitch against the other two. The seed clip is the short reference recording stored with every identity when it is minted.</p>

          <h3 class="sub"><span class="painted" lang="hi">दृश्य</span> The scene</h3>
          <div class="instrument" data-instrument aria-label="The scene, five lines">
            <div class="transport">
              <button type="button" class="btn btn--haldi" data-scene-play aria-pressed="false"><span class="tri" aria-hidden="true"></span><span class="scene-txt">Play the scene</span><span class="btn-sub">all five lines in order</span></button>
              <button type="button" class="tbtn" data-scene-prev aria-label="Previous line">◀ Line</button>
              <button type="button" class="tbtn" data-scene-next aria-label="Next line">Line ▶</button>
              <button type="button" class="tbtn" data-scene-stop>■ Stop</button>
              <p class="where" data-where aria-live="polite">Nothing playing</p>
            </div>
            <div class="timeline" data-timeline>
              {scene.map((c, i) => <button type="button" class={`seg ch-${c.character}`} style={`--s:${c.seconds}`} data-seg={i} aria-label={`Play the scene from line ${i + 1}, ${cap(c.character)}, ${c.seconds} seconds`}>{cap(c.character)}</button>)}
              <span class="playhead" aria-hidden="true"></span>
            </div>
            <p class="keys">One block per line, as long as its clip. Tap a block to run the scene from there; a line's own play plays only that line. Keys, once a control here has focus: ← → change line · 1 to 5 jump · Esc stops.</p>
            <ol class="lines">
              {scene.map((c, i) => (
                <li class={`line ch-${c.character}`} data-player data-kind="line" data-character={c.character} data-index={i} data-seconds={c.seconds}>
                  <span class="num" aria-hidden="true">{i + 1}</span>
                  <span class="who" data-n={i + 1}>{cap(c.character)}</span>
                  <button type="button" class="play" data-play aria-pressed="false" aria-label={`Play line ${i + 1}, ${cap(c.character)}: ${c.text}`}><span class="tri" aria-hidden="true"></span><span class="play-txt" aria-hidden="true">Play</span></button>
                  <p class="words">“{c.text.split(' ').map((w, k, arr) => <><span class="w">{w}</span>{k < arr.length - 1 ? ' ' : ''}</>)}”</p>
                  <canvas class="wave" aria-hidden="true"></canvas>
                  <span class="dur">{c.seconds} s</span>
                  {c.experimentalEmotionSetting ? <span class="slip slip--tag">experimental emotion setting, unvalidated</span> : <span class="tag-plain">no direction</span>}
                  <audio preload="none" controls src={c.src}></audio>
                </li>
              ))}
            </ol>
            <p class="note">Words light as the line plays. Their timing is approximate, spread across the clip's measured speech by word length, not aligned by the engine; the line and the speaker's card are exact.</p>
          </div>
          <div class="slips">
            <p class="slip">{clipCaveats.watermark}</p>
            <p class="slip">{clipCaveats.emotionSetting}</p>
            <p class="slip">These are the English clips from the end-to-end demo, the only audio that ships. The Hindi renders under <span lang="hi">हिन्दी</span> are here for review only: the Indian-language engine is research-only under its licence.</p>
          </div>
        </div>

        <div class="panel panel--hi" id="panel-hi" role="tabpanel" aria-labelledby="tab-hi" data-lang-panel="hi">
          <p class="band-intro">Hindi plays here, for review. Three of these four voices were minted on the Indian-language engine from the same three sentences that made the mentor, the scout and the innkeeper; every voice says the same three lines. Bars and the low-to-high mark are drawn from the clips, as in English. In the project's own measurements the Hindi path scored higher than the English path on all three identity checks.</p>

          <h3 class="sub"><span class="painted" lang="hi">एक वाक्य</span> One description, two engines</h3>
          <div class="compare" data-compare>
            <p class="cmp-desc">“{characters[0].description}”</p>
            <button type="button" class="btn btn--haldi cmp-btn" data-compare-play aria-pressed="false"><span class="tri" aria-hidden="true"></span><span class="cmp-txt">Hear both</span><span class="btn-sub">the English seed, then the Hindi line</span></button>
            <div class="cmp-pair">
              <div class="cmp ch-mentor" data-player data-kind="cmp" data-character="mentor" data-seconds={seedOf('mentor').seconds}>
                <p class="cmp-lab"><b>English engine</b> · Mentor · seed clip · {seedOf('mentor').seconds} s</p>
                <button type="button" class="play" data-play aria-pressed="false" aria-label={`Play the mentor's seed clip, ${seedOf('mentor').seconds} seconds`}><span class="tri" aria-hidden="true"></span><span class="play-txt" aria-hidden="true">Play</span></button>
                <canvas class="wave" aria-hidden="true"></canvas>
                <div class="register" hidden aria-hidden="true"><span>low</span><span class="reg-scale"><span class="reg-mark"></span></span><span>high</span></div>
                <p class="words">“{seedOf('mentor').text}”</p>
                <audio preload="none" controls src={seedOf('mentor').src}></audio>
              </div>
              <div class="cmp ch-guru" data-player data-kind="hi" data-character="guru" data-seconds={hiClip('guru', 0).seconds}>
                <p class="cmp-lab"><b>Indian-language engine</b> · Guru · line 1 of 3</p>
                <button type="button" class="play" data-play aria-pressed="false" aria-label={`Play the guru's Hindi line 1, ${hiClip('guru', 0).seconds} seconds`}><span class="tri" aria-hidden="true"></span><span class="play-txt" aria-hidden="true">Play</span></button>
                <canvas class="wave" aria-hidden="true"></canvas>
                <div class="register" hidden aria-hidden="true"><span>low</span><span class="reg-scale"><span class="reg-mark"></span></span><span>high</span></div>
                <p class="words" lang="hi">“{hindiLines[0]}”</p>
                <p class="gloss">Our translation, not a project claim: “{hindiLinesEnglish[0]}”</p>
                <p class="checked">Checked by a fluent Hindi speaker, asked “does it say this?”: it does.</p>
                <p class="missing" hidden>No clip in this build; the words stand.</p>
                <audio preload="none" controls src={hiClip('guru', 0).src}></audio>
              </div>
            </div>
            <p class="slip">{indicCaveat}</p>
          </div>

          <h3 class="sub"><span class="painted" lang="hi">चार आवाज़ें</span> Four voices, the same three lines</h3>
          <div class="hgrid">
            <div class="hhead">
              <p class="hcorner">Every voice, every line. Only the guru's first line has been checked by a fluent Hindi speaker; the rest are unchecked.</p>
              {indicVoices.map((v) => (
                <div class={`hvoice ch-${v.id}`}>
                  <h4 class="hv-name">{cap(v.id)}</h4>
                  <p class="hv-same">{v.sameDescriptionAs ? <>same description as the <b>{v.sameDescriptionAs}</b></> : 'Hindi only'}</p>
                  <p class="hv-desc"><q>{v.description}</q></p>
                  <div class="register" data-reg-of={v.id} hidden aria-hidden="true"><span>low</span><span class="reg-scale"><span class="reg-mark"></span></span><span>high</span></div>
                </div>
              ))}
            </div>
            {[0, 1, 2].map((i) => (
              <div class="hrow">
                <div class="hline">
                  <span class="num" aria-hidden="true">{i + 1}</span>
                  <p class="words" lang="hi">“{hindiLines[i]}”</p>
                  <p class="gloss">Our translation: “{hindiLinesEnglish[i]}”</p>
                </div>
                {indicVoices.map((v) => { const c = hiClip(v.id, i); return (
                  <div class={`hcell ch-${v.id}`} data-player data-kind="hi" data-character={v.id} data-seconds={c.seconds} data-reg-for={i === 0 ? v.id : undefined}>
                    <button type="button" class="play" data-play aria-pressed="false" aria-label={`Play ${cap(v.id)}, Hindi line ${i + 1}, ${c.seconds} seconds`}><span class="tri" aria-hidden="true"></span><span class="play-txt" aria-hidden="true">Play</span></button>
                    <canvas class="wave" aria-hidden="true" style={`--s:${c.seconds}`}></canvas>
                    {c.nativeSpeakerChecked && <span class="checked">checked: it says this sentence</span>}
                    <span class="missing" hidden>no clip in this build</span>
                    <audio preload="none" controls src={c.src}></audio>
                  </div>
                ); })}
                <p class="slip slip--row">{indicCaveat}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="panel panel--lang" id="panel-bn" role="tabpanel" aria-labelledby="tab-bn" data-lang-panel="bn">
          <h3 class="sub"><span class="painted" lang="bn">বাংলা</span> Bengali: measured; renders do not ship</h3>
          <p>Bengali is one of the four languages measured so far, of the 22 the Indian-language engine covers. Finding a voice by description was checked on a library of 138 Bengali voices and replicates the Hindi result within a point or two. Its rendered audio stays in the repository under the same research-only licence.</p>
        </div>
        <div class="panel panel--lang" id="panel-ta" role="tabpanel" aria-labelledby="tab-ta" data-lang-panel="ta">
          <h3 class="sub"><span class="painted" lang="ta">தமிழ்</span> Tamil: measured; renders do not ship</h3>
          <p>Tamil is one of the four languages measured so far, of the 22 the Indian-language engine covers. Its rendered audio stays in the repository under the same research-only licence, so there is no Tamil clip here and no placeholder pretending to be one.</p>
        </div>
      </section>

      <!-- 3 · top billing: the four differentiators -->
      <section class="band band--sindoor billing" id="billing" aria-labelledby="bill-h">
        <h2 class="bill" id="bill-h"><span class="bill-hi painted" lang="hi">खासियत</span><span class="bill-en">Top billing · the four things that make it different</span></h2>
        <p class="band-intro">Indic is the stated reason the project exists. The tools that do this well mostly do it in English; Indian-language creators either use a handful of stock voices that everyone else is also using, or they hire actors. This project treats Hindi, Bengali and Tamil as first-class, not as an afterthought port.</p>
        <div class="entries">
        <div class="entry">
          <h3 class="shout painted">A voice you keep</h3>
          <p>Most tools generate a voice each time you ask. Here the character's voice is stored as an identity and re-used: the same person across every line, every scene, every session. That consistency is measured, not hoped for.</p>
        </div>
        <div class="entry">
          <h3 class="shout painted">Who speaks is not what is said</h3>
          <p>The system holds a character's identity apart from the words. One character can say anything without their voice changing, and changing the line never changes the person. Verified rather than assumed: the same audio content played through two different identities came out saying identical words, with a measured error of exactly zero on every line tested.</p>
        </div>
        <div class="entry">
          <h3 class="shout painted">No recording. Ever.</h3>
          <p>There is no voice cloning here, and no user uploads their own audio. Voices are created from a written description. That sidesteps the consent and impersonation problem entirely: you cannot accidentally clone a real person if the system never accepts a recording.</p>
        </div>
        <div class="entry">
          <h3 class="shout painted">It knows what it does not know</h3>
          <div>
            <p>Every capability is measured against a control, and the honest limits are published alongside the results. Roughly twenty findings were wrong on the first attempt and caught by a check, including one where an entire experiment produced fluent-sounding speech saying different words than requested, and nothing errored. That is written up publicly rather than quietly fixed.</p>
            <p class="slip">House rule: “A suspiciously good or suspiciously bad number is a bug report about your setup.”</p>
          </div>
        </div>
        </div>
      </section>

      <!-- 4 · measured -->
      <section class="band band--haldi measured" id="measured" aria-labelledby="meas-h">
        <h2 class="bill" id="meas-h"><span class="bill-hi painted" lang="hi">नापा गया</span><span class="bill-en">Measured · and, pasted over each result, what it does not say</span></h2>
        <div class="ledger">
          <div class="row">
            <h3 class="lead">It works end to end today</h3>
            <p>On one 6 GB laptop GPU, in English, Hindi, Bengali and Tamil. Describe a character, get a voice, render a scene, and out comes watermarked audio plus a file a game engine can read. The Indian-language engine covers 22 Indian languages; four are measured so far.</p>
          </div>
          <div class="row">
            <h3 class="lead">Minting a voice costs nothing in clarity</h3>
            <p>A described voice is just as intelligible as one taken from a real recording. The measured difference was tiny, leaned slightly in the invented voice's favour, and the gap between two real speakers was six times larger. Read it as no detectable difference, not as invented voices being better.</p>
            <p class="slip">The control that had to pass first: every version must come out the same length before any score is read, or the run aborts.</p>
          </div>
          <div class="row">
            <h3 class="lead">Invented voices are distinct people</h3>
            <p>Verified by a separate speaker-recognition system that has never seen the generator: an independent check, not the system marking its own homework. Each invented voice also sits clearly apart from the nearest real voice the system learned from, so these are new voices, not real people wearing a label.</p>
          </div>
          <div class="row">
            <h3 class="lead">A character stays itself more than a real person does</h3>
            <p>Across different sentences a character stays itself more consistently than a real person does across different recordings. Unsurprising once you think about it: a stored voice has no bad-throat day, no change of microphone, no mood.</p>
          </div>
          <div class="row">
            <h3 class="lead">A blind listening test found a real problem</h3>
            <p>Pairs the system called different voices were heard as the same person about half the time. The threshold was raised; that removed 10 duplicate voices from a set of 50 and cost 3 percent of measured variety.</p>
            <p class="slip">Small test: 8 pairs and one listener, every control answered correctly. It found the problem but does not settle the exact threshold, and the English threshold has not had its own listening test.</p>
          </div>
          <div class="row">
            <h3 class="lead">Pacing holds within a measured range</h3>
            <p>Slow a character to about two-thirds of normal speed or push them to about 1.4 times, and they stay the same person saying the same words. Outside that range the identity fades gradually rather than breaking.</p>
            <div class="pace">
              <label class="pace-label" for="pace">Speed, as a bounded illustration: nothing on this page re-times audio.</label>
              <input id="pace" type="range" min="0.67" max="1.43" step="0.01" value="1" />
              <div class="ticks" aria-hidden="true"><span>0.67×</span><span>0.8×</span><span>normal</span><span>1.25×</span><span>1.43×</span></div>
              <output for="pace" id="pace-out" class="pace-out">Inside the range a listener called clean: the same person, the same words.</output>
            </div>
            <p class="slip">A listener noted the slow extreme starts to sound processed; the range they called clean is narrower, about 0.8 to 1.25 times.</p>
          </div>
          <div class="row">
            <h3 class="lead">The Hindi says what it should</h3>
            <p>One rendered line, confirmed by a fluent Hindi speaker who was asked “does it say this?”, not “does it sound right?”. Hear it, and the same description minted on both engines, under <a href="#stage"><span lang="hi">हिन्दी</span> on the stage</a>: review renders, marked as such.</p>
          </div>
          <div class="row">
            <h3 class="lead">Watermarked and logged from the first render</h3>
            <p>Every render is watermarked and logged from the first output, not added later; the watermark is AudioSeal. The manifest's own disclosure line: “AI-generated synthetic speech. All audio carries an AudioSeal watermark.” 114 automated checks guard the rules the project learned the hard way.</p>
          </div>
        </div>
          <div class="row row--wide">
            <h3 class="lead">Double bill: two ways to answer a description</h3>
            <p>Invent a new voice, or find the closest match in an existing library of voices. Inventing gives you a character nobody else has; finding gives you higher accuracy and studio quality. Neither is strictly better, and the project has numbers for the trade-off.</p>
            <div class="double">
              <div class="half">
                <h4 class="shout painted">Invent</h4>
                <p>A character nobody else has. Finding reaches 87% of the variety its library holds; inventing reached 37% before two mis-set settings were fixed, and the fix raised the invented catalogue from 14 to 22 distinct Hindi voices and from 23 to 41 English.</p>
              </div>
              <div class="half">
                <h4 class="shout painted">Find</h4>
                <p>On a library of 141 real Hindi voices, two thirds of descriptions (65.6%) get a voice that matches on every trait named, and 87% land within one step. When a description names only a couple of traits, the way people actually write, 53.8% match exactly; chance is about 20%. On 2,500 English voices the same method reaches 88.5%.</p>
                <p>What finding cannot do: produce a voice the library does not contain; guarantee a new character is unique, since two descriptions can return the same voice; and the library is someone else's, so every project draws from the same shelf.</p>
              </div>
            </div>
            <p class="slip">The library measured was real recorded speakers standing in for a studio library. No commercial system has been measured.</p>
          </div>
      </section>

      <!-- 5 · how it is done: three questions, painted -->
      <section class="band band--neel how" id="how" aria-labelledby="how-h">
        <h2 class="bill" id="how-h"><span class="bill-hi painted" lang="hi">कैसे</span><span class="bill-en">How it is done · the whole thing in one picture</span></h2>

        <figure class="dgm">
          <figcaption class="dgm-q">What is the whole thing?</figcaption>
          <ol class="flow">
            <li class="nd nd--plain">your description</li>
            <li class="nd nd--box"><strong>the mapper</strong><small>the only part that learns</small></li>
            <li class="nd nd--box nd--paper"><strong>a voice identity</strong><small>stored: the voice, a short seed clip, the engine version that made it</small></li>
            <li class="nd nd--box nd--outline"><strong>the voice engine</strong><small>never modified, swappable</small></li>
            <li class="nd nd--plain">audio, one file per line</li>
            <li class="nd nd--box nd--red"><strong>watermark</strong><small>every file, from the first render</small></li>
            <li class="nd nd--plain nd--out">the audio files, plus a manifest a game engine can read</li>
          </ol>
          <ul class="side">
            <li><strong>Also into the engine:</strong> the script, as lines of dialogue, and per-line direction: pacing, within a measured range. Emotion is not solved.</li>
            <li><strong>Alongside, the checker:</strong> a separate speaker-recognition system that has never seen the engine's internals listens to the render and asks whether it is the voice that was asked for.</li>
          </ul>
        </figure>

        <p class="rules">The rules, one line each: never accept a user's audio · watermark from the first render · store timbre, not performance · do not start the next stage until this one is measured.</p>

        <div class="map-call">
          <p class="map-lede">That is the whole thing. The rest of the picture is for engineers: the two towers and why the engine is frozen, what each check asks, why the same character stays the same person, the two engines behind one interface, the module map, and what was tried that did not work. Fourteen pictures, with the real numbers.</p>
          <a class="btn btn--haldi map-btn" href="#technical">Open the technical map<span class="btn-sub">the same sheet, a second view</span></a>
        </div>
      </section>

      <!-- 6 · fine print -->
      <section class="band band--chuna fine" id="fine" aria-labelledby="fine-h">
        <h2 class="bill" id="fine-h"><span class="bill-hi painted" lang="hi">अभी नहीं</span><span class="bill-en">Not there yet · the fine print, in full</span></h2>
        <div class="fine-cols">
          <p><strong>Not a product.</strong> This is a working research system, not a product. There is no signup, no hosted service, no API.</p>
          <p><strong>Emotion is not solved.</strong> You can control pacing within a measured range. You cannot yet say “say this line apologetically” and have it work. That was tested thoroughly and does not work on the current engine, for reasons the project documented and reported upstream: the engine's documented emotion tags turn out not to be recognised by the engine at all, and a listener heard no difference between four tagged versions of the same line.</p>
          <p><strong>The catalogue is small.</strong> Tens of distinct voices per language so far, not hundreds: about 22 in Hindi and 41 in English by the project's own measure. The limit is understood and measured rather than mysterious: the real speakers the system learned from hold about 38 to 48 distinguishable voices, and the project measured exactly where its own method loses variety.</p>
          <p><strong>Cannot ship as a product, for licensing reasons.</strong> The Indian-language engine's training chain includes data licensed for non-commercial use, so no model weights and no Indian-language audio leave the repository. It is research-only today, deliberately.</p>
          <p><strong>Very little has been listened to.</strong> Most results are automatic measurements. One listener, a handful of pairs.</p>
          <p><strong>No comparison against a commercial system.</strong> None has been measured.</p>
          <p><strong>The clips that ship are English.</strong> Hindi renders exist and a native speaker has checked one; they play under <span lang="hi">हिन्दी</span> on the stage for review only, because the Indian-language engine's licence is research-only, so they do not ship.</p>
          <p><strong>Three of the five demo lines</strong> were rendered with an experimental emotion setting whose effect has not been validated on this engine. Listen to them as voice samples, not performances.</p>
        </div>
      </section>

      <!-- 7 · booking -->
      <footer class="band band--kajal booking" id="read">
        <div class="cta">
          <a class="btn btn--haldi" href={links.repo}>Read the research</a>
          <a class="btn btn--line" href={links.issues}>Corrections welcome</a>
        </div>
        <p class="quote">“If a claim here is wrong, an issue with a primary source is more useful than almost anything else.”</p>
        <p class="licence">Research and documentation CC-BY-4.0 · code MIT · no model weights and no generated Indian-language audio ship · research pass 2026-09-02, measurement 2026-09-05 · <a href={links.repo}>github.com/PranavMishra17/alaap</a></p>
        <p class="foot-map"><a href="#technical">For engineers: the technical map, fourteen pictures with the real numbers →</a></p>
      </footer>

      <!-- the second view: the engineer's map, on the same sheet. Hidden until switched to; #technical works with scripts off -->
      <section class="tech band band--chuna" id="technical" aria-labelledby="tech-h">
        <h2 class="bill" id="tech-h"><span class="bill-hi painted" lang="hi">नक्शा</span><span class="bill-en">The technical map · for engineers, with the real numbers</span></h2>
        <TechnicalMap id="map" heading="Fourteen questions, read top to bottom" />
        <p class="tech-back"><a href="#top">← Back to the landing page</a></p>
      </section>
    </main>

    <!-- the 1200×630 card, shown only with ?og -->
    <div class="og-card" aria-hidden="true">
      <p class="og-tag">Describe a character. Get a voice nobody has recorded. Keep it.</p>
      <p class="og-title painted" lang="hi">{name.devanagari}</p>
      <p class="og-lat">Alaap · a voice from a description</p>
      <p class="og-slip slip">three voices minted from a sentence each · five lines · English, Hindi, Bengali, Tamil measured · research, not a product</p>
    </div>
  </body>
</html>

