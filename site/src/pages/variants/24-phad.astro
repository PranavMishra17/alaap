<script>
  // The lamp lights one panel at a time. Every clip on the cloth is pre-rendered; the hem of each
  // panel is that clip's real loudness envelope, woven as a row of kangura triangles.
  const html = document.documentElement;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const scroller = document.querySelector<HTMLElement>('.scroll')!;
  const cloth = document.querySelector<HTMLElement>('.cloth')!;
  const lamp = cloth.querySelector<SVGElement>('.lamp')!;
  const glow = cloth.querySelector<HTMLElement>('.glow')!;
  const panels = [...cloth.querySelectorAll<HTMLElement>('.panel')];
  const status = document.getElementById('status')!;
  const byClip = new Map<string, number>();
  panels.forEach((p, i) => { if (p.dataset.clip) byClip.set(p.dataset.clip, i); });
  const who: Record<string, string> = { mentor: 'the mentor', scout: 'the scout', innkeeper: 'the innkeeper' };
  const ordinal = ['first', 'second', 'third', 'fourth', 'fifth', 'sixth', 'seventh', 'eighth', 'ninth', 'last'];
  const css = (el: Element, v: string) => getComputedStyle(el).getPropertyValue(v).trim();

  // ---- the lamp ----
  let lit = panels.findIndex((p) => p.classList.contains('lit'));
  if (lit < 0) lit = 0;
  const vertical = () => getComputedStyle(cloth).flexDirection === 'column';
  function place() {
    const p = panels[lit];
    const rem = parseFloat(getComputedStyle(html).fontSize) || 16;
    lamp.style.left = `${p.offsetLeft + p.offsetWidth - 2.4 * rem}px`;
    lamp.style.top = `${p.offsetTop}px`;
    glow.style.left = `${p.offsetLeft + p.offsetWidth - 2.4 * rem}px`;
    glow.style.top = `${p.offsetTop + p.offsetHeight * 0.32}px`;
  }
  function describe(i: number) {
    const p = panels[i], ch = p.dataset.character || '';
    const where = `The lamp is on the ${ordinal[i]} panel`;
    if (p.classList.contains('panel--title')) return `${where}: the title.`;
    if (p.classList.contains('panel--end')) return `${where}: the cloth ends here.`;
    if (p.classList.contains('panel--birth')) return `${where}: ${who[ch]}, minted from one sentence.`;
    return `${where}: ${who[ch]} speaks.`;
  }
  function setStatus(extra = '') { status.textContent = describe(lit) + (extra ? ` ${extra}` : ''); }
  function light(i: number, scroll = true) {
    lit = Math.max(0, Math.min(panels.length - 1, i));
    if (scroll) hold = performance.now() + 1100;
    panels.forEach((p, k) => p.classList.toggle('lit', k === lit));
    place();
    setStatus();
    if (!scroll) return;
    const p = panels[lit];
    const behavior: ScrollBehavior = reduced ? 'auto' : 'smooth';
    if (vertical()) {
      const top = p.getBoundingClientRect().top + scrollY - 16;
      scrollTo({ top, behavior });
    } else {
      const gutter = parseFloat(getComputedStyle(cloth).paddingLeft) || 0;
      scroller.scrollTo({ left: Math.max(0, p.offsetLeft - gutter), behavior });
    }
  }

  // ---- the hem: a woven border, its triangles as tall as the clip is loud ----
  const env = new Map<HTMLElement, number[]>();
  function drawHem(p: HTMLElement, progress = -1) {
    const c = p.querySelector<HTMLCanvasElement>('canvas.hem');
    if (!c) return;
    const dpr = Math.min(2, devicePixelRatio || 1), w = c.clientWidth || 480, h = 30;
    if (c.width !== Math.round(w * dpr)) { c.width = Math.round(w * dpr); c.height = h * dpr; }
    const g = c.getContext('2d'); if (!g) return;
    g.setTransform(dpr, 0, 0, dpr, 0, 0);
    g.fillStyle = css(p, '--hem-bg') || '#A82D18'; g.fillRect(0, 0, w, h);
    const fg = css(p, '--hem-fg') || '#E3A83A', litc = css(p, '--hem-lit') || '#EBDAB5';
    const e = env.get(p);
    const n = e ? e.length : Math.round(w / 12), tw = w / n;
    for (let i = 0; i < n; i++) {
      const a = e ? e[i] : 0.6, th = 3 + a * (h - 5);
      const played = progress >= 0 && (i + 0.5) / n <= progress;
      g.fillStyle = played ? litc : fg;
      g.beginPath(); g.moveTo(i * tw, h); g.lineTo(i * tw + tw / 2, h - th); g.lineTo((i + 1) * tw, h); g.closePath(); g.fill();
    }
  }
  panels.forEach((p) => drawHem(p));
  async function decodeAll() {
    if (!('OfflineAudioContext' in window) || (navigator as any).connection?.saveData) return;
    for (const p of panels) {
      const a = p.querySelector('audio'); if (!a) continue;
      try {
        const buf = await (await fetch(a.getAttribute('src')!)).arrayBuffer();
        const data = await new OfflineAudioContext(1, 1, 44100).decodeAudioData(buf);
        const ch = data.getChannelData(0), n = 60, step = Math.max(1, Math.floor(ch.length / n));
        const out: number[] = [];
        for (let i = 0; i < n; i++) { let peak = 0; for (let j = i * step, end = Math.min(ch.length, (i + 1) * step); j < end; j += 2) { const v = Math.abs(ch[j]); if (v > peak) peak = v; } out.push(peak); }
        const max = Math.max(...out) || 1;
        env.set(p, out.map((v) => v / max));
        drawHem(p);
      } catch (e) { console.warn('hem skipped for', p.dataset.clip, e); }
    }
  }
  const idle = (window as any).requestIdleCallback || ((fn: () => void) => setTimeout(fn, 150));
  idle(() => { decodeAll(); });

  // ---- the analyser: the lamp's glow breathes with the real signal ----
  let ac: AudioContext | null = null, analyser: AnalyserNode | null = null, tdata: Uint8Array<ArrayBuffer> | null = null;
  const routed = new WeakSet<HTMLAudioElement>();
  function graph(a: HTMLAudioElement) {
    try {
      if (!ac) { ac = new AudioContext(); analyser = ac.createAnalyser(); analyser.fftSize = 1024; analyser.smoothingTimeConstant = 0.6; analyser.connect(ac.destination); tdata = new Uint8Array(analyser.fftSize); }
      if (ac.state === 'suspended') ac.resume();
      if (!routed.has(a)) { ac.createMediaElementSource(a).connect(analyser!); routed.add(a); }
    } catch { /* the element still plays; the glow just holds steady */ }
  }
  let raf = 0;
  function frame() {
    if (!current || !analyser || !tdata) return;
    analyser.getByteTimeDomainData(tdata);
    let s = 0;
    for (let i = 0; i < tdata.length; i += 4) { const v = (tdata[i] - 128) / 128; s += v * v; }
    const rms = Math.sqrt(s / (tdata.length / 4));
    html.style.setProperty('--pulse', (1 + Math.min(rms * 2.4, 0.38)).toFixed(3));
    raf = requestAnimationFrame(frame);
  }

  // ---- playback: one clip at a time, the lamp always on the singer ----
  let current: HTMLAudioElement | null = null, curIdx = -1, queue: string[] = [], seqBtn: HTMLButtonElement | null = null;
  function mark(i: number, on: boolean) {
    const p = panels[i], b = p.querySelector<HTMLButtonElement>('[data-play]');
    if (b) { b.setAttribute('aria-pressed', String(on)); const t = b.querySelector('.play-txt'); if (t) t.textContent = on ? 'Stop' : 'Play'; }
    if (!on) drawHem(p);
  }
  function stop() {
    if (current) { current.pause(); current.currentTime = 0; mark(curIdx, false); current = null; curIdx = -1; }
    cancelAnimationFrame(raf);
    html.style.setProperty('--pulse', '1');
  }
  function endSeq() {
    queue = [];
    if (seqBtn) { seqBtn.textContent = seqBtn.dataset.label!; seqBtn.setAttribute('aria-pressed', 'false'); seqBtn = null; }
  }
  function play(i: number) {
    stop();
    const p = panels[i], a = p.querySelector('audio');
    if (!a) return;
    light(i);
    graph(a);
    current = a; curIdx = i; mark(i, true);
    setStatus(`Playing, ${p.dataset.seconds} s.`);
    a.play().then(() => { if (!reduced) { cancelAnimationFrame(raf); raf = requestAnimationFrame(frame); } })
      .catch(() => { mark(i, false); current = null; curIdx = -1; endSeq(); setStatus(); });
  }
  function next() {
    const id = queue.shift();
    if (id !== undefined && byClip.has(id)) play(byClip.get(id)!); else { endSeq(); setStatus(); }
  }
  panels.forEach((p, i) => {
    const a = p.querySelector('audio'), b = p.querySelector<HTMLButtonElement>('[data-play]');
    if (!a || !b) return;
    b.addEventListener('click', () => { if (current === a) { stop(); endSeq(); setStatus(); } else { endSeq(); play(i); } });
    a.addEventListener('timeupdate', () => { if (current === a && a.duration) drawHem(p, a.currentTime / a.duration); });
    a.addEventListener('ended', () => {
      if (current === a) { mark(i, false); current = null; curIdx = -1; cancelAnimationFrame(raf); html.style.setProperty('--pulse', '1'); }
      if (queue.length) setTimeout(next, 520); else { endSeq(); setStatus(); }
    });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-seq]').forEach((b) => b.addEventListener('click', () => {
    if (seqBtn === b) { stop(); endSeq(); setStatus(); return; }
    stop(); endSeq();
    seqBtn = b; b.textContent = 'Stop'; b.setAttribute('aria-pressed', 'true');
    queue = b.dataset.seq!.split(',');
    if (b.closest('.walk-in')) document.getElementById('cloth')?.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
    next();
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => {
    stop(); endSeq();
    light(lit + Number(b.dataset.step));
  }));

  // the reader carries the lamp: scrolling the cloth moves it to the panel in view, unless a clip is playing
  let hold = 0, ticking = false;
  function follow() {
    ticking = false;
    if (current || performance.now() < hold) return;
    let best = lit, bestD = Infinity;
    if (vertical()) {
      const ref = scrollY + innerHeight * 0.42;
      panels.forEach((p, i) => { const r = p.getBoundingClientRect(); const d = Math.abs(r.top + scrollY + r.height / 2 - ref); if (d < bestD) { bestD = d; best = i; } });
    } else {
      const ref = scroller.scrollLeft + scroller.clientWidth * 0.36;
      panels.forEach((p, i) => { const d = Math.abs(p.offsetLeft + p.offsetWidth / 2 - ref); if (d < bestD) { bestD = d; best = i; } });
    }
    if (best !== lit) light(best, false);
  }
  const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(follow); } };
  scroller.addEventListener('scroll', onScroll, { passive: true });
  addEventListener('scroll', onScroll, { passive: true });

  const relayout = () => { place(); panels.forEach((p) => drawHem(p, current && panels[curIdx] === p && current.duration ? current.currentTime / current.duration : -1)); };
  addEventListener('resize', relayout);
  (document as any).fonts?.ready?.then(relayout);
  relayout();
  setStatus();

</script>
