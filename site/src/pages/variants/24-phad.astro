  .two dd { font-size: .98rem; }

  /* how it is made: a strip of five small panels, only one painted */
  .strip { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 2px; background: var(--raat); border: 2px solid var(--raat); margin-bottom: .6rem; }
  .strip li { padding: .8rem .8rem .7rem; background: var(--kapda); font: 400 .85rem/1.35 var(--util); color: var(--ink-2); }
  .strip li strong { display: block; font: 400 1.05rem/1.2 var(--display); color: var(--raat); margin-bottom: .25rem; }
  .strip .painted { background: var(--hingul); color: var(--kapda-2); }
