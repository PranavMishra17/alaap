  .prose p, .claim p, .plain li, dd { max-width: 62ch; }
  .prose p + p, .claim p + p { margin-top: .8rem; }
  .prose strong, .plain strong { font-weight: 600; }
  .rule { margin-top: 1rem; padding-left: 1rem; border-left: 3px solid var(--hingul); font: 400 1.2rem/1.35 var(--display); max-width: 40ch; }
