  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: .16em; }
  q { quotes: '“' '”'; }
  button { font: inherit; color: inherit; }
  :focus-visible { outline: 3px solid var(--harda); outline-offset: 3px; }
  .cotton :focus-visible { outline-color: var(--hingul); }
  .c-mentor { color: var(--asmani); }
  .c-scout { color: var(--harda); }
  .c-innkeeper { color: var(--hara); }

  /* ---- the rail the cloth hangs from ---- */
  .rail { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; padding: 1rem var(--gutter) .9rem; border-bottom: 1px solid rgba(235, 218, 181, .22); }
