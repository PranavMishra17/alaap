  .told .words { font-size: .95rem; color: var(--kapda-2); }

  /* scene panels: the speaker on the left, the listeners turned to face them */
  .stage { flex: 1; display: flex; align-items: flex-end; justify-content: space-between; min-height: 15rem; padding: 0 .4rem; }
  .fig { aspect-ratio: 5 / 8; }
  .stage .speaker { height: 15rem; width: 9.4rem; }
  .listeners { display: flex; align-items: flex-end; gap: .2rem; }
  .listener { height: 10.5rem; width: 6.6rem; transform: scaleX(-1); opacity: .72; }
  .words--line { margin-top: .6rem; font-size: 1.22rem; line-height: 1.3; min-height: 3.2em; }
  .words--line q { color: var(--kapda); }

  /* the end panel: unpainted */
  .end-lede { margin-top: .5rem; font-size: 1.05rem; max-width: 40ch; }
  .end-small { margin-top: auto; padding-top: 1rem; font: 400 .88rem/1.45 var(--body); color: var(--ink-2); }

  /* ---- the bhopa's controls and the caveats beside the players ---- */
  .bhopa { padding: .6rem var(--gutter) 2.4rem; }
  .walk { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; }
  .step { width: 2.4rem; height: 2.4rem; background: transparent; color: var(--kapda); border: 1.5px solid var(--kapda-2); cursor: pointer; font-size: .7rem; padding: 0; }
  .step:hover { background: var(--kapda); color: var(--raat); }
  .seq { background: var(--harda); color: var(--raat); border: 0; padding: .6rem 1rem .5rem; font: 600 .9rem/1 var(--util); cursor: pointer; }
  .seq:hover, .seq[aria-pressed="true"] { background: var(--kapda); }
  .status { flex: 1 1 16rem; font: 400 1rem/1.4 var(--body); color: var(--kapda); }
  .caveats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem 2rem; margin-top: 1.4rem; padding-top: 1rem; border-top: 1px solid rgba(235, 218, 181, .22); font: 400 .88rem/1.45 var(--util); color: var(--kapda-2); }

  /* ---- the telling, on cotton ---- */
  .cotton { background: var(--kapda); color: var(--raat); padding: 0 var(--gutter) 3rem; }
  .sec { display: grid; grid-template-columns: minmax(9rem, 17rem) minmax(0, 1fr); gap: .8rem 3rem; max-width: 68rem; margin: 0 auto; padding: 3rem 0 2.8rem; }
  .sec + .sec { background: var(--kangura-hingul) repeat-x top / 18px 12px; padding-top: 3.4rem; }
  .sec h2 { font: 400 clamp(1.45rem, 2.1vw, 1.85rem)/1.15 var(--display); align-self: start; position: sticky; top: 1.2rem; text-wrap: balance; }
