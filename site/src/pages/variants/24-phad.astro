  .quote { margin-top: 1.4rem; max-width: 48ch; font: 400 1.15rem/1.4 var(--display); }
  .colophon { margin-top: 1.2rem; max-width: 70ch; font: 400 .88rem/1.5 var(--util); color: var(--ink-2); }
