  .rail-link { font: 600 .85rem/1 var(--util); letter-spacing: .04em; color: var(--kapda); border: 1.5px solid var(--kapda-2); padding: .55rem .9rem .45rem; text-decoration: none; white-space: nowrap; }
  .rail-link:hover { background: var(--kapda); color: var(--raat); }

  /* ---- the cloth: one horizontal track, ten panels ---- */
  .phad { padding: 1.4rem 0 0; }
  .scroll { overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain; scroll-snap-type: x proximity; scrollbar-width: thin; scrollbar-color: var(--harda) transparent; padding: 0 0 .6rem; }
  .cloth { position: relative; display: flex; width: max-content; gap: 0; padding: 1.1rem var(--gutter) 0; isolation: isolate; }
  .border-top { position: absolute; left: var(--gutter); right: var(--gutter); top: 0; height: 12px; background: var(--kangura-harda) repeat-x bottom / 18px 12px; z-index: 2; pointer-events: none; }
  .cloth::after { content: ''; position: absolute; inset: 1.1rem var(--gutter) 0; z-index: 2; pointer-events: none; opacity: .9; mix-blend-mode: multiply;
    background: repeating-linear-gradient(0deg, rgba(27, 19, 14, .055) 0 1px, transparent 1px 3px), repeating-linear-gradient(90deg, rgba(27, 19, 14, .03) 0 1px, transparent 1px 3px); }
  .panel { position: relative; flex: 0 0 var(--panel-w); width: var(--panel-w); min-height: var(--panel-h); display: flex; flex-direction: column; scroll-snap-align: start; scroll-margin-left: var(--gutter); border-right: 2px solid var(--raat); z-index: 1; }
  .panel--title { flex-basis: 37rem; width: 37rem; }
  .panel--end { flex-basis: 27rem; width: 27rem; border-right: 0; }
  .paint { flex: 1; display: flex; flex-direction: column; padding: 1.3rem 1.5rem 1rem; background: var(--hingul); color: var(--kapda); transition: filter .7s ease; }
  .js .panel:not(.lit) .paint { filter: brightness(.44) saturate(.55); }
  .js .panel:not(.lit) .hem { opacity: .35; }
  .hem { display: block; width: 100%; height: 30px; background: var(--hingul); transition: opacity .7s ease; }
  .panel { --hem-bg: var(--hingul); --hem-fg: var(--harda); --hem-lit: var(--kapda); }
  .panel--end { --hem-bg: var(--kapda); --hem-fg: var(--hingul); --hem-lit: var(--raat); }
  .panel--end .paint, .panel--end .hem { background: var(--kapda); color: var(--raat); }
  .panel--end .caption { color: var(--hingul); }

  /* lamp and its light */
  .lamp { position: absolute; left: 0; top: 1.1rem; width: 46px; height: 106px; z-index: 5; transform: translateX(-50%); pointer-events: none; filter: drop-shadow(0 4px 8px rgba(0, 0, 0, .45)); transition: left .9s cubic-bezier(.45, 0, .2, 1), top .9s cubic-bezier(.45, 0, .2, 1); }
  .glow { position: absolute; left: 0; top: 0; width: 70rem; height: 70rem; z-index: 3; pointer-events: none; mix-blend-mode: screen; opacity: .9;
    transform: translate(-50%, -50%) scale(var(--pulse)); background: radial-gradient(circle, rgba(255, 210, 110, .42) 0, rgba(255, 200, 100, .16) 24%, rgba(255, 190, 90, 0) 58%);
    transition: left .9s cubic-bezier(.45, 0, .2, 1), top .9s cubic-bezier(.45, 0, .2, 1), transform .09s linear; }
  html:not(.js) .lamp, html:not(.js) .glow, html:not(.js) .walk, html:not(.js) .play, html:not(.js) .walk-in { display: none; }
  .js .panel audio { display: none; }
  html:not(.js) .panel audio { display: block; width: 100%; margin-top: .6rem; }

  /* panel type */
  .caption { display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .7rem; margin-bottom: .6rem; font: 600 .8rem/1.3 var(--util); letter-spacing: .04em; color: var(--kapda); }
  .caption [lang="hi"] { font: 400 1.35rem/1 var(--display); letter-spacing: 0; color: var(--harda); }
  .caption .note { font-weight: 400; color: var(--kapda-2); }
  .caption .note--flag { color: var(--harda); border-bottom: 1px dotted var(--harda); }
  .panel--end .caption .note, .panel--end .caption span { color: var(--hingul); }
  .words { font: 400 1.05rem/1.4 var(--body); }
  .len { font: 500 .82rem/1 var(--util); letter-spacing: .04em; opacity: .85; margin-left: .25rem; }
  .play { display: inline-flex; align-items: center; gap: .35rem; align-self: flex-start; margin: .7rem 0 .55rem; padding: .5rem .85rem .4rem; background: var(--kapda); color: var(--raat); border: 0; font: 600 .9rem/1 var(--util); cursor: pointer; }
  .play:hover, .play[aria-pressed="true"] { background: var(--harda); }
  .tri { display: inline-block; width: 0; height: 0; border-left: .62em solid currentColor; border-top: .4em solid transparent; border-bottom: .4em solid transparent; }
  .play[aria-pressed="true"] .tri { width: .55em; height: .62em; border: 0; background: currentColor; }

  /* title panel */
  .panel--title .paint { padding-right: 2rem; }
  .tag { font: 600 .82rem/1.3 var(--util); letter-spacing: .06em; color: var(--harda); }
  .panel--title h1 { display: flex; flex-direction: column; margin: .6rem 0 .5rem; line-height: 1; }
  .deva { font: 400 clamp(5.4rem, 9vw, 7.6rem)/1.05 var(--display); color: var(--harda); -webkit-text-stroke: .018em var(--raat); paint-order: stroke fill; margin-left: -.03em; }
  .latin { font: 600 .95rem/1 var(--util); letter-spacing: .34em; text-transform: uppercase; color: var(--kapda); margin: .2rem 0 0 .2em; }
  .meaning { font: 400 1.12rem/1.35 var(--display); max-width: 30ch; color: var(--kapda); }
  .lede { margin-top: .9rem; max-width: 46ch; font-size: 1.02rem; }
  .how-read { margin-top: auto; padding-top: .9rem; font: 400 .9rem/1.45 var(--body); color: var(--kapda-2); max-width: 44ch; border-top: 1px solid rgba(235, 218, 181, .3); }

  /* birth panels: the figure faces the words that spoke it into being */
  .birth { flex: 1; display: grid; grid-template-columns: 9.5rem minmax(0, 1fr); gap: 1rem; align-items: end; }
