  html:not(.no-js) .pan[hidden] { display: none; }
  .no-js .pan--lang { margin-top: 2.2rem; border-top: 3px solid var(--haldi); padding-top: 1.4rem; }
  .lang-lead { font: 700 1.2rem/1.25 var(--cond); text-transform: uppercase; letter-spacing: .04em; color: var(--haldi); max-width: 60ch; }
  .lang-p { max-width: 62ch; margin-top: .8rem; }
  .pan--lang .small { margin-top: .6rem; max-width: 62ch; }
  .hindi-line { margin-top: .8rem; font: 400 clamp(1.7rem, 3.4vw, 2.5rem)/1.35 var(--display); color: var(--haldi); text-shadow: .05em .05em 0 var(--sindoor); }
  .deck { display: grid; grid-template-columns: auto auto minmax(0, 1fr); gap: .8rem 1.4rem; align-items: center; margin-bottom: 1.4rem; }
  .cells { display: flex; gap: .35rem; }
  .cell { width: 2.6rem; height: 2.6rem; padding: 0; background: transparent; color: var(--haldi); border: 3px solid var(--haldi); font: 700 1.1rem/1 var(--cond); cursor: pointer; }
  .cell:hover { background: rgba(242,180,30,.2); }
  .cell.is-now { background: var(--haldi); color: var(--kajal); box-shadow: 2px 2px 0 var(--sindoor); }
  .cell.is-done { background: rgba(242,180,30,.35); }
  .now { font: 600 1rem/1.2 var(--cond); text-transform: uppercase; letter-spacing: .08em; opacity: .9; }
  .lines { border-top: 3px solid var(--haldi); }
  .line { display: grid; grid-template-columns: 7.5rem 5.6rem minmax(0, 1fr) 4rem; grid-template-areas: 'who play words dur' 'who play wave wave' 'who play tag tag'; column-gap: 1rem; row-gap: .25rem; align-items: start; padding: .85rem 0; border-bottom: 3px solid var(--haldi); }
  .line.is-playing { background: rgba(242,180,30,.12); box-shadow: 0 0 0 .6rem rgba(242,180,30,.12); }
  .who { grid-area: who; font: 400 1.5rem/1.1 var(--display); color: var(--haldi); text-shadow: .05em .05em 0 var(--sindoor); padding-top: .15rem; }
  .play { grid-area: play; display: inline-flex; align-items: center; justify-content: center; height: 2.6rem; min-width: 5.2rem; padding: 0 .6rem; background: var(--haldi); color: var(--kajal); border: 0; font: 700 1rem/1 var(--cond); text-transform: uppercase; letter-spacing: .06em; cursor: pointer; box-shadow: 2px 2px 0 var(--sindoor); }
