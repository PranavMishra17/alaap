---
// Variant 28 — "poster · HLD", round 2: the 12 wall poster for the engineer. The landing page
// carries one painted picture (the whole system) and a compact measured ledger; a second view,
// the technical map, is the shared TechnicalMap component repainted in this page's diagram
// language (red learns, outlined is never modified, black asks and can say no, haldi is stored)
// with its own sticky sub-contents. The programme strip switches between the two views; with
// scripts off, #technical is reachable through :target. The हिन्दी tab plays the review renders.
import { name, meaning, links, characters, scene, seeds, clipCaveats } from '../../content/alaap';
import { indicVoices, indicClips, indicCaveat } from '../../content/indic-review';
import TechnicalMap from '../../components/TechnicalMap.astro';
const seedOf = (id: string) => seeds.find((s) => s.character === id)!;
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
const hiClip = (voice: string, i: number) => indicClips.find((c) => c.voice === voice && c.lineIndex === i)!;
const techSecs = [
  ['ctx', 'The whole system'], ['tower', 'Two towers'], ['mint', 'Minting'], ['render', 'Rendering'], ['gates', 'The gates'],
  ['rev', 'Checkable captions'], ['geom', 'The speaker space'], ['axes', 'What describes a voice'], ['backend', 'Two engines'],
  ['codec', 'Content and identity'], ['dir', 'Direction'], ['mods', 'Modules'], ['exp', 'Experiments'], ['stages', 'Plan status'],
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname.replace(/\/$/, ''), site).href;
const ogImage = new URL(`${base}/og/28-poster-hld.png`, site).href;
const title = 'Alaap — a voice from a description';
const tagline = 'Describe a character. Get a voice nobody has recorded. Keep it.';
const description = 'Describe a character in ordinary language and get back a voice that has never existed. Use it for any line you write; it stays the same character every time.';
const ogAlt = 'A hand-painted poster: आलाप in red enamel on a yellow ground, and the line “Describe a character. Get a voice nobody has recorded. Keep it.”';
const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%23F2B41E'/%3E%3Ctext x='32' y='49' font-size='42' font-family='Nirmala UI,Noto Sans Devanagari,Kohinoor Devanagari,sans-serif' font-weight='700' text-anchor='middle' fill='%23C6201A' stroke='%2317140F' stroke-width='2' paint-order='stroke'%3Eआ%3C/text%3E%3C/svg%3E";
const ld = { '@context': 'https://schema.org', '@type': 'SoftwareSourceCode', name: name.latin, alternateName: name.devanagari, description, url: canonical, image: ogImage, codeRepository: links.repo, license: ['https://opensource.org/license/mit', 'https://creativecommons.org/licenses/by/4.0/'], inLanguage: 'en', dateModified: '2026-09-05' };
const arrow = '<svg viewBox="0 0 44 24" aria-hidden="true" focusable="false"><path class="shaft" d="M2 12h26"/><path class="head" d="M23 1.5l19 10.5-19 10.5z"/></svg>';
const programme = [
  { id: 'cast', hi: 'कलाकार', en: 'Cast' }, { id: 'scene', hi: 'दृश्य', en: 'Scene' }, { id: 'why', hi: 'खासियत', en: 'Why it is different' },
  { id: 'built', hi: 'ढाँचा', en: 'How it is built' }, { id: 'not-yet', hi: 'अभी नहीं', en: 'Not there yet' },
];
---
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F2B41E" />
    <meta name="robots" content="index,follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Alaap" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Eczar:wght@400;500;700&family=Khand:wght@400;500;600;700&family=Yatra+One&display=swap" rel="stylesheet" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>document.documentElement.classList.remove('no-js');if(/[?&]og(?=&|$)/.test(location.search))document.documentElement.classList.add('og-mode');if(/^#(technical|tmap-)/.test(location.hash))document.documentElement.classList.add('view-tech');</script>
  </head>
  <body>
    <svg class="defs" aria-hidden="true" width="0" height="0" focusable="false">
      <filter id="brush" x="-5%" y="-60%" width="110%" height="220%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.009 0.09" numOctaves="2" seed="11" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="16" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="brush-soft" x="-4%" y="-8%" width="108%" height="116%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="4" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="3.5" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="brush-box" x="-6%" y="-10%" width="112%" height="120%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="2" seed="7" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="2.6" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <!-- the 1200×630 share card; shown only under ?og, for the image in public/og/ -->
    <div class="og" aria-hidden="true">
      <p class="og-top"><span>English · Hindi · Bengali · Tamil</span><span>Measured 2026-09-05</span></p>
      <p class="og-dev painted" lang="hi">{name.devanagari}</p>
      <p class="og-lat">{name.latin}</p>
      <p class="og-tag">{tagline}</p>
      <p class="og-mean">“{meaning}”</p>
      <p class="og-foot">github.com/PranavMishra17/alaap</p>
    </div>

    <main class="poster">
      <!-- 1 · masthead -->
      <header class="band band--haldi masthead">
        <p class="topline"><span>English · Hindi · Bengali · Tamil</span><span>Measured 2026-09-05</span></p>
        <p class="tagline">{tagline}</p>
        <h1 class="title">
          <span class="title-dev painted" lang="hi">{name.devanagari}</span>
          <span class="title-lat">{name.latin}</span>
        </h1>
        <p class="meaning">“{meaning}”</p>
        <div class="lede">
          <div>
            <p class="oneliner">You describe a character in ordinary language. You get back a voice that has never existed. Then you use that voice for any line of dialogue you write, and it stays the same character every time.</p>
            <p class="forwhom">For people making games, animation, audio drama, dubbing, interactive fiction: anyone who needs many distinct speaking characters and cannot hire a cast for each one.</p>
          </div>
          <div class="example" data-player>
            <p class="ex-label">All the system was given</p>
            <p class="ex-desc">“{characters[0].description}”</p>
            <button type="button" class="btn btn--sindoor" data-play aria-pressed="false"><span class="tri" aria-hidden="true"></span><span class="play-txt">Play</span><span class="btn-sub">the voice it made · {seedOf('mentor').seconds} s</span></button>
            <p class="words">It says: “{seedOf('mentor').text}”</p>
            <audio preload="none" controls src={seedOf('mentor').src}></audio>
          </div>
        </div>
      </header>

      <!-- the programme: a black strip that pins to the top and shows where you are -->
      <nav class="prog" aria-label="Contents of this poster">
        <a class="prog-brand" href="#top" lang="hi">{name.devanagari}</a>
        <ol class="prog-list">
          {programme.map((p) => (
            <li><a href={`#${p.id}`} data-prog-link={p.id}><span class="prog-hi" lang="hi">{p.hi}</span><span class="prog-en">{p.en}</span></a></li>
          ))}
        </ol>
        <p class="prog-tech-title" aria-hidden="true">The technical map<span>· for engineers</span></p>
        <div class="view" role="group" aria-label="Which view of this page">
          <a href="#top" data-view="landing" aria-current="page">Landing</a>
          <a href="#technical" data-view="tech">Technical<span class="long"> map</span></a>
        </div>
      </nav>

      <!-- 2 · the cast -->
      <section class="band band--neel cast" id="cast" data-prog="cast" aria-labelledby="cast-h">
        <h2 class="bill" id="cast-h"><span class="bill-hi painted" lang="hi">कलाकार</span><span class="bill-en">The cast · three voices, minted from nothing but the line under each name</span></h2>
        <p class="band-intro">Tap a name to hear its seed clip, the short reference recording stored with every identity when it is minted.</p>
        <ul class="stars">
          {characters.map((ch) => { const s = seedOf(ch.id); return (
            <li class="star" data-player>
              <button type="button" class="star-btn" data-play aria-pressed="false">
                <span class="star-name">{cap(ch.id)}</span>
                <span class="star-hint"><span class="tri" aria-hidden="true"></span><span class="play-txt">Play</span> the seed clip · {s.seconds} s</span>
              </button>
              <p class="star-desc">Given only: <q>{ch.description}</q></p>
              <canvas class="wave" aria-hidden="true"></canvas>
              <p class="words">Seed clip says: “{s.text}”</p>
              <audio preload="none" controls src={s.src}></audio>
            </li>
          ); })}
        </ul>
        <p class="slip">Pre-rendered. Every clip on this page comes from the end-to-end demo run on 2026-09-05. Nothing here generates a voice live.</p>
      </section>

      <!-- 3 · the scene, behind an honest language switch -->
      <section class="band band--kajal scene" id="scene" data-prog="scene" aria-labelledby="scene-h">
        <h2 class="bill" id="scene-h"><span class="bill-hi painted" lang="hi">दृश्य</span><span class="bill-en">The scene · five lines, three characters, one run</span></h2>
        <p class="band-intro">Rendered with the cast above in about four minutes on one laptop GPU: watermarked audio, plus a manifest a game engine can read.</p>
        <div class="langs" role="tablist" aria-label="Language of the clips">
          <button type="button" role="tab" id="tab-en" aria-selected="true" aria-controls="pan-en">English<small>plays</small></button>
          <button type="button" role="tab" id="tab-hi" aria-selected="false" aria-controls="pan-hi" tabindex="-1"><span lang="hi">हिन्दी</span><small>plays · review only</small></button>
          <button type="button" role="tab" id="tab-bn" aria-selected="false" aria-controls="pan-bn" tabindex="-1"><span lang="bn">বাংলা</span><small>measured</small></button>
          <button type="button" role="tab" id="tab-ta" aria-selected="false" aria-controls="pan-ta" tabindex="-1"><span lang="ta">தமிழ்</span><small>measured</small></button>
        </div>

        <div class="pan" id="pan-en" role="tabpanel" aria-labelledby="tab-en">
          <div class="deck">
            <button type="button" class="btn btn--haldi scene-btn" data-play-scene aria-pressed="false"><span class="tri" aria-hidden="true"></span><span class="scene-txt">Play the scene</span><span class="btn-sub">all five lines in order</span></button>
            <ol class="cells" aria-label="Play the scene from a line">
              {scene.map((c, i) => <li><button type="button" class="cell" data-cell={i} aria-label={`From line ${i + 1}, ${cap(c.character)}`}>{i + 1}</button></li>)}
            </ol>
            <p class="now" aria-live="polite">Nothing playing</p>
          </div>
          <ol class="lines">
            {scene.map((c, i) => (
              <li class="line" data-player data-line={i}>
                <span class="who">{cap(c.character)}</span>
                <button type="button" class="play" data-play aria-pressed="false" aria-label={`Play line ${i + 1}, ${cap(c.character)}: ${c.text}`}><span class="tri" aria-hidden="true"></span><span class="play-txt" aria-hidden="true">Play</span></button>
                <p class="words">“{c.text}”</p>
                <canvas class="wave" aria-hidden="true"></canvas>
                <span class="dur">{c.seconds} s</span>
                {c.experimentalEmotionSetting ? <span class="slip slip--tag">experimental emotion setting, unvalidated</span> : <span class="tag-plain">no direction</span>}
                <audio preload="none" controls src={c.src}></audio>
              </li>
            ))}
          </ol>
          <div class="slips">
            <p class="slip">{clipCaveats.watermark}</p>
            <p class="slip">{clipCaveats.emotionSetting}</p>
            <p class="slip">{clipCaveats.englishOnly}</p>
          </div>
        </div>

        <div class="pan pan--lang pan--hi" id="pan-hi" role="tabpanel" aria-labelledby="tab-hi">
          <p class="lang-lead">The same three descriptions, minted a second time on the Indian-language engine.</p>
          <p class="lang-p">Indic is the stated reason the project exists. Guru, Student and Narrator were made from exactly the sentences that made Mentor, Scout and Innkeeper; Elder is Hindi only. Every voice says the same three lines. These are research renders, here for review: none of them ships.</p>
          <div class="pair" data-pair>
            <p class="pair-h">One description, two engines</p>
            <button type="button" class="btn btn--haldi" data-pair-play aria-pressed="false"><span class="tri" aria-hidden="true"></span><span class="pair-txt">Play both</span><span class="btn-sub">Mentor in English, then Guru in Hindi</span></button>
            <p class="pair-desc">Both were given only: <q>{indicVoices[0].description}</q></p>
            <p class="pair-now" aria-live="polite">Nothing playing</p>
          </div>
          <ul class="hvs">
            {indicVoices.map((v) => (
              <li class="hv">
                <h3 class="hv-name">{cap(v.id)}<small>{v.sameDescriptionAs ? <>same description as <b>{cap(v.sameDescriptionAs)}</b></> : 'Hindi only'}</small></h3>
                <p class="hv-desc">Given only: <q>{v.description}</q></p>
                <ol class="hlines">
                  {[0, 1, 2].map((i) => { const c = hiClip(v.id, i); return (
                    <li class="hline" data-player data-hi={c.id}>
                      <button type="button" class="play" data-play aria-pressed="false" aria-label={`Play ${cap(v.id)}, Hindi line ${i + 1}`}><span class="tri" aria-hidden="true"></span><span class="play-txt" aria-hidden="true">Play</span></button>
                      <p class="words" lang="hi">{c.text}</p>
                      <p class="gloss">“{c.english}” <span>our translation</span></p>
                      <canvas class="wave" aria-hidden="true"></canvas>
                      <p class="gone" hidden>Clip not in this build; the text stands.</p>
                      {c.nativeSpeakerChecked && <p class="slip slip--tag slip--check">Checked by a fluent Hindi speaker, asked “does it say this?”: it does</p>}
                      <audio preload="none" controls src={c.src}></audio>
                    </li>
                  ); })}
                </ol>
                <p class="slip">{indicCaveat}</p>
              </li>
            ))}
          </ul>
          <p class="lang-p small">Only Guru's first line has been checked by a fluent speaker, told the sentence and asked “does it say this?”, not “does it sound right?”: the check an earlier batch of audio failed, sounding fluent while saying different words. Still to be checked: the other three voices and the other two lines.</p>
        </div>
        <div class="pan pan--lang" id="pan-bn" role="tabpanel" aria-labelledby="tab-bn">
          <p class="lang-lead">Bengali: measured; renders do not ship.</p>
          <p class="lang-p">One of the four languages measured. The Indian-language engine is research-only under its licence, so no Bengali audio leaves the repository.</p>
        </div>
        <div class="pan pan--lang" id="pan-ta" role="tabpanel" aria-labelledby="tab-ta">
          <p class="lang-lead">Tamil: measured; renders do not ship.</p>
          <p class="lang-p">One of the four languages measured. The Indian-language engine is research-only under its licence, so no Tamil audio leaves the repository.</p>
        </div>
      </section>

      <!-- 4 · top billing: the four differentiators -->
      <section class="band band--sindoor billing" id="why" data-prog="why" aria-labelledby="bill-h">
        <h2 class="bill" id="bill-h"><span class="bill-hi painted" lang="hi">खासियत</span><span class="bill-en">Top billing · the four things that make it different</span></h2>
        <div class="entries">
          <div class="entry">
            <h3 class="shout painted">A voice you keep</h3>
            <p>Most tools generate a voice each time you ask. Here the character's voice is stored as an identity and re-used, so the same character sounds like the same person across every line, every scene and every session. That consistency is measured, not hoped for.</p>
          </div>
          <div class="entry">
            <h3 class="shout painted">Who speaks is not what is said</h3>
            <p>The identity is held apart from the words, so a character can say anything without the voice changing, and changing the line never changes the person. Verified, not assumed: the same audio content played through two different identities came out with identical words. The measured error between them was exactly zero on every line tested.</p>
          </div>
          <div class="entry">
            <h3 class="shout painted">No recording. Ever.</h3>
            <p>There is no voice cloning, and no user uploads their own audio. Voices are created from a written description. That sidesteps the consent and impersonation problem entirely: you cannot accidentally clone a real person if the system never accepts a recording.</p>
          </div>
          <div class="entry">
            <h3 class="shout painted">It knows what it does not know</h3>
            <p>Every capability is measured against a control, and the honest limits are published alongside the results. Roughly twenty findings were wrong on the first attempt and caught by a check, including an experiment that produced fluent-sounding speech saying different words than requested, while nothing errored. Written up publicly, not quietly fixed.</p>
            <p class="slip">House rule: “A suspiciously good or suspiciously bad number is a bug report about your setup.”</p>
          </div>
        </div>
      </section>

      <!-- 5 · how it is built, picture 1: the whole thing -->
      <section class="band band--haldi hld-band" id="built" data-prog="built" aria-labelledby="hA-h">
        <h2 class="bill" id="built-h"><span class="bill-hi painted" lang="hi">ढाँचा</span><span class="bill-en">How it is built · one picture here, fourteen in the technical map</span></h2>
        <p class="key">How to read it: <span class="k k--learn">red</span> is the only part that learns · <span class="k k--frozen">outlined</span> is never modified · <span class="k k--check">black</span> asks a question and can say no · <span class="k k--store">haldi</span> is stored · <span class="k k--slip">a slip</span> is what the picture does not say.</p>
        <figure class="hld">
          <figcaption>
            <h3 class="hq" id="hA-h">What happens when I describe a character?</h3>
            <p class="vh">As a flow: your description, to the mapper (the only part that learns), to a voice identity (stored with a short seed clip and the engine version that made it). The identity, the script and per-line direction (pacing; emotion is not solved) go into the voice engine, never modified and swappable. Out comes audio, one file per line, watermarked from the first render: the audio files plus a manifest a game engine can read. The checker, a separate speaker-recognition system that has never seen the engine's internals, listens to the render and asks whether it is the voice that was asked for.</p>
          </figcaption>
          <div class="dg dg--a" aria-hidden="true">
            <div class="hn hn--in ar-desc"><em class="role">you give</em><b>your description</b><small>“a very deep voice, very rough and gravelly, speaking very slowly”</small></div>
            <i class="arr ar-a1" set:html={arrow}></i>
            <div class="hn hn--learn ar-mapper"><b>the mapper</b><small>the only part that learns</small></div>
            <i class="arr arr--down ar-d1" set:html={arrow}></i>
            <div class="hn hn--store ar-ident"><b>a voice identity</b><small>stored: the voice, a short seed clip, the engine version that made it</small></div>
            <i class="arr arr--down ar-d2" set:html={arrow}></i>
            <p class="also ar-also">also into the engine:</p>
            <div class="hn hn--in ar-script"><em class="role">you give</em><b>the script</b><small>lines of dialogue</small></div>
            <i class="arr ar-a2" set:html={arrow}></i>
            <div class="hn hn--in ar-dir"><em class="role">you give</em><b>per-line direction</b><small>pacing, within a measured range; emotion is not solved</small></div>
            <i class="arr ar-a3" set:html={arrow}></i>
            <div class="hn hn--frozen ar-engine"><b>the voice engine</b><small>never modified, swappable</small></div>
            <i class="arr arr--down ar-d3" set:html={arrow}></i>
            <div class="hn ar-audio"><b>audio</b><small>one file per line</small></div>
            <i class="arr ar-listen" set:html={arrow}></i>
            <div class="hn hn--check ar-checker"><em class="role">listens to the render</em><b>the checker</b><small>a separate speaker-recognition system that has never seen the engine's internals. It asks: is this the voice that was asked for?</small></div>
            <i class="arr arr--down ar-d4" set:html={arrow}></i>
            <div class="hn ar-wm"><b>watermark</b><small>every file, from the first render</small></div>
            <i class="arr ar-a4" set:html={arrow}></i>
            <div class="stack ar-out">
              <div class="hn hn--in"><em class="role">you get</em><b>the audio files</b></div>
              <div class="hn hn--in"><em class="role">you get</em><b>a manifest</b><small>a game engine can read it</small></div>
            </div>
          </div>
        </figure>
        <a class="pointer" href="#technical" data-view-link="tech">
          <span class="pointer-k">For engineers</span>
          <span class="pointer-t painted">Open the technical map</span>
          <span class="pointer-s">Fourteen pictures with the real numbers: the two towers, minting and its gates, rendering, both engines, the module map, what was tried, and how far along it honestly is.</span>
        </a>
        <h3 class="ledger-h">Measured, not hoped for · the ledger in brief</h3>
        <div class="ledger">
          <div class="row">
            <h4 class="lead">It works end to end today</h4>
            <p>On one 6 GB laptop GPU, in English, Hindi, Bengali and Tamil. Describe a character, get a voice, render a scene, and out comes watermarked audio plus a file a game engine can read. The cast and scene above are that run.</p>
            <p class="slip">Not a product: no signup, no hosted service, no API. A working research system.</p>
          </div>
          <div class="row">
            <h4 class="lead">Watermarked and logged from the first render</h4>
            <p>Not added later. The watermark is AudioSeal; the manifest's own disclosure line reads “AI-generated synthetic speech. All audio carries an AudioSeal watermark.” 114 automated checks guard the rules the project learned the hard way.</p>
          </div>
          <div class="row">
            <h4 class="lead">Minting costs nothing in clarity</h4>
            <p>A described voice is as intelligible as one taken from a real recording. The measured difference was tiny and leaned the invented voice's way; the gap between two real speakers was six times larger. Read it as no detectable difference.</p>
          </div>
          <div class="row">
            <h4 class="lead">Invented voices are distinct people</h4>
            <p>Verified by the checker, a separate speaker-recognition system that has never seen the generator. Each invented voice also sits clearly apart from the nearest real voice the system learned from: new voices, not real people wearing a label.</p>
          </div>
          <div class="row">
            <h4 class="lead">A character stays itself more than a real person does</h4>
            <p>Across different sentences, more consistently than a real speaker across recordings. A stored voice has no bad-throat day, no change of microphone, no mood.</p>
          </div>
          <div class="row">
            <h4 class="lead">Pacing holds within a measured range</h4>
            <p>Slow a character to about two-thirds of normal speed or push to about 1.4 times, and they stay the same person saying the same words. A listener called about 0.8 to 1.25 times clean; the slow extreme starts to sound processed.</p>
          </div>
          <div class="row">
            <h4 class="lead">A blind listening test found and fixed a real problem</h4>
            <p>Pairs the “is it new?” check called different were heard as the same person about half the time. The threshold was raised; that removed 10 duplicate voices from a set of 50 and cost 3 percent of measured variety.</p>
            <p class="slip">Small test: 8 pairs, one listener, every control answered correctly. It found the problem; it does not settle the exact threshold.</p>
          </div>
          <div class="row">
            <h4 class="lead">Two ways to answer a description, both measured</h4>
            <p><strong>Invent</strong> a new voice: a character nobody else has. Before two mis-set settings were fixed, inventing reached 37% of the variety available; the fix raised the catalogue from 14 to 22 distinct Hindi voices and from 23 to 41 English. <strong>Find</strong> the closest match in a library instead: on 141 real Hindi voices, two thirds of descriptions (65.6%) get every trait named and 87% land within one step, against about 20% by chance; on 2,500 English voices, 88.5%. Finding reaches 87% of the variety a library holds, but cannot make a voice the library lacks.</p>
            <p class="slip">The library measured was real recorded speakers standing in for a studio library. No commercial system has been measured.</p>
          </div>
        </div>
      </section>

      <!-- 9 · fine print -->
      <section class="band band--chuna fine" id="not-yet" data-prog="not-yet" aria-labelledby="fine-h">
        <h2 class="bill" id="fine-h"><span class="bill-hi painted" lang="hi">अभी नहीं</span><span class="bill-en">Not there yet · the fine print, in full</span></h2>
        <div class="fine-cols">
          <p><strong>Not a product.</strong> This is a working research system, not a product. There is no signup, no hosted service, no API.</p>
          <p><strong>Emotion is not solved.</strong> You can control pacing within a measured range. You cannot yet say “say this line apologetically” and have it work. That was tested thoroughly and does not work on the current engine, for reasons the project documented and reported upstream: the engine's documented emotion tags turn out not to be recognised by the engine at all, and a listener heard no difference between four tagged versions of the same line.</p>
          <p><strong>The catalogue is small.</strong> Tens of distinct voices per language so far, not hundreds: about 22 in Hindi and 41 in English by the project's own measure. The limit is understood and measured rather than mysterious: the real speakers the system learned from hold about 38 to 48 distinguishable voices, and the project measured exactly where its own method loses variety.</p>
          <p><strong>Cannot ship as a product, for licensing reasons.</strong> The Indian-language engine's training chain includes data licensed for non-commercial use, so no model weights and no Indian-language audio leave the repository. It is research-only today, deliberately.</p>
          <p><strong>Very little has been listened to.</strong> Most results are automatic measurements. One listener, a handful of pairs.</p>
          <p><strong>No comparison against a commercial system.</strong> None has been measured.</p>
          <p><strong>The clips that ship are English.</strong> The Hindi renders under <span lang="hi">हिन्दी</span> are here for review and marked so on every player; a native speaker has checked one line. The Indian-language engine's licence is research-only, so they do not ship.</p>
          <p><strong>Three of the five demo lines</strong> were rendered with an experimental emotion setting whose effect has not been validated on this engine. Listen to them as voice samples, not performances.</p>
        </div>
      </section>

      <!-- 10 · booking -->
      <footer class="band band--kajal booking">
        <div class="cta">
          <a class="btn btn--haldi" href={links.repo}>Read the research</a>
          <a class="btn btn--line" href={links.issues}>Corrections welcome</a>
        </div>
        <p class="quote">“If a claim here is wrong, an issue with a primary source is more useful than almost anything else.”</p>
        <p class="licence">Research and documentation CC-BY-4.0 · code MIT · no model weights and no generated Indian-language audio ship · <a href={links.repo}>github.com/PranavMishra17/alaap</a></p>
        <p class="licence"><a href="#technical" data-view-link="tech">The technical map, for engineers</a></p>
      </footer>

      <!-- 11 · the technical map: a second view of the same page. Hidden until switched to; with
           scripts off, #technical (or any figure inside it) is shown through :target. -->
      <section class="tech" id="technical" aria-label="The technical map">
        <nav class="tech-nav" aria-label="Sections of the technical map">
          <ol>{techSecs.map(([k, t], i) => <li><a href={`#tmap-${k}`} data-tech-link={`tmap-${k}`}><span class="tech-n">{i + 1}</span>{t}</a></li>)}</ol>
        </nav>
        <header class="tech-head">
          <p class="tech-kicker">For engineers · every number here is from <code>learning/architecture.html</code> in the repository · nothing here is a claim the landing page makes</p>
          <h2 class="tech-title painted">The technical map</h2>
          <p class="tech-lede">How the whole thing fits together: what is learned, what is frozen, where the checks sit, what was tried that did not work, and how far along it honestly is. Fourteen pictures, each headed by the question it answers. Read top to bottom, or jump.</p>
        </header>
        <p class="key key--tech">How to read the pictures: <span class="k k--learn">red</span> is the only part that learns · <span class="k k--frozen">outlined</span> is never modified · <span class="k k--check">black</span> asks a question and can say no · <span class="k k--store">haldi</span> is stored · <span class="k k--drop">dashed</span> was dropped, or never started · <span class="k k--slip">a slip</span> is what the picture does not say. Each picture is numbered as its section in <code>learning/architecture.html</code>.</p>
        <TechnicalMap id="tmap" heading="The technical map" />
        <p class="tech-back"><a href="#top" data-view-link="landing">Back to the landing page</a></p>
      </section>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
