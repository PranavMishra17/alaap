  .band::before { content: ''; position: absolute; left: -40px; right: -40px; top: -18px; height: 36px; background: var(--paint); filter: url(#brush); pointer-events: none; }
  .masthead::before, .cast::before { display: none; }
  .band--haldi { --paint: var(--haldi); --ink: var(--kajal); --shout: var(--sindoor); --shadow: var(--neel); --stroke: var(--kajal); --wave: var(--neel); --wave-lit: var(--sindoor); --focus: var(--kajal); --n-shadow: var(--neel); --n-fill: var(--chuna); }
  .band--neel { --paint: var(--neel); --ink: var(--chuna); --shout: var(--haldi); --shadow: var(--sindoor); --stroke: var(--kajal); --wave: var(--haldi); --wave-lit: var(--chuna); --focus: var(--haldi); --n-shadow: var(--kajal); --n-fill: var(--chuna); }
  .band--kajal { --paint: var(--kajal); --ink: var(--chuna); --shout: var(--haldi); --shadow: var(--sindoor); --stroke: transparent; --wave: var(--haldi); --wave-lit: var(--gulabi); --focus: var(--haldi); --n-shadow: var(--sindoor); --n-fill: var(--chuna); }
  .band--sindoor { --paint: var(--sindoor); --ink: var(--chuna); --shout: var(--chuna); --shadow: var(--kajal); --stroke: transparent; --focus: var(--chuna); --n-shadow: var(--kajal); --n-fill: var(--chuna); }
  .band--chuna { --paint: var(--chuna); --ink: var(--kajal); --shout: var(--kajal); --shadow: var(--haldi); --stroke: transparent; --focus: var(--sindoor); }

  /* painted lettering: fill, a black brush outline, a hard offset shadow in a second enamel */
