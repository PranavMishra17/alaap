  .prog-hi { font: 400 1.15rem/1 var(--display); color: var(--haldi); }
  .prog-en { font: 600 .7rem/1 var(--cond); text-transform: uppercase; letter-spacing: .1em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; opacity: .85; }
  .prog-list a::after { content: ''; position: absolute; left: 12%; right: 12%; bottom: 0; height: 6px; background: var(--sindoor); transform: scaleX(0); transform-origin: left; transition: transform .2s; }
