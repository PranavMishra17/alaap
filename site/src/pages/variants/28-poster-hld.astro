  .prog { position: sticky; top: 0; z-index: 6; display: flex; align-items: stretch; height: var(--prog-h); background: var(--kajal); color: var(--chuna); border-bottom: 3px solid var(--haldi); padding: 0 var(--gutter); }
  .prog-brand { display: flex; align-items: center; padding-right: 1rem; margin-right: .5rem; border-right: 2px solid rgba(244,238,221,.35); font: 400 1.5rem/1 var(--display); color: var(--haldi); text-decoration: none; text-shadow: .05em .05em 0 var(--sindoor); }
  .prog-list { display: flex; flex: 1; min-width: 0; }
  .prog-list li { flex: 1; min-width: 0; display: flex; }
