  @media (max-width: 640px) {
    .form { grid-template-columns: 1fr; }
    .form dt { border-bottom: 0; padding-bottom: 0; }
    .form dd { padding-left: 0; padding-top: .25rem; }
  }

  /* ─── documents in the file ─── */
  .doc { padding-top: 5rem; }
  .doc__head { border-top: 3px solid var(--ink); padding-top: .6rem; margin-bottom: 1.6rem; display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .2rem 2rem; }
  .doc__head h2 { font: 700 clamp(2.2rem, 4vw, 3rem)/1 var(--display); text-transform: uppercase; letter-spacing: .02em; }
  .doc__intro { max-width: var(--measure); font-size: 1.1rem; margin-bottom: 2.4rem; }

  /* ─── the roles: headshots with no face ─── */
  .roles { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem 2rem; max-width: 66rem; }
  .role { display: grid; gap: 1.1rem; align-content: start; }
  .print { background: var(--white); padding: .7rem .7rem 0; box-shadow: 0 1px 0 rgba(23, 23, 26, .14), 0 18px 30px -18px rgba(23, 23, 26, .5); }
  .print__photo { position: relative; aspect-ratio: 4 / 5; background: var(--photo); overflow: hidden; }
  .print__photo canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .print__nophoto { position: absolute; left: .55rem; top: .5rem; padding: .1rem .15rem; background: var(--photo); font: 400 .66rem/1.3 var(--mono); letter-spacing: .1em; text-transform: uppercase; opacity: .85; }
  .print__name { font: 700 1.6rem/1 var(--display); text-transform: uppercase; letter-spacing: .08em; text-align: center; padding: .75rem 0 .6rem; }
  .role__meta { display: grid; gap: .3rem; }
  .role__desc { font-family: var(--mono); font-size: .97rem; line-height: 1.5; }
  .role__desc::before { content: '\201C'; }
  .role__desc::after { content: '\201D'; }
  .slate { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .5rem .85rem; align-items: start; }
  .slate audio { grid-column: 1 / -1; }
  .slate__words { font-family: var(--mono); font-size: .97rem; line-height: 1.5; }
  .slate__words .kicker { display: block; margin-bottom: .1rem; }
  .slate__len { display: block; font: 500 .75rem/1.4 var(--body); color: var(--pencil); }
  @media (max-width: 820px) {
    .roles { grid-template-columns: 1fr; gap: 2.25rem; }
    .role { grid-template-columns: 8.5rem minmax(0, 1fr); gap: .6rem 1.25rem; }
    .print { grid-row: 1 / 3; }
    .print__name { font-size: 1.15rem; padding: .55rem 0 .45rem; }
    .print__nophoto { font-size: .55rem; left: .45rem; top: .4rem; }
  }
  @media (max-width: 420px) { .role { grid-template-columns: 7rem minmax(0, 1fr); gap: .5rem .9rem; } }

  /* ─── play controls ─── */
  .play { display: inline-flex; align-items: center; gap: .45rem; font: 600 .74rem/1 var(--body); letter-spacing: .1em; text-transform: uppercase; background: var(--ink); color: var(--paper); border: 2px solid var(--ink); padding: .52rem .7rem .4rem; cursor: pointer; border-radius: 2px; white-space: nowrap; }
  .play svg { width: .62rem; height: .62rem; fill: currentColor; flex: none; }
  .play .play__stop { display: none; }
  .play[aria-pressed="true"] { background: var(--pen); border-color: var(--pen); }
  .play[aria-pressed="true"] .play__go { display: none; }
  .play[aria-pressed="true"] .play__stop { display: block; }

  .notes { margin-top: 2.75rem; max-width: var(--measure); display: grid; gap: .7rem; }
  .notes p { font-size: .95rem; }

  /* ─── the sides ─── */
  .script { background: var(--white); max-width: 48rem; margin: 0 auto; padding: clamp(1.5rem, 5vw, 3.25rem) clamp(1rem, 6vw, 4rem) clamp(2rem, 5vw, 3.25rem); box-shadow: 0 1px 0 rgba(23, 23, 26, .14), 0 26px 40px -26px rgba(23, 23, 26, .45); font-family: var(--mono); font-size: 1rem; line-height: 1.5; }
  .script__head { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .25rem 1.5rem; font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; border-bottom: 1px solid var(--ink); padding-bottom: .6rem; margin-bottom: 2.25rem; }
  .cues { list-style: none; padding: 0; display: grid; gap: 1.9rem; }
  .cue { display: grid; grid-template-columns: 5.6rem minmax(0, 1fr); gap: .4rem 1rem; align-items: start; }
  .cue__ctl { display: grid; gap: .35rem; justify-items: start; padding-top: .15rem; }
  .cue__len { font: 500 .74rem/1.4 var(--body); color: var(--pencil); }
  .cue__body { padding-left: clamp(0rem, 9vw, 5.5rem); }
  .cue__who { display: block; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; padding-left: clamp(0rem, 8vw, 5rem); }
  .cue.is-playing .cue__who { color: var(--pen); }
  .cue__paren { display: block; font-style: italic; font-size: .9rem; padding-left: clamp(0rem, 4vw, 2.25rem); color: var(--pencil); }
  .cue__words { background-image: linear-gradient(var(--mark), var(--mark)); background-repeat: no-repeat; background-size: calc(var(--p, 0) * 100%) 100%; -webkit-box-decoration-break: slice; box-decoration-break: slice; padding: .08em 0; }
  .script__foot { margin-top: 2.5rem; border-top: 1px solid var(--ink); padding-top: 1rem; font-family: var(--body); font-size: .9rem; display: grid; gap: .6rem; }
  @media (max-width: 520px) {
    .cue { grid-template-columns: 1fr; }
    .cue__ctl { grid-row: 2; display: flex; align-items: center; gap: .75rem; }
    .cue__body { padding-left: 0; }
  }

  /* ─── callbacks ─── */
  .callbacks { margin: 3.25rem auto 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 3rem; max-width: 66rem; }
  .callback { border-top: 2px solid var(--pen); padding-top: 1rem; }
  .callback h3 { font: 700 1.4rem/1.1 var(--display); text-transform: uppercase; letter-spacing: .04em; margin-bottom: .5rem; }
  .callback p { font-size: .95rem; max-width: 46ch; }
  .queue { display: inline-flex; gap: .5rem; align-items: center; font: 600 .78rem/1 var(--body); letter-spacing: .1em; text-transform: uppercase; color: var(--pen); background: transparent; border: 2px solid var(--pen); padding: .62rem .9rem .5rem; border-radius: 2px; cursor: pointer; margin: .2rem 0 .9rem; }
  .queue::before { content: ''; width: .55rem; height: .55rem; background: currentColor; clip-path: polygon(0 0, 100% 50%, 0 100%); }
  .queue[aria-pressed="true"] { background: var(--pen); color: var(--paper); }
  .queue[aria-pressed="true"]::before { clip-path: none; }
  .queue__now { grid-column: 1 / -1; font: 500 .85rem/1.4 var(--body); color: var(--pen); min-height: 1.3em; }
  .queue__now:empty::before { content: 'Nothing playing.'; color: var(--pencil); }
  @media (max-width: 820px) { .callbacks { grid-template-columns: 1fr; } }

  /* ─── conditions ─── */
  .conds { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.6rem 3.5rem; max-width: 70rem; }
  .cond h3 { font: 700 1.65rem/1.05 var(--display); text-transform: uppercase; letter-spacing: .02em; margin-bottom: .6rem; max-width: 30ch; }
  .cond p { max-width: 54ch; }
  .cond blockquote { margin-top: 1rem; padding-left: 1rem; border-left: 3px solid var(--pen); font-family: var(--mono); font-size: .95rem; max-width: 48ch; }
  @media (max-width: 820px) { .conds { grid-template-columns: 1fr; gap: 2rem; } }

  /* ─── routing slip ─── */
  .flow { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0 2.4rem; margin-bottom: 3rem; }
  .flow li { position: relative; border-top: 2px solid var(--ink); padding-top: .7rem; }
  .flow li + li::before { content: '\2192'; position: absolute; left: -1.95rem; top: .5rem; font: 700 1.5rem/1 var(--display); color: var(--pen); }
  .flow b { display: block; font: 700 1.35rem/1.05 var(--display); text-transform: uppercase; letter-spacing: .03em; margin-bottom: .35rem; }
  .flow span { display: block; font-size: .9rem; }
  .flow .is-learn { border-top-color: var(--pen); }
  .flow .is-learn b { color: var(--pen); }
  .ideas { display: grid; grid-template-columns: 15rem minmax(0, 1fr); border-top: 1px solid var(--ink); max-width: 70rem; }
  .ideas dt { font: 700 1.15rem/1.2 var(--display); text-transform: uppercase; letter-spacing: .03em; padding: .9rem 1rem .8rem 0; border-bottom: 1px solid var(--ink); }
  .ideas dd { padding: .95rem 0 .8rem; border-bottom: 1px solid var(--ink); font-size: .95rem; max-width: 62ch; }
  @media (max-width: 820px) {
    .flow { grid-template-columns: 1fr; gap: 1.8rem; }
    .flow li + li::before { content: '\2193'; left: 0; top: -1.75rem; }
    .ideas { grid-template-columns: 1fr; }
    .ideas dt { border-bottom: 0; padding-bottom: 0; }
    .ideas dd { padding-top: .25rem; }
  }

  /* ─── languages ─── */
  .hindi { margin-top: 1.75rem; padding: 1.25rem 1.5rem 1.35rem; border: 2px solid var(--ink); max-width: 42rem; }
  .hindi [lang="hi"] { font: 500 clamp(1.5rem, 3vw, 1.9rem)/1.55 var(--body); margin-bottom: .6rem; }
  .hindi figcaption { font-size: .9rem; color: var(--pencil); }

  /* ─── the notes on file ─── */
  .file { display: grid; grid-template-columns: 1fr; gap: 3rem 4rem; }
  .file__col { min-width: 0; max-width: 72ch; }
  @media (min-width: 1100px) {
    .file { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
    .file__col { max-width: none; }
  }
  .check { list-style: none; padding: 0; display: grid; gap: 1.7rem; }
  .check li { display: grid; grid-template-columns: 1.6rem minmax(0, 1fr); gap: .95rem; }
  .box { width: 1.35rem; height: 1.35rem; border: 2px solid var(--ink); margin-top: .35rem; position: relative; }
  .box svg { position: absolute; left: -.2rem; top: -.55rem; width: 1.9rem; height: 1.9rem; overflow: visible; fill: none; stroke: var(--pen); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .check h3 { font: 700 1.4rem/1.1 var(--display); text-transform: uppercase; letter-spacing: .02em; margin-bottom: .4rem; }
  .check p + p { margin-top: .7em; }
  .caveat { color: var(--pencil); font-size: .93rem; }
  .caveat b { color: var(--ink); font-weight: 600; }
  .check__sub { font: 700 clamp(1.8rem, 3vw, 2.3rem)/1 var(--display); text-transform: uppercase; letter-spacing: .02em; margin: 0 0 1.5rem; padding-top: 1rem; border-top: 2px solid var(--ink); }
  .check--not h3 { color: var(--ink); }

  .ruler { position: relative; height: 4.6rem; margin: 1.1rem 0 .4rem; max-width: 36rem; }
  .ruler__track { position: absolute; left: 0; right: 0; top: 2rem; height: 2px; background: var(--ink); }
  .ruler__band { position: absolute; top: 1.45rem; height: 1.1rem; background: var(--mark); }
  .ruler__band--measured { left: 15.2%; width: 69.3%; opacity: .5; }
  .ruler__band--clean { left: 27.3%; width: 40.9%; top: 1.6rem; height: .8rem; }
  .ruler__tick { position: absolute; top: 1.35rem; width: 2px; height: 1.3rem; background: var(--ink); transform: translateX(-1px); }
  .ruler__lab { position: absolute; transform: translateX(-50%); font: 500 .7rem/1.2 var(--body); letter-spacing: .04em; color: var(--pencil); white-space: nowrap; }
  .ruler__lab--up { top: .1rem; }
  .ruler__lab--down { top: 2.9rem; }

  /* ─── close ─── */
  .close { margin-top: 6rem; border-top: 3px solid var(--ink); padding: 2rem 0 3.5rem; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 2rem 4rem; }
  .close h2 { font: 700 clamp(2.2rem, 5vw, 3.6rem)/1 var(--display); text-transform: uppercase; letter-spacing: .01em; max-width: 14ch; }
  .close__p { max-width: 46ch; margin: 1rem 0; }
  .cta { display: inline-flex; font: 600 .82rem/1 var(--body); letter-spacing: .1em; text-transform: uppercase; background: var(--ink); color: var(--paper); padding: .85rem 1.1rem .7rem; text-decoration: none; border-radius: 2px; border: 2px solid var(--ink); margin: .25rem .5rem .25rem 0; }
  .cta--pen { background: transparent; color: var(--pen); border-color: var(--pen); }
  @media (max-width: 820px) { .close { grid-template-columns: 1fr; } }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const INK = '#17171A';
  const PEN = '#1E3F96';
  const PHOTO = '#C9CAC4';

  // ─── audio on file ───
  const audios = new Map<string, HTMLAudioElement>();
  document.querySelectorAll<HTMLAudioElement>('audio[data-clip]').forEach((a) => audios.set(a.dataset.clip!, a));
  const cues = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('.cue[data-clip]').forEach((c) => cues.set(c.dataset.clip!, c));
  const playButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-play]'));
  const queueButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-queue]'));
  const status = document.getElementById('now-playing');

  let queue: string[] = [];
  let activeQueue: HTMLButtonElement | null = null;
  let raf = 0;

  const isPlaying = (a: HTMLAudioElement) => !a.paused && !a.ended;

  function pauseOthers(except: string | null) {
    audios.forEach((a, id) => { if (id !== except && !a.paused) a.pause(); });
  }
  function play(id: string) {
    const a = audios.get(id);
    if (!a) return;
    pauseOthers(id);
    try { a.currentTime = 0; } catch { /* not loaded yet; starts at 0 anyway */ }
    const cue = cues.get(id);
    if (cue) cue.style.setProperty('--p', '0');
    a.play().catch(() => reflect(id));
  }
  function endQueue() {
    queue = [];
    if (activeQueue) activeQueue.setAttribute('aria-pressed', 'false');
    activeQueue = null;
  }
  function reflect(id: string) {
    const a = audios.get(id)!;
    const on = isPlaying(a);
    playButtons.forEach((b) => { if (b.dataset.play === id) b.setAttribute('aria-pressed', on ? 'true' : 'false'); });
    cues.get(id)?.classList.toggle('is-playing', on);
    if (status) {
      if (on) status.textContent = `Now playing: ${a.dataset.label ?? id}`;
      else if (![...audios.values()].some(isPlaying)) status.textContent = '';
    }
  }
  function tick() {
    let any = false;
    audios.forEach((a, id) => {
      if (!isPlaying(a) || !a.duration) return;
      any = true;
      const p = Math.min(1, a.currentTime / a.duration);
      const cue = cues.get(id);
      if (cue) cue.style.setProperty('--p', reduced ? '1' : p.toFixed(4));
      const port = portraits.get(id);
      if (port) drawPortrait(port, p);
    });
    raf = any ? requestAnimationFrame(tick) : 0;
  }

  audios.forEach((a, id) => {
    a.addEventListener('play', () => { pauseOthers(id); reflect(id); if (!raf) raf = requestAnimationFrame(tick); });
    a.addEventListener('pause', () => {
      reflect(id);
      const port = portraits.get(id);
      if (port && a.ended) drawPortrait(port, null);
    });
    a.addEventListener('ended', () => {
      reflect(id);
      const cue = cues.get(id);
      if (cue) cue.style.setProperty('--p', '1');
      const port = portraits.get(id);
      if (port) drawPortrait(port, null);
      if (queue.length) play(queue.shift()!);
      else endQueue();
    });
    a.addEventListener('error', () => { reflect(id); endQueue(); });
  });

  playButtons.forEach((b) => b.addEventListener('click', () => {
    const id = b.dataset.play!;
    const a = audios.get(id);
    if (!a) return;
    endQueue();
    if (isPlaying(a)) a.pause();
    else play(id);
  }));

  queueButtons.forEach((b) => b.addEventListener('click', () => {
    if (activeQueue === b) { endQueue(); pauseOthers(null); return; }
    endQueue();
    activeQueue = b;
    b.setAttribute('aria-pressed', 'true');
    const ids = (b.dataset.queue ?? '').split(',').filter(Boolean);
    ids.forEach((id) => cues.get(id)?.style.setProperty('--p', '0'));
    queue = ids.slice(1);
    play(ids[0]);
  }));

  // ─── the portraits: each slate's loudness, top to bottom, mirrored ───
  interface Portrait { canvas: HTMLCanvasElement; data: Float32Array; env: Float32Array | null; dpr: number; reveal: number; seen: boolean; developed: boolean; }
  const portraits = new Map<string, Portrait>();

  function envelope(data: Float32Array, rows: number): Float32Array {
    const n = data.length;
    const per = n / rows;
    const raw = new Float32Array(rows);
    for (let i = 0; i < rows; i++) {
      const s = Math.floor(i * per);
      const e = Math.min(n, Math.floor((i + 1) * per));
      let peak = 0;
      for (let j = s; j < e; j++) { const v = Math.abs(data[j]); if (v > peak) peak = v; }
      raw[i] = peak;
    }
    const env = new Float32Array(rows);
    let max = 0;
    for (let i = 0; i < rows; i++) {
      let acc = 0, c = 0;
      for (let k = -3; k <= 3; k++) { const j = i + k; if (j >= 0 && j < rows) { acc += raw[j]; c++; } }
      env[i] = acc / c;
      if (env[i] > max) max = env[i];
    }
    // Normalise; drop the faint transient rows so a stray tick never floats above the silhouette.
    if (max > 0) for (let i = 0; i < rows; i++) { const v = Math.pow(env[i] / max, 0.85); env[i] = v < 0.035 ? 0 : v; }
    return env;
  }
  function size(st: Portrait) {
    const r = st.canvas.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    st.canvas.width = Math.max(1, Math.round(r.width * dpr));
    st.canvas.height = Math.max(1, Math.round(r.height * dpr));
    st.dpr = dpr;
    st.env = envelope(st.data, Math.max(40, Math.round(r.height / 2)));
  }
  function drawPortrait(st: Portrait, progress: number | null) {
    const ctx = st.canvas.getContext('2d');
    if (!ctx || !st.env) return;
    const W = st.canvas.width, H = st.canvas.height;
    ctx.fillStyle = PHOTO;
    ctx.fillRect(0, 0, W, H);
    const top = H * 0.08, span = H * 0.84, rows = st.env.length, rowH = span / rows, half = W * 0.44, cx = W / 2;
    const limit = Math.round(rows * st.reveal);
    ctx.fillStyle = INK;
    for (let i = 0; i < limit; i++) {
      const h = st.env[i] * half;
      if (h < 0.75) continue;
      ctx.fillRect(cx - h, top + i * rowH, h * 2, rowH + 0.6);
    }
    if (progress != null && progress > 0) {
      ctx.fillStyle = PEN;
      ctx.fillRect(0, top + progress * span - st.dpr, W, 2 * st.dpr);
    }
  }
  function develop(st: Portrait) {
    st.developed = true;
    if (reduced) { st.reveal = 1; drawPortrait(st, null); return; }
    const t0 = performance.now();
    const step = (t: number) => {
      const k = Math.min(1, (t - t0) / 1100);
      st.reveal = 1 - Math.pow(1 - k, 3);
      drawPortrait(st, null);
      if (k < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  // A card counts as seen whether or not its clip has decoded yet; whichever happens second develops it.
  const seenIds = new Set<string>();
  const seen = 'IntersectionObserver' in window
    ? new IntersectionObserver((entries) => {
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          const id = (en.target as HTMLElement).dataset.seed!;
          seenIds.add(id);
          const st = portraits.get(id);
          if (st && st.env && !st.developed) develop(st);
          seen!.unobserve(en.target);
        });
      }, { threshold: 0.2 })
    : null;

  async function loadPortrait(canvas: HTMLCanvasElement) {
    const id = canvas.dataset.seed!;
    const src = canvas.dataset.src!;
    try {
      const res = await fetch(src);
      if (!res.ok) return;
      const buf = await res.arrayBuffer();
      const decoded = await new OfflineAudioContext(1, 1, 44100).decodeAudioData(buf);
      const st: Portrait = { canvas, data: decoded.getChannelData(0), env: null, dpr: 1, reveal: 0, seen: false, developed: false };
      portraits.set(id, st);
      size(st);
      if (!seen || seenIds.has(id)) develop(st);
      // Whatever the observer does, no card stays blank for long.
      else window.setTimeout(() => { if (!st.developed) develop(st); }, 3500);
    } catch { /* the "no photograph on file" label stays, which is also true */ }
  }

  const canvases = Array.from(document.querySelectorAll<HTMLCanvasElement>('canvas[data-seed]'));
  canvases.forEach((c) => { seen?.observe(c); loadPortrait(c); });

  let resizeTimer = 0;
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      portraits.forEach((st) => { size(st); if (st.developed) { st.reveal = 1; drawPortrait(st, null); } });
    }, 120);
  });
</script>
