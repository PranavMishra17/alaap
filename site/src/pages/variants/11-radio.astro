<script>
  const set = document.getElementById('set')!;
  const band = document.getElementById('band')!;
  const needle = document.getElementById('needle')!;
  const display = document.getElementById('display')!;
  const tuned = document.getElementById('tuned')!;
  const eyeCanvas = document.getElementById('eye') as HTMLCanvasElement;
  const knob = document.getElementById('knob')!;
  const knobLabel = knob.querySelector('.knob-label')!;
  const stationLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.stations a'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('section.station'));
  const N = sections.length;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---------- the dial: where you are on the page ----------
  const cssNum = (name: string) => parseFloat(getComputedStyle(document.documentElement).getPropertyValue(name));
  const probeOffset = () => cssNum('--set-c') + innerHeight * 0.22;
  const tops = () => sections.map((s) => s.getBoundingClientRect().top + scrollY);

  function position() {
    const t = tops();
    if (scrollY + innerHeight >= document.documentElement.scrollHeight - 2) return { i: N - 1, f: 0 };
    const probe = scrollY + probeOffset();
    let i = 0;
    while (i < N - 1 && probe >= t[i + 1]) i++;
    if (i === N - 1) return { i, f: 0 };
    const f = Math.min(1, Math.max(0, (probe - t[i]) / (t[i + 1] - t[i])));
    return { i, f };
  }

  let compact = false;
  let lastIndex = -1;
  function render() {
    const { i, f } = position();
    needle.style.setProperty('--nx', String((i + f) / (N - 1)));
    if (i !== lastIndex) {
      lastIndex = i;
      stationLinks.forEach((a, k) => (k === i ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
