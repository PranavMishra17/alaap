---
// Variant 11, "radio": All India Radio and the radio drama. The tuning dial is the navigation,
// the stations are the sections, the clips are broadcasts, and static marks what is not there yet.
import type { CharacterId } from '../../content/alaap';
import { name, meaning, links, characters, clips, scene, seeds, clipCaveats, languages } from '../../content/alaap';

const stations = [
  { id: 'sign-on', label: 'Sign-on' },
  { id: 'the-play', label: 'The play' },
  { id: 'indian-languages', label: 'Indic first' },
  { id: 'different', label: 'What differs' },
  { id: 'how-it-works', label: 'How it works' },
  { id: 'the-log', label: 'The log' },
  { id: 'not-there-yet', label: 'Not there yet' },
  { id: 'sign-off', label: 'Sign-off' },
];
const last = stations.length - 1;
const castNames: Record<CharacterId, string> = { mentor: 'The mentor', scout: 'The scout', innkeeper: 'The innkeeper' };
const seedOf = (id: CharacterId) => seeds.find((s) => s.character === id)!;
const mentorClips = clips.filter((c) => c.character === 'mentor');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alaap · a voice nobody has recorded</title>
    <meta name="description" content="Describe a character. Get a voice nobody has recorded. Keep it." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Khand:wght@500;600&family=Martel:wght@400;700;900&display=swap" rel="stylesheet" />
    <noscript><style>.knob, .btn-js { display: none !important; } .set { height: var(--set-c) !important; } body { padding-top: var(--set-c) !important; }</style></noscript>
  </head>
  <body>
    <!-- The radio face. Fixed at the top; compacts on scroll; every clip on the page plays through it. -->
    <header class="set" id="set">
      <div class="chassis">
        <a class="badge" href="#sign-on"><span>{name.latin}</span><span lang="hi">{name.devanagari}</span></a>
        <div class="glass" id="glass">
          <nav class="stations" aria-label="Stations on the dial. Each is a section of this page.">
            {stations.map((s, i) => (
              <a href={`#${s.id}`} style={`--x:${i / last}`}>{s.label}</a>
            ))}
          </nav>
          <div class="band" id="band" title="Drag the needle to tune" tabindex="0" role="slider" aria-label="Tuning dial. Arrow keys move between stations." aria-valuemin="0" aria-valuemax={last} aria-valuenow="0">
            <div class="ticks"></div>
            {stations.map((s, i) => <span class="mark" style={`--x:${i / last}`}></span>)}
            <span class="dead" aria-hidden="true"></span>
            <span class="needle" id="needle"></span>
          </div>
          <p class="display" id="display" aria-live="polite">
            <span class="tuned" id="tuned"></span>
            <span class="idle">AI-generated synthetic speech. All audio carries an AudioSeal watermark.</span>
          </p>
        </div>
        <div class="meter">
          <canvas class="eye" id="eye" width="120" height="120" aria-hidden="true"></canvas>
          <button class="knob" id="knob" type="button" aria-pressed="false">
            <span class="knob-face" aria-hidden="true"></span>
            <span class="knob-label">Switch on</span>
          </button>
        </div>
      </div>
    </header>

    <main>
      <!-- Station 1: sign-on -->
      <section class="station hero" id="sign-on">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="ident" lang="hi">यह आलाप है।</p>
            <h1 class="wordmark">{name.latin} <span lang="hi">{name.devanagari}</span></h1>
            <p class="meaning">{meaning}</p>
            <p class="lede">You describe a character in ordinary language. You get back a voice that has never existed. Then you use that voice for any line of dialogue you write, and it stays the same character every time.</p>
            <p class="who">For people making games, animation, audio drama, dubbing, interactive fiction: anyone who needs many distinct speaking characters and cannot hire a cast for each one.</p>
            <p class="langs">Measured in {languages.join(', ')}. The Indian-language engine covers 22 Indian languages; four measured so far.</p>
          </div>
          <div class="presets">
            <p class="presets-head">Three characters, minted from these descriptions before this page was made. A key replays that character's stored seed clip; the switch plays the first. The mentor's description is the project's own example. Nothing on this page generates a voice live.</p>
            <div class="keys">
              {characters.map((ch) => { const s = seedOf(ch.id); return (
                <a class="key" href={`#clip-${s.id}`} data-play={s.id}>
                  <span class="key-name">{castNames[ch.id]}</span>
                  <span class="key-desc">“{ch.description}”</span>
                  <span class="key-says">says “{s.text}”</span>
                </a>
              ); })}
            </div>
          </div>
        </div>
      </section>

      <!-- Station 2: the play -->
      <section class="station panel" id="the-play">
        <div class="wrap">
          <p class="eyebrow">The play</p>
          <h2>Three characters minted from text. A five-line scene. About four minutes on one laptop GPU.</h2>
          <p class="intro">The demo mints the three characters from their descriptions, renders the scene, watermarks everything and writes a file a game engine can read, on one 6 GB laptop GPU. These clips are that run's output, rendered 2026-09-05. Every player shows the exact words.</p>

          <h3>Cast</h3>
          <ul class="cast">
            {characters.map((ch) => { const s = seedOf(ch.id); return (
              <li class="member">
                <div class="member-who">
                  <p class="speaker">{castNames[ch.id]}</p>
                  <p class="desc">minted from “{ch.description}”</p>
                </div>
                <figure class="clip" id={`clip-${s.id}`} data-clip={s.id} data-who={castNames[ch.id]}>
                  <figcaption><span class="words">“{s.text}”</span><span class="note">seed clip · {s.seconds} s</span></figcaption>
                  <audio preload="none" controls src={s.src}></audio>
                </figure>
              </li>
            ); })}
          </ul>

          <div class="script-head">
            <h3>Script</h3>
            <button class="btn btn-js" id="play-scene" type="button">Play the scene</button>
          </div>
          <ol class="script">
            {scene.map((c) => (
              <li class="line">
                <figure class="clip" id={`clip-${c.id}`} data-clip={c.id} data-who={castNames[c.character]}>
                  <p class="speaker">{castNames[c.character]}</p>
                  <figcaption>
                    <span class="words">“{c.text}”</span>
                    <span class="note">{c.seconds} s · {c.experimentalEmotionSetting ? 'experimental emotion setting, unvalidated' : 'no direction'}</span>
                  </figcaption>
                  <audio preload="none" controls src={c.src}></audio>
                </figure>
              </li>
            ))}
          </ol>

          <div class="caveats">
            <p>{clipCaveats.watermark}</p>
            <p>{clipCaveats.emotionSetting}</p>
            <p>{clipCaveats.englishOnly}</p>
          </div>
        </div>
      </section>

      <!-- Station 3: Indian languages -->
      <section class="station" id="indian-languages">
        <div class="wrap narrow">
          <p class="eyebrow">Indic first</p>
          <h2>Indic is the stated reason the project exists.</h2>
          <p>The tools that do this well mostly do it in English. Indian-language creators either use a handful of stock voices that everyone else is also using, or they hire actors. This project treats Hindi, Bengali and Tamil as first-class, not as an afterthought port.</p>
          <p>The Indian-language tools that exist ship a fixed menu of voices, and every project draws from the same menu. In the project's own measurements the Hindi path scored higher than the English path on every identity check.</p>
          <div class="hindi-check">
            <p class="hindi-line" lang="hi">नमस्ते आप कैसे हैं आज मौसम बहुत अच्छा है</p>
            <p class="hindi-gloss">Roughly: “Hello, how are you? The weather is very nice today.” Our translation, not a project claim.</p>
            <p>A fluent Hindi speaker has confirmed one rendered line says this sentence. They were told the sentence and asked “does it say this?”, not “does it sound right?”. That is the check an earlier, faulty batch of audio failed. Still to be checked: the other voices and the other lines. The Hindi render itself does not ship, not even here: the engine is research-only under its licence.</p>
          </div>
        </div>
      </section>

      <!-- Station 4: what is different -->
      <section class="station panel" id="different">
        <div class="wrap">
          <p class="eyebrow">What differs</p>
          <h2>Four things, each one measured.</h2>
          <div class="listing">
            <article class="prog">
              <h3>A voice is a thing you keep, not a setting you re-guess</h3>
              <p>Most tools generate a voice each time you ask. Here the character's voice is stored as an identity and re-used. The same character sounds like the same person across every line, every scene, and every session. That consistency is measured, not hoped for.</p>
              <div class="hear">
                <button class="btn btn-js" type="button" data-queue="mentor_seed,mentor_line0,mentor_line3">Hear the same character across different sentences</button>
                <ul class="hear-words">
                  {mentorClips.map((c) => <li>“{c.text}”</li>)}
                </ul>
              </div>
            </article>
            <article class="prog">
              <h3>Who is speaking and what is being said are genuinely separate</h3>
              <p>The system holds a character's identity apart from the words. That is why one character can say anything without their voice drifting, and why changing the line never changes the person. This was verified rather than assumed: when the same audio content is played through two different identities, the words come out identically. The measured error between them was exactly zero on every line tested.</p>
            </article>
            <article class="prog">
              <h3>It does not need a recording of the character</h3>
              <p>There is no voice cloning here, and no user uploads their own audio. Voices are created from a written description. That sidesteps the consent and impersonation problem entirely: you cannot accidentally clone a real person if the system never accepts a recording.</p>
            </article>
            <article class="prog">
              <h3>It knows what it does not know</h3>
              <p>Every capability is measured against a control, and the honest limits are published alongside the results. Roughly twenty findings in this project were wrong on the first attempt and caught by a check, including one where an entire experiment produced fluent-sounding speech that was saying different words than requested, and nothing errored. That is written up publicly rather than quietly fixed.</p>
              <p class="rule">“A suspiciously good or suspiciously bad number is a bug report about your setup.”</p>
            </article>
          </div>
        </div>
      </section>

      <!-- Station 5: how it works -->
      <section class="station" id="how-it-works">
        <div class="wrap">
          <p class="eyebrow">How it works</p>
          <h2>One small piece learns. Everything else is used as-is.</h2>
          <ol class="chain" aria-label="The signal chain, in order">
            <li class="node"><span class="node-name">your description</span><span class="node-sub">ordinary language</span></li>
            <li class="node lit"><span class="node-name">the mapper</span><span class="node-sub">the only part that learns</span></li>
            <li class="node"><span class="node-name">a voice identity</span><span class="node-sub">small, storable, versioned</span></li>
            <li class="node"><span class="node-name">the voice engine</span><span class="node-sub">never modified, swappable</span></li>
            <li class="node"><span class="node-name">audio</span><span class="node-sub">watermarked and logged</span></li>
          </ol>
          <div class="ideas">
            <p><b>Only one small piece is trained.</b> The speech engine is used as-is and never altered, so a better engine can be swapped in without rebuilding everything.</p>
            <p><b>The voice identity is a small, storable thing.</b> That is what makes a character persistent: it can be saved, versioned and handed to someone else. Each one is stored with a short seed clip and the engine version that made it.</p>
            <p><b>The checker is separate.</b> A speaker-recognition system that has never seen the generator, and never sees the engine's internals, does the checking. Every render is watermarked and logged from the first output, not added later.</p>
          </div>

          <h3 class="ways-head">Two ways to answer a description, both measured</h3>
          <p class="ways-intro">Invent a new voice, or find the closest match in an existing library of voices. Inventing gives you a character nobody else has; finding gives you higher accuracy and studio quality. Neither is strictly better and the project has numbers for the trade-off.</p>
          <div class="ways">
            <article class="way">
              <h4>Invent</h4>
              <p>A voice nobody else has. The three characters on this page were made this way, from nothing but their descriptions. Inventing reached 37 percent of the variety the library actually holds before two mis-set settings were fixed; the fix raised the invented catalogue from 14 to 22 distinct Hindi voices and from 23 to 41 English.</p>
            </article>
            <article class="way">
              <h4>Find</h4>
              <p>On a library of 141 real Hindi voices, two thirds of descriptions get a voice that matches on every trait named, and 87 percent land within one step. When a description names only a couple of traits, the way people actually write, a bit over half match exactly on the traits named; about one in five would by chance. The same method on a library of 2,500 English voices reaches 88.5 percent, and it replicates in Bengali within a point or two. Finding reaches 87 percent of the variety the library holds.</p>
              <p>What finding cannot do: produce a voice the library does not contain; guarantee a new character is unique, since two descriptions can return the same voice; and the library is someone else's, so every character in every project draws from the same shelf.</p>
            </article>
          </div>
          <p class="caveat-line">The library measured was real recorded speakers standing in for a studio library. No commercial system has been measured.</p>
        </div>
      </section>

      <!-- Station 6: the log -->
      <section class="station panel" id="the-log">
        <div class="wrap">
          <p class="eyebrow">The log</p>
          <h2>What was measured, with the caveat on the same line.</h2>
          <div class="log">
            <article class="entry">
              <h3>Minting a voice from a description costs nothing in clarity</h3>
              <p class="measured">A described voice is just as intelligible as one taken from a real recording. The measured difference was tiny, leaned slightly in the invented voice's favour, and was smaller than the difference between two real speakers: the gap between two real speakers was six times larger.</p>
              <p class="caveat">The project reads that as no detectable difference, not as invented voices being better. The control that had to pass first: every version must come out the same length before any score is read, or the run aborts.</p>
            </article>
            <article class="entry">
              <h3>Invented voices are recognisably distinct people</h3>
              <p class="measured">Verified by a separate speaker-recognition system that has never seen the generator: an independent check, not the system marking its own homework. Each invented voice also sits clearly apart from the nearest real voice the system learned from, so these are new voices, not real people wearing a label.</p>
              <div class="hear">
                <button class="btn btn-js" type="button" data-queue="mentor_seed,scout_seed">Hear the mentor, then the scout</button>
                <ul class="hear-words"><li>Both say “This is how I sound when I speak.”</li></ul>
              </div>
            </article>
            <article class="entry">
              <h3>A character stays itself more consistently than a real person does</h3>
              <p class="measured">A character stays itself across different sentences more consistently than a real person does across different recordings.</p>
              <p class="note">Unsurprising once you think about it: a stored voice has no bad-throat day, no change of microphone, no mood.</p>
            </article>
            <article class="entry">
              <h3>A blind listening test found and fixed a real problem</h3>
              <p class="measured">A blind listening test with built-in controls found a real problem in how the system judged whether two voices were the same person: pairs the system called different were heard as the same person about half the time. The threshold was raised. That removed 10 duplicate voices from a set of 50 and cost 3 percent of measured variety.</p>
              <p class="caveat">The test was small: 8 pairs and one listener, with every control answered correctly. It found the problem but does not settle the exact threshold, and the English threshold has not had its own listening test.</p>
            </article>
            <article class="entry">
              <h3>Pacing is controllable within a measured range</h3>
              <p class="measured">You can slow a character to about two-thirds of normal speed or push them to about 1.4 times, and they stay the same person saying the same words. Outside that range the identity fades gradually rather than breaking.</p>
              <p class="caveat">A listener noted the slow extreme starts to sound processed; the range they called clean is narrower, about 0.8 to 1.25 times. The scale below is an illustration of those ranges. Nothing on this page re-times audio.</p>
              <svg class="pace" viewBox="0 0 600 96" role="img" aria-label="A speed scale. The measured range runs from about two-thirds to about 1.4 times normal speed. The range a listener called clean runs from about 0.8 to about 1.25 times.">
                <line x1="40" y1="52" x2="560" y2="52" class="pace-rail" />
                <rect x="77" y="44" width="406" height="16" rx="8" class="pace-measured" />
                <rect x="147" y="48" width="240" height="8" rx="4" class="pace-clean" />
                <line x1="253" y1="34" x2="253" y2="70" class="pace-normal" />
                <text x="253" y="26" class="pace-label mid">normal speed</text>
                <text x="40" y="26" class="pace-label">about two-thirds</text>
                <text x="560" y="26" class="pace-label right">about 1.4×</text>
                <text x="147" y="88" class="pace-label small">about 0.8×</text>
                <text x="387" y="88" class="pace-label small right">about 1.25×</text>
              </svg>
              <p class="pace-key"><span class="swatch sw-measured"></span> measured range <span class="swatch sw-clean"></span> heard as clean</p>
            </article>
            <article class="entry">
              <h3>Watermarked and logged from the first render</h3>
              <p class="measured">Every render is watermarked and logged, from the first output, not added later. Output includes a manifest a game engine can consume: this is built for a pipeline, not a demo button.</p>
              <p class="note">114 automated checks guard the rules the project learned the hard way: never accept a user's audio; watermark from the first render; store timbre, not performance; do not start the next stage until this one is measured.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- Station 7: not there yet. No carrier here; the static is the point. -->
      <section class="station dead-air" id="not-there-yet">
        <svg class="static" aria-hidden="true" focusable="false">
          <filter id="grain"><feTurbulence type="turbulence" baseFrequency="0.62" numOctaves="3" stitchTiles="stitch" /><feColorMatrix type="saturate" values="0" /><feComponentTransfer><feFuncR type="linear" slope="2.6" intercept="-0.55" /><feFuncG type="linear" slope="2.6" intercept="-0.55" /><feFuncB type="linear" slope="2.6" intercept="-0.55" /></feComponentTransfer></filter>
          <rect width="100%" height="100%" filter="url(#grain)" />
        </svg>
        <div class="wrap narrow">
          <p class="eyebrow">Not there yet</p>
          <h2>Static is honest silence. Here is what is missing.</h2>
          <ul class="missing">
            <li><b>Not a product.</b> This is a working research system, not a product. There is no signup, no hosted service, no API.</li>
            <li><b>Emotion is not solved.</b> Emotional performance direction is not solved. You can control pacing within a measured range. You cannot yet say “say this line apologetically” and have it work. That was tested thoroughly and does not work on the current engine, for reasons the project documented and reported upstream: the engine's documented emotion tags turn out not to be recognised by the engine at all, and a listener heard no difference between tagged versions of the same line.</li>
            <li><b>The catalogue is small.</b> Tens of distinct voices per language so far, not hundreds: about 22 in Hindi and 41 in English by the project's own measure. The limit is understood and measured rather than mysterious: the real speakers the system learned from hold about 38 to 48 distinguishable voices, and the project measured exactly where its own method loses variety.</li>
            <li><b>Cannot ship as a product, for licensing reasons.</b> It cannot be shipped as a product in its current form for licensing reasons, which are documented. The Indian-language engine's training chain includes data licensed for non-commercial use, so no model weights and no Indian-language audio leave the repository. It is research-only today, deliberately.</li>
            <li><b>Very little has been listened to.</b> Most results are automatic measurements. One listener, a handful of pairs.</li>
            <li><b>No comparison against a commercial system.</b></li>
            <li><b>The clips on this page are English.</b> {clipCaveats.englishOnly}</li>
            <li><b>Three of the five demo lines</b> were rendered with an experimental emotion setting whose effect has not been validated on this engine. Listen to them as voice samples, not performances.</li>
          </ul>
        </div>
      </section>

      <!-- Station 8: sign-off -->
      <section class="station signoff" id="sign-off">
        <div class="wrap narrow">
          <p class="eyebrow">Sign-off</p>
          <h2>Here is what we built, what we measured, and what is missing.</h2>
          <div class="ctas">
            <a class="cta" href={links.repo}>Read the research</a>
            <a class="cta quiet" href={links.issues}>Corrections welcome</a>
          </div>
          <p class="quote">“If a claim here is wrong, an issue with a primary source is more useful than almost anything else.”</p>
          <p class="small">Research and documentation CC BY 4.0; code MIT. No model weights and no generated Indian-language audio ship. Research pass 2026-09-02; implementation and measurement 2026-09-05.</p>
          <p class="small">Repository: <a href={links.repo}>github.com/PranavMishra17/alaap</a></p>
          <p class="endline">End of broadcast.</p>
        </div>
      </section>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bakelite: #2E1912;
    --bakelite-2: #452519;
    --glass: #F2DDA8;
    --glass-dim: #CDB37C;
    --ink: #241108;
    --brass: #C9A24A;
    --needle: #C8352A;
    --eye: #7FD9A6;
    --set-h: 236px;
    --set-c: 108px;
    --eye-s: 104px;
    --pad: 6%;
    --body: 'Martel', Georgia, 'Noto Serif Devanagari', 'Noto Serif', serif;
    --dial: 'Khand', 'Arial Narrow', 'Noto Sans Devanagari', 'Helvetica Neue', sans-serif;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; padding-top: var(--set-h);
    background: var(--bakelite); color: var(--glass);
    font: 400 17px/1.65 var(--body);
    overflow-x: hidden;
  }
  h1, h2, h3, h4, p, ul, ol, figure { margin: 0; }
  ul, ol { padding: 0; list-style: none; }
  a { color: inherit; }
  b { font-weight: 700; }
  :focus-visible { outline: 3px solid var(--eye); outline-offset: 3px; }
  .panel :focus-visible, .key:focus-visible, .band:focus-visible { outline-color: var(--needle); }
  [lang="hi"] { font-family: var(--body); }

  /* ---------- the radio face ---------- */
  .set {
    position: fixed; inset: 0 0 auto 0; z-index: 20; height: var(--set-h);
    background: var(--bakelite);
    background-image: linear-gradient(180deg, rgba(255,255,255,.05), transparent 30%, rgba(0,0,0,.25));
    box-shadow: 0 2px 0 var(--bakelite-2), 0 14px 30px rgba(0,0,0,.5);
    transition: height .55s cubic-bezier(.2,.7,.2,1);
  }
  .set.compact { height: var(--set-c); --eye-s: 54px; }
  .chassis { height: 100%; max-width: 1360px; margin: 0 auto; padding: 16px 22px; display: flex; gap: 22px; align-items: stretch; }
  .set.compact .chassis { padding: 10px 18px; gap: 16px; }
  .badge {
    align-self: center; display: flex; flex-direction: column; gap: 2px; text-decoration: none; min-width: 5.5rem;
    font: 600 16px/1 var(--dial); letter-spacing: .24em; text-transform: uppercase; color: var(--brass);
  }
  .badge [lang="hi"] { font: 400 15px/1.2 var(--body); letter-spacing: 0; text-transform: none; }
  .glass {
    flex: 1; min-width: 0; position: relative; border-radius: 16px; padding: 8px 18px 8px;
    display: flex; flex-direction: column; gap: 6px;
    background: var(--glass-dim);
    background-image: linear-gradient(180deg, rgba(255,255,255,.18), transparent 40%, rgba(0,0,0,.12));
    box-shadow: inset 0 0 0 2px #1a0d08, inset 0 10px 24px rgba(0,0,0,.35);
    transition: background-color 1.6s ease, box-shadow 1.6s ease;
  }
  .set.compact .glass { padding: 5px 14px; gap: 3px; border-radius: 11px; }
  body.on .glass {
    background-color: var(--glass);
    box-shadow: inset 0 0 0 2px #1a0d08, inset 0 10px 24px rgba(0,0,0,.18), 0 0 46px rgba(255,140,42,.38), 0 0 4px rgba(255,180,90,.5);
  }
  .stations { position: relative; height: 22px; color: var(--ink); }
  .stations a {
    position: absolute; top: 0; left: calc(var(--pad) + var(--x) * (100% - 2 * var(--pad))); transform: translateX(-50%);
