    }
    const wantCompact = compact ? scrollY > 12 : scrollY > 72;
    if (wantCompact !== compact) { compact = wantCompact; set.classList.toggle('compact', compact); }
  }
  let ticking = false;
  const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; render(); }); } };
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  render();
  if (document.fonts) document.fonts.ready.then(render);

  // Drag or click the needle to tune.
  let dragging = false;
  function tuneTo(clientX: number) {
    const r = band.getBoundingClientRect();
    const padPx = r.width * cssNum('--pad') / 100;
    const frac = Math.min(1, Math.max(0, (clientX - r.left - padPx) / (r.width - 2 * padPx)));
    const pos = frac * (N - 1);
    const i = Math.min(N - 2, Math.floor(pos));
    const f = pos - i;
    const t = tops();
    const target = t[i] + f * (t[i + 1] - t[i]) - probeOffset();
    scrollTo({ top: Math.max(0, Math.ceil(target) + 1), behavior: 'instant' });
  }
  band.addEventListener('pointerdown', (e) => { dragging = true; band.classList.add('dragging'); band.setPointerCapture(e.pointerId); tuneTo(e.clientX); });
  band.addEventListener('pointermove', (e) => { if (dragging) tuneTo(e.clientX); });
  const endDrag = () => { dragging = false; band.classList.remove('dragging'); };
  band.addEventListener('pointerup', endDrag);
  band.addEventListener('pointercancel', endDrag);
  band.addEventListener('keydown', (e) => {
    const step = /^Arrow(Right|Down)$/.test(e.key) ? 1 : /^Arrow(Left|Up)$/.test(e.key) ? -1 : 0;
    const to = e.key === 'Home' ? 0 : e.key === 'End' ? N - 1 : step ? lastIndex + step : -1;
    if (to < 0 || to >= N) return;
    e.preventDefault(); sections[to].scrollIntoView();
  });

  // ---------- the set: one audio path, one magic eye ----------
  const audios = Array.from(document.querySelectorAll<HTMLAudioElement>('figure.clip audio'));
  const byId = new Map<string, HTMLAudioElement>();
  let actx: AudioContext | null = null;
  let analyser: AnalyserNode | null = null;
  let data: Float32Array<ArrayBuffer> | null = null;
  const sources = new WeakSet<HTMLAudioElement>();
  let current: HTMLAudioElement | null = null;
  let queue: HTMLAudioElement[] = [];
  let queueButton: HTMLButtonElement | null = null;

  function powerOn() {
    if (!actx) {
      actx = new AudioContext();
      analyser = actx.createAnalyser();
      analyser.fftSize = 1024;
      analyser.smoothingTimeConstant = 0.5;
      analyser.connect(actx.destination);
      data = new Float32Array(analyser.fftSize);
    }
    if (actx.state === 'suspended') actx.resume();
    if (!document.body.classList.contains('on')) {
      document.body.classList.add('on');
      knob.setAttribute('aria-pressed', 'true');
      knobLabel.textContent = 'On';
      drawEye(0);
    }
  }
  function attach(el: HTMLAudioElement) {
    if (!actx || !analyser || sources.has(el)) return;
    actx.createMediaElementSource(el).connect(analyser);
    sources.add(el);
  }
  function stopAll(except?: HTMLAudioElement) {
    for (const a of audios) if (a !== except && !a.paused) a.pause();
  }
  function clearQueue() {
    queue = [];
    if (queueButton) { queueButton.setAttribute('aria-pressed', 'false'); queueButton.textContent = queueButton.dataset.label ?? ''; queueButton = null; }
  }
  function play(el: HTMLAudioElement) {
    powerOn();
    attach(el);
    stopAll(el);
    el.currentTime = 0;
    el.play().catch(() => {});
  }
  function playQueue(list: HTMLAudioElement[], button: HTMLButtonElement) {
    if (queueButton === button) { clearQueue(); stopAll(); return; }
    clearQueue();
    queue = list.slice();
    queueButton = button;
    button.dataset.label = button.dataset.label ?? button.textContent ?? '';
    button.setAttribute('aria-pressed', 'true');
    button.textContent = 'Stop';
    const first = queue.shift();
    if (first) play(first);
  }

  // Replace native controls with one honest button per clip. Words stay in the figcaption.
  for (const el of audios) {
    const fig = el.closest('figure.clip') as HTMLElement;
    byId.set(fig.dataset.clip ?? '', el);
    el.removeAttribute('controls');
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'play';
    btn.textContent = 'Play';
    btn.setAttribute('aria-pressed', 'false');
    fig.appendChild(btn);
    btn.addEventListener('click', () => { if (el.paused) { clearQueue(); play(el); } else { el.pause(); } });
    el.addEventListener('play', () => {
      current = el;
      fig.classList.add('is-playing');
      btn.textContent = 'Stop'; btn.setAttribute('aria-pressed', 'true');
      document.querySelectorAll<HTMLElement>('.key').forEach((k) => k.classList.toggle('is-playing', k.dataset.play === fig.dataset.clip));
      showPlaying(fig.dataset.who ?? '', fig.querySelector('.words')?.textContent ?? '');
      if (!reduce) startLoop(); else drawEye(0.55);
    });
    const stopped = () => {
      fig.classList.remove('is-playing');
      btn.textContent = 'Play'; btn.setAttribute('aria-pressed', 'false');
      document.querySelectorAll<HTMLElement>('.key').forEach((k) => k.classList.remove('is-playing'));
      if (current === el) { current = null; document.body.classList.remove('playing'); if (reduce) drawEye(0); }
    };
    el.addEventListener('pause', stopped);
    el.addEventListener('ended', () => {
      stopped();
      const next = queue.shift();
      if (next) play(next); else clearQueue();
    });
  }

  let playLine: HTMLElement | null = null;
  function showPlaying(who: string, words: string) {
    if (!playLine) {
      playLine = document.createElement('span');
      playLine.className = 'now';
      display.appendChild(playLine);
    }
    playLine.textContent = '';
    const b = document.createElement('b'); b.textContent = who;
    const q = document.createElement('q'); q.textContent = words.replace(/^“|”$/g, '');
    playLine.append(b, q);
    document.body.classList.add('playing');
  }

  // Preset keys in the hero replay the stored seed clips.
  document.querySelectorAll<HTMLAnchorElement>('.key').forEach((k) => {
    k.setAttribute('role', 'button');
    k.addEventListener('click', (e) => {
      e.preventDefault();
      const el = byId.get(k.dataset.play ?? '');
      if (!el) return;
      if (!el.paused) el.pause(); else { clearQueue(); play(el); }
    });
  });

  // Back-to-back buttons: the scene, one character across sentences, two characters.
  const sceneBtn = document.getElementById('play-scene') as HTMLButtonElement | null;
  if (sceneBtn) sceneBtn.addEventListener('click', () => {
    const list = Array.from(document.querySelectorAll<HTMLElement>('.script figure.clip')).map((f) => byId.get(f.dataset.clip ?? '')!).filter(Boolean);
    playQueue(list, sceneBtn);
  });
  document.querySelectorAll<HTMLButtonElement>('[data-queue]').forEach((b) => {
    b.addEventListener('click', () => {
      const list = (b.dataset.queue ?? '').split(',').map((id) => byId.get(id)!).filter(Boolean);
      playQueue(list, b);
    });
  });

  // The knob: switch on, and the set says its first words.
  knob.addEventListener('click', () => {
    if (knob.getAttribute('aria-pressed') === 'true') {
      stopAll(); clearQueue();
      document.body.classList.remove('on');
      knob.setAttribute('aria-pressed', 'false');
      knobLabel.textContent = 'Switch on';
      drawEye(0);
      return;
    }
    const first = byId.get('mentor_seed');
    if (first) { clearQueue(); play(first); } else powerOn();
  });

  // ---------- the magic eye ----------
  const ectx = eyeCanvas.getContext('2d')!;
  let raf = 0;
  let level = 0;
  function drawEye(lvl: number) {
    const s = eyeCanvas.width, c = s / 2, R = s * 0.47;
    ectx.clearRect(0, 0, s, s);
    ectx.beginPath(); ectx.arc(c, c, R, 0, Math.PI * 2); ectx.fillStyle = '#120906'; ectx.fill();
    if (!document.body.classList.contains('on')) {
      ectx.beginPath(); ectx.arc(c, c, R * 0.86, 0, Math.PI * 2); ectx.fillStyle = '#2f3a33'; ectx.fill();
      ectx.beginPath(); ectx.arc(c, c, R * 0.16, 0, Math.PI * 2); ectx.fillStyle = '#0d1a12'; ectx.fill();
      return;
    }
    const g = ectx.createRadialGradient(c, c, R * 0.12, c, c, R * 0.9);
    g.addColorStop(0, '#f2fff5'); g.addColorStop(0.3, '#7FD9A6'); g.addColorStop(1, '#18603f');
    ectx.beginPath(); ectx.arc(c, c, R * 0.86, 0, Math.PI * 2); ectx.fillStyle = g; ectx.fill();
    const open = (1 - Math.min(1, lvl * 3)) * Math.PI * 0.5;
    if (open > 0.02) {
      ectx.fillStyle = 'rgba(8,22,14,.94)';
      for (const base of [-Math.PI / 2, Math.PI / 2]) {
        ectx.beginPath(); ectx.moveTo(c, c); ectx.arc(c, c, R * 0.86, base - open / 2, base + open / 2); ectx.closePath(); ectx.fill();
      }
    }
    ectx.beginPath(); ectx.arc(c, c, R * 0.16, 0, Math.PI * 2); ectx.fillStyle = '#0d1a12'; ectx.fill();
  }
  function loop() {
    if (analyser && data) {
      analyser.getFloatTimeDomainData(data);
      let sum = 0;
      for (let i = 0; i < data.length; i++) sum += data[i] * data[i];
      const rms = Math.sqrt(sum / data.length);
      level = Math.max(rms, level * 0.86);
    }
    drawEye(level);
    if (current || level > 0.005) raf = requestAnimationFrame(loop);
    else { raf = 0; level = 0; drawEye(0); }
  }
  function startLoop() { if (!raf) raf = requestAnimationFrame(loop); }
  drawEye(0);
</script>
