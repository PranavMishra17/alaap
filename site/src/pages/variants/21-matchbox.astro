<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---- 1. the colour-control bar follows the reader down the sheet ---- */
  const swatches = Array.from(document.querySelectorAll<HTMLElement>('.sw[data-row]'));
  const rowEls = Array.from(document.querySelectorAll<HTMLElement>('.row[data-row]'));
  const whereL = document.querySelector<HTMLElement>('.where-l');
  const whereT = document.querySelector<HTMLElement>('.where-t');
  let ticking = false;
  function updateRow() {
    ticking = false;
    const line = window.innerHeight * 0.4;
    let current = rowEls[0]?.dataset.row || 'top';
    for (const r of rowEls) if (r.getBoundingClientRect().top <= line) current = r.dataset.row!;
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) current = rowEls[rowEls.length - 1].dataset.row!;
    swatches.forEach((s) => {
      const on = s.dataset.row === current;
      s.classList.toggle('is-current', on);
      const a = s.querySelector('a')!;
      if (on) { a.setAttribute('aria-current', 'location'); const t = a.getAttribute('title') || ''; const m = /^Row (\w), (.*)$/.exec(t); if (m && whereL && whereT) { whereL.textContent = m[1]; whereT.textContent = m[2]; } }
      else a.removeAttribute('aria-current');
    });
  }
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(updateRow); } }, { passive: true });
  addEventListener('resize', updateRow);
  updateRow();

  /* ---- 2. every label: decode its clip, keep the loudness envelope ---- */
  type Label = { el: HTMLElement; id: string; audio: HTMLAudioElement; canvas: HTMLCanvasElement; btn: HTMLButtonElement; txt: HTMLElement; env: Float32Array | null; burnt: number };
  const labels: Label[] = Array.from(document.querySelectorAll<HTMLElement>('.pos[data-clip]')).map((el) => ({
    el, id: el.dataset.clip!, audio: el.querySelector('audio')!, canvas: el.querySelector('canvas')!, btn: el.querySelector('.strip')!, txt: el.querySelector('.strip-txt')!, env: null, burnt: 0,
  }));
  const byId = new Map(labels.map((l) => [l.id, l]));
  const BINS = 160;
  const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();

  function envelope(buf: AudioBuffer): Float32Array {
    const x = buf.getChannelData(0), out = new Float32Array(BINS), step = x.length / BINS;
    let max = 0;
    for (let b = 0; b < BINS; b++) {
      let peak = 0;
      for (let i = Math.floor(b * step), end = Math.min(x.length, Math.floor((b + 1) * step)); i < end; i++) { const v = Math.abs(x[i]); if (v > peak) peak = v; }
      out[b] = peak; if (peak > max) max = peak;
    }
    for (let b = 0; b < BINS; b++) out[b] = Math.pow(out[b] / (max || 1), 0.8);
    return out;
  }

  /* the strike mark: the envelope mirrored about the strip's midline, burnt in as far as the head has travelled */
  function tracePath(g: CanvasRenderingContext2D, env: Float32Array, w: number, mid: number, amp: number, from: number, to: number, scale: number) {
    const b0 = Math.max(0, Math.floor(from * BINS)), b1 = Math.min(BINS, Math.ceil(to * BINS));
    if (b1 <= b0) return false;
    const xOf = (b: number) => (b / BINS) * w;
    g.beginPath();
    g.moveTo(xOf(b0), mid);
    for (let b = b0; b < b1; b++) g.lineTo(xOf(b + 0.5), mid - Math.max(0.6, env[b] * amp * scale));
    g.lineTo(xOf(b1), mid);
    for (let b = b1 - 1; b >= b0; b--) g.lineTo(xOf(b + 0.5), mid + Math.max(0.6, env[b] * amp * scale));
    g.closePath();
    return true;
  }
  function draw(l: Label, progress = l.burnt, head = false) {
    const cv = l.canvas, dpr = Math.min(2, devicePixelRatio || 1);
    const w = cv.clientWidth || 200, h = 34;
    if (cv.width !== Math.round(w * dpr)) { cv.width = Math.round(w * dpr); cv.height = h * dpr; }
    const g = cv.getContext('2d')!; g.setTransform(dpr, 0, 0, dpr, 0, 0); g.clearRect(0, 0, w, h);
    if (!l.env) return;
    const mid = h / 2, amp = mid - 2.5;
    // the pale trace: what the strip would show if struck
    if (tracePath(g, l.env, w, mid, amp, 0, 1, 1)) { g.fillStyle = 'rgba(231, 224, 202, 0.28)'; g.fill(); }
    if (progress <= 0) return;
    // soot, then the scratch showing the board through it
    if (tracePath(g, l.env, w, mid, amp, 0, progress, 1)) { g.fillStyle = css('--key'); g.fill(); }
    if (tracePath(g, l.env, w, mid, amp, 0, progress, 0.55)) { g.fillStyle = css('--board'); g.fill(); }
    if (!head) return;
    // the head: a short hot tail and the ember
    const x = progress * w, tail = Math.min(x, 26);
    if (tracePath(g, l.env, w, mid, amp, Math.max(0, progress - tail / w), progress, 0.75)) {
      const grad = g.createLinearGradient(x - tail, 0, x, 0); grad.addColorStop(0, 'rgba(201, 59, 120, 0)'); grad.addColorStop(0.7, css('--rani')); grad.addColorStop(1, css('--ember'));
      g.fillStyle = grad; g.fill();
    }
    const glow = g.createRadialGradient(x, mid, 1, x, mid, 11); glow.addColorStop(0, 'rgba(240, 138, 36, 0.9)'); glow.addColorStop(1, 'rgba(240, 138, 36, 0)');
    g.fillStyle = glow; g.beginPath(); g.arc(x, mid, 11, 0, Math.PI * 2); g.fill();
    g.fillStyle = css('--ember'); g.beginPath(); g.arc(x, mid, 3.2, 0, Math.PI * 2); g.fill();
  }
  labels.forEach((l) => draw(l));
  let rt = 0;
  addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => labels.forEach((l) => draw(l, l.burnt, playing === l)), 120); });

  async function decodeAll() {
    if (!('AudioContext' in window) || (navigator as any).connection?.saveData) return;
    let ctx: AudioContext;
    try { ctx = new AudioContext(); } catch { return; }
    for (const l of labels) {
      try {
        const res = await fetch(l.audio.getAttribute('src')!);
        l.env = envelope(await ctx.decodeAudioData(await res.arrayBuffer()));
        draw(l);
      } catch (e) { console.warn('strip left blank for', l.id, e); }
    }
    try { await ctx.close(); } catch {}
  }
  const idle = (window as any).requestIdleCallback || ((fn: () => void) => setTimeout(fn, 150));
  idle(() => { decodeAll(); });

  /* ---- 3. striking: one label at a time, the mark burns in as the clip plays ---- */
  let playing: Label | null = null, queue: string[] = [], raf = 0;
  function setState(l: Label, on: boolean) {
    l.el.classList.toggle('is-playing', on);
    l.btn.setAttribute('aria-pressed', String(on));
    l.txt.textContent = on ? 'Stop' : l.burnt >= 0.999 ? 'Strike again' : 'Strike';
  }
  function progressOf(l: Label) { const d = l.audio.duration || Number(l.el.dataset.seconds) || 1; return Math.min(1, l.audio.currentTime / d); }
  function stopAll() {
    queue = [];
    cancelAnimationFrame(raf);
    if (playing) { const l = playing; playing = null; l.audio.pause(); setState(l, false); draw(l); }
  }
  function tick() {
    if (!playing) return;
    playing.burnt = progressOf(playing);
    draw(playing, playing.burnt, true);
    if (!playing.audio.paused && !playing.audio.ended) raf = requestAnimationFrame(tick);
  }
  function play(id: string) {
    const l = byId.get(id); if (!l) return;
    if (playing && playing !== l) { const p = playing; playing = null; p.audio.pause(); setState(p, false); draw(p); }
    playing = l; l.burnt = 0; setState(l, true); draw(l);
    l.audio.currentTime = 0;
    l.audio.play().then(() => { if (!reduced) raf = requestAnimationFrame(tick); }).catch(() => { setState(l, false); playing = null; });
  }
  function next() { const id = queue.shift(); if (id) play(id); else stopAll(); }
  labels.forEach((l) => {
    l.audio.addEventListener('ended', () => { l.burnt = 1; setState(l, false); draw(l); if (playing === l) { playing = null; next(); } });
    l.audio.addEventListener('pause', () => { if (playing === l && !l.audio.ended) { playing = null; cancelAnimationFrame(raf); setState(l, false); draw(l); } });
    // reduced motion: no ember, the mark advances in steps
    l.audio.addEventListener('timeupdate', () => { if (!reduced || playing !== l) return; l.burnt = progressOf(l); draw(l); });
    l.btn.addEventListener('click', () => { if (playing === l) { stopAll(); return; } queue = []; play(l.id); });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-seq]').forEach((b) => {
    b.addEventListener('click', () => {
      const ids = (b.dataset.seq || '').split(',').filter(Boolean);
      stopAll();
      const first = byId.get(ids[0]); if (!first) return;
      const r = first.el.getBoundingClientRect();
      if (r.top < 60 || r.bottom > innerHeight) first.el.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
      queue = ids.slice(1); play(ids[0]);
    });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-stop]').forEach((b) => b.addEventListener('click', stopAll));
</script>
