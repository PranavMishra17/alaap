---
// Variant 21 "matchbox": one uncut press sheet of matchbox labels. Every clip is a label with a
// striking strip; striking it plays the clip and burns the real loudness envelope into the strip.
import { name, meaning, links, characters, scene, seeds, byCharacter, clipCaveats } from '../../content/alaap';

const who: Record<string, string> = { mentor: 'Mentor', scout: 'Scout', innkeeper: 'Innkeeper' };
const desc = Object.fromEntries(characters.map((c) => [c.id, c.description]));
const mentorSeq = byCharacter('mentor').map((c) => c.id).join(',');
const sceneSeq = scene.map((c) => c.id).join(',');
const pairSeq = [scene[0].id, scene[1].id].join(',');
const hindiLine = 'नमस्ते आप कैसे हैं आज मौसम बहुत अच्छा है';

// The sheet's rows. Letters, as on a press sheet, so no digit here can be read as a claim.
const rows = [
  { id: 'top', l: 'A', title: 'the label' },
  { id: 'brands', l: 'B', title: 'three brands' },
  { id: 'scene', l: 'C', title: 'the scene' },
  { id: 'how', l: 'D', title: 'how it works' },
  { id: 'four', l: 'E', title: 'four things' },
  { id: 'measured', l: 'F', title: 'measured' },
  { id: 'blank', l: 'G', title: 'not there yet' },
  { id: 'imprint', l: 'H', title: 'imprint' },
];

// Brand figures, flat two-plate litho. f = fill plate, s = stroke plate, reg = print a rani copy off-register underneath.
type Shape = { d: string; f?: string; s?: string; w?: number; reg?: boolean; dash?: boolean; t?: string };
const rays = [168, 143, 118, 90, 62, 37, 12].map((deg) => {
  const a = (deg * Math.PI) / 180, cx = 60, cy = 60;
  const p = (r: number, da: number) => `${(cx + r * Math.cos(a + da)).toFixed(1)} ${(cy - r * Math.sin(a + da)).toFixed(1)}`;
  return `M${p(37, -0.11)} L${p(58, 0)} L${p(37, 0.11)} Z`;
}).join(' ');
const figures: Record<string, Shape[]> = {
  sun: [
    { d: rays, f: 'vir', reg: true },
    { d: 'M28 60 A32 32 0 0 1 92 60 Z', f: 'rani' },
    { d: 'M28 60 A32 32 0 0 1 92 60 Z', s: 'key', w: 2, t: 'translate(1.6 -1.2)' },
    { d: 'M4 60 H116', s: 'key', w: 2 },
    { d: 'M10 67 q6 -3 12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0 t12 0', s: 'vir', w: 2 },
    { d: 'M22 74 q6 -3 12 0 t12 0 t12 0 t12 0 t12 0 t12 0', s: 'vir', w: 2 },
  ],
  mentor: [
    { d: 'M42 72 L74 22 L118 72 Z', f: 'rani' },
    { d: 'M2 72 L36 26 L56 52 L70 44 L96 72 Z', f: 'vir', reg: true },
    { d: 'M2 72 L36 26 L56 52 L70 44 L96 72 Z', s: 'key', w: 2, t: 'translate(1.4 -1.2)' },
    { d: 'M30 34 L36 26 L42 34 L39 32 L36 36 L33 32 Z', f: 'board' },
    { d: 'M2 72 H118', s: 'key', w: 2 },
  ],
  scout: [
    { d: 'M2 72 Q30 42 60 58 T118 72 Z', f: 'vir', reg: true },
    { d: 'M2 72 Q30 42 60 58 T118 72', s: 'key', w: 2, t: 'translate(1.4 -1.2)' },
    { d: 'M38 54 c-7 -8 5 -13 0 -21 c-5 -7 5 -11 1 -19', s: 'key', w: 2.5 },
    { d: 'M66 60 c-7 -8 5 -13 0 -21 c-5 -7 5 -11 1 -19', s: 'key', w: 2.5 },
    { d: 'M92 66 c-7 -8 5 -13 0 -21 c-5 -7 5 -11 1 -19', s: 'rani', w: 2.5, dash: true },
  ],
  innkeeper: [
    { d: 'M44 72 q4 -16 10 -22 q3 9 8 0 q7 8 6 22 Z', f: 'rani' },
    { d: 'M44 72 q4 -16 10 -22 q3 9 8 0 q7 8 6 22 Z', s: 'key', w: 1.6, t: 'translate(1.2 -1)' },
    { d: 'M34 38 C34 14 86 14 86 38 C86 60 34 60 34 38 Z', f: 'vir', reg: true },
    { d: 'M34 38 C34 14 86 14 86 38 C86 60 34 60 34 38 Z', s: 'key', w: 2, t: 'translate(1.4 -1.2)' },
    { d: 'M46 16 H74 V22 H46 Z', f: 'key' },
    { d: 'M22 70 h14 v5 h-14 Z M84 70 h14 v5 h-14 Z', f: 'key' },
    { d: 'M2 75 H118', s: 'key', w: 2 },
  ],
};
const fillClass = (s: Shape) => [s.f ? `f-${s.f}` : '', s.s ? `s-${s.s}` : '', s.dash ? 'dashed' : ''].filter(Boolean).join(' ');
---
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alaap · आलाप</title>
    <meta name="description" content="Describe a character. Get a voice nobody has recorded. Keep it." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jaini&family=Martel:wght@400;600&family=Pragati+Narrow:wght@400;700&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>
  <body>
    <!-- the colour-control bar: one swatch per row of the sheet, the current one in register -->
    <nav class="bar" aria-label="Rows of this sheet">
      <a class="bar-brand" href="#top"><span lang="hi">{name.devanagari}</span><span class="bar-latin">{name.latin}</span></a>
      <ol class="swatches">
        {rows.map((r, i) => (
          <li class={`sw sw-${i + 1}`} data-row={r.id}><a href={`#${r.id}`} title={`Row ${r.l}, ${r.title}`}><span class="reg" aria-hidden="true"></span><span class="sr">Row {r.l}, {r.title}</span></a></li>
        ))}
      </ol>
      <p class="where" aria-live="polite"><span class="where-l">A</span><span class="where-t">the label</span></p>
    </nav>

    <main class="sheet">
      <!-- Row A: the master label and the copy beside it -->
      <section class="row hero" id="top" data-row="top" aria-labelledby="h-name">
        <div class="pos pos-master">
          <div class="label master">
            <h1 class="band band-master" id="h-name"><span lang="hi" class="deva">{name.devanagari}</span><span class="latin">{name.latin}</span></h1>
            <span class="corner tr">2026-09-05</span>
            <div class="fig fig-master"><svg viewBox="0 0 120 80" aria-hidden="true" focusable="false">{figures.sun.map((s) => (<>{s.reg && <path d={s.d} class="f-reg" transform="translate(-1.6 1.4)" />}<path d={s.d} class={fillClass(s)} stroke-width={s.w} transform={s.t} /></>))}</svg></div>
            <p class="slogan">Describe a character. Get a voice nobody has recorded. Keep it.</p>
            <p class="stat">Voices from written descriptions<br />Accepts no recordings</p>
            <p class="stat foot-stat">Measured in English, Hindi, Bengali and Tamil<br />Rendered on one laptop GPU</p>
          </div>
        </div>
        <div class="hero-copy">
          <p class="lede">You describe a character in ordinary language. You get back a voice that has never existed. Then you use that voice for any line of dialogue you write, and it stays the same character every time.</p>
          <p class="meaning"><em lang="hi">आलाप</em> is {meaning}: a voice mapping out its own possibility space, which is what description-to-voice design does.</p>
          <div class="example crop">
            <p class="ex-lead">The whole of what the system was given for the first brand on this sheet:</p>
            <p class="ex-desc">&ldquo;{desc.mentor}&rdquo;</p>
            <button type="button" class="btn strike-hero" data-seq="mentor_seed">Strike the mentor&rsquo;s label</button>
            <p class="ex-note">That replays the demo&rsquo;s pre-rendered seed clip. Nothing on this page generates a voice.</p>
          </div>
          <p class="how-read">This page is one uncut sheet of labels. Each clip is a label. Strike its strip to hear it: the pale trace on the strip is the clip&rsquo;s own loudness, measured from the audio in your browser, and striking burns it in.</p>
        </div>
      </section>

      <!-- Row B: three brands, the seed clips -->
      <section class="row" id="brands" data-row="brands" aria-labelledby="h-brands">
        <h2 class="row-h" id="h-brands"><span class="row-l" aria-hidden="true">B</span>Three brands, each minted from the line on its label</h2>
        <p class="row-intro">The seed clip is the short reference recording the system stores alongside every identity when it is minted. The description on the label is the whole of what the system was given.</p>
        <div class="grid brands">
          {seeds.map((c) => (
            <div class="pos" data-clip={c.id} data-seconds={c.seconds} id={`label-${c.id}`}>
              <div class="label">
                <p class="band">{who[c.character]}</p>
                <span class="corner tr">{c.seconds.toFixed(1)} s</span>
                <div class="fig"><svg viewBox="0 0 120 80" aria-hidden="true" focusable="false">{figures[c.character].map((s) => (<>{s.reg && <path d={s.d} class="f-reg" transform="translate(-1.6 1.4)" />}<path d={s.d} class={fillClass(s)} stroke-width={s.w} transform={s.t} /></>))}</svg></div>
                <p class="slogan">&ldquo;{desc[c.character]}&rdquo;</p>
                <p class="says">Says: &ldquo;{c.text}&rdquo;</p>
                <p class="stat">Seed clip<br />AI-generated speech, watermarked</p>
                <audio preload="none" controls src={c.src}></audio>
              </div>
              <button type="button" class="strip" aria-label={`Strike: play ${who[c.character]}, ${c.text}`}><span class="strip-txt">Strike</span><canvas class="mark" width="300" height="34" aria-hidden="true"></canvas></button>
            </div>
          ))}
        </div>
        <ul class="caveats">
          <li>{clipCaveats.watermark}</li>
          <li>{clipCaveats.englishOnly}</li>
        </ul>
        <div class="two">
          <p class="who-for">For people making games, animation, audio drama, dubbing, interactive fiction: anyone who needs many distinct speaking characters and cannot hire a cast for each one.</p>
          <p>Indic is the stated reason the project exists. The tools that do this well mostly do it in English. Indian-language creators either use a handful of stock voices that everyone else is also using, or they hire actors. This project treats Hindi, Bengali and Tamil as first-class, not as an afterthought port.</p>
          <p>Measured so far in English, Hindi, Bengali and Tamil. The Indian-language engine covers 22 Indian languages; four are measured so far. In the project&rsquo;s own measurements the Hindi path scored higher than the English path on all three identity checks.</p>
        </div>
      </section>

      <!-- Row C: the scene, a strip of five labels -->
      <section class="row" id="scene" data-row="scene" aria-labelledby="h-scene">
        <h2 class="row-h" id="h-scene"><span class="row-l" aria-hidden="true">C</span>The scene: five labels, three brands, one run</h2>
        <p class="row-intro">The demo mints the three voices from text, renders this five-line scene, watermarks everything and writes a manifest a game engine can read, in about four minutes on one laptop GPU. The same figure on two labels is the same stored voice saying a different line.</p>
        <div class="actions">
          <button type="button" class="btn" data-seq={sceneSeq}>Strike all five in order</button>
          <button type="button" class="btn" data-seq={mentorSeq}>Strike the mentor&rsquo;s three</button>
          <button type="button" class="btn quiet" data-stop>Stop</button>
        </div>
        <div class="grid strip5">
          {scene.map((c) => (
            <div class="pos" data-clip={c.id} data-seconds={c.seconds}>
              <div class="label">
                <p class="band">{who[c.character]}</p>
                <span class="corner tl">{(c.lineIndex ?? 0) + 1}</span>
                <span class="corner tr">{c.seconds.toFixed(1)} s</span>
                <div class="fig"><svg viewBox="0 0 120 80" aria-hidden="true" focusable="false">{figures[c.character].map((s) => (<>{s.reg && <path d={s.d} class="f-reg" transform="translate(-1.6 1.4)" />}<path d={s.d} class={fillClass(s)} stroke-width={s.w} transform={s.t} /></>))}</svg></div>
                <p class="says">&ldquo;{c.text}&rdquo;</p>
                {c.experimentalEmotionSetting ? <p class="stat stamp">Experimental emotion setting, unvalidated</p> : <p class="stat">No direction</p>}
                <audio preload="none" controls src={c.src}></audio>
              </div>
              <button type="button" class="strip" aria-label={`Strike: play ${who[c.character]}, ${c.text}`}><span class="strip-txt">Strike</span><canvas class="mark" width="220" height="34" aria-hidden="true"></canvas></button>
            </div>
          ))}
        </div>
        <ul class="caveats">
          <li>{clipCaveats.emotionSetting}</li>
          <li>{clipCaveats.watermark} The manifest&rsquo;s own line: &ldquo;AI-generated synthetic speech. All audio carries an AudioSeal watermark.&rdquo;</li>
        </ul>
      </section>

      <!-- Row D: how it works, as the instruction strip on the back of the box -->
      <section class="row" id="how" data-row="how" aria-labelledby="h-how">
        <h2 class="row-h" id="h-how"><span class="row-l" aria-hidden="true">D</span>How it works</h2>
        <ol class="flow" aria-label="The shape of the system">
          <li class="node"><span class="node-t">your description</span><span class="node-s">in ordinary language</span></li>
          <li class="node node-inked"><span class="node-t">the mapper</span><span class="node-s">the only part that learns</span></li>
          <li class="node"><span class="node-t">a voice identity</span><span class="node-s">small, stored, kept</span></li>
          <li class="node node-outlined"><span class="node-t">the voice engine</span><span class="node-s">never modified, swappable</span></li>
          <li class="node"><span class="node-t">audio</span><span class="node-s">watermarked and logged</span></li>
        </ol>
        <div class="three">
          <div class="crop"><h3>Only one small piece is trained.</h3><p>The speech engine is used as-is and never altered, so a better engine can be swapped in without rebuilding everything.</p></div>
          <div class="crop"><h3>The voice identity is a small, storable thing.</h3><p>That is what makes a character persistent: it can be saved, versioned and handed to someone else. Each one is stored with a short seed clip and the engine version that made it. The identity is who the character is; each line is a separate performance.</p></div>
          <div class="crop"><h3>Two ways to answer a description, both measured.</h3><p>Invent a new voice, or find the closest match in a library. The numbers for the trade-off are in row F. The checker that judges voices is a separate speaker-recognition system that never sees the engine&rsquo;s internals.</p></div>
        </div>
      </section>

      <!-- Row E: the four differentiators -->
      <section class="row" id="four" data-row="four" aria-labelledby="h-four">
        <h2 class="row-h" id="h-four"><span class="row-l" aria-hidden="true">E</span>Four things that make it different</h2>
        <div class="grid four-grid">
          <div class="crop">
            <h3>A voice is a thing you keep, not a setting you re-guess</h3>
            <p>Most tools generate a voice each time you ask. Here the character&rsquo;s voice is stored as an identity and re-used. The same character sounds like the same person across every line, every scene, and every session. That consistency is measured, not hoped for.</p>
            <button type="button" class="btn small" data-seq={mentorSeq}>Strike the mentor&rsquo;s three labels</button>
          </div>
          <div class="crop">
            <h3>Who is speaking and what is being said are genuinely separate</h3>
            <p>The system holds a character&rsquo;s identity apart from the words. That is why one character can say anything without their voice changing, and why changing the line never changes the person. This was verified rather than assumed: when the same audio content is played through two different identities, the words come out identically. The measured error between them was exactly zero on every line tested.</p>
            <button type="button" class="btn small" data-seq={pairSeq}>Strike two brands, one after the other</button>
          </div>
          <div class="crop">
            <h3>It does not need a recording of the character</h3>
            <p>There is no voice cloning here, and no user uploads their own audio. Voices are created from a written description. That sidesteps the consent and impersonation problem entirely: you cannot accidentally clone a real person if the system never accepts a recording.</p>
          </div>
          <div class="crop">
            <h3>It knows what it does not know</h3>
            <p>Every capability is measured against a control, and the honest limits are published alongside the results. Roughly twenty findings in this project were wrong on the first attempt and caught by a check, including one where an entire experiment produced fluent-sounding speech that was saying different words than requested, and nothing errored. That is written up publicly rather than quietly fixed.</p>
            <blockquote>A suspiciously good or suspiciously bad number is a bug report about your setup.</blockquote>
          </div>
        </div>
      </section>

      <!-- Row F: what is measured, the caveat set beside it as a proof note -->
      <section class="row" id="measured" data-row="measured" aria-labelledby="h-measured">
        <h2 class="row-h" id="h-measured"><span class="row-l" aria-hidden="true">F</span>What is measured, with the caveat beside it</h2>
        <div class="meas">
          <div class="crop">
            <h3>It works end to end today</h3>
            <p>On one 6 GB laptop GPU, in English, Hindi, Bengali and Tamil. Describe a character, get a voice, render a scene of dialogue, and out comes watermarked audio plus a file a game engine can read. The clips on this sheet are that demo&rsquo;s output.</p>
          </div>
          <div class="crop">
            <h3>Minting a voice from a description costs nothing in clarity</h3>
            <p>A described voice is just as intelligible as one taken from a real recording. The measured difference was tiny, leaned slightly in the invented voice&rsquo;s favour, and was smaller than the difference between two real speakers: that gap was six times larger. The project reads that as no detectable difference, not as invented voices being better.</p>
            <p class="proof">The control that had to pass first: every version must come out the same length before any score is read, or the run aborts.</p>
          </div>
          <div class="crop">
            <h3>Invented voices are recognisably distinct people</h3>
            <p>Verified by a separate speaker-recognition system that has never seen the generator: an independent check, not the system marking its own homework. Each invented voice also sits clearly apart from the nearest real voice the system learned from, so these are new voices, not real people wearing a label.</p>
          </div>
          <div class="crop">
            <h3>A character stays itself more consistently than a real person does</h3>
            <p>Across different sentences, more consistently than a real person across different recordings, which is unsurprising once you think about it: a stored voice has no bad-throat day, no change of microphone, no mood.</p>
          </div>
          <div class="crop">
            <h3>A native speaker confirmed the Hindi says what it should</h3>
            <p>A fluent Hindi speaker has confirmed one rendered line says the target sentence. They were told the sentence and asked &ldquo;does it say this?&rdquo;, not &ldquo;does it sound right?&rdquo;. That is the check the earlier faulty audio failed: it sounded fluent and was saying different words.</p>
            <p class="hindi" lang="hi">{hindiLine}</p>
            <p class="gloss">A plain translation, ours and not a project claim: &ldquo;Hello, how are you? The weather is very nice today.&rdquo;</p>
            <p class="proof">Still to be checked: the other three voices and the other two lines. One rendered line, one speaker, so far.</p>
          </div>
          <div class="crop">
            <h3>A blind listening test found and fixed a real problem</h3>
            <p>A blind listening test with built-in controls found a real problem in how the system judged whether two voices were the same person: pairs the system called different were heard as the same person about half the time. The threshold was raised. That removed 10 duplicate voices from a set of 50 and cost 3 percent of measured variety.</p>
            <p class="proof">The test was small: 8 pairs and one listener, with every control answered correctly. It found the problem but does not settle the exact threshold, and the English threshold has not had its own listening test.</p>
          </div>
          <div class="crop">
            <h3>Pacing is controllable within a measured range</h3>
            <p>You can slow a character to about two-thirds of normal speed or push them to about 1.4 times, and they stay the same person saying the same words. Outside that range the identity fades gradually rather than breaking.</p>
            <figure class="pace">
              <svg viewBox="0 0 640 72" role="img" aria-labelledby="pace-t">
                <title id="pace-t">Pacing scale from about two-thirds to about 1.4 times normal speed. The measured range spans the whole scale; the listener's clean range is the narrower band from 0.8 to 1.25.</title>
                <line x1="40" y1="30" x2="600" y2="30" class="p-meas" />
                <line x1="163" y1="30" x2="486" y2="30" class="p-clean" />
                <g class="p-tick"><line x1="40" y1="20" x2="40" y2="40" /><line x1="163" y1="22" x2="163" y2="38" /><line x1="330" y1="18" x2="330" y2="42" /><line x1="486" y1="22" x2="486" y2="38" /><line x1="600" y1="20" x2="600" y2="40" /></g>
                <g class="p-text" text-anchor="middle"><text x="40" y="62">0.67×</text><text x="163" y="62">0.8×</text><text x="330" y="62">1×</text><text x="486" y="62">1.25×</text><text x="600" y="62">1.43×</text></g>
              </svg>
              <figcaption>Measured range in the pale band, the range a listener called clean in viridian. A bounded illustration: nothing on this page re-times audio.</figcaption>
            </figure>
            <p class="proof">A listener noted the slow extreme starts to sound processed; the range they called clean is narrower, about 0.8 to 1.25 times.</p>
          </div>
          <div class="crop">
            <h3>Two ways to answer a description, and the numbers for the trade-off</h3>
            <p>Invent a new voice, or find the closest match in an existing library of voices. Inventing gives you a character nobody else has; finding gives you higher accuracy and studio quality. Neither is strictly better and the project has numbers for the trade-off.</p>
            <p>Finding, on a library of 141 real Hindi voices: two thirds of descriptions (65.6%) get a voice that matches on every trait named, and 87% land within one step. When the description names only a couple of traits, the way people actually write, 53.8% match exactly on the traits named. Random chance is about 20%. The same method on a library of 2,500 English voices reaches 88.5%, and it replicates on 138 Bengali voices within a point or two.</p>
            <p>Reach: finding reaches 87% of the variety the library actually holds; inventing reached 37% before two mis-set settings were fixed, and the fix raised the invented catalogue from 14 to 22 distinct Hindi voices and from 23 to 41 English.</p>
            <p>What finding cannot do: produce a voice the library does not contain; guarantee a new character is unique, since two descriptions can return the same voice; and the library is someone else&rsquo;s, so every character in every project draws from the same shelf.</p>
            <p class="proof">The library measured was real recorded speakers standing in for a studio library, and no commercial system has been measured.</p>
          </div>
          <div class="crop">
            <h3>Watermarked and logged from the first render</h3>
            <p>Every render is watermarked and logged, from the first output, not added later. The watermark is AudioSeal. Output includes a manifest a game engine can consume: this is built for a pipeline, not a demo button. 114 automated checks guard the rules the project learned the hard way: never accept a user&rsquo;s audio; watermark from the first render; store timbre, not performance; do not start the next stage until this one is measured.</p>
          </div>
        </div>
      </section>

      <!-- Row G: what is not there yet, as blank positions on the sheet -->
      <section class="row" id="blank" data-row="blank" aria-labelledby="h-blank">
        <h2 class="row-h" id="h-blank"><span class="row-l" aria-hidden="true">G</span>Not there yet: eight positions on this sheet are still blank</h2>
        <p class="row-intro">Stated plainly, because it is the most useful part of the page.</p>
        <ul class="grid blanks">
          <li class="blank-pos"><strong>Not a product.</strong> This is a working research system, not a product. There is no signup, no hosted service, no API.</li>
          <li class="blank-pos"><strong>Emotion is not solved.</strong> Emotional performance direction is not solved. You can control pacing within a measured range. You cannot yet say &ldquo;say this line apologetically&rdquo; and have it work. That was tested thoroughly and does not work on the current engine, for reasons the project documented and reported upstream. The engine&rsquo;s documented emotion tags turn out not to be recognised by the engine at all, and a listener heard no difference between four tagged versions of the same line.</li>
          <li class="blank-pos"><strong>The catalogue is small.</strong> Tens of distinct voices per language so far, not hundreds: about 22 in Hindi and 41 in English by the project&rsquo;s own measure. The limit is understood and measured rather than mysterious: the real speakers the system learned from hold about 38 to 48 distinguishable voices, and the project measured exactly where its own method loses variety.</li>
          <li class="blank-pos"><strong>Cannot ship as a product, for licensing reasons.</strong> It cannot be shipped as a product in its current form for licensing reasons, which are documented. The Indian-language engine&rsquo;s training chain includes data licensed for non-commercial use, so no model weights and no Indian-language audio leave the repository. It is research-only today, deliberately.</li>
          <li class="blank-pos"><strong>Very little has been listened to.</strong> Most results are automatic measurements. One listener, a handful of pairs.</li>
          <li class="blank-pos"><strong>No comparison against a commercial system.</strong> None has been measured.</li>
          <li class="blank-pos"><strong>The clips on this page are English.</strong> Hindi renders exist and a native speaker has checked one, but the Indian-language engine&rsquo;s licence is research-only, so those clips do not ship, not even here.</li>
          <li class="blank-pos"><strong>Three of the five demo lines</strong> were rendered with an experimental emotion setting whose effect has not been validated on this engine. They are stamped on the strip above. Listen to them as voice samples, not performances.</li>
        </ul>
      </section>

      <!-- Row H: the printer's imprint -->
      <footer class="row imprint" id="imprint" data-row="imprint">
        <p class="row-h"><span class="row-l" aria-hidden="true">H</span>Here is what we built, here is what we measured, here is what is missing.</p>
