<script>
  document.body.classList.remove('no-js');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const TAU = Math.PI * 2;
  const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
  const C = { skin: css('--skin'), ink: css('--ink'), syahi: css('--syahi'), iron: css('--iron'), leather: css('--leather') };
  const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
  const SYAHI = hex(C.syahi), SKIN = hex(C.skin);
  const rgba = (c: number[], a: number) => `rgba(${c[0]},${c[1]},${c[2]},${a})`;

  /* ---- 1. the strip follows the reader ---- */
  const bolItems = Array.from(document.querySelectorAll<HTMLElement>('.bols li[data-for]'));
  const where = document.getElementById('where')!;
  const sam = document.getElementById('sam')!;
  let ticking = false;
  function updateStrip() {
    ticking = false;
    const line = innerHeight * 0.38;
    let current = 'dha';
    for (const li of bolItems) {
      const el = document.getElementById(li.dataset.for!);
      if (el && el.getBoundingClientRect().top <= line) current = li.dataset.for!;
    }
    if (sam.getBoundingClientRect().top <= line || innerHeight + scrollY >= document.documentElement.scrollHeight - 2) current = 'dha';
    for (const li of bolItems) {
      const on = li.dataset.for === current;
      li.classList.toggle('is-current', on);
      const a = li.querySelector('a')!;
      if (on) { a.setAttribute('aria-current', 'location'); where.textContent = a.title; } else a.removeAttribute('aria-current');
    }
  }
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(updateStrip); } }, { passive: true });
  addEventListener('resize', updateStrip);
  updateStrip();

  /* ---- 2. analysis: fetch, decode, windowed FFT on a log-frequency axis ---- */
  const SR = 16000, N = 1024, HOP = 128, FMIN = 60, FMAX = 8000, FLOOR = 52;
  type Analysis = { frames: number; B: number; mag: Float32Array; duration: number };
  function makeFFT(n: number) {
    const cos = new Float32Array(n / 2), sin = new Float32Array(n / 2), rev = new Uint32Array(n), bits = Math.log2(n);
    for (let i = 0; i < n / 2; i++) { cos[i] = Math.cos((TAU * i) / n); sin[i] = Math.sin((TAU * i) / n); }
    for (let i = 0; i < n; i++) { let r = 0; for (let b = 0; b < bits; b++) r = (r << 1) | ((i >> b) & 1); rev[i] = r; }
    return (re: Float32Array, im: Float32Array) => {
      for (let i = 0; i < n; i++) { const j = rev[i]; if (j > i) { let t = re[i]; re[i] = re[j]; re[j] = t; t = im[i]; im[i] = im[j]; im[j] = t; } }
      for (let size = 2; size <= n; size <<= 1) {
        const half = size >> 1, step = n / size;
        for (let start = 0; start < n; start += size) for (let k = 0; k < half; k++) {
          const c = cos[k * step], s = -sin[k * step], i = start + k, j = i + half;
          const tr = re[j] * c - im[j] * s, ti = re[j] * s + im[j] * c;
          re[j] = re[i] - tr; im[j] = im[i] - ti; re[i] += tr; im[i] += ti;
        }
      }
    };
  }
  const fft = makeFFT(N);
  const hann = new Float32Array(N);
  for (let i = 0; i < N; i++) hann[i] = 0.5 - 0.5 * Math.cos((TAU * i) / (N - 1));
  const cache = new Map<string, Promise<Analysis>>();
  function analyse(src: string): Promise<Analysis> {
    let p = cache.get(src);
    if (p) return p;
    p = (async () => {
      const buf = await (await fetch(src)).arrayBuffer();
      const ab = await new OfflineAudioContext(1, 1, SR).decodeAudioData(buf);
      const x = new Float32Array(ab.length);
      for (let c = 0; c < ab.numberOfChannels; c++) { const d = ab.getChannelData(c); for (let i = 0; i < x.length; i++) x[i] += d[i] / ab.numberOfChannels; }
      const frames = Math.max(1, Math.floor((x.length - N) / HOP) + 1), B = N / 2 + 1;
      const mag = new Float32Array(frames * B), re = new Float32Array(N), im = new Float32Array(N);
      let peak = -Infinity;
      for (let f = 0; f < frames; f++) {
        const off = f * HOP;
        for (let i = 0; i < N; i++) { re[i] = (x[off + i] || 0) * hann[i]; im[i] = 0; }
        fft(re, im);
        for (let k = 0; k < B; k++) { const db = 10 * Math.log10(re[k] * re[k] + im[k] * im[k] + 1e-12); mag[f * B + k] = db; if (db > peak) peak = db; }
      }
      for (let i = 0; i < mag.length; i++) { const m = (mag[i] - peak + FLOOR) / FLOOR; mag[i] = m < 0 ? 0 : m > 1 ? 1 : m; }
      return { frames, B, mag, duration: ab.duration };
    })();
    cache.set(src, p);
    return p;
  }

  /* ---- 3. the heads ---- */
  type Head = { id: string; el: HTMLElement; canvas: HTMLCanvasElement; bayan: boolean; S: number; dpr: number; base: HTMLCanvasElement | null; syahi: HTMLCanvasElement | null; a: Analysis | null; src: string; progress: number };
  const heads = new Map<string, Head>();
  for (const el of document.querySelectorAll<HTMLElement>('.drum[data-head]')) {
    heads.set(el.dataset.head!, { id: el.dataset.head!, el, canvas: el.querySelector('canvas')!, bayan: el.dataset.bayan === '1', S: 0, dpr: 1, base: null, syahi: null, a: null, src: '', progress: -1 });
  }
  // geometry, as fractions of the head radius
  const geo = (h: Head) => {
    const c = h.S / 2, R = c - 1;
    const sr = h.bayan ? 0.36 * R : 0.40 * R, off = h.bayan ? 0.17 * R : 0;
    return { c, R, sx: c - off * 0.7, sy: c - off * 0.7, sr, chaat: h.bayan ? 0.64 : 0.58 };
  };
  function drawBase(h: Head) {
    const { c, R, chaat } = geo(h), S = h.S, dpr = h.dpr;
    const cv = h.base || document.createElement('canvas'); h.base = cv;
    cv.width = S * dpr; cv.height = S * dpr;
    const g = cv.getContext('2d')!; g.setTransform(dpr, 0, 0, dpr, 0, 0); g.clearRect(0, 0, S, S);
    g.lineCap = 'round';
    // sixteen strap ends beyond the gajra
    g.strokeStyle = rgba(hex(C.leather), 0.55); g.lineWidth = Math.max(2, 0.045 * R);
    for (let i = 0; i < 16; i++) { const a = (i / 16) * TAU; g.beginPath(); g.moveTo(c + 0.93 * R * Math.cos(a), c + 0.93 * R * Math.sin(a)); g.lineTo(c + R * Math.cos(a), c + R * Math.sin(a)); g.stroke(); }
    // gajra: the braided rim
    g.fillStyle = C.leather; g.beginPath(); g.arc(c, c, 0.95 * R, 0, TAU); g.arc(c, c, 0.76 * R, 0, TAU, true); g.fill();
    const segs = 44, w = 0.045 * R;
    for (let layer = 0; layer < 2; layer++) {
      g.strokeStyle = layer ? 'rgba(20,10,4,0.55)' : 'rgba(240,222,196,0.28)'; g.lineWidth = w;
      for (let i = 0; i < segs; i++) {
        const a0 = ((i + layer * 0.5) / segs) * TAU, a1 = a0 + (layer ? -0.75 : 0.75) * (TAU / segs);
        g.beginPath(); g.moveTo(c + 0.93 * R * Math.cos(a0), c + 0.93 * R * Math.sin(a0)); g.lineTo(c + 0.78 * R * Math.cos(a1), c + 0.78 * R * Math.sin(a1)); g.stroke();
      }
    }
    // the straps crossing the gajra
    g.lineWidth = 0.05 * R;
    for (let i = 0; i < 16; i++) {
      const a = (i / 16) * TAU, x0 = c + 0.745 * R * Math.cos(a), y0 = c + 0.745 * R * Math.sin(a), x1 = c + 0.965 * R * Math.cos(a), y1 = c + 0.965 * R * Math.sin(a);
      g.strokeStyle = 'rgba(30,16,8,0.6)'; g.lineWidth = 0.05 * R + 2; g.beginPath(); g.moveTo(x0, y0); g.lineTo(x1, y1); g.stroke();
      g.strokeStyle = '#d6c7b0'; g.lineWidth = 0.05 * R; g.beginPath(); g.moveTo(x0, y0); g.lineTo(x1, y1); g.stroke();
    }
    // chaat: the outer ring of skin, then the maidan
    g.fillStyle = '#e4dccf'; g.beginPath(); g.arc(c, c, 0.765 * R, 0, TAU); g.fill();
    g.strokeStyle = rgba(hex(C.leather), 0.45); g.lineWidth = 1; g.beginPath(); g.arc(c, c, 0.765 * R, 0, TAU); g.stroke();
    g.fillStyle = C.skin; g.beginPath(); g.arc(c, c, chaat * R, 0, TAU); g.fill();
    g.strokeStyle = rgba(hex(C.leather), 0.35); g.beginPath(); g.arc(c, c, chaat * R, 0, TAU); g.stroke();
  }
  function drawSyahi(h: Head) {
    const a = h.a; if (!a) { h.syahi = null; return; }
    const { sr } = geo(h), Rs = Math.ceil(sr * h.dpr), W = Rs * 2, r0 = 0.05;
    const cv = h.syahi || document.createElement('canvas'); h.syahi = cv;
    cv.width = W; cv.height = W;
    const g = cv.getContext('2d')!, img = g.createImageData(W, W), d = img.data;
    const binHz = SR / N, lr = Math.log(FMAX / FMIN), dr = 1 / (Rs * (1 - r0)), F = a.frames;
    for (let y = 0; y < W; y++) for (let x = 0; x < W; x++) {
      const dx = x + 0.5 - Rs, dy = y + 0.5 - Rs, rr = Math.sqrt(dx * dx + dy * dy) / Rs;
      if (rr > 1) continue;
      const o = (y * W + x) * 4;
      let th = Math.atan2(dx, -dy); if (th < 0) th += TAU;
      const t = th / TAU, dt = rr > 0.02 ? 1 / (TAU * rr * Rs) : 1 / F;
      const f0 = Math.min(F - 1, Math.floor(t * F)), f1 = Math.min(F - 1, f0 + 3, Math.floor((t + dt) * F));
      const re = Math.max(0, (rr - r0) / (1 - r0));
      const fb = (FMIN * Math.exp(lr * re)) / binHz, ft = (FMIN * Math.exp(lr * (re + dr))) / binHz;
      let m = 0;
      for (let f = f0; f <= f1; f++) {
        const row = f * a.B;
        if (ft - fb >= 1) { for (let k = Math.floor(fb); k <= Math.ceil(ft) && k < a.B; k++) { const v = a.mag[row + k]; if (v > m) m = v; } }
        else { const k = Math.floor(fb), tt = fb - k, v = a.mag[row + k] * (1 - tt) + (a.mag[row + Math.min(k + 1, a.B - 1)] || 0) * tt; if (v > m) m = v; }
      }
      const paste = 1 - 0.86 * Math.pow(m, 1.5), edge = Math.min(1, (1 - rr) * Rs);
      d[o] = SYAHI[0]; d[o + 1] = SYAHI[1]; d[o + 2] = SYAHI[2]; d[o + 3] = Math.round(paste * edge * 255);
    }
    g.putImageData(img, 0, 0);
    // the layers a syahi is built in: the pitch grid, as faint rings
    g.strokeStyle = rgba(SKIN, 0.1); g.lineWidth = Math.max(1, h.dpr * 0.8);
    for (const f of [100, 200, 300, 500, 1000, 2000, 3000, 5000]) { const r = (r0 + (1 - r0) * (Math.log(f / FMIN) / lr)) * Rs; g.beginPath(); g.arc(Rs, Rs, r, 0, TAU); g.stroke(); }
  }
  let active: Head | null = null;
  function render(h: Head) {
    if (!h.base) return;
    const { sx, sy, sr } = geo(h), S = h.S, g = h.canvas.getContext('2d')!;
    g.setTransform(h.dpr, 0, 0, h.dpr, 0, 0); g.clearRect(0, 0, S, S);
    g.drawImage(h.base, 0, 0, S, S);
    const p = h.progress;
    if (h.syahi) {
      g.drawImage(h.syahi, sx - sr, sy - sr, sr * 2, sr * 2);
      if (p >= 0 && p < 1) { // the paste is still intact ahead of the stroke
        g.save(); g.beginPath(); g.moveTo(sx, sy); g.arc(sx, sy, sr + 2, -Math.PI / 2 + TAU * p, -Math.PI / 2 + TAU); g.closePath(); g.clip();
        g.fillStyle = C.syahi; g.beginPath(); g.arc(sx, sy, sr, 0, TAU); g.fill(); g.restore();
      }
    } else { g.fillStyle = C.syahi; g.beginPath(); g.arc(sx, sy, sr, 0, TAU); g.fill(); }
    // time marks, half a second apart, around the syahi
    const dur = h.a?.duration || Number(h.el.dataset.seconds) || 0;
    g.strokeStyle = C.iron; g.lineCap = 'butt';
    for (let t = 0; t < dur; t += 0.5) {
      const a = (t / dur) * TAU - Math.PI / 2, whole = t % 1 === 0, r1 = sr + 5, r2 = sr + (t === 0 ? 17 : whole ? 12 : 8);
      g.lineWidth = t === 0 ? 2 : 1;
      g.beginPath(); g.moveTo(sx + r1 * Math.cos(a), sy + r1 * Math.sin(a)); g.lineTo(sx + r2 * Math.cos(a), sy + r2 * Math.sin(a)); g.stroke();
    }
    // the stroke: a spoke from the centre, skin over the paste, iron over the skin
    if (p >= 0) {
      const a = TAU * p - Math.PI / 2, ca = Math.cos(a), sa = Math.sin(a);
      g.lineCap = 'round'; g.lineWidth = 2;
      g.strokeStyle = C.skin; g.beginPath(); g.moveTo(sx, sy); g.lineTo(sx + sr * ca, sy + sr * sa); g.stroke();
      g.strokeStyle = C.iron; g.beginPath(); g.moveTo(sx + sr * ca, sy + sr * sa); g.lineTo(sx + (sr + 20) * ca, sy + (sr + 20) * sa); g.stroke();
    }
    if (h === active) renderMini(h);
  }
  function size(h: Head) {
    const S = h.el.clientWidth; if (S < 8) return;
    const dpr = Math.min(2, devicePixelRatio || 1);
    if (S === h.S && dpr === h.dpr) return;
    h.S = S; h.dpr = dpr; h.canvas.width = S * dpr; h.canvas.height = S * dpr;
    drawBase(h); drawSyahi(h); render(h);
  }
  async function put(h: Head, src: string) {
    h.src = src;
    try { const a = await analyse(src); if (h.src !== src) return; h.a = a; drawSyahi(h); render(h); }
    catch (e) { console.warn('syahi skipped for', src, e); }
  }
  const ro = new ResizeObserver(() => heads.forEach(size));
  heads.forEach((h) => { size(h); ro.observe(h.el); });

  // the small head in the strip mirrors whichever head is active
  const miniBtn = document.getElementById('mini')!, miniCv = miniBtn.querySelector('canvas')!;
  function renderMini(h: Head) {
    const dpr = Math.min(2, devicePixelRatio || 1), S = 40; miniCv.width = S * dpr; miniCv.height = S * dpr;
    const g = miniCv.getContext('2d')!; g.setTransform(dpr, 0, 0, dpr, 0, 0); g.clearRect(0, 0, S, S);
    const c = S / 2, R = c - 0.5, sr = 0.44 * R;
    g.fillStyle = C.leather; g.beginPath(); g.arc(c, c, R, 0, TAU); g.fill();
    g.fillStyle = C.skin; g.beginPath(); g.arc(c, c, 0.76 * R, 0, TAU); g.fill();
    if (h.syahi) g.drawImage(h.syahi, c - sr, c - sr, sr * 2, sr * 2); else { g.fillStyle = C.syahi; g.beginPath(); g.arc(c, c, sr, 0, TAU); g.fill(); }
    if (h.progress >= 0) { const a = TAU * h.progress - Math.PI / 2; g.strokeStyle = C.skin; g.lineWidth = 1.5; g.beginPath(); g.moveTo(c, c); g.lineTo(c + sr * Math.cos(a), c + sr * Math.sin(a)); g.stroke(); g.strokeStyle = C.iron; g.beginPath(); g.moveTo(c + sr * Math.cos(a), c + sr * Math.sin(a)); g.lineTo(c + R * 0.74 * Math.cos(a), c + R * 0.74 * Math.sin(a)); g.stroke(); }
  }

  /* ---- 4. rows, playback, the sector that fills as the voice sounds ---- */
  type Row = { key: string; el: HTMLElement; audio: HTMLAudioElement; head: Head; src: string };
  const rows = new Map<string, Row>();
  for (const el of document.querySelectorAll<HTMLElement>('.row[data-key]')) {
    rows.set(el.dataset.key!, { key: el.dataset.key!, el, audio: el.querySelector('audio')!, head: heads.get(el.dataset.head!)!, src: el.dataset.src! });
  }
  const oh = { who: document.getElementById('oh-who')!, len: document.getElementById('oh-len')!, desc: document.getElementById('oh-desc')!, words: document.getElementById('oh-words')!, note: document.getElementById('oh-note')!, btn: document.getElementById('strike-hero') as HTMLButtonElement };
  let heroRow: Row = rows.get('hero:mentor_seed')!;
  function readout(r: Row) {
    if (r.head.id !== 'hero') return;
    heroRow = r; const d = r.el.dataset;
    oh.who.textContent = d.who!; oh.len.textContent = `${Number(d.seconds).toFixed(1)} s`; oh.desc.textContent = `“${d.desc}”`; oh.words.textContent = `“${d.text}”`; oh.note.hidden = d.exp !== '1';
  }
  let playing: Row | null = null, queue: string[] = [], raf = 0;
  function clearPlaying() {
    if (!playing) return;
    playing.el.classList.remove('is-playing'); playing.head.progress = -1; render(playing.head);
    if (playing.head.id === 'hero') { oh.btn.setAttribute('aria-pressed', 'false'); oh.btn.textContent = 'Strike the head'; }
    playing = null; cancelAnimationFrame(raf);
  }
  function stopAll() { queue = []; if (playing) playing.audio.pause(); clearPlaying(); }
  function tick() {
    if (!playing) return;
    const a = playing.audio, d = a.duration || Number(playing.el.dataset.seconds) || 1;
    playing.head.progress = Math.min(1, a.currentTime / d); render(playing.head);
    if (!a.paused && !a.ended) raf = requestAnimationFrame(tick);
  }
  async function play(key: string) {
    const r = rows.get(key); if (!r) return;
    if (playing && playing !== r) { playing.audio.pause(); clearPlaying(); }
    playing = r; active = r.head; r.el.classList.add('is-playing'); readout(r);
    if (r.head.id === 'hero') { oh.btn.setAttribute('aria-pressed', 'true'); oh.btn.textContent = 'Stop'; }
    if (r.head.src !== r.src) { r.head.a = null; r.head.syahi = null; r.head.progress = -1; render(r.head); await put(r.head, r.src); if (playing !== r) return; }
    r.head.progress = 0; render(r.head);
    r.audio.currentTime = 0;
    r.audio.play().then(() => { if (!reduced) raf = requestAnimationFrame(tick); }).catch(() => clearPlaying());
  }
  function next() { const k = queue.shift(); if (k) play(k); else stopAll(); }
  rows.forEach((r) => {
    r.audio.addEventListener('ended', () => { if (playing === r) { clearPlaying(); next(); } });
    r.audio.addEventListener('pause', () => { if (playing === r && !r.audio.ended) clearPlaying(); });
    r.audio.addEventListener('timeupdate', () => { if (reduced && playing === r) { const d = r.audio.duration || 1; r.head.progress = Math.min(1, r.audio.currentTime / d); render(r.head); } });
    r.el.querySelector<HTMLButtonElement>('.strike')!.addEventListener('click', () => { if (playing === r) { stopAll(); return; } queue = []; play(r.key); });
  });
  oh.btn.addEventListener('click', () => { if (playing && playing.head.id === 'hero') stopAll(); else { queue = []; play(heroRow.key); } });
  miniBtn.addEventListener('click', () => { if (playing) stopAll(); else document.getElementById('dha')!.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth' }); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && playing) stopAll(); });
  document.querySelectorAll<HTMLButtonElement>('button[data-seq]').forEach((b) => b.addEventListener('click', () => {
    const keys = (b.dataset.seq || '').split(',').filter((k) => rows.has(k));
    if (!keys.length) return;
    stopAll();
    const h = rows.get(keys[0])!.head, box = h.el.getBoundingClientRect();
    if (box.top < 0 || box.bottom > innerHeight) h.el.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'nearest' });
    queue = keys.slice(1); play(keys[0]);
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-stop]').forEach((b) => b.addEventListener('click', stopAll));

  /* ---- 5. first paint: the three seeds on their heads, then warm the rest ---- */
  (async () => {
    if (!('OfflineAudioContext' in window)) return;
    const hero = heads.get('hero')!, bayan = heads.get('bayan')!, dayan = heads.get('dayan')!;
    active = hero;
    await put(hero, rows.get('hero:mentor_seed')!.src);
    await put(bayan, rows.get('bayan:mentor_seed')!.src);
    await put(dayan, rows.get('dayan:scout_seed')!.src);
    for (const r of rows.values()) await analyse(r.src).catch(() => {});
  })();
</script>
