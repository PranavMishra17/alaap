<script>
  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const TAU = Math.PI * 2;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const stage = $('#stage');
  const canvas = $('#disc') as HTMLCanvasElement;
  const body = document.body;
  const els = {
    title: $('#lbl-title'), desc: $('#lbl-desc'), secs: $('#lbl-secs'),
    words: $('#now-words'), char: $('#now-char'), kind: $('#now-kind'), nsecs: $('#now-secs'), ndesc: $('#now-desc'), note: $('#now-note'),
    needle: $('#needle') as HTMLButtonElement, strip: $('#strip-words'),
  };

  interface Rec { id: string; text: string; secs: string; char: string; desc: string; kind: string; exp: boolean; audio: HTMLAudioElement; row: HTMLElement | null }
  const records = new Map<string, Rec>();
  for (const b of document.querySelectorAll<HTMLButtonElement>('.put')) {
    const d = b.dataset;
    const audio = document.getElementById('a-' + d.id) as HTMLAudioElement;
    const rec: Rec = { id: d.id!, text: d.text!, secs: d.secs!, char: d.char!, desc: d.desc!, kind: d.kind!, exp: d.exp === '1', audio, row: b.closest('.rec') };
    records.set(rec.id, rec);
    b.addEventListener('click', () => play(rec));
    audio.addEventListener('ended', () => onEnded(rec));
    audio.addEventListener('error', () => { if (current === rec) stop(); });
  }

  // Tonearm geometry, in units of the stage width. Pivot at (0.92, 0.08); arm length 0.5;
  // the arm at rotate(0) points straight down, and 45deg aims it at the disc centre.
  const A0 = 45, D = 0.594, L = 0.5, R_OUT = 0.463, R_IN = 0.216, REST = -14;
  const armFor = (r: number) => A0 - (Math.acos(Math.max(-1, Math.min(1, (D * D + L * L - r * r) / (2 * D * L)))) * 180) / Math.PI;
  const setArm = (deg: number) => stage.style.setProperty('--arm', deg.toFixed(2) + 'deg');

  // The groove: RMS envelope of the actual clip, decoded in the browser.
  const envCache = new Map<string, Promise<Float32Array | null>>();
  function envelope(src: string) {
    let p = envCache.get(src);
    if (p) return p;
    p = (async () => {
      try {
        const buf = await (await fetch(src)).arrayBuffer();
        const ab = await new OfflineAudioContext(1, 1, 44100).decodeAudioData(buf);
        const ch = ab.getChannelData(0);
        const N = 1400, out = new Float32Array(N), step = Math.max(1, Math.floor(ch.length / N));
        let max = 0;
        for (let i = 0; i < N; i++) {
          let s = 0; const a = i * step;
          for (let j = a; j < a + step && j < ch.length; j++) s += ch[j] * ch[j];
          out[i] = Math.sqrt(s / step); if (out[i] > max) max = out[i];
        }
        for (let i = 0; i < N; i++) out[i] = Math.pow(out[i] / (max || 1), 0.6);
        return out;
      } catch { return null; }
    })();
    envCache.set(src, p);
    return p;
  }

  let lastEnv: Float32Array | null = null;
  function spiral(g: CanvasRenderingContext2D, c: number, r0: number, r1: number, turns: number, from: number) {
    const n = Math.ceil(turns * 120);
    g.beginPath();
    for (let i = 0; i <= n; i++) {
      const t = i / n, th = from + t * turns * TAU, r = r0 + (r1 - r0) * t;
      const x = c + r * Math.cos(th), y = c + r * Math.sin(th);
      i ? g.lineTo(x, y) : g.moveTo(x, y);
    }
    g.stroke();
  }
  function drawDisc(env: Float32Array | null) {
    lastEnv = env;
    const size = canvas.clientWidth; if (size < 8) return; // a collapsed layout mid-resize gives a 1px canvas
    const dpr = Math.min(3, Math.max(2, devicePixelRatio || 1));
    canvas.width = size * dpr; canvas.height = size * dpr;
    const g = canvas.getContext('2d')!; g.setTransform(dpr, 0, 0, dpr, 0, 0);
    const c = size / 2, R = c - 1;
    g.clearRect(0, 0, size, size);
    g.fillStyle = '#171211'; g.beginPath(); g.arc(c, c, R, 0, TAU); g.fill();
    const rL = size * 0.215, rStart = R * 0.962, rEnd = rL * 1.09;
    const turns = 38, segs = 200, total = turns * segs, buckets = 12;
    const paths = Array.from({ length: buckets }, () => new Path2D());
    let px = c + rStart, py = c;
    for (let i = 1; i <= total; i++) {
      const t = i / total, th = t * turns * TAU, r = rStart - (rStart - rEnd) * t;
      const x = c + r * Math.cos(th), y = c + r * Math.sin(th);
      const e = env ? env[Math.min(env.length - 1, Math.floor(t * env.length))] : 0.28;
      const b = Math.min(buckets - 1, Math.floor(e * buckets));
      paths[b].moveTo(px, py); paths[b].lineTo(x, y); px = x; py = y;
    }
    g.lineCap = 'round';
    for (let b = 0; b < buckets; b++) {
      const e = (b + 0.5) / buckets;
      g.strokeStyle = `rgba(206,197,182,${(0.07 + e * 0.46).toFixed(3)})`; g.lineWidth = 0.5 + e * 1.15; g.stroke(paths[b]);
    }
    g.strokeStyle = 'rgba(206,197,182,0.2)'; g.lineWidth = 0.6;
    spiral(g, c, R * 0.985, rStart, 1.5, -1.5 * TAU);
    spiral(g, c, rEnd, rL * 1.03, 1.5, turns * TAU);
    g.strokeStyle = 'rgba(201,162,78,0.5)'; g.lineWidth = 1; g.beginPath(); g.arc(c, c, R - 0.5, 0, TAU); g.stroke();
  }
  new ResizeObserver(() => drawDisc(lastEnv)).observe(canvas);

  // Turntable state.
  let current: Rec | null = null;
  let queue: Rec[] = [];
  let playing = false;
  let rot = 0, speed = 0, target = 0, last = performance.now(), raf = 0;
  const wait = () => (reduce.matches ? 0 : 900);

  function load(rec: Rec) {
    if (current && current !== rec) { current.audio.pause(); current.audio.currentTime = 0; current.row?.classList.remove('active'); }
    current = rec;
    els.title.textContent = `“${rec.text}”`; els.title.classList.toggle('long', rec.text.length > 40);
    els.desc.textContent = rec.desc; els.secs.textContent = `${rec.secs} s`;
    els.words.textContent = `“${rec.text}”`; els.char.textContent = rec.char; els.kind.textContent = rec.kind === 'seed' ? 'seed clip' : 'line from the scene';
    els.nsecs.textContent = `${rec.secs} s`; els.ndesc.textContent = rec.desc; els.note.hidden = !rec.exp; els.strip.textContent = `“${rec.text}”`;
    rec.row?.classList.add('active');
    envelope(rec.audio.getAttribute('src')!).then((env) => { if (current === rec) drawDisc(env); });
  }
  function settle(deg: number) { stage.classList.add('settling'); setArm(deg); setTimeout(() => stage.classList.remove('settling'), wait()); }
  function tick(now: number) {
    const dt = Math.min(0.05, (now - last) / 1000); last = now;
    speed += (target - speed) * Math.min(1, dt * (target > speed ? 2.4 : 1.3));
    if (target === 0 && speed < 0.003) speed = 0;
    if (speed && !reduce.matches) { rot = (rot + speed * 360 * dt) % 360; body.style.setProperty('--rot', rot.toFixed(2) + 'deg'); }
    if (playing && current) {
      const a = current.audio, dur = a.duration || Number(current.secs);
      setArm(armFor(R_OUT + (R_IN - R_OUT) * (dur ? Math.min(1, a.currentTime / dur) : 0)));
    }
    raf = playing || speed ? requestAnimationFrame(tick) : 0;
  }
  const run = () => { if (!raf) { last = performance.now(); raf = requestAnimationFrame(tick); } };
  async function play(rec: Rec) {
    if (playing && current) { current.audio.pause(); current.audio.currentTime = 0; }
    load(rec);
    playing = false; target = 0.5; run();
    body.classList.add('playing');
    els.needle.setAttribute('aria-pressed', 'true'); els.needle.textContent = 'Lift the needle';
    settle(armFor(R_OUT));
    await new Promise((r) => setTimeout(r, wait()));
    if (current !== rec) return;
    try { await rec.audio.play(); playing = true; run(); } catch { stop(); }
  }
  function stop() {
    if (current) { current.audio.pause(); current.audio.currentTime = 0; }
    playing = false; target = 0; queue = []; run();
    body.classList.remove('playing');
    els.needle.setAttribute('aria-pressed', 'false'); els.needle.textContent = 'Lower the needle';
    settle(REST);
  }
  function onEnded(rec: Rec) {
    if (current !== rec) return;
    playing = false; target = 0; run();
    settle(REST);
    const next = queue.shift();
    if (next) { setTimeout(() => { if (!playing) play(next); }, 1100); }
    else { body.classList.remove('playing'); els.needle.setAttribute('aria-pressed', 'false'); els.needle.textContent = 'Lower the needle'; }
  }

  els.needle.addEventListener('click', () => { if (playing) stop(); else if (current) play(current); });
  $('#strip-stop').addEventListener('click', stop);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && playing) stop(); });
  const sceneBtn = $('#scene') as HTMLButtonElement;
  sceneBtn.addEventListener('click', () => {
    const ids = (sceneBtn.dataset.queue || '').split(',').map((id) => records.get(id)).filter((r): r is Rec => !!r);
    if (!ids.length) return;
    queue = ids.slice(1); play(ids[0]);
    // On a wide screen the turntable is sticky beside the catalogue; on a phone the strip at the
    // bottom carries the state, so do not yank the reader back up the page.
    if (matchMedia('(min-width: 960px)').matches) $('#stage').scrollIntoView({ block: 'nearest', behavior: reduce.matches ? 'auto' : 'smooth' });
  });

  drawDisc(null);
  load(records.get('mentor_seed')!);
</script>
