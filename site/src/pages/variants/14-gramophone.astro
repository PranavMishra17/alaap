---
// Variant 14 — gramophone. The history of the recorded voice in India as the visual world:
// a shellac disc whose grooves are the real waveform of the clip on the turntable, a paper label
// that carries the exact words, typed catalogue cards, a sleeve back, and an honest gaps register.
import { name, meaning, links, characters, clips, scene, seeds, clipCaveats } from '../../content/alaap';
const first = clips.find((c) => c.id === 'mentor_seed')!;
const descOf = (id: string) => characters.find((k) => k.id === id)!.description;
const cast = characters.map((k) => ({
  ...k,
  seed: seeds.find((s) => s.character === k.id)!,
  lines: scene.filter((l) => l.character === k.id),
}));
const sceneQueue = scene.map((l) => l.id).join(',');
const hindiLine = 'नमस्ते आप कैसे हैं आज मौसम बहुत अच्छा है';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alaap — a record of a voice nobody recorded</title>
    <meta name="description" content="Describe a character. Get a voice nobody has recorded. Keep it." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Eczar:wght@500;600;800&family=Gentium+Book+Plus:ital,wght@0,400;0,700;1,400&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <header class="top">
      <a class="mark" href="#top"><span lang="hi">{name.devanagari}</span>{name.latin}</a>
      <nav aria-label="Sections">
        <a href="#catalogue">Catalogue</a>
        <a href="#sleeve">Sleeve notes</a>
        <a href="#cut">How a voice is cut</a>
        <a href="#measured">Measured</a>
        <a href="#gaps">Not in the collection</a>
        <a href={links.repo}>Repository</a>
      </nav>
    </header>

    <main id="top">
      <section class="desk" aria-label="Turntable and catalogue">
        <div class="head">
          <p class="def"><span lang="hi">{name.devanagari}</span> / {name.latin}, <i>n.</i> — {meaning}.</p>
          <h1>Describe a character. Get a voice nobody has recorded. Keep it.</h1>
        </div>
        <div class="stage-col">
          <div class="stage" id="stage" style="--arm:-14deg">
            <div class="platter" id="platter">
              <canvas id="disc" aria-hidden="true"></canvas>
              <div class="label">
                <svg viewBox="0 0 200 200" aria-hidden="true">
                  <defs>
                    <path id="arc-top" d="M 22 100 A 78 78 0 0 1 178 100" />
                    <path id="arc-bot" d="M 20 100 A 80 80 0 0 0 180 100" />
                  </defs>
                  <circle cx="100" cy="100" r="100" class="lbl-paper" />
                  <circle cx="100" cy="100" r="95" class="lbl-ring" />
                  <text class="lbl-brand"><textPath href="#arc-top" startOffset="50%" text-anchor="middle"><tspan lang="hi">आलाप</tspan> · ALAAP</textPath></text>
                  <text class="lbl-foot"><textPath href="#arc-bot" startOffset="50%" text-anchor="middle">PRESSED FROM A SENTENCE · ENGLISH</textPath></text>
                  <circle cx="100" cy="100" r="3.6" class="lbl-hole" />
                </svg>
                <div class="lbl-text">
                  <p class="lbl-title" id="lbl-title">“{first.text}”</p>
                  <span class="lbl-gap" aria-hidden="true"></span>
                  <div>
                    <p class="lbl-desc" id="lbl-desc">{descOf('mentor')}</p>
                    <p class="lbl-secs" id="lbl-secs">{first.seconds} s</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="base" aria-hidden="true"></div>
            <div class="pivot" aria-hidden="true"><div class="arm"><div class="soundbox"></div></div></div>
          </div>

          <div class="now" aria-live="polite">
            <p class="eyebrow">On the turntable</p>
            <p class="now-words" id="now-words">“{first.text}”</p>
            <p class="now-meta"><span class="char" id="now-char">mentor</span> · <span id="now-kind">seed clip</span> · <span id="now-secs">{first.seconds} s</span></p>
            <p class="now-desc">described as “<span id="now-desc">{descOf('mentor')}</span>”</p>
            <p class="now-note" id="now-note" hidden>Rendered with the experimental emotion setting, unvalidated. A voice sample, not a performance.</p>
            <button type="button" class="needle" id="needle" aria-pressed="false">Lower the needle</button>
            <p class="now-plain">The seed clip is the short reference recording the system stores alongside every identity when it is minted. Nothing on this page generates a voice live: every record here was rendered in advance.</p>
          </div>
        </div>
        <div class="head-more">
          <p class="lead">On the label, where a singer's name would go, there is a sentence. That sentence is everything the voice on this turntable was made from. Nobody spoke into a horn; nobody was copied. Lower the needle and hear the seed clip that was stored with it when it was minted.</p>
          <p>You describe a character in ordinary language. You get back a voice that has never existed. Then you use that voice for any line of dialogue you write, and it stays the same character every time.</p>
          <p class="who">For people making games, animation, audio drama, dubbing, interactive fiction: anyone who needs many distinct speaking characters and cannot hire a cast for each one.</p>
        </div>

          <section id="catalogue" class="catalogue">
            <h2><span class="eyebrow">The catalogue</span>Three characters, each minted from nothing but the sentence on its card</h2>
            <p>Every clip is English, watermarked, and from the same end-to-end demo run on 2026-09-05. Put any of them on: the grooves on the disc are drawn from the actual audio of the record that is playing.</p>

            {cast.map((k) => (
              <article class="card" id={'card-' + k.id}>
                <dl class="fields">
                  <div><dt>Character</dt><dd class="char">{k.id}</dd></div>
                  <div><dt>Described as</dt><dd class="desc">“{k.description}”</dd></div>
                </dl>
                <p class="fld">Seed clip <span class="hint">stored with the identity when it was minted</span></p>
                <ul class="recs">
                  <li class="rec">
                    <button type="button" class="put" data-id={k.seed.id} data-text={k.seed.text} data-secs={k.seed.seconds} data-char={k.id} data-desc={k.description} data-kind="seed" data-exp="0" aria-label={`Put on the turntable and play: ${k.seed.text}`}><span class="glyph" aria-hidden="true"></span>Put on</button>
                    <span class="words">“{k.seed.text}”</span>
                    <span class="secs">{k.seed.seconds} s</span>
                    <audio controls preload="none" src={k.seed.src} id={'a-' + k.seed.id}></audio>
                  </li>
                </ul>
                <p class="fld">Lines in the scene</p>
                <ul class="recs">
                  {k.lines.map((l) => (
                    <li class="rec">
                      <button type="button" class="put" data-id={l.id} data-text={l.text} data-secs={l.seconds} data-char={k.id} data-desc={k.description} data-kind="line" data-exp={l.experimentalEmotionSetting ? '1' : '0'} aria-label={`Put on the turntable and play: ${l.text}`}><span class="glyph" aria-hidden="true"></span>Put on</button>
                      <span class="words">“{l.text}”</span>
                      <span class="secs">{l.seconds} s</span>
                      <span class="note">{l.experimentalEmotionSetting ? 'experimental emotion setting, unvalidated' : 'no direction given'}</span>
                      <audio controls preload="none" src={l.src} id={'a-' + l.id}></audio>
                    </li>
                  ))}
                </ul>
              </article>
            ))}

            <div class="scene">
              <p class="fld">The scene <span class="hint">five lines, three characters, in the order they were written</span></p>
              <button type="button" class="needle alt" id="scene" data-queue={sceneQueue}>Play the scene in order</button>
              <p class="hint-p">Each line is one of the records above. One character across different sentences; two characters against each other.</p>
            </div>

            <ul class="notes-on">
              <li>{clipCaveats.watermark}</li>
              <li>{clipCaveats.emotionSetting}</li>
              <li>{clipCaveats.englishOnly}</li>
            </ul>
          </section>
      </section>

      <section id="sleeve" class="sleeve">
        <div class="sleeve-box">
          <div class="sleeve-head">
            <h2><span class="eyebrow">Sleeve notes</span>What makes this a different kind of record</h2>
            <div class="cutout" aria-hidden="true"></div>
          </div>
          <div class="notes">
            <div>
              <h3>Why Indian languages</h3>
              <p>Indic is the stated reason the project exists. The tools that do this well mostly do it in English. Indian-language creators either use a handful of stock voices that everyone else is also using, or they hire actors. This project treats Hindi, Bengali and Tamil as first-class, not as an afterthought port. The Indian-language engine covers 22 Indian languages; four are measured so far: English, Hindi, Bengali, Tamil.</p>
            </div>
            <div>
              <h3>A voice is a thing you keep, not a setting you re‑guess</h3>
              <p>Most tools generate a voice each time you ask. Here the character's voice is stored as an identity and re-used. The same character sounds like the same person across every line, every scene, and every session. That consistency is measured, not hoped for.</p>
            </div>
            <div>
              <h3>Who is speaking and what is being said are genuinely separate</h3>
              <p>The system holds a character's identity apart from the words. That is why one character can say anything without their voice changing, and why changing the line never changes the person. This was verified rather than assumed: when the same audio content is played through two different identities, the words come out identically. The measured error between them was exactly zero on every line tested.</p>
            </div>
            <div>
              <h3>It does not need a recording of the character</h3>
              <p>There is no voice cloning here, and no user uploads their own audio. Voices are created from a written description. That sidesteps the consent and impersonation problem entirely: you cannot accidentally clone a real person if the system never accepts a recording.</p>
            </div>
            <div>
              <h3>It knows what it does not know</h3>
              <p>Every capability is measured against a control, and the honest limits are published alongside the results. Roughly twenty findings in this project were wrong on the first attempt and caught by a check, including one where an entire experiment produced fluent-sounding speech that was saying different words than requested, and nothing errored. That is written up publicly rather than quietly fixed.</p>
              <p class="rule-q">“A suspiciously good or suspiciously bad number is a bug report about your setup.”</p>
            </div>
          </div>
        </div>
      </section>

      <section id="cut" class="cut">
        <h2><span class="eyebrow">How a voice is cut</span>One small piece learns. Everything else is used as it comes.</h2>
        <ol class="chain">
          <li>
            <svg viewBox="0 0 64 48" aria-hidden="true"><path d="M6 20h30M6 28h22M6 36h26" /><path d="M44 12l14 12-14 12z" /></svg>
            <b>your description</b>
            <span>ordinary language, nothing else</span>
          </li>
          <li>
            <svg viewBox="0 0 64 48" aria-hidden="true"><rect x="10" y="8" width="44" height="32" rx="2" /><circle cx="22" cy="18" r="2.2" /><circle cx="32" cy="30" r="2.2" /><circle cx="42" cy="18" r="2.2" /><path d="M22 18l10 12 10-12" /></svg>
            <b>the mapper</b>
            <span>the only part that learns</span>
          </li>
          <li>
            <svg viewBox="0 0 64 48" aria-hidden="true"><circle cx="32" cy="24" r="21" /><circle cx="32" cy="24" r="14" /><circle cx="32" cy="24" r="8" class="fill" /><circle cx="32" cy="24" r="1.6" class="hole" /></svg>
            <b>a voice identity</b>
            <span>small, storable, versioned</span>
          </li>
          <li>
            <svg viewBox="0 0 64 48" aria-hidden="true"><circle cx="32" cy="24" r="16" /><circle cx="32" cy="24" r="6" /><path d="M32 40v6M16 24H8M48 24h8" /></svg>
            <b>the voice engine</b>
            <span>never modified, swappable</span>
          </li>
          <li>
            <svg viewBox="0 0 64 48" aria-hidden="true"><path d="M4 24h6l4-10 5 20 5-26 5 30 5-22 5 14 4-6h13" /></svg>
            <b>audio</b>
            <span>watermarked and logged from the first render</span>
          </li>
        </ol>
        <div class="ideas">
          <p><b>Only one small piece is trained.</b> The speech engine is used as-is and never altered, so a better engine can be swapped in without rebuilding everything.</p>
          <p><b>The voice identity is a small, storable thing.</b> That is what makes a character persistent: it can be saved, versioned and handed to someone else. Each one is stored with a short seed clip and the engine version that made it. The identity is who the character is; each line is a separate performance.</p>
          <p><b>Two ways to answer a description, both measured.</b> Invent a new voice, or find the closest match in an existing library. The numbers for the trade-off are on the cards below.</p>
          <p><b>The checker is a separate system.</b> It never sees the engine's internals: an independent check, not the system marking its own homework.</p>
        </div>
        <ul class="house">
          <li>Never accept a user's audio</li>
          <li>Watermark from the first render</li>
          <li>Store timbre, not performance</li>
          <li>Do not start the next stage until this one is measured</li>
          <li>114 automated checks guard these rules</li>
        </ul>
      </section>

      <section id="measured" class="measured-sec">
        <h2><span class="eyebrow">What was measured</span>Each card carries its result and its caveat together</h2>
        <p class="intro">Most of these are automatic measurements. Where a person listened, the card says how many.</p>
        <div class="measured">
          <article class="mcard">
            <h3>It works end to end today</h3>
            <p>On one laptop GPU, 6 GB, in English, Hindi, Bengali and Tamil. Describe a character, get a voice, render a scene of dialogue, and out comes watermarked audio plus a file a game engine can read. The demo mints three characters from text, renders a five-line scene, watermarks everything and writes the manifest in about four minutes. The records in the catalogue are that run's output.</p>
            <p class="caveat"><b>Caveat</b> A working research system, not a product. See the gaps register below.</p>
          </article>
          <article class="mcard">
            <h3>Minting a voice from a description costs nothing in clarity</h3>
            <p>A described voice is just as intelligible as one taken from a real recording. The measured difference was tiny, leaned slightly in the invented voice's favour, and was smaller than the difference between two real speakers: the gap between two real speakers was six times larger.</p>
            <p class="caveat"><b>Caveat</b> Read as no detectable difference, not as invented voices being better. The control that had to pass first: every version must come out the same length before any score is read, or the run aborts.</p>
          </article>
          <article class="mcard">
            <h3>Invented voices are recognisably distinct people</h3>
            <p>Verified by a separate speaker-recognition system that has never seen the generator. Each invented voice also sits clearly apart from the nearest real voice the system learned from, so these are new voices, not real people wearing a label.</p>
            <p class="caveat"><b>Caveat</b> An automatic measurement. Very little has been listened to.</p>
          </article>
          <article class="mcard">
            <h3>A character stays itself more consistently than a real person does</h3>
            <p>Across different sentences, a character stays itself more consistently than a real person does across different recordings, which is unsurprising once you think about it: a stored voice has no bad-throat day, no change of microphone, no mood.</p>
            <p class="caveat"><b>Caveat</b> Measured by the same separate checker; not yet confirmed by listeners.</p>
          </article>
          <article class="mcard">
            <h3>A native speaker confirmed the Hindi says what it should</h3>
            <p class="hindi" lang="hi">{hindiLine}</p>
            <p>A fluent Hindi speaker has confirmed one rendered line says this sentence. They were told the sentence and asked “does it say this?”, not “does it sound right?”. That is the check the earlier faulty audio failed. Our plain translation, not a project claim: “Hello, how are you? The weather is very nice today.”</p>
            <p class="caveat"><b>Caveat</b> Still to be checked: the other three voices and the other two lines.</p>
          </article>
          <article class="mcard">
            <h3>A blind listening test found and fixed a real problem</h3>
            <p>A blind listening test with built-in controls found a real problem in how the system judged whether two voices were the same person: pairs the system called different were heard as the same person about half the time. The threshold was raised. That removed 10 duplicate voices from a set of 50 and cost 3 percent of measured variety.</p>
            <p class="caveat"><b>Caveat</b> The test was small: 8 pairs and one listener, with every control answered correctly. It found the problem but does not settle the exact threshold, and the English threshold has not had its own listening test.</p>
          </article>
          <article class="mcard">
            <h3>Pacing is controllable within a measured range</h3>
            <p>You can slow a character to about two-thirds of normal speed or push them to about 1.4 times, and they stay the same person saying the same words. Outside that range the identity fades gradually rather than breaking.</p>
            <svg class="governor" viewBox="0 0 320 78" role="img" aria-label="Speed scale from 0.67 times to 1.43 times normal, with the listener's clean range of 0.8 to 1.25 times shaded and normal speed marked.">
              <rect x="67.9" y="30" width="165.8" height="14" class="band" />
              <line x1="20" y1="37" x2="300" y2="37" class="axis" />
              <g class="tick"><line x1="20" y1="26" x2="20" y2="48" /><line x1="67.9" y1="28" x2="67.9" y2="46" /><line x1="141.6" y1="22" x2="141.6" y2="52" /><line x1="233.7" y1="28" x2="233.7" y2="46" /><line x1="300" y1="26" x2="300" y2="48" /></g>
              <g class="tlab"><text x="20" y="66" text-anchor="middle">0.67×</text><text x="67.9" y="16" text-anchor="middle">0.8×</text><text x="141.6" y="66" text-anchor="middle">normal</text><text x="233.7" y="16" text-anchor="middle">1.25×</text><text x="300" y="66" text-anchor="middle">1.43×</text></g>
            </svg>
            <p class="caveat"><b>Caveat</b> A listener noted the slow extreme starts to sound processed; the range they called clean is narrower, about 0.8 to 1.25 times, the shaded band. The scale is drawn, not wired: nothing on this page re-times a voice.</p>
          </article>
          <article class="mcard">
            <h3>Watermarked and logged from the first render</h3>
            <p>Every render is watermarked and logged, from the first output, not added later. Output includes a manifest a game engine can consume: this is built for a pipeline, not a demo button. The manifest's own disclosure line: “AI-generated synthetic speech. All audio carries an AudioSeal watermark.”</p>
            <p class="caveat"><b>Caveat</b> The watermark is a marker of origin, not a guarantee that a voice is original. The independent checker is what says two voices are different people.</p>
          </article>
          <article class="mcard wide">
            <h3>Two ways to answer a description, and the numbers for the trade-off</h3>
            <p>Invent a new voice, or find the closest match in an existing library of voices. Inventing gives you a character nobody else has; finding gives you higher accuracy and studio quality. Neither is strictly better and the project has numbers for the trade-off.</p>
            <ul class="tradeoff">
              <li><b>Finding, on a library of 141 real Hindi voices.</b> Two thirds of descriptions (65.6%) get a voice that matches on every trait named, and 87 percent land within one step. When the description names only a couple of traits, the way people actually write, a bit over half (53.8%) match exactly on the traits named. About one in five would by chance. The same method on a library of 2,500 English voices reaches 88.5%. It replicates in Bengali within a point or two.</li>
              <li><b>Reach.</b> Finding reaches 87% of the variety the library actually holds; inventing reached 37% before two mis-set settings were fixed, and the fix raised the invented catalogue from 14 to 22 distinct Hindi voices and from 23 to 41 English.</li>
              <li><b>What finding cannot do.</b> Produce a voice the library does not contain; guarantee a new character is unique, since two descriptions can return the same voice; and the library is someone else's, so every character in every project draws from the same shelf.</li>
            </ul>
            <p class="caveat"><b>Caveat</b> The library measured was real recorded speakers standing in for a studio library, and no commercial system has been measured.</p>
          </article>
        </div>
      </section>

      <section id="gaps" class="gaps">
        <div class="gaps-inner">
          <h2><span class="eyebrow">Not in the collection</span>An archive is only as useful as its honesty about gaps</h2>
          <p class="intro">Everything below is missing, stated plainly.</p>
          <ul class="gap-list">
            <li><span class="stamp">Not held</span><h3>A product</h3><p>This is a working research system, not a product. There is no signup, no hosted service, no API.</p></li>
            <li><span class="stamp">Not held</span><h3>Emotional direction</h3><p>Emotional performance direction is not solved. You can control pacing within a measured range. You cannot yet say “say this line apologetically” and have it work. That was tested thoroughly and does not work on the current engine, for reasons the project documented and reported upstream: the engine's documented emotion tags turn out not to be recognised by the engine at all, and a listener heard no difference between tagged versions of the same line.</p></li>
            <li><span class="stamp">Not held</span><h3>A large catalogue</h3><p>Tens of distinct voices per language so far, not hundreds: about 22 in Hindi and 41 in English by the project's own measure. The limit is understood and measured rather than mysterious: the real speakers the system learned from hold about 38 to 48 distinguishable voices, and the project measured exactly where its own method loses variety.</p></li>
            <li><span class="stamp">Not held</span><h3>A licence to ship</h3><p>It cannot be shipped as a product in its current form for licensing reasons, which are documented. The Indian-language engine's training chain includes data licensed for non-commercial use, so no model weights and no Indian-language audio leave the repository. It is research-only today, deliberately.</p></li>
            <li><span class="stamp">Not held</span><h3>Much listening</h3><p>Most results are automatic measurements. One listener, a handful of pairs.</p></li>
            <li><span class="stamp">Not held</span><h3>A comparison against a commercial system</h3><p>No commercial system has been measured against this one.</p></li>
            <li><span class="stamp">Not held</span><h3>Indian-language clips on this page</h3><p>{clipCaveats.englishOnly}</p></li>
            <li><span class="stamp">Not held</span><h3>A validated emotion setting</h3><p>{clipCaveats.emotionSetting}</p></li>
          </ul>
        </div>
      </section>

      <section class="end" aria-label="Read the research">
        <div>
          <h2><span class="eyebrow">Corrections welcome</span>If a claim here is wrong, an issue with a primary source is more useful than almost anything else.</h2>
        </div>
        <div class="ctas">
          <a class="needle" href={links.repo}>Read the research</a>
          <a class="needle alt" href={links.issues}>Open an issue</a>
          <p class="fine">Research and documentation CC-BY-4.0; code MIT. No model weights and no generated Indian-language audio ship. Research pass 2026-09-02; implementation and measurement 2026-09-05.</p>
        </div>
      </section>
    </main>

    <div class="strip" id="strip">
      <span class="strip-disc" aria-hidden="true"></span>
      <span class="strip-words" id="strip-words"></span>
      <button type="button" class="strip-stop" id="strip-stop">Lift the needle</button>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --card: #DDE0D7;   /* grey-green catalogue card stock: the page ground */
    --ink: #171211;    /* shellac: the disc, the ink, the gaps register */
    --green: #1F4A3C;  /* bottle-green paper label */
    --gold: #C9A24E;   /* old-gold label type, rim, focus */
    --rule: #7E9BB0;   /* faded blue index-card rule */
    --red: #9A3B31;    /* the one red rule at the top of an index card */
    --paper: color-mix(in srgb, var(--card) 55%, white);
    --line: color-mix(in srgb, var(--ink) 28%, transparent);
    --disp: 'Eczar', 'Noto Serif Devanagari', Georgia, serif;
    --body: 'Gentium Book Plus', 'Palatino Linotype', Palatino, Georgia, serif;
    --type: 'Courier Prime', 'Courier New', Courier, monospace;
    --pad: clamp(1rem, 4vw, 3rem);
  }
  * { box-sizing: border-box; }
  html { background: var(--card); scroll-behavior: smooth; }
  body { margin: 0; background: var(--card); color: var(--ink); font: 400 17px/1.55 var(--body); -webkit-font-smoothing: antialiased; }
  h1, h2, h3 { font-family: var(--disp); font-weight: 600; line-height: 1.1; margin: 0; letter-spacing: -0.005em; }
  h1 { font-size: clamp(2.1rem, 4.4vw, 3.5rem); font-weight: 800; line-height: 1.02; margin: 0.4rem 0 1.2rem; }
  h2 { font-size: clamp(1.5rem, 2.6vw, 2.1rem); max-width: 30ch; }
  h3 { font-size: 1.22rem; }
  p { margin: 0 0 1rem; }
  a { color: var(--green); }
