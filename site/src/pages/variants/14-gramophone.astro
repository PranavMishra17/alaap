  .strip-words { flex: 1; min-width: 0; font: italic 0.95rem/1.3 var(--body); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .strip-stop { flex: none; background: transparent; color: var(--gold); border: 1.5px solid var(--gold); font: 700 0.68rem/1 var(--type); letter-spacing: 0.12em; text-transform: uppercase; padding: 0.55rem 0.7rem; border-radius: 2px; cursor: pointer; }

  @media (prefers-reduced-motion: reduce) {
