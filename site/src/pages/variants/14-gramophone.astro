  .needle { display: inline-block; background: var(--green); color: var(--card); border: 2px solid var(--green); font: 700 0.82rem/1.2 var(--type); letter-spacing: 0.12em; text-transform: uppercase; padding: 0.75rem 1.15rem; border-radius: 3px; cursor: pointer; text-decoration: none; }
  .needle:hover { background: color-mix(in srgb, var(--green) 85%, var(--ink)); border-color: color-mix(in srgb, var(--green) 85%, var(--ink)); }
