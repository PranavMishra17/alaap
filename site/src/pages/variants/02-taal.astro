<script>
  document.body.classList.remove('no-js');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---- 1. the theka follows the reader through the sixteen matras ---- */
  const cells = Array.from(document.querySelectorAll<HTMLElement>('.theka .cell'));
  const matras = Array.from(document.querySelectorAll<HTMLElement>('.matra[data-matra]'));
  const samReturn = document.querySelector<HTMLElement>('.sam-return');
  let ticking = false;
  function updateBeat() {
    ticking = false;
    const line = window.innerHeight * 0.38;
    let current = 1;
    for (const m of matras) {
      if (m.getBoundingClientRect().top <= line) current = Number(m.dataset.matra);
    }
    // the closing section, and the foot of the page, are the cycle coming back to sam
    if (samReturn && samReturn.getBoundingClientRect().top <= line) current = 1;
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) current = 1;
    for (const c of cells) {
      const on = Number(c.dataset.cell) === current;
      c.classList.toggle('is-current', on);
      const a = c.querySelector('a');
      if (a) { if (on) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current'); }
    }
  }
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(updateBeat); } }, { passive: true });
  addEventListener('resize', updateBeat);
  updateBeat();

  /* ---- 2. notation: measure each clip, draw one mark per matra ---- */
  type Cell = { f0: number | null; loud: number; sound: boolean };
  type Row = { el: HTMLElement; audio: HTMLAudioElement; canvas: HTMLCanvasElement; cells: Cell[] | null; id: string };
  const rows: Row[] = Array.from(document.querySelectorAll<HTMLElement>('.row[data-clip]')).map((el) => ({
    el, id: el.dataset.clip!, audio: el.querySelector('audio')!, canvas: el.querySelector('canvas')!, cells: null,
  }));
  const byId = new Map(rows.map((r) => [r.id, r]));
  const N = 16, FMIN = 60, FMAX = 450;
  const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();

  function analyse(buf: AudioBuffer): Cell[] {
    // downsample to ~12 kHz, then normalised autocorrelation per 512-sample frame
    const src = buf.getChannelData(0);
    const step = Math.max(1, Math.round(buf.sampleRate / 12000));
    const sr = buf.sampleRate / step;
    const x = new Float32Array(Math.floor(src.length / step));
    for (let i = 0; i < x.length; i++) { let s = 0; for (let k = 0; k < step; k++) s += src[i * step + k]; x[i] = s / step; }
    const W = 512, H = 256, lmin = Math.floor(sr / FMAX), lmax = Math.ceil(sr / FMIN);
    const frames: { t: number; rms: number; f0: number | null }[] = [];
    let maxRms = 0;
    for (let s = 0; s + W + lmax < x.length; s += H) {
      let e = 0; for (let i = 0; i < W; i++) e += x[s + i] * x[s + i];
      const rms = Math.sqrt(e / W); maxRms = Math.max(maxRms, rms);
      frames.push({ t: (s + W / 2) / sr, rms, f0: null });
    }
    frames.forEach((f, fi) => {
      if (f.rms < maxRms * 0.08) return;
      const s = fi * H; let best = 0, bestLag = 0;
      const e0 = f.rms * f.rms * W;
      const r: number[] = [];
      for (let lag = lmin; lag <= lmax; lag++) {
        let c = 0, e1 = 0;
        for (let i = 0; i < W; i++) { const b = x[s + i + lag]; c += x[s + i] * b; e1 += b * b; }
        const v = c / Math.sqrt(e0 * e1 + 1e-9); r.push(v);
        if (v > best) { best = v; bestLag = lag; }
      }
      if (best < 0.55) return;
      // prefer the shortest lag that is nearly as good, to avoid octave-down errors
      for (let lag = lmin; lag < bestLag; lag++) { if (r[lag - lmin] >= best * 0.92) { bestLag = lag; break; } }
      f.f0 = sr / bestLag;
    });
    const dur = buf.duration, cellsOut: Cell[] = [];
    for (let c = 0; c < N; c++) {
      const a = (c / N) * dur, b = ((c + 1) / N) * dur;
      const inCell = frames.filter((f) => f.t >= a && f.t < b);
      const voiced = inCell.filter((f) => f.f0).map((f) => f.f0!).sort((p, q) => p - q);
      const loud = inCell.length ? Math.max(...inCell.map((f) => f.rms)) / (maxRms || 1) : 0;
      cellsOut.push({ f0: voiced.length ? voiced[Math.floor(voiced.length / 2)] : null, loud, sound: loud > 0.08 });
    }
    return cellsOut;
  }

  function draw(row: Row, progress = -1) {
    const cv = row.canvas, dpr = Math.min(2, devicePixelRatio || 1);
    const w = cv.clientWidth || 640, h = 56;
    if (cv.width !== Math.round(w * dpr)) { cv.width = Math.round(w * dpr); cv.height = h * dpr; }
    const g = cv.getContext('2d')!; g.setTransform(dpr, 0, 0, dpr, 0, 0); g.clearRect(0, 0, w, h);
    const ink = row.el.closest('.khali') ? css('--chalk') : css('--ink');
    const brass = css('--brass'), rule = css('--rule'), soft = css('--rule-soft');
    const cw = w / N;
    for (let c = 0; c <= N; c++) {
      g.strokeStyle = c % 4 === 0 ? rule : soft; g.lineWidth = c % 4 === 0 ? 1.25 : 1;
      const x = Math.round(c * cw) + 0.5; g.beginPath(); g.moveTo(x, 4); g.lineTo(x, h - 4); g.stroke();
    }
    const cursorCell = progress >= 0 ? Math.floor(progress * N) : -1;
    for (let c = 0; c < N; c++) {
      const cell = row.cells?.[c];
      const x0 = c * cw;
      if (!cell || !cell.sound) continue;
      const struck = cursorCell >= 0 && c <= cursorCell;
      g.strokeStyle = struck ? brass : ink; g.fillStyle = g.strokeStyle;
      if (cell.f0) {
        const t = Math.min(1, Math.max(0, Math.log(cell.f0 / FMIN) / Math.log(FMAX / FMIN)));
        const y = h - 10 - t * (h - 20);
        const len = cw * (0.28 + 0.55 * Math.min(1, cell.loud));
        g.lineWidth = 3.25; g.lineCap = 'round';
        g.beginPath(); g.moveTo(x0 + (cw - len) / 2, y); g.lineTo(x0 + (cw + len) / 2, y); g.stroke();
      } else {
        g.lineWidth = 1.25; g.lineCap = 'butt';
        g.beginPath(); g.moveTo(x0 + cw * 0.3, h - 9); g.lineTo(x0 + cw * 0.7, h - 9); g.stroke();
      }
    }
    if (progress >= 0) { g.strokeStyle = brass; g.lineWidth = 2; const x = progress * w; g.beginPath(); g.moveTo(x, 2); g.lineTo(x, h - 2); g.stroke(); }
  }
  rows.forEach((r) => draw(r));
  addEventListener('resize', () => rows.forEach((r) => draw(r)));

  async function decodeAll() {
    if (!('AudioContext' in window) || (navigator as any).connection?.saveData) return;
    let ctx: AudioContext;
    try { ctx = new AudioContext(); } catch { return; }
    for (const r of rows) {
      try {
        const res = await fetch(r.audio.getAttribute('src')!);
        const buf = await ctx.decodeAudioData(await res.arrayBuffer());
        r.cells = analyse(buf);
        draw(r);
      } catch (e) { console.warn('notation skipped for', r.id, e); }
    }
    try { await ctx.close(); } catch {}
  }
  const idle = (window as any).requestIdleCallback || ((fn: () => void) => setTimeout(fn, 200));
  idle(() => { decodeAll(); });

  /* ---- 3. playback from the sheet, with a cursor that walks the matras ---- */
  let playing: Row | null = null, queue: string[] = [], raf = 0;
  function stopAll() {
    queue = [];
    if (playing) { playing.audio.pause(); playing.el.classList.remove('is-playing'); draw(playing); playing = null; }
    cancelAnimationFrame(raf);
  }
  function tick() {
    if (!playing) return;
    const a = playing.audio, d = a.duration || Number(playing.el.dataset.seconds) || 1;
    draw(playing, Math.min(1, a.currentTime / d));
    if (!a.paused && !a.ended) raf = requestAnimationFrame(tick);
  }
  function play(id: string) {
    const row = byId.get(id); if (!row) return;
    if (playing && playing !== row) { playing.audio.pause(); playing.el.classList.remove('is-playing'); draw(playing); }
    playing = row; row.el.classList.add('is-playing');
    row.audio.currentTime = 0;
    row.audio.play().then(() => { if (!reduced) raf = requestAnimationFrame(tick); }).catch(() => { row.el.classList.remove('is-playing'); playing = null; });
  }
  function next() {
    const id = queue.shift();
    if (id) play(id); else stopAll();
  }
  rows.forEach((r) => {
    r.audio.addEventListener('ended', () => { r.el.classList.remove('is-playing'); draw(r); if (playing === r) { playing = null; next(); } });
    r.audio.addEventListener('pause', () => { if (playing === r && !r.audio.ended) { r.el.classList.remove('is-playing'); draw(r); playing = null; cancelAnimationFrame(raf); } });
    // reduced motion: no swept cursor; the struck marks advance one matra at a time
    r.audio.addEventListener('timeupdate', () => {
      if (!reduced || playing !== r) return;
      const d = r.audio.duration || Number(r.el.dataset.seconds) || 1;
      draw(r, Math.min(1, Math.floor((r.audio.currentTime / d) * N) / N));
    });
    r.el.querySelector<HTMLButtonElement>('.play')!.addEventListener('click', () => {
      if (playing === r) { stopAll(); return; }
      queue = []; play(r.id);
    });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-seq]').forEach((b) => {
    b.addEventListener('click', () => {
      const ids = (b.dataset.seq || '').split(',').filter(Boolean);
      stopAll();
      const first = byId.get(ids[0]);
      if (first && !first.el.closest('.sheet')?.getBoundingClientRect().height) return;
      const sheet = first?.el.closest('.sheet') as HTMLElement | null;
      if (sheet && (sheet.getBoundingClientRect().top < 0 || sheet.getBoundingClientRect().bottom > innerHeight)) {
        sheet.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
      }
      queue = ids.slice(1); play(ids[0]);
    });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-stop]').forEach((b) => b.addEventListener('click', stopAll));
</script>
