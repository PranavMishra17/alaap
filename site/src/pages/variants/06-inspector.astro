    const n = Math.max(40, Math.floor(w / bar)); const pk = peaks(data, n); const bw = w / n;
    let peak = 0; for (const [mn, mx] of pk) peak = Math.max(peak, mx, -mn); const k = peak > 0 ? 0.92 / peak : 1;
    for (let i = 0; i < n; i++) {
      const [mn, mx] = pk[i]; const y1 = mid - mx * mid * k, y2 = mid - mn * mid * k;
      g.fillStyle = played && i / n < progress ? GENDA : INK;
      g.fillRect(i * bw + 0.5, y1, Math.max(1, bw - 1.3), Math.max(1.2, y2 - y1));
    }
    if (played && progress > 0) { g.fillStyle = GENDA; g.fillRect(progress * w - 1, 0, 2, h); }
  }
  async function drawViewport(progress = 0) {
    if (!current) return;
    const src = current.dataset.audio!;
    const data = await load(src);
    if (current?.dataset.audio !== src) return;
    draw(wave, data, progress, 4);
    if (!data && !vpMeta.textContent!.includes('waveform')) vpMeta.textContent += ' · waveform unavailable in this browser';
  }
  function fmt(s: number) { return (Math.round(s * 10) / 10).toFixed(1) + ' s'; }
  function tick() {
    if (!audio || audio.paused) return;
    const p = audio.duration ? audio.currentTime / audio.duration : 0;
    drawViewport(p); vpTime.textContent = fmt(audio.currentTime) + ' / ' + fmt(audio.duration || 0);
    raf = requestAnimationFrame(tick);
  }

  function select(id: string, opts: { scroll?: boolean } = {}) {
    const next = insps.find((a) => a.dataset.obj === id); if (!next) return;
    if (audio && !audio.paused && current !== next) stopAudio();
    current = next;
    for (const a of insps) a.classList.toggle('is-selected', a === next);
    for (const b of $$('[data-select][aria-pressed]')) b.setAttribute('aria-pressed', String(b.dataset.select === id));
    audio = next.querySelector('audio');
    vpWords.textContent = next.dataset.words || ''; vpMeta.textContent = next.dataset.meta || ''; vpTime.textContent = '';
    vpPlay.innerHTML = '<span class="glyph">▶</span> Play clip';
    drawViewport(0);
    if (opts.scroll) $('#editor')!.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
  }
  function stopAudio() {
    if (audio) { audio.pause(); audio.currentTime = 0; }
    cancelAnimationFrame(raf); vpPlay.innerHTML = '<span class="glyph">▶</span> Play clip'; vpTime.textContent = ''; drawViewport(0);
  }
  async function playCurrent() {
    if (!audio || !current) return;
    try { await audio.play(); } catch { setStatus('blocked: press play again'); return; }
    vpPlay.innerHTML = '<span class="glyph">❚❚</span> Pause';
    log('playing', ` ${current.dataset.char}: “${current.dataset.words}”`);
    cancelAnimationFrame(raf); raf = requestAnimationFrame(tick);
  }
  vpPlay.addEventListener('click', () => {
    if (!audio) return;
    if (audio.paused) { sceneOn = false; setStatus('playing · ' + current!.dataset.char, true); playCurrent(); }
    else { audio.pause(); cancelAnimationFrame(raf); vpPlay.innerHTML = '<span class="glyph">▶</span> Resume'; setStatus('paused'); }
  });
  for (const a of $$('audio')) a.addEventListener('ended', () => {
    cancelAnimationFrame(raf); drawViewport(1); vpPlay.innerHTML = '<span class="glyph">▶</span> Play clip';
    if (sceneOn) { sceneIdx++; playScene(); } else setStatus('idle');
  });

  function playScene() {
    if (sceneIdx >= sceneIds.length) { sceneOn = false; setStatus('scene finished'); log('finished', ' the five-line scene, three characters, one identity each'); return; }
    if (sceneIdx === 0) log('play', ' the scene, line by line, in the order the manifest lists');
    select(sceneIds[sceneIdx]);
    setStatus('playing · ' + current!.dataset.char, true);
    playCurrent();
  }
  $('#play-scene')!.addEventListener('click', () => { stopAudio(); sceneOn = true; sceneIdx = 0; playScene(); });
  $('#stop-scene')!.addEventListener('click', () => { sceneOn = false; stopAudio(); setStatus('idle'); log('stopped', ' playback'); });

  for (const b of $$('[data-select]')) b.addEventListener('click', () => {
    sceneOn = false; select(b.dataset.select!, { scroll: b.hasAttribute('data-scroll') });
    if (!b.hasAttribute('aria-pressed') && !b.hasAttribute('data-scroll')) $('.inspector')!.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'nearest' });
  });

  // Replay the minting: type the description back in, then play the seed the system returned. Nothing is generated.
  for (const btn of $$('.mint-btn')) btn.addEventListener('click', async () => {
    const art = btn.closest('.insp') as HTMLElement; const field = art.querySelector('.desc-field') as HTMLElement;
    const text = field.dataset.text || ''; select(art.dataset.obj!); sceneOn = false;
    log('replaying', ` the minting of ${art.dataset.char}: description typed back in, pre-rendered seed from 2026-09-05 plays. Nothing generated live.`);
    setStatus('replaying · ' + art.dataset.char, true); btn.disabled = true;
    if (reduced) { field.textContent = `“${text}”`; }
    else {
      field.textContent = '“';
      for (let i = 1; i <= text.length; i++) { field.textContent = '“' + text.slice(0, i); await new Promise((r) => setTimeout(r, 28)); }
      field.textContent = `“${text}”`;
    }
    btn.disabled = false; await playCurrent();
  });

  // Asset tiles: the seed clips' own waveforms, decoded in the browser.
  async function drawMinis() {
    for (const c of $$('canvas.mini') as HTMLCanvasElement[]) { const d = await load(c.dataset.src!); draw(c, d, 0, 3, false); }
  }
  let rt = 0;
  const redraw = () => { clearTimeout(rt); rt = window.setTimeout(() => { drawViewport(audio && !audio.paused ? audio.currentTime / audio.duration : 0); drawMinis(); }, 80); };
  window.addEventListener('resize', redraw);
  if ('ResizeObserver' in window) new ResizeObserver(redraw).observe($('#wavebox')!);

  select('voice:mentor');
  drawMinis();
</script>
