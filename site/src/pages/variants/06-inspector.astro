---
// Variant 06 — "inspector". Lens: inside the game engine. One editor window, designed as an object.
import { name, meaning, links, characters, scene, seeds, clipCaveats, languages } from '../../content/alaap';

const voices = characters.map((ch) => ({
  id: `voice:${ch.id}`,
  char: ch.id,
  description: ch.description,
  seed: seeds.find((s) => s.character === ch.id)!,
  lines: scene.filter((l) => l.character === ch.id),
}));
const fonts =
  'https://fonts.googleapis.com/css2?family=Anek+Devanagari:wdth,wght@75..125,100..800&family=Anek+Latin:wdth,wght@75..125,100..800&family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap';
const short = (t: string, n = 34) => (t.length > n ? t.slice(0, n - 1).trimEnd() + '…' : t);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alaap — voice editor</title>
    <meta name="description" content="Describe a character. Get a voice nobody has recorded. Keep it." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <div class="win">
      <header class="titlebar">
        <p class="brand"><span class="latin">{name.latin}</span> <span lang="hi" class="deva">{name.devanagari}</span> <span class="app">voice editor</span></p>
        <p class="tagline">Describe a character. Get a voice nobody has recorded. Keep it.</p>
        <a class="repo" href={links.repo}>github.com/PranavMishra17/alaap ↗</a>
      </header>

      <nav class="toolbar" aria-label="Sections and transport">
        <ul class="menu">
          <li><a href="#editor">Scene</a></li>
          <li><a href="#readme">Readme</a></li>
          <li><a href="#properties">Properties</a></li>
          <li><a href="#graph">Graph</a></li>
          <li><a href="#measured">Measured</a></li>
          <li><a href="#notyet">Not there yet</a></li>
        </ul>
        <div class="transport js-only">
          <button type="button" id="play-scene" class="tb play"><span class="glyph">▶</span> Play scene</button>
          <button type="button" id="stop-scene" class="tb"><span class="glyph">■</span> Stop</button>
          <output id="status" class="status" aria-live="polite">idle</output>
        </div>
      </nav>

      <main>
        <div class="editor" id="editor">
          <!-- Hierarchy -->
          <section class="panel hier" aria-labelledby="hier-t">
            <h2 class="tab" id="hier-t">Hierarchy</h2>
            <div class="tree">
              <p class="group">Scene <span class="dim">· five lines</span></p>
              <ul class="branch">
                {scene.map((l) => (
                  <li>
                    <button type="button" class="row" data-select={l.id} data-line aria-pressed="false">
                      <span class="guide" aria-hidden="true"></span>
                      <span class="who">{l.character}</span>
                      <span class="what">{short(l.text)}</span>
                      {l.experimentalEmotionSetting && <span class="flag" role="img" aria-label="experimental emotion setting, unvalidated"></span>}
                    </button>
                  </li>
                ))}
              </ul>
              <p class="group">Voices <span class="dim">· three, minted from text</span></p>
              <ul class="branch">
                {voices.map((v) => (
                  <li>
                    <button type="button" class="row" data-select={v.id} aria-pressed="false">
                      <span class="guide" aria-hidden="true"></span>
                      <span class="who">{v.char}</span>
                      <span class="what">voice identity · seed {v.seed.seconds} s</span>
                    </button>
                  </li>
                ))}
              </ul>
              <p class="legend"><span class="flag" aria-hidden="true"></span> rendered with an experimental emotion setting, unvalidated</p>
            </div>
          </section>

          <!-- Viewport -->
          <section class="panel viewport" aria-labelledby="vp-t">
            <div class="tab-row">
              <h2 class="tab" id="vp-t">Viewport</h2>
              <div class="vp-tools js-only">
                <button type="button" id="vp-play" class="tb play"><span class="glyph">▶</span> Play clip</button>
                <span id="vp-time" class="mono dim"></span>
              </div>
            </div>
            <div class="stage">
              <div class="wavebox" id="wavebox"><canvas id="wave" width="800" height="200" aria-hidden="true"></canvas></div>
              <p class="vp-words" id="vp-words">This is how I sound when I speak.</p>
              <p class="vp-meta mono" id="vp-meta">mentor · voice identity · seed clip · 2.2 s · mentor_seed.mp3</p>
              <p class="vp-hint dim js-only">The waveform is the clip itself, decoded in your browser.</p>
            </div>
            <ul class="notes">
              <li>{clipCaveats.watermark}</li>
              <li>{clipCaveats.englishOnly}</li>
              <li>{clipCaveats.emotionSetting}</li>
            </ul>
          </section>

          <!-- Inspector -->
          <section class="panel inspector" aria-labelledby="insp-t">
            <h2 class="tab" id="insp-t">Inspector</h2>
            <div class="insp-scroll">
              {voices.map((v) => (
                <article class="insp" data-obj={v.id} data-kind="voice" data-char={v.char} data-audio={v.seed.src}
                  data-words={v.seed.text} data-meta={`${v.char} · voice identity · seed clip · ${v.seed.seconds} s · ${v.seed.src.split('/').pop()}`}>
                  <h3 class="obj"><span class="who">{v.char}</span> <span class="dim">voice identity</span></h3>
                  <dl class="props">
                    <dt>Minted from</dt>
                    <dd class="desc-field" data-text={v.description}>“{v.description}”</dd>
                    <dt>Recording used</dt>
                    <dd>None. Nothing was uploaded; the system never accepts a recording.</dd>
                    <dt>Stored with</dt>
                    <dd>This seed clip and the version of the engine that made it, so the character can be saved, versioned and handed on.</dd>
                    <dt>Engine</dt>
                    <dd>Qwen3-TTS, Apache-2.0 · never modified, swappable</dd>
                    <dt>Lines in scene</dt>
                    <dd>
                      {v.lines.map((l) => (
                        <button type="button" class="link" data-select={l.id}>“{short(l.text, 40)}”</button>
                      ))}
                    </dd>
                    <dt>Watermark</dt>
                    <dd>AudioSeal, from the first render · logged as AI-generated speech</dd>
                  </dl>
                  <figure class="player">
                    <figcaption>Seed clip says: “{v.seed.text}” <span class="mono dim">{v.seed.seconds} s</span></figcaption>
                    <audio controls preload="none" src={v.seed.src}></audio>
                  </figure>
                  <div class="mint">
                    <button type="button" class="tb mint-btn js-only" data-char={v.char}>Replay the minting</button>
                    <p class="mint-note js-only">Replays, does not generate: the description is typed back in and the seed the system returned on 2026-09-05 plays. Nothing on this page renders a voice live.</p>
                  </div>
                </article>
              ))}
              {scene.map((l) => (
                <article class="insp" data-obj={l.id} data-kind="line" data-char={l.character} data-audio={l.src}
                  data-words={l.text} data-meta={`${l.character} · scene line · ${l.seconds} s · ${l.src.split('/').pop()}`}>
                  <h3 class="obj"><span class="mono">{l.src.split('/').pop()}</span> <span class="dim">scene line</span></h3>
                  <dl class="props">
                    <dt>Character</dt>
                    <dd><button type="button" class="link" data-select={`voice:${l.character}`}>{l.character}</button> <span class="dim">— same identity on every line</span></dd>
                    <dt>Says</dt>
                    <dd>“{l.text}”</dd>
                    <dt>Length</dt>
                    <dd class="mono">{l.seconds} s</dd>
                    <dt>Direction</dt>
                    <dd>{l.experimentalEmotionSetting ? <span><span class="flag" aria-hidden="true"></span> experimental emotion setting, not validated on this engine. A voice sample, not a performance.</span> : 'none'}</dd>
                    <dt>Language</dt>
                    <dd>English</dd>
                    <dt>Watermark</dt>
                    <dd>AudioSeal · logged as AI-generated speech</dd>
                  </dl>
                  <figure class="player">
                    <figcaption>“{l.text}” <span class="mono dim">{l.seconds} s</span></figcaption>
                    <audio controls preload="none" src={l.src}></audio>
                  </figure>
                </article>
              ))}
            </div>
          </section>

          <!-- Dock -->
          <div class="dock">
            <section class="panel assets" aria-labelledby="as-t">
              <h2 class="tab" id="as-t">Voice assets</h2>
              <div class="tiles">
                {voices.map((v) => (
                  <button type="button" class="tile" data-select={v.id} aria-pressed="false">
                    <span class="tile-name">{v.char}</span>
                    <canvas class="mini" data-src={v.seed.src} width="200" height="40" aria-hidden="true"></canvas>
                    <span class="tile-desc">“{v.description}”</span>
                    <span class="tile-meta mono">seed {v.seed.seconds} s · {v.lines.length === 1 ? 'one line' : 'two lines'} in scene</span>
                  </button>
                ))}
              </div>
            </section>

            <section class="panel log" aria-labelledby="log-t">
              <h2 class="tab" id="log-t">Render log <span class="dim">· 2026-09-05</span></h2>
              <ol class="loglist" id="log-list">
                <li><b>minted</b> mentor from “a very deep voice, very rough and gravelly, speaking very slowly”</li>
                <li><b>minted</b> scout from “a high voice, crisp-toned, speaking quickly and highly animated”</li>
                <li><b>minted</b> innkeeper from “a mid-range voice, warm-toned, at a steady pace”</li>
                <li><b>rendered</b> five lines of dialogue, three characters</li>
                <li><b>watermarked</b> every clip with AudioSeal, logged as AI-generated speech</li>
                <li><b>wrote</b> manifest.json for the game engine</li>
                <li><b>done</b> in about four minutes on one laptop GPU (6 GB)</li>
              </ol>
            </section>

            <section class="panel manifest" aria-labelledby="mf-t">
              <h2 class="tab" id="mf-t">Manifest <span class="dim">· what the engine reads</span></h2>
              <dl class="mf">
                <dt>disclosure</dt><dd>“AI-generated synthetic speech. All audio carries an AudioSeal watermark.”</dd>
                <dt>engine</dt><dd>Qwen3-TTS · Apache-2.0</dd>
                <dt>rendered</dt><dd>2026-09-05 · one laptop GPU · about four minutes</dd>
                <dt>language</dt><dd>English</dd>
                <dt>characters</dt><dd>{characters.map((c) => c.id).join(' · ')}</dd>
                <dt>scene</dt><dd>{scene.map((l) => l.src.split('/').pop()).join(' · ')}</dd>
                <dt>direction</dt><dd>experimental emotion setting on three of the five lines, unvalidated; none on the rest</dd>
              </dl>
              <p class="cap dim">Abridged from the demo’s manifest.json, keys put in plain words.</p>
            </section>
          </div>
        </div>

        <!-- Readme -->
        <section class="panel doc" id="readme" aria-labelledby="rd-t">
          <h2 class="tab" id="rd-t">Readme</h2>
          <div class="doc-body readme">
            <p class="h1"><span class="latin">{name.latin}</span> <span lang="hi" class="deva">{name.devanagari}</span></p>
            <p class="meaning">{meaning}. A voice mapping out its own possibility space. That is exactly what description-to-voice design does.</p>
            <div class="cols">
              <div>
                <h3>What it is</h3>
                <p>You describe a character in ordinary language. You get back a voice that has never existed. Then you use that voice for any line of dialogue you write, and it stays the same character every time.</p>
                <p class="example"><span class="mono dim">the example</span> “a very deep voice, very rough and gravelly, speaking very slowly” → a voice nobody has recorded → say anything you like, in Hindi or English. <button type="button" class="link js-only" data-select="voice:mentor" data-scroll>Hear it: select mentor</button></p>
                <h3>Who it is for</h3>
                <p>People making games, animation, audio drama, dubbing, interactive fiction: anyone who needs many distinct speaking characters and cannot hire a cast for each one.</p>
              </div>
              <div>
                <h3>Why Indian languages</h3>
                <p>The tools that do this well mostly do it in English. Indian-language creators either use a handful of stock voices that everyone else is also using, or they hire actors. This project treats Hindi, Bengali and Tamil as first-class, not as an afterthought port.</p>
                <p>Measured so far in {languages.join(', ')}. The Indian-language engine covers 22 Indian languages; four measured so far. It works end to end today on one laptop GPU.</p>
                <h3>Rules the project keeps</h3>
                <ul class="rules">
                  <li>never accept a user’s audio</li>
                  <li>watermark from the first render</li>
                  <li>store timbre, not performance: the identity is who the character is, each line is a separate performance</li>
                  <li>do not start the next stage until this one is measured</li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <!-- Properties (§4) -->
        <section class="panel doc" id="properties" aria-labelledby="pr-t">
          <h2 class="tab" id="pr-t">Properties <span class="dim">· of a voice identity, all four measured</span></h2>
          <div class="doc-body">
            <div class="pgrid head" aria-hidden="true"><span>property</span><span>value</span><span>how we know</span></div>
            <div class="pgrid">
              <h3>Kept, not re-guessed</h3>
              <p>Most tools generate a voice each time you ask. Here the character’s voice is stored as an identity and re-used. The same character sounds like the same person across every line, every scene, and every session. That consistency is measured, not hoped for.</p>
              <p class="how">Every identity stores the voice, a short seed clip and the engine version that made it. Consistency across sentences was measured, and beat a real person across recordings.</p>
            </div>
            <div class="pgrid">
              <h3>Who is speaking is separate from what is said</h3>
              <p>The system holds a character’s identity apart from the words. One character can say anything without the voice changing, and changing the line never changes the person.</p>
              <p class="how">Verified, not assumed: the same audio content played through two different identities came out with identical words. The measured error between them was exactly zero on every line tested.</p>
            </div>
            <div class="pgrid">
              <h3>No recording of the character needed</h3>
              <p>There is no voice cloning here, and no user uploads their own audio. Voices are created from a written description. That sidesteps the consent and impersonation problem entirely: you cannot accidentally clone a real person if the system never accepts a recording.</p>
              <p class="how">A standing rule of the project: no user audio upload in the public product, ever.</p>
            </div>
            <div class="pgrid">
              <h3>It knows what it does not know</h3>
              <p>Every capability is measured against a control, and the honest limits are published alongside the results. Roughly twenty findings were wrong on the first attempt and caught by a check, including one where an entire experiment produced fluent-sounding speech that was saying different words than requested, and nothing errored. That is written up publicly rather than quietly fixed.</p>
              <p class="how">Every experiment states what was <em>not</em> established. Project rule: “A suspiciously good or suspiciously bad number is a bug report about your setup.”</p>
            </div>
          </div>
        </section>

        <!-- Graph (§7) -->
        <section class="panel doc" id="graph" aria-labelledby="gr-t">
          <h2 class="tab" id="gr-t">Graph <span class="dim">· how a description becomes audio</span></h2>
          <div class="doc-body">
            <ol class="nodes">
              <li class="node"><span class="port">in</span><b>your description</b><span>plain words</span></li>
              <li class="node learns"><span class="port">trained</span><b>the mapper</b><span>the only part that learns</span></li>
              <li class="node"><span class="port">asset</span><b>a voice identity</b><span>small, storable, versioned; kept with a seed clip and the engine version</span></li>
              <li class="node"><span class="port">frozen</span><b>the voice engine</b><span>never modified, swappable</span></li>
              <li class="node"><span class="port">out</span><b>audio</b><span>watermarked and logged from the first render, plus a manifest a game engine can read</span></li>
            </ol>
            <div class="cols three">
              <p><b>Only one small piece is trained.</b> The speech engine is used as-is and never altered, so a better engine can be swapped in without rebuilding everything.</p>
              <p><b>The voice identity is a small, storable thing.</b> That is what makes a character persistent: it can be saved, versioned and handed to someone else.</p>
              <p><b>The checker is a separate system.</b> Distinctness and consistency are judged by a speaker-recognition system that has never seen the generator’s internals: not the system marking its own homework.</p>
            </div>
          </div>
        </section>

        <!-- Measured (§5) -->
        <section class="panel doc" id="measured" aria-labelledby="me-t">
          <h2 class="tab" id="me-t">Measured <span class="dim">· each result with its caveat</span></h2>
          <div class="doc-body">
            <div class="mrow head" aria-hidden="true"><span>result</span><span>what was measured</span><span>caveat</span></div>
            <div class="mrow">
              <h3>It works end to end today</h3>
              <p>On one laptop GPU, in English, Hindi, Bengali and Tamil: describe a character, get a voice, render a scene of dialogue, and out comes watermarked audio plus a file a game engine can read. The demo in the editor above minted three characters from text, rendered five lines, watermarked everything and wrote the manifest in about four minutes.</p>
              <p class="but">The clips on this page are that demo’s English output; the Indian-language renders do not ship.</p>
            </div>
            <div class="mrow">
              <h3>Minting from a description costs nothing in clarity</h3>
              <p>A described voice is just as intelligible as one taken from a real recording. The measured difference was tiny, leaned slightly in the invented voice’s favour, and was smaller than the difference between two real speakers: that gap was six times larger.</p>
              <p class="but">Read as no detectable difference, not as invented voices being better. Before any score was read, every version had to come out the same length or the run aborted.</p>
            </div>
            <div class="mrow">
              <h3>Invented voices are recognisably distinct people</h3>
              <p>Verified by a separate speaker-recognition system that has never seen the generator. Each invented voice also sits clearly apart from the nearest real voice the system learned from: new voices, not real people wearing a label.</p>
              <p class="but">An automatic check. Very little has been listened to.</p>
            </div>
            <div class="mrow">
              <h3>A character stays itself</h3>
              <p>A character stays itself across different sentences more consistently than a real person does across different recordings. Unsurprising once you think about it: a stored voice has no bad-throat day, no change of microphone, no mood.</p>
              <p class="but">Automatic measurement, not a listening test.</p>
            </div>
            <div class="mrow">
              <h3>A native speaker confirmed one Hindi line</h3>
              <p>A fluent Hindi speaker confirmed one rendered line says the target sentence. They were told the sentence and asked “does it say this?”, not “does it sound right?”. That is the check the earlier faulty audio failed. The sentence: <span lang="hi" class="deva-inline">नमस्ते आप कैसे हैं आज मौसम बहुत अच्छा है</span> <span class="dim">(our translation, not a project claim: “Hello, how are you? The weather is very nice today.”)</span></p>
              <p class="but">Still to be checked: the other voices and the other lines.</p>
            </div>
            <div class="mrow">
              <h3>A blind listening test found and fixed a real problem</h3>
              <p>A blind test with built-in controls found a real problem in how the system judged whether two voices were the same person: pairs the system called different were heard as the same person about half the time. The threshold was raised. That removed 10 duplicate voices from a set of 50 and cost 3 percent of measured variety.</p>
              <p class="but">The test was small: 8 pairs, one listener, every control answered correctly. It found the problem but does not settle the exact threshold, and the English threshold has not had its own listening test.</p>
            </div>
            <div class="mrow">
              <h3>Pacing is controllable within a measured range</h3>
              <div>
                <p>Slow a character to about two-thirds of normal speed or push them to about 1.4 times, and they stay the same person saying the same words. Outside that range the identity fades gradually rather than breaking.</p>
                <div class="pace" role="img" aria-label="Measured pacing range from 0.67 times to 1.43 times normal speed; the range a listener called clean is 0.8 to 1.25 times.">
                  <div class="track"><div class="clean"></div><div class="knob"></div></div>
                  <span class="tick" style="left:0%">0.67×</span>
                  <span class="tick" style="left:17.1%">0.8×</span>
                  <span class="tick" style="left:43.4%">normal</span>
                  <span class="tick" style="left:76.3%">1.25×</span>
                  <span class="tick" style="left:100%">1.43×</span>
                </div>
                <p class="cap dim">An illustration of the measured range. This page does not re-time audio. The marked band is the part a listener called clean.</p>
              </div>
              <p class="but">A listener noted the slow extreme starts to sound processed; the range they called clean is narrower, about 0.8 to 1.25 times.</p>
            </div>
            <div class="mrow">
              <h3>Two ways to answer a description</h3>
              <div>
                <p>Invent a new voice, or find the closest match in an existing library of voices. Inventing gives you a character nobody else has; finding gives you higher accuracy and studio quality. Neither is strictly better, and the project has numbers for the trade-off.</p>
                <p>Finding, on a library of 141 real Hindi voices: two thirds of descriptions (65.6%) get a voice that matches on every trait named, and 87 percent land within one step. When a description names only a couple of traits, the way people actually write, a bit over half (53.8%) match exactly; chance is about one in five. On 2,500 English voices the same method reaches 88.5%, and it replicates in Bengali within a point or two.</p>
                <p>Reach: finding reaches 87% of the variety the library actually holds; inventing reached 37% before mis-set settings were fixed, and the fix raised the invented catalogue from 14 to 22 distinct Hindi voices and from 23 to 41 English.</p>
              </div>
              <p class="but">Finding cannot produce a voice the library does not contain, cannot guarantee a new character is unique, and the library is someone else’s: every character in every project draws from the same shelf. The library measured was real recorded speakers standing in for a studio library; no commercial system has been measured.</p>
            </div>
            <div class="mrow">
              <h3>Watermarked and logged from the first render</h3>
              <p>Every render is watermarked with AudioSeal and logged, from the first output, not added later. Output includes a manifest a game engine can consume: this is built for a pipeline, not a demo button.</p>
              <p class="but">Watermarked and logged does not mean shippable; see the licensing item below.</p>
            </div>
          </div>
        </section>

        <!-- Not there yet (§6) -->
        <section class="panel doc" id="notyet" aria-labelledby="ny-t">
          <h2 class="tab" id="ny-t">Not there yet <span class="dim">· stated plainly</span></h2>
          <div class="doc-body">
            <div class="issue"><span class="st">not built</span><p><b>Not a product.</b> This is a working research system, not a product. There is no signup, no hosted service, no API.</p></div>
            <div class="issue"><span class="st">does not work</span><p><b>Emotion is not solved.</b> You can control pacing within a measured range. You cannot yet say “say this line apologetically” and have it work. That was tested thoroughly and does not work on the current engine, for reasons the project documented and reported upstream: the engine’s documented emotion tags turn out not to be recognised by the engine at all, and a listener heard no difference between tagged versions of the same line.</p></div>
            <div class="issue"><span class="st">small, measured</span><p><b>The catalogue is small.</b> Tens of distinct voices per language so far, not hundreds: about 22 in Hindi and 41 in English by the project’s own measure. The limit is understood rather than mysterious: the real speakers the system learned from hold about 38 to 48 distinguishable voices, and the project measured exactly where its own method loses variety.</p></div>
            <div class="issue"><span class="st">blocked by licence</span><p><b>Cannot ship as a product.</b> Not in its current form, for licensing reasons, which are documented. The Indian-language engine’s training chain includes data licensed for non-commercial use, so no model weights and no Indian-language audio leave the repository. It is research-only today, deliberately.</p></div>
            <div class="issue"><span class="st">barely listened to</span><p><b>Very little has been listened to.</b> Most results are automatic measurements. One listener, a handful of pairs.</p></div>
            <div class="issue"><span class="st">not compared</span><p><b>No comparison against a commercial system.</b></p></div>
            <div class="issue"><span class="st">English only here</span><p><b>The clips on this page are English.</b> Hindi renders exist and a native speaker has checked one, but the Indian-language engine’s licence is research-only, so those clips do not ship, not even here.</p></div>
            <div class="issue"><span class="st">unvalidated</span><p><b>Three of the five demo lines</b> were rendered with an experimental emotion setting whose effect has not been validated on this engine. Listen to them as voice samples, not performances.</p></div>
          </div>
        </section>

        <!-- Calls to action (§11) -->
        <section class="panel doc cta" aria-labelledby="ct-t">
          <h2 class="tab" id="ct-t">Research</h2>
          <div class="doc-body cols">
