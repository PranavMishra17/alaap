<script>
  const $ = (s: string, r: ParentNode = document) => r.querySelector(s) as HTMLElement | null;
  const $$ = (s: string, r: ParentNode = document) => Array.from(r.querySelectorAll(s)) as HTMLElement[];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const css = getComputedStyle(document.documentElement);
  const INK = css.getPropertyValue('--ink').trim(), GENDA = css.getPropertyValue('--genda').trim(), ASH = css.getPropertyValue('--ash').trim();

  const insps = $$('.insp');
  const wave = $('#wave') as HTMLCanvasElement;
  const vpWords = $('#vp-words')!, vpMeta = $('#vp-meta')!, vpTime = $('#vp-time')!, vpPlay = $('#vp-play') as HTMLButtonElement;
  const status = $('#status')!, logList = $('#log-list')!;
  const sceneIds = $$('.hier [data-select][data-line]').map((b) => b.dataset.select!);

  let current: HTMLElement | null = null;
  let audio: HTMLAudioElement | null = null;
  let sceneOn = false, sceneIdx = 0, raf = 0;
  const samples = new Map<string, Promise<Float32Array | null>>();
  let ac: AudioContext | null = null;

  function log(verb: string, text: string) {
    const li = document.createElement('li'); li.className = 'live';
    const b = document.createElement('b'); b.textContent = verb; li.append(b, document.createTextNode(text));
    logList.append(li); logList.scrollTop = logList.scrollHeight;
  }
  function setStatus(text: string, on = false) { status.textContent = text; status.classList.toggle('on', on); }

  async function load(src: string): Promise<Float32Array | null> {
    if (!samples.has(src)) samples.set(src, (async () => {
      try {
        ac ??= new (window.AudioContext || (window as any).webkitAudioContext)();
        const buf = await (await fetch(src)).arrayBuffer();
        const decoded = await ac.decodeAudioData(buf);
        return decoded.getChannelData(0);
      } catch { return null; }
    })());
    return samples.get(src)!;
  }
  function peaks(data: Float32Array, n: number) {
    const out: [number, number][] = []; const step = data.length / n;
    for (let i = 0; i < n; i++) {
      let mn = 0, mx = 0; const a = Math.floor(i * step), b = Math.min(data.length, Math.floor((i + 1) * step));
      for (let j = a; j < b; j += 1) { const v = data[j]; if (v > mx) mx = v; if (v < mn) mn = v; }
      out.push([mn, mx]);
