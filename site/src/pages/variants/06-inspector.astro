    return out;
  }
  function draw(c: HTMLCanvasElement, data: Float32Array | null, progress: number, bar: number, played = true) {
    const dpr = window.devicePixelRatio || 1; const w = c.clientWidth || 300, h = c.clientHeight || 100;
