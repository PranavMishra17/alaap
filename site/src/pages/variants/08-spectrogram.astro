---
// Variant 08 — "spectrogram". The physical shape of a voice: every clip on the page is drawn
// from its own audio in the browser (STFT on a log-frequency axis, burned like a Sona-Graph
// print) with the pitch traced over it in red pencil. Reading down a column: same words,
// three voices. Reading across a row: one voice, any words.
import { name, meaning, links, languages, characters, scene, seeds, clipCaveats } from '../../content/alaap';

const charOf = (id: string) => characters.find((c) => c.id === id)!;
const seedRows = characters.map((ch) => ({ ch, clip: seeds.find((s) => s.character === ch.id)! }));
const sceneRows = scene.map((clip) => ({ clip, ch: charOf(clip.character) }));
const mentorSeed = seeds.find((s) => s.character === 'mentor')!;
const seedMax = Math.max(...seeds.map((s) => s.seconds));
const sceneMax = Math.max(...scene.map((s) => s.seconds));
const s1 = (n: number) => n.toFixed(1);

// Frequency axis of every plot: log scale, 60 Hz to 8 kHz. Mirrored in the script.
const FMIN = 60, FMAX = 8000;
const tickTop = (f: number) => (Math.log(FMAX / f) / Math.log(FMAX / FMIN)) * 100;
const ticks = [[100, '100 Hz'], [300, '300 Hz'], [1000, '1 kHz'], [3000, '3 kHz']] as const;

const hindiSentence = 'नमस्ते आप कैसे हैं आज मौसम बहुत अच्छा है';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alaap — describe a character, get a voice nobody has recorded</title>
    <meta name="description" content="Describe a character. Get a voice nobody has recorded. Keep it. Every clip on this page is drawn from its own audio." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gentium+Book+Plus:ital,wght@0,400;0,700;1,400&family=Fira+Sans:ital,wght@0,300;0,400;0,500;1,400&family=Courier+Prime:wght@400;700&family=Tiro+Devanagari+Hindi&display=swap" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#input">Skip to content</a>
    <header class="mast wrap">
      <p class="brand"><span class="latin">{name.latin}</span> <span lang="hi">{name.devanagari}</span></p>
      <p class="meaning">{meaning}</p>
      <nav class="mastnav" aria-label="Repository"><a href={links.repo}>Read the research</a></nav>
    </header>

    <main>
      <!-- ============ HERO: the whole input, and the shape it produced ============ -->
      <section class="hero wrap" id="input" aria-labelledby="hero-desc">
        <p class="label">The whole input. Nothing else was given.</p>
        <h1 class="desc" id="hero-desc"><span class="vh">Alaap. The description: </span><span id="desc-text">“{charOf('mentor').description}”</span></h1>
        <p class="lede">That sentence is everything the system was given. Below is the voice it minted, drawn from the actual clip.</p>

        <figure class="plot plot-hero" id="hero-plot" data-src={mentorSeed.src} data-seconds={mentorSeed.seconds}>
          <div class="paper">
            <canvas aria-hidden="true"></canvas>
            <div class="head" aria-hidden="true"></div>
            <ul class="fticks" aria-hidden="true">{ticks.map(([f, l]) => <li style={`top:${tickTop(f).toFixed(1)}%`}>{l}</li>)}</ul>
          </div>
          <figcaption class="ctl">
            <button class="play" type="button" aria-pressed="false" hidden>Play the seed</button>
            <span class="words">“{mentorSeed.text}”</span>
            <span class="meta"><span id="hero-role">mentor</span> · seed clip · <span class="secs">{s1(mentorSeed.seconds)}</span> s</span>
          </figcaption>
          <audio controls preload="none" src={mentorSeed.src}></audio>
        </figure>
        <p class="legend">Time runs left to right; the vertical lines are half a second apart. Pitch runs upward on a log scale. Dark is loud. The red line traces the pitch of the voice; where it breaks, the sound was not periodic enough to pin a pitch to: silence, breath, or grit.<noscript> Scripts are off in this browser, so the plots stay blank; the players still work.</noscript></p>

        <fieldset class="choose" id="choose">
          <legend>Three descriptions were given on 2026-09-05. Choose one to see and hear its seed.</legend>
          <div class="choices">
            {characters.map((ch) => {
              const s = seeds.find((x) => x.character === ch.id)!;
              return (
                <button type="button" class="choice" aria-pressed={ch.id === 'mentor' ? 'true' : 'false'} data-role={ch.id} data-src={s.src} data-seconds={s.seconds} data-desc={ch.description}>
                  <span class="role">{ch.id}</span>
                  <span class="cdesc">“{ch.description}”</span>
                </button>
              );
            })}
          </div>
          <p class="note">Choosing replays a clip that was rendered on 2026-09-05. Nothing on this page generates a voice.</p>
        </fieldset>

        <div class="thesis">
          <p class="oneliner">You describe a character in ordinary language. You get back a voice that has never existed. Then you use that voice for any line of dialogue you write, and it stays the same character every time.</p>
          <p class="who">For people making games, animation, audio drama, dubbing, interactive fiction: anyone who needs many distinct speaking characters and cannot hire a cast for each one.</p>
        </div>
      </section>

      <!-- ============ WHO: same sentence, three voices ============ -->
      <section class="wrap sect" id="who" aria-labelledby="who-h">
        <p class="label">Reading down: the same sentence, three voices. Same time scale.</p>
        <h2 id="who-h">Who is speaking is one layer. What is said is another.</h2>
        <div class="cols">
          <p>The system holds a character's identity apart from the words. That is why one character can say anything without their voice wandering, and why changing the line never changes the person. This was verified rather than assumed: when the same audio content is played through two different identities, the words come out identically. The measured error between them was exactly zero on every line tested.</p>
          <p class="pencil">Here the separation is visible. All three seeds say the same sentence, so the dark shapes carry the same syllables at three different paces. The red pitch line sits at three different heights: three people who do not exist.</p>
        </div>

        <div class="rows">
          {seedRows.map(({ ch, clip }) => (
            <div class="row">
              <div class="rowlabel">
                <span class="role">{ch.id}</span>
                <span class="cdesc">“{ch.description}”</span>
              </div>
              <figure class="plot plot-row" data-src={clip.src} data-seconds={clip.seconds} style={`--w:${((clip.seconds / seedMax) * 100).toFixed(1)}%`}>
                <div class="paper">
                  <canvas aria-hidden="true"></canvas>
                  <div class="head" aria-hidden="true"></div>
                </div>
                <figcaption class="ctl">
                  <button class="play" type="button" aria-pressed="false" hidden>Play</button>
                  <span class="words">“{clip.text}”</span>
                  <span class="meta">seed clip · {s1(clip.seconds)} s</span>
                </figcaption>
                <audio controls preload="none" src={clip.src}></audio>
              </figure>
            </div>
          ))}
        </div>
        <p class="after">Verified by a separate speaker-recognition system that has never seen the generator: an independent check, not the system marking its own homework. Each invented voice also sits clearly apart from the nearest real voice the system learned from, so these are new voices, not real people wearing a label.</p>
      </section>

      <!-- ============ WHAT: one voice, any line — the five-line scene ============ -->
      <section class="wrap sect" id="what" aria-labelledby="what-h">
        <p class="label">Reading across: the five-line scene, in order. Same time scale.</p>
        <h2 id="what-h">A voice is a thing you keep, not a setting you re-guess.</h2>
        <div class="cols">
          <p>Most tools generate a voice each time you ask. Here the character's voice is stored as an identity and re-used. The same character sounds like the same person across every line, every scene, and every session. That consistency is measured, not hoped for: a character stays itself across different sentences more consistently than a real person does across different recordings, which is unsurprising once you think about it. A stored voice has no bad-throat day, no change of microphone, no mood.</p>
          <p class="pencil">The mentor speaks twice below, and its pitch line sits where it sat in the seed. Different words, same person. The demo that produced these clips mints three characters from text, renders the five-line scene, watermarks everything and writes the manifest in about four minutes, on one laptop GPU.</p>
        </div>

        <div class="rows">
          {sceneRows.map(({ clip, ch }) => (
            <div class="row">
              <div class="rowlabel">
                <span class="role">{ch.id}</span>
                <span class="cdesc">“{ch.description}”</span>
              </div>
              <figure class="plot plot-row plot-line" data-src={clip.src} data-seconds={clip.seconds} style={`--w:${((clip.seconds / sceneMax) * 100).toFixed(1)}%`}>
                <div class="paper">
                  <canvas aria-hidden="true"></canvas>
                  <div class="head" aria-hidden="true"></div>
                </div>
                <figcaption class="ctl">
                  <button class="play" type="button" aria-pressed="false" hidden>Play</button>
                  <span class="words">“{clip.text}”</span>
                  <span class="meta">{s1(clip.seconds)} s{clip.experimentalEmotionSetting ? ' · experimental emotion setting, unvalidated' : ' · no direction given'}</span>
                </figcaption>
                <audio controls preload="none" src={clip.src}></audio>
              </figure>
            </div>
          ))}
        </div>

        <div class="caveats">
          <p><strong>Watermark.</strong> {clipCaveats.watermark} The manifest's own disclosure line: “AI-generated synthetic speech. All audio carries an AudioSeal watermark.”</p>
          <p><strong>English only.</strong> {clipCaveats.englishOnly}</p>
          <p><strong>Emotion setting.</strong> {clipCaveats.emotionSetting}</p>
        </div>
      </section>

      <!-- ============ NO RECORDING, and why Indian languages ============ -->
      <section class="wrap sect" id="rules" aria-labelledby="rules-h">
        <p class="label">Two rules the system was built around.</p>
        <h2 id="rules-h">It never hears a recording of the character. It is Indic-first.</h2>
        <div class="cols">
          <div>
            <p>There is no voice cloning here, and no user uploads their own audio. Voices are created from a written description. That sidesteps the consent and impersonation problem entirely: you cannot accidentally clone a real person if the system never accepts a recording.</p>
            <ul class="rules">
              <li>never accept a user's audio</li>
              <li>watermark from the first render</li>
              <li>store timbre, not performance</li>
              <li>do not start the next stage until this one is measured</li>
            </ul>
          </div>
          <div>
            <p>Indic is the stated reason the project exists. The tools that do this well mostly do it in English. Indian-language creators either use a handful of stock voices that everyone else is also using, or they hire actors. This project treats Hindi, Bengali and Tamil as first-class, not as an afterthought port. Measured so far: {languages.join(', ')}. The Indian-language engine covers 22 Indian languages; four measured so far.</p>
            <p class="hindi"><span lang="hi">{hindiSentence}</span><span class="meta">one rendered line, checked by a fluent Hindi speaker</span></p>
            <p class="small">They were told the sentence and asked “does it say this?”, not “does it sound right?”. That is the check the earlier faulty audio failed. Still to be checked: the other three voices and the other two lines. A plain translation, ours and not a project claim: “Hello, how are you? The weather is very nice today.”</p>
          </div>
        </div>
      </section>

      <!-- ============ HOW: the signal chain ============ -->
      <section class="wrap sect" id="how" aria-labelledby="how-h">
        <p class="label">The shape of the system, left to right.</p>
        <h2 id="how-h">Only one small piece learns. Everything else is measured.</h2>
        <ol class="chain" aria-label="Signal chain">
          <li class="node data"><span class="nname">your description</span><span class="nnote">ordinary language</span></li>
          <li class="node box"><span class="nname">the mapper</span><span class="nnote">the only part that learns</span></li>
          <li class="node data"><span class="nname">a voice identity</span><span class="nnote">small and storable: saved with a short seed clip and the engine version that made it</span></li>
          <li class="node box"><span class="nname">the voice engine</span><span class="nnote">never modified, swappable</span></li>
          <li class="node data"><span class="nname">audio</span><span class="nnote">watermarked and logged from the first render, plus a manifest a game engine can read</span></li>
        </ol>
        <p class="checker"><span class="role">the checker</span> A separate speaker-recognition system listens to the audio and never sees the engine's internals. It is what says whether two clips are the same person.</p>
        <div class="cols">
          <p>Only one small piece is trained. The speech engine is used as-is and never altered, so a better engine can be swapped in without rebuilding everything. The voice identity is a small, storable thing: it can be saved, versioned and handed to someone else. That is what makes a character persistent.</p>
          <p>There are two ways to answer a description, and the system measures both: invent a new voice, or find the closest match in an existing library of voices. Inventing gives you a character nobody else has; finding gives you higher accuracy and studio quality. Neither is strictly better and the project has numbers for the trade-off, below.</p>
        </div>
      </section>

      <!-- ============ MEASURED ============ -->
      <section class="wrap sect" id="measured" aria-labelledby="meas-h">
        <p class="label">Every capability is measured against a control. The caveat stays next to the result.</p>
        <h2 id="meas-h">What was measured, and what it cost to find out.</h2>
        <div class="meas">
          <div class="m">
            <h3>Minting a voice costs nothing in clarity</h3>
            <p>A described voice is just as intelligible as one taken from a real recording. The measured difference was tiny, leaned slightly in the invented voice's favour, and was smaller than the difference between two real speakers: that gap was six times larger. Read as no detectable difference, not as invented voices being better.</p>
            <p class="cav">The control that had to pass first: every version must come out the same length before any score is read, or the run aborts.</p>
          </div>
          <div class="m">
            <h3>Pacing is controllable within a measured range</h3>
            <p>You can slow a character to about two-thirds of normal speed or push them to about 1.4 times, and they stay the same person saying the same words. Outside that range the identity fades gradually rather than breaking.</p>
            <div class="pace" role="img" aria-label="Pacing scale: measured range about two-thirds to about 1.4 times normal speed; the range a listener called clean, about 0.8 to 1.25 times.">
              <span class="plabel ptop">clean, by ear: about 0.8× to 1.25×</span>
              <span class="bracket up" style="left:28%;width:44%"></span>
              <span class="track"></span>
              <i class="tick" style="left:10%"></i><i class="tick" style="left:28%"></i><i class="tick" style="left:50%"></i><i class="tick" style="left:72%"></i><i class="tick" style="left:86%"></i>
              <span class="plabel normal" style="left:50%">normal speed</span>
              <span class="bracket down" style="left:10%;width:76%"></span>
              <span class="plabel pbot">measured: about two-thirds to about 1.4× normal speed</span>
            </div>
            <p class="cav">A listener noted the slow extreme starts to sound processed; the range they called clean is narrower, about 0.8 to 1.25 times. This is a drawing of the measured range, not a live control.</p>
          </div>
          <div class="m">
            <h3>Invent, or find: the trade-off in numbers</h3>
            <p>Finding, on a library of 141 real Hindi voices: two thirds of descriptions (65.6%) get a voice that matches on every trait named, and 87% land within one step. When the description names only a couple of traits, the way people actually write, 53.8% match exactly on the traits named. Random chance is about 20%. The same method on a library of 2,500 English voices reaches 88.5%.</p>
            <p>Reach: finding reaches 87% of the variety the library actually holds; inventing reached 37% before two mis-set settings were fixed, and the fix raised the invented catalogue from 14 to 22 distinct Hindi voices and from 23 to 41 English.</p>
            <p class="cav">What finding cannot do: produce a voice the library does not contain; guarantee a new character is unique; and the library is someone else's, so every character in every project draws from the same shelf. The library measured was real recorded speakers standing in for a studio library, and no commercial system has been measured.</p>
          </div>
          <div class="m">
            <h3>A blind listening test found and fixed a real problem</h3>
            <p>A blind listening test with built-in controls found a real problem in how the system judged whether two voices were the same person: pairs the system called different were heard as the same person about half the time. The threshold was raised. That removed 10 duplicate voices from a set of 50 and cost 3 percent of measured variety.</p>
            <p class="cav">The test was small: 8 pairs and one listener, with every control answered correctly. It found the problem but does not settle the exact threshold, and the English threshold has not had its own listening test.</p>
          </div>
          <div class="m wide">
            <h3>It knows what it does not know</h3>
            <div class="cols">
              <p>Every capability is measured against a control, and the honest limits are published alongside the results. Roughly twenty findings in this project were wrong on the first attempt and caught by a check, including one where an entire experiment produced fluent-sounding speech that was saying different words than requested, and nothing errored. That is written up publicly rather than quietly fixed. 114 automated checks guard the rules it learned the hard way.</p>
              <p class="pencil">“A suspiciously good or suspiciously bad number is a bug report about your setup.”</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ NOT THERE YET ============ -->
      <section class="wrap sect" id="missing" aria-labelledby="miss-h">
        <p class="label">Stated plainly. Every item is open.</p>
        <h2 id="miss-h">Not there yet.</h2>
        <ul class="missing">
          <li><strong>Not a product.</strong> This is a working research system, not a product. There is no signup, no hosted service, no API.</li>
          <li><strong>Emotion is not solved.</strong> Emotional performance direction is not solved. You can control pacing within a measured range. You cannot yet say “say this line apologetically” and have it work. That was tested thoroughly and does not work on the current engine, for reasons the project documented and reported upstream. The engine's documented emotion tags turn out not to be recognised by the engine at all, and a listener heard no difference between four tagged versions of the same line.</li>
          <li><strong>The catalogue is small.</strong> Tens of distinct voices per language so far, not hundreds: about 22 in Hindi and 41 in English by the project's own measure. The limit is understood and measured rather than mysterious: the real speakers the system learned from hold about 38 to 48 distinguishable voices, and the project measured exactly where its own method loses variety.</li>
          <li><strong>Cannot ship as a product, for licensing reasons.</strong> It cannot be shipped as a product in its current form for licensing reasons, which are documented. The Indian-language engine's training chain includes data licensed for non-commercial use, so no model weights and no Indian-language audio leave the repository. It is research-only today, deliberately.</li>
          <li><strong>Very little has been listened to.</strong> Most results are automatic measurements. One listener, a handful of pairs.</li>
          <li><strong>No comparison against a commercial system.</strong></li>
          <li><strong>The clips on this page are English.</strong> Hindi renders exist and a native speaker has checked one, but the Indian-language engine's licence is research-only, so those clips do not ship, not even here.</li>
          <li><strong>Three of the five demo lines</strong> were rendered with an experimental emotion setting whose effect has not been validated on this engine. Listen to them as voice samples, not performances.</li>
        </ul>
      </section>
    </main>

    <footer class="wrap foot">
      <div class="ctas">
        <a class="cta" href={links.repo}>Read the research <span class="arrow">→</span></a>
        <a class="cta" href={links.issues}>Corrections welcome <span class="arrow">→</span></a>
      </div>
      <p class="quote">“If a claim here is wrong, an issue with a primary source is more useful than almost anything else.”</p>
      <p class="fine">Research and documentation CC-BY-4.0; code MIT. No model weights and no generated Indian-language audio ship. Research pass 2026-09-02; implementation and measurement 2026-09-05.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --paper: #f1f2ee;
    --grid: #c9d5df;
    --ink: #1f1d1a;
    --scorch: #7a5c3e;
    --pencil: #c2372f;
    --graphite: #66645e;
    --display: 'Gentium Book Plus', 'Gentium Plus', Georgia, 'Times New Roman', serif;
    --body: 'Fira Sans', 'Segoe UI', system-ui, -apple-system, sans-serif;
    --mono: 'Courier Prime', 'Courier New', Courier, monospace;
    --hindi: 'Tiro Devanagari Hindi', 'Noto Sans Devanagari', 'Nirmala UI', Mangal, serif;
    --rule: color-mix(in srgb, var(--ink) 22%, transparent);
  }
  * { box-sizing: border-box; }
  html { background: var(--paper); -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; background: var(--paper); color: var(--ink); font: 400 17px/1.55 var(--body); overflow-x: hidden; }
  a { color: inherit; text-decoration: underline; text-decoration-color: var(--pencil); text-underline-offset: 3px; text-decoration-thickness: 1.5px; }
  a:hover { color: var(--pencil); }
  :focus-visible { outline: 2px solid var(--pencil); outline-offset: 3px; }
  h1, h2, h3 { font-family: var(--display); font-weight: 400; margin: 0; }
  p { margin: 0 0 1em; }
  [lang='hi'] { font-family: var(--hindi); font-weight: 400; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .skip { position: absolute; left: 12px; top: -60px; background: var(--ink); color: var(--paper); padding: 8px 12px; z-index: 10; }
  .skip:focus { top: 12px; }
  .wrap { max-width: 1180px; margin: 0 auto; padding-left: 24px; padding-right: 24px; }

  /* masthead */
  .mast { display: grid; grid-template-columns: auto 1fr auto; gap: 24px; align-items: baseline; padding-top: 22px; padding-bottom: 8px; }
  .brand { margin: 0; font-family: var(--display); font-size: 1.5rem; letter-spacing: 0.01em; white-space: nowrap; }
  .brand [lang='hi'] { font-size: 1.35em; margin-left: 0.15em; }
  .meaning { margin: 0; color: var(--graphite); font-size: 0.92rem; max-width: 56ch; }
  .mastnav a { font-size: 0.95rem; white-space: nowrap; }

  /* section furniture */
  .label { font-family: var(--mono); font-size: 0.82rem; color: var(--graphite); margin: 0 0 0.6em; }
  .label::before { content: ''; display: inline-block; width: 1.4em; height: 2px; background: var(--pencil); vertical-align: middle; margin-right: 0.7em; }
  .sect { padding-top: 84px; padding-bottom: 12px; }
  .sect h2 { font-size: clamp(1.7rem, 3.2vw, 2.5rem); line-height: 1.12; max-width: 24ch; margin-bottom: 0.8em; letter-spacing: -0.005em; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 56px; align-items: start; max-width: 1080px; }
  .cols > p, .cols > div { max-width: 58ch; }
  .pencil { color: var(--pencil); font: italic 400 1.18rem/1.4 var(--display); border-left: 2px solid var(--pencil); padding-left: 16px; }
  .after { max-width: 66ch; margin-top: 28px; }
  .small, .cav { font-size: 0.93rem; color: var(--graphite); }
  .role { font-family: var(--mono); font-size: 0.82rem; letter-spacing: 0.02em; color: var(--ink); }
  .cdesc { font: italic 400 1rem/1.35 var(--display); color: var(--graphite); }

  /* hero */
  .hero { padding-top: 40px; }
  .desc { font: italic 400 clamp(2.1rem, 5.3vw, 4.5rem)/1.06 var(--display); letter-spacing: -0.012em; max-width: 22ch; margin: 0.1em 0 0.35em; }
  .lede { font-size: 1.15rem; max-width: 52ch; color: var(--graphite); margin-bottom: 18px; }
  .legend { font-family: var(--mono); font-size: 0.82rem; color: var(--graphite); margin: 10px 0 34px; }

  /* the plots */
  .plot { margin: 0; }
  .paper { position: relative; border: 1px solid var(--rule); background-color: var(--paper);
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 28px 28px; overflow: hidden; }
  .paper canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .plot-hero .paper { height: clamp(240px, 38vh, 440px); }
  .plot-row .paper { height: 132px; width: var(--w, 100%); }
  .plot-line .paper { height: 112px; }
  .head { position: absolute; top: 0; bottom: 0; left: 0; width: 2px; margin-left: -1px; background: var(--pencil); display: none; pointer-events: none; }
  .head::before { content: ''; position: absolute; top: 0; left: -4px; border-left: 5px solid transparent; border-right: 5px solid transparent; border-top: 7px solid var(--pencil); }
  .paper.playing .head { display: block; }
  .burn { animation: burn 1.5s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  @keyframes burn { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  .fticks { list-style: none; margin: 0; padding: 0; position: absolute; left: 6px; top: 0; bottom: 0; pointer-events: none; }
  .fticks li { position: absolute; transform: translateY(-55%); white-space: nowrap; font-family: var(--mono); font-size: 0.72rem; color: var(--graphite); background: color-mix(in srgb, var(--paper) 80%, transparent); padding: 0 3px; }
  .plot audio { display: block; width: 100%; max-width: 420px; margin-top: 10px; }
  .js .plot audio { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .ctl { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; margin-top: 12px; }
  .play { font: 500 0.92rem var(--body); color: var(--ink); background: transparent; border: 1.5px solid var(--ink); border-radius: 2px; padding: 7px 14px 7px 12px; display: inline-flex; align-items: center; gap: 9px; cursor: pointer; }
  .play::before { content: ''; display: inline-block; border-left: 9px solid currentColor; border-top: 5.5px solid transparent; border-bottom: 5.5px solid transparent; }
  .play[aria-pressed='true']::before { border: 0; width: 10px; height: 10px; background: currentColor; }
  .play:hover { color: var(--pencil); border-color: var(--pencil); }
  .words { font: italic 400 1.08rem/1.35 var(--display); }
  .meta { font-family: var(--mono); font-size: 0.8rem; color: var(--graphite); }

  /* chooser */
  .choose { border: 0; padding: 0; margin: 0 0 44px; }
  .choose legend { padding: 0; margin-bottom: 12px; font-size: 1rem; }
  .choices { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .choice { text-align: left; background: transparent; border: 1.5px solid var(--rule); border-radius: 2px; padding: 12px 14px; cursor: pointer; display: grid; gap: 4px; font: inherit; color: inherit; }
  .choice:hover { border-color: var(--ink); }
  .choice[aria-pressed='true'] { border-color: var(--pencil); box-shadow: inset 0 0 0 1px var(--pencil); }
  .choice[aria-pressed='true'] .role::after { content: ' · shown above'; color: var(--pencil); }
  .choice .cdesc { color: var(--ink); }
  .note { font-size: 0.93rem; color: var(--graphite); margin: 12px 0 0; }
  .thesis { max-width: 62ch; }
  .oneliner { font: 400 1.35rem/1.35 var(--display); margin-bottom: 0.6em; }
  .who { color: var(--graphite); }

  /* rows */
  .rows { margin-top: 24px; border-top: 1px solid var(--rule); }
  .row { display: grid; grid-template-columns: 210px 1fr; gap: 12px 32px; padding: 22px 0; border-bottom: 1px solid var(--rule); align-items: start; }
  .rowlabel { display: grid; gap: 4px; padding-top: 4px; }

  /* caveats, rules, hindi */
  .caveats { margin-top: 28px; max-width: 76ch; }
  .caveats p { font-size: 0.95rem; }
  .rules { list-style: none; padding: 0; margin: 8px 0 0; font-family: var(--mono); font-size: 0.88rem; }
  .rules li { padding: 6px 0; border-top: 1px solid var(--rule); }
  .hindi { margin: 10px 0 8px; display: grid; gap: 2px; }
  .hindi [lang='hi'] { font-size: 1.7rem; line-height: 1.5; }

  /* signal chain */
  .chain { list-style: none; margin: 8px 0 18px; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; counter-reset: none; }
  .node { position: relative; padding: 14px 26px 14px 0; display: grid; align-content: start; gap: 6px; }
  .node .nname { font: 400 1.25rem/1.2 var(--display); }
  .node.box .nname { display: inline-block; border: 1.5px solid var(--ink); padding: 6px 12px; border-radius: 2px; justify-self: start; }
  .node .nnote { font-size: 0.88rem; color: var(--graphite); max-width: 22ch; }
  .node:not(:last-child)::after { content: '→'; position: absolute; right: 6px; top: 16px; font-family: var(--display); font-size: 1.3rem; color: var(--pencil); }
  .checker { font-size: 0.95rem; color: var(--graphite); border-top: 1px dashed var(--pencil); padding-top: 10px; max-width: 60ch; margin-bottom: 28px; }
  .checker .role { color: var(--pencil); margin-right: 0.6em; }

  /* measured */
  .meas { display: grid; grid-template-columns: 1fr 1fr; gap: 36px 56px; max-width: 1080px; }
  .m h3 { font-size: 1.32rem; margin-bottom: 0.45em; }
  .m p { max-width: 58ch; }
  .m.wide { grid-column: 1 / -1; border-top: 1px solid var(--rule); padding-top: 28px; }
  .pace { position: relative; height: 118px; margin: 10px 0 14px; max-width: 520px; font-family: var(--mono); font-size: 0.76rem; color: var(--graphite); }
  .pace .track { position: absolute; left: 0; right: 0; top: 56px; height: 1px; background: var(--ink); }
  .pace .tick { position: absolute; top: 51px; width: 1px; height: 11px; background: var(--ink); }
  .pace .plabel { position: absolute; transform: translateX(-50%); white-space: nowrap; }
  .pace .ptop { top: 0; left: 50%; }
  .pace .pbot { bottom: 0; left: 48%; }
  .pace .normal { top: 64px; color: var(--ink); }
  .pace .bracket { position: absolute; height: 10px; border: 1.5px solid var(--pencil); }
  .pace .up { top: 22px; border-bottom: 0; }
  .pace .down { top: 82px; border-top: 0; }

  /* missing */
  .missing { list-style: none; padding: 0; margin: 0; columns: 2; column-gap: 56px; max-width: 1080px; }
  .missing li { position: relative; padding-left: 28px; max-width: 58ch; break-inside: avoid; margin-bottom: 14px; }
  .missing li::before { content: ''; position: absolute; left: 0; top: 0.42em; width: 0.65em; height: 0.65em; border: 1.5px solid var(--ink); }
  .missing strong { font-weight: 500; }

  /* footer */
  .foot { padding-top: 96px; padding-bottom: 56px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 14px 40px; margin-bottom: 22px; }
  .cta { font: 400 1.6rem/1.2 var(--display); text-decoration: none; border-bottom: 2px solid var(--pencil); padding-bottom: 2px; }
  .cta .arrow { color: var(--pencil); }
  .quote { font: italic 400 1.15rem/1.4 var(--display); max-width: 54ch; color: var(--graphite); }
  .fine { font-family: var(--mono); font-size: 0.8rem; color: var(--graphite); max-width: 80ch; margin-bottom: 0.5em; }

  @media (max-width: 900px) {
    .mast { grid-template-columns: 1fr auto; }
    .meaning { grid-column: 1 / -1; grid-row: 2; }
    .cols, .meas { grid-template-columns: 1fr; }
    .missing { columns: 1; }
    .chain { grid-template-columns: 1fr; }
    .node { padding: 10px 0 10px 20px; border-left: 1.5px solid var(--rule); }
    .node:not(:last-child)::after { content: '↓'; right: auto; left: -10px; top: auto; bottom: -14px; background: var(--paper); line-height: 1; }
    .node .nnote { max-width: 48ch; }
  }
  @media (max-width: 640px) {
    body { font-size: 16px; }
    .wrap { padding-left: 18px; padding-right: 18px; }
    .mast { grid-template-columns: 1fr; gap: 6px; }
    .meaning { grid-row: auto; }
    .hero { padding-top: 32px; }
    .sect { padding-top: 60px; }
    .plot-hero .paper { height: 240px; }
    .choices { grid-template-columns: 1fr; }
    .row { grid-template-columns: 1fr; gap: 8px; }
    .plot-row .paper { height: 100px; }
    .plot-line .paper { height: 88px; }
    .fticks li:nth-child(2) { display: none; }
    .pace { height: 136px; }
    .pace .ptop, .pace .pbot { left: 0; right: 0; transform: none; text-align: center; white-space: normal; }
    .cta { font-size: 1.3rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>

<script>
  // Every plot is drawn from its own clip: fetch, decode, short-time spectrum on a log axis,
  // pitch by autocorrelation, all in the browser. No pre-rendered images exist.
  const SR = 16000, N = 1024, HOP = 128, FMIN = 60, FMAX = 8000, FLOOR = 62;
  const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const css = (v) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
  const hex = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
  const PAPER = hex(css('--paper')), INK = hex(css('--ink')), SCORCH = hex(css('--scorch'));
  const PENCIL = css('--pencil'), GRID = css('--grid');

  // ---- FFT (radix-2, in place) ----
  function makeFFT(n) {
    const cos = new Float32Array(n / 2), sin = new Float32Array(n / 2), rev = new Uint32Array(n);
    for (let i = 0; i < n / 2; i++) { cos[i] = Math.cos((2 * Math.PI * i) / n); sin[i] = Math.sin((2 * Math.PI * i) / n); }
    const bits = Math.log2(n);
    for (let i = 0; i < n; i++) { let r = 0; for (let b = 0; b < bits; b++) r = (r << 1) | ((i >> b) & 1); rev[i] = r; }
    return (re, im, inverse) => {
      for (let i = 0; i < n; i++) { const j = rev[i]; if (j > i) { let t = re[i]; re[i] = re[j]; re[j] = t; t = im[i]; im[i] = im[j]; im[j] = t; } }
      for (let size = 2; size <= n; size <<= 1) {
        const half = size >> 1, step = n / size;
        for (let start = 0; start < n; start += size) {
          for (let k = 0; k < half; k++) {
            const c = cos[k * step], s = inverse ? sin[k * step] : -sin[k * step];
            const i = start + k, j = i + half;
            const tr = re[j] * c - im[j] * s, ti = re[j] * s + im[j] * c;
            re[j] = re[i] - tr; im[j] = im[i] - ti; re[i] += tr; im[i] += ti;
          }
        }
      }
      if (inverse) for (let i = 0; i < n; i++) { re[i] /= n; im[i] /= n; }
    };
  }
  const fft = makeFFT(N);
  const hann = new Float32Array(N);
  for (let i = 0; i < N; i++) hann[i] = 0.5 - 0.5 * Math.cos((2 * Math.PI * i) / (N - 1));

  // ---- analysis: spectrogram (dB, normalised) + pitch track ----
  const cache = new Map();
  function analyse(src) {
    if (cache.has(src)) return cache.get(src);
    const p = (async () => {
      const buf = await (await fetch(src)).arrayBuffer();
      const ab = await new OfflineAudioContext(1, 1, SR).decodeAudioData(buf);
      const x = new Float32Array(ab.length);
      for (let c = 0; c < ab.numberOfChannels; c++) { const d = ab.getChannelData(c); for (let i = 0; i < x.length; i++) x[i] += d[i] / ab.numberOfChannels; }
      const frames = Math.max(1, Math.floor((x.length - N) / HOP) + 1), B = N / 2 + 1;
      const mag = new Float32Array(frames * B), f0 = new Float32Array(frames), rms = new Float32Array(frames);
      const re = new Float32Array(N), im = new Float32Array(N);
      const lagMin = Math.round(SR / 500), lagMax = Math.round(SR / 60);
      let peak = -Infinity, rmsMax = 0, prev = 0, since = 99;
      for (let f = 0; f < frames; f++) {
        const off = f * HOP; let e = 0;
        for (let i = 0; i < N; i++) { const v = x[off + i] || 0; e += v * v; re[i] = v * hann[i]; im[i] = 0; }
        rms[f] = Math.sqrt(e / N); if (rms[f] > rmsMax) rmsMax = rms[f];
        fft(re, im, false);
        for (let k = 0; k < N; k++) { const pw = re[k] * re[k] + im[k] * im[k]; if (k < B) { const db = 10 * Math.log10(pw + 1e-12); mag[f * B + k] = db; if (db > peak) peak = db; } re[k] = pw; im[k] = 0; }
        fft(re, im, true); // autocorrelation
        // candidates: local maxima of the normalised autocorrelation in the voice range
        const r0 = re[0], cands = []; let best = 0;
        if (r0 > 0) for (let l = lagMin + 1; l < lagMax; l++) { const r = re[l] / r0; if (r >= 0.5 && re[l] > re[l - 1] && re[l] >= re[l + 1]) { cands.push([l, r]); if (r > best) best = r; } }
        let pick = null;
        if (cands.length) {
          const strong = cands.filter((c) => c[1] >= best * 0.85);
          if (prev > 0 && since <= 3) { let bd = 0.35; for (const c of strong) { const d = Math.abs(Math.log(SR / c[0] / prev)); if (d < bd) { bd = d; pick = c; } } }
          if (!pick) for (const c of strong) if (c[1] >= best * 0.9 && (!pick || c[0] < pick[0])) pick = c;
        }
        if (pick) { f0[f] = SR / pick[0]; prev = f0[f]; since = 0; } else since++;
      }
      for (let f = 0; f < frames; f++) if (rms[f] < rmsMax * 0.06) f0[f] = 0;
      const sm = new Float32Array(frames); // median of 5, gaps stay gaps
      for (let f = 0; f < frames; f++) {
        if (!f0[f]) continue; const w = [];
        for (let k = -2; k <= 2; k++) { const v = f0[f + k]; if (v) w.push(v); }
        w.sort((a, b) => a - b); sm[f] = w[w.length >> 1];
      }
      for (let f = 0; f < frames; ) { // drop voiced runs shorter than three frames
        if (!sm[f]) { f++; continue; } let g = f; while (g < frames && sm[g]) g++;
        if (g - f < 3) for (let k = f; k < g; k++) sm[k] = 0;
        f = g;
      }
      for (let i = 0; i < mag.length; i++) { const m = (mag[i] - peak + FLOOR) / FLOOR; mag[i] = m < 0 ? 0 : m > 1 ? 1 : m; }
      return { frames, B, mag, f0: sm, duration: ab.duration };
    })();
    cache.set(src, p);
    return p;
  }

  // ---- drawing ----
  function draw(paper, a) {
    const canvas = paper.querySelector('canvas');
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const W = Math.max(1, Math.round(paper.clientWidth * dpr)), H = Math.max(1, Math.round(paper.clientHeight * dpr));
    canvas.width = W; canvas.height = H;
    const ctx = canvas.getContext('2d');
    const img = ctx.createImageData(W, H), d = img.data;
    const binHz = SR / N, lr = Math.log(FMAX / FMIN);
    const fy = (y) => FMAX * Math.exp(-lr * (y / H));
    const lo = new Float32Array(H), hi = new Float32Array(H); // bin span of each pixel row, once
    for (let y = 0; y < H; y++) { lo[y] = fy(y + 1) / binHz; hi[y] = fy(y) / binHz; }
    const col = new Float32Array(H);
    for (let x = 0; x < W; x++) {
      const t0 = Math.floor((x / W) * a.frames), t1 = Math.max(t0, Math.floor(((x + 1) / W) * a.frames) - 1);
      for (let y = 0; y < H; y++) {
        const fb = lo[y], ft = hi[y];
        let v = 0;
        for (let t = t0; t <= t1; t++) {
          const row = t * a.B;
          if (ft - fb >= 1) { for (let k = Math.floor(fb); k <= Math.ceil(ft) && k < a.B; k++) { const m = a.mag[row + k]; if (m > v) v = m; } }
          else { const k = Math.floor(fb), tt = fb - k, m = a.mag[row + k] * (1 - tt) + (a.mag[row + Math.min(k + 1, a.B - 1)] || 0) * tt; if (m > v) v = m; }
        }
        col[y] = v;
      }
      for (let y = 0; y < H; y++) {
        const m = col[y], al = Math.pow(m, 2.1), o = (y * W + x) * 4;
        d[o] = SCORCH[0] + (INK[0] - SCORCH[0]) * m; d[o + 1] = SCORCH[1] + (INK[1] - SCORCH[1]) * m; d[o + 2] = SCORCH[2] + (INK[2] - SCORCH[2]) * m; d[o + 3] = al * 255;
      }
    }
    ctx.putImageData(img, 0, 0);
    // graph paper under the burn: log-frequency lines and half-second lines
    ctx.globalCompositeOperation = 'destination-over';
    ctx.strokeStyle = GRID; ctx.lineWidth = dpr;
    ctx.beginPath();
    for (const f of [100, 200, 300, 500, 1000, 2000, 3000, 5000]) { const y = Math.round((Math.log(FMAX / f) / lr) * H) + 0.5; ctx.moveTo(0, y); ctx.lineTo(W, y); }
    for (let t = 0.5; t < a.duration; t += 0.5) { const x = Math.round((t / a.duration) * W) + 0.5; ctx.moveTo(x, 0); ctx.lineTo(x, H); }
    ctx.stroke();
    ctx.fillStyle = `rgb(${PAPER.join(',')})`; ctx.fillRect(0, 0, W, H);
    // the red pencil: pitch track
    ctx.globalCompositeOperation = 'source-over';
    ctx.strokeStyle = PENCIL; ctx.lineWidth = 2 * dpr; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    ctx.beginPath(); let pen = 0;
    for (let f = 0; f < a.frames; f++) {
      const v = a.f0[f];
      if (!v) { pen = 0; continue; }
      const x = ((f + 0.5) / a.frames) * W, y = (Math.log(FMAX / v) / lr) * H;
      if (pen && Math.abs(Math.log(v / pen)) < 0.3) ctx.lineTo(x, y); else ctx.moveTo(x, y); // a jump is a gap, not a line
      pen = v;
    }
    ctx.stroke();
  }

  // ---- players ----
  const plots = Array.from(document.querySelectorAll('figure.plot'));
  const allAudio = plots.map((p) => p.querySelector('audio'));
  function stopOthers(keep) { for (const a of allAudio) if (a !== keep && !a.paused) a.pause(); }

  function wire(plot) {
    const paper = plot.querySelector('.paper'), audio = plot.querySelector('audio'), btn = plot.querySelector('.play'), head = plot.querySelector('.head');
    audio.removeAttribute('controls'); btn.hidden = false;
    const label = btn.textContent;
    let raf = 0;
    const tick = () => { if (audio.duration) head.style.left = `${(audio.currentTime / audio.duration) * 100}%`; raf = requestAnimationFrame(tick); };
    audio.addEventListener('play', () => { stopOthers(audio); paper.classList.add('playing'); btn.setAttribute('aria-pressed', 'true'); btn.textContent = 'Stop'; cancelAnimationFrame(raf); tick(); });
    const done = () => { paper.classList.remove('playing'); btn.setAttribute('aria-pressed', 'false'); btn.textContent = label; cancelAnimationFrame(raf); head.style.left = '0%'; };
    audio.addEventListener('pause', done); audio.addEventListener('ended', done);
    btn.addEventListener('click', () => { if (audio.paused) audio.play().catch(() => {}); else { audio.pause(); audio.currentTime = 0; } });
    let last = '';
    const render = async (burn) => {
      const src = plot.dataset.src;
      try {
        const a = await analyse(src);
        if (plot.dataset.src !== src) return;
        draw(paper, a);
        if (burn && !REDUCED && last !== src) { const c = paper.querySelector('canvas'); c.classList.remove('burn'); void c.offsetWidth; c.classList.add('burn'); }
        last = src;
      } catch (e) { console.warn('plot failed', src, e); }
    };
    let ro;
    if ('ResizeObserver' in window) { let w = paper.clientWidth; ro = new ResizeObserver(() => { if (paper.clientWidth !== w) { w = paper.clientWidth; render(false); } }); ro.observe(paper); }
    return { plot, audio, render };
  }
  const players = plots.map(wire);
  const hero = players.find((p) => p.plot.id === 'hero-plot');

  // hero first, then the rest in page order
  (async () => {
    if (hero) await hero.render(true);
    for (const p of players) if (p !== hero) await p.render(false);
  })();

  // the "describe a voice" moment: replays the pre-rendered seed of the chosen description
  const choices = Array.from(document.querySelectorAll('.choice'));
  const descText = document.getElementById('desc-text'), heroRole = document.getElementById('hero-role');
  for (const ch of choices) ch.addEventListener('click', async () => {
    if (!hero) return;
    for (const c of choices) c.setAttribute('aria-pressed', c === ch ? 'true' : 'false');
    const { src, seconds, desc, role } = ch.dataset;
    stopOthers(null);
    hero.plot.dataset.src = src; hero.plot.dataset.seconds = seconds;
    descText.textContent = `“${desc}”`;
    if (heroRole) heroRole.textContent = role;
    for (const s of hero.plot.querySelectorAll('.secs')) s.textContent = Number(seconds).toFixed(1);
    hero.audio.src = src;
    // bring the paper back into view if the chooser sits below it, then burn the new print
    const r = hero.plot.getBoundingClientRect();
    if (r.top < 0 || r.bottom > window.innerHeight) hero.plot.scrollIntoView({ block: 'nearest', behavior: REDUCED ? 'auto' : 'smooth' });
    await hero.render(true);
    hero.audio.play().catch(() => {});
  });
</script>
