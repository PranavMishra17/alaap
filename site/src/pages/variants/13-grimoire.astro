</style>

<script>
  // Every player replays a stored clip. The portraits are the clip's own waveform, decoded here and
  // painted in time with playback: underdrawing first, colour as the voice is heard.
  const BINS = 480;
  // The portrait stands: time runs top to bottom, amplitude mirrors left and right, painted head-down.
  const MINI = { rest: 'rgba(214,192,143,.42)', played: '#E9B949', pitch: 4, vertical: true };
  const STRIP = { rest: 'rgba(91,75,58,.62)', played: '#9E2F24', pitch: 3, vertical: false };
  const OfflineCtx = (window as any).OfflineAudioContext || (window as any).webkitOfflineAudioContext;
  // Reduced motion: no progressive fill; the whole waveform is painted the moment the clip starts.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const peaksCache = new Map<string, Promise<Float32Array>>();

  function loadPeaks(src: string): Promise<Float32Array> {
    let p = peaksCache.get(src);
    if (p) return p;
    p = (async () => {
      const buf = await (await fetch(src)).arrayBuffer();
      const ctx = new OfflineCtx(1, 1, 44100);
      const decoded: AudioBuffer = await new Promise((res, rej) => ctx.decodeAudioData(buf, res, rej));
      const data = decoded.getChannelData(0);
      const step = Math.max(1, Math.floor(data.length / BINS));
      const peaks = new Float32Array(BINS);
      let max = 0;
      for (let i = 0; i < BINS; i++) {
        let m = 0;
        const end = Math.min(data.length, (i + 1) * step);
        for (let j = i * step; j < end; j++) { const v = Math.abs(data[j]); if (v > m) m = v; }
        peaks[i] = m; if (m > max) max = m;
      }
      if (max > 0) for (let i = 0; i < BINS; i++) peaks[i] /= max;
      return peaks;
    })();
    peaksCache.set(src, p);
    return p;
  }

  function draw(canvas: HTMLCanvasElement, peaks: Float32Array, progress: number, style: typeof MINI) {
    const dpr = window.devicePixelRatio || 1;
    const w = canvas.clientWidth, h = canvas.clientHeight;
    if (!w || !h) return;
    const cw = Math.round(w * dpr), ch = Math.round(h * dpr);
    if (canvas.width !== cw || canvas.height !== ch) { canvas.width = cw; canvas.height = ch; }
    const g = canvas.getContext('2d')!;
    g.setTransform(dpr, 0, 0, dpr, 0, 0);
    g.clearRect(0, 0, w, h);
    const along = style.vertical ? h : w;      // the time axis
    const across = style.vertical ? w : h;     // the amplitude axis
    const inset = style.vertical ? along * 0.07 : 0;
    const span = along - inset * 2;
    const n = Math.max(8, Math.min(peaks.length, Math.floor(span / style.pitch)));
    const pitch = span / n, bw = Math.max(1, pitch * 0.55);
    const mid = across / 2, amp = mid - (style.vertical ? across * 0.1 : 2);
    for (let i = 0; i < n; i++) {
      const a = Math.floor((i * peaks.length) / n), b = Math.max(a + 1, Math.floor(((i + 1) * peaks.length) / n));
      let m = 0; for (let j = a; j < b; j++) if (peaks[j] > m) m = peaks[j];
      const bh = Math.max(1, m * amp);
      g.fillStyle = (i + 0.5) / n <= progress ? style.played : style.rest;
      if (style.vertical) g.fillRect(mid - bh, inset + i * pitch, bh * 2, bw);
      else g.fillRect(inset + i * pitch, mid - bh, bw, bh * 2);
    }
  }

  type Api = { play: () => Promise<void>; audio: HTMLAudioElement; render: () => void };
  const api = new WeakMap<Element, Api>();
  const clipEls = Array.from(document.querySelectorAll<HTMLElement>('.clip'));
  const renderers: Array<() => void> = [];

  function stopAll(except: Element | null) {
    for (const el of clipEls) if (el !== except) { const a = api.get(el)?.audio; if (a && !a.paused) a.pause(); }
  }

  // Each leaf owns its portraits; a clip paints the portrait of its own character on its own leaf.
  for (const el of clipEls) {
    const audio = el.querySelector('audio') as HTMLAudioElement;
    const btn = el.querySelector('.speak') as HTMLButtonElement;
    const wave = el.querySelector('.wave') as HTMLCanvasElement | null;
    const lbl = btn.querySelector('.speak-label') as HTMLElement;
    const leaf = el.closest('.leaf');
    const portrait = leaf?.querySelector<HTMLElement>(`.portrait[data-character="${el.dataset.character}"]`) ?? null;
    const pc = portrait?.querySelector('canvas') as HTMLCanvasElement | null;
    const pcap = portrait?.querySelector('[data-portrait-of]') as HTMLElement | null;
    const src = audio.getAttribute('src')!;
    let peaks: Float32Array | null = null;
    let raf = 0;
    let finished = false;

    const render = () => {
      if (!peaks) return;
      const p = finished || (reduceMotion && !audio.paused) ? 1 : audio.duration ? audio.currentTime / audio.duration : 0;
      if (wave) draw(wave, peaks, p, STRIP);
      if (pc && portrait && portrait.dataset.showing === el.dataset.clip) draw(pc, peaks, p, MINI);
    };
    renderers.push(render);
    const tick = () => { render(); if (!reduceMotion && !audio.paused && !audio.ended) raf = requestAnimationFrame(tick); };
    const ensure = async () => { if (!peaks) { peaks = await loadPeaks(src); render(); } };

    const play = async () => {
      stopAll(el);
      finished = false;
      if (portrait) { portrait.dataset.showing = el.dataset.clip; if (pcap) pcap.textContent = el.dataset.label ?? ''; }
      await ensure();
      try { await audio.play(); } catch { /* blocked or unsupported: the native player is still in the DOM */ }
    };
    btn.addEventListener('click', () => { if (audio.paused) play(); else audio.pause(); });
    audio.addEventListener('play', () => { el.classList.add('is-playing'); lbl.textContent = 'Pause'; btn.setAttribute('aria-label', btn.getAttribute('aria-label')!.replace(/^Play/, 'Pause')); cancelAnimationFrame(raf); tick(); });
    audio.addEventListener('pause', () => { el.classList.remove('is-playing'); lbl.textContent = 'Play'; btn.setAttribute('aria-label', btn.getAttribute('aria-label')!.replace(/^Pause/, 'Play')); cancelAnimationFrame(raf); if (audio.ended) finished = true; render(); });
    api.set(el, { play, audio, render });

    // Underdrawing: decode when the leaf comes near the viewport, not before.
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); ensure(); } }, { rootMargin: '240px' });
      io.observe(el);
    } else ensure();
  }

  // Portraits start on the character's seed clip.
  for (const portrait of document.querySelectorAll<HTMLElement>('.portrait')) {
    const leaf = portrait.closest('.leaf');
    const seed = leaf?.querySelector<HTMLElement>(`.clip[data-character="${portrait.dataset.character}"][data-clip$="_seed"]`)
      ?? leaf?.querySelector<HTMLElement>(`.clip[data-character="${portrait.dataset.character}"]`);
    if (seed) portrait.dataset.showing = seed.dataset.clip;
  }
  // The cast on the scene leaf has no seed clips there: paint each from its first line until a line plays.
  for (const portrait of document.querySelectorAll<HTMLElement>('.scene .portrait')) {
    const first = document.querySelector<HTMLElement>(`.scene .clip[data-character="${portrait.dataset.character}"]`);
    const cap = portrait.querySelector('[data-portrait-of]');
    if (first) { portrait.dataset.showing = first.dataset.clip; if (cap) cap.textContent = first.dataset.label ?? ''; }
  }

  let resizeT = 0;
  window.addEventListener('resize', () => { cancelAnimationFrame(resizeT); resizeT = requestAnimationFrame(() => renderers.forEach((r) => r())); });

  // Recite: the five stored scene clips, back to back, in order.
  const reciteBtn = document.querySelector<HTMLButtonElement>('[data-recite]');
  if (reciteBtn) {
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.scene .clip'));
    let reciting = false;
    const waitEnd = (a: HTMLAudioElement) => new Promise<boolean>((res) => { const done = () => { a.removeEventListener('pause', done); res(a.ended); }; a.addEventListener('pause', done); });
    reciteBtn.addEventListener('click', async () => {
      if (reciting) { reciting = false; stopAll(null); return; }
      reciting = true; reciteBtn.textContent = 'Stop reciting'; reciteBtn.setAttribute('data-on', '');
      for (const row of rows) {
        if (!reciting) break;
        const a = api.get(row)!;
        await a.play();
        if (a.audio.paused) break;
        const ended = await waitEnd(a.audio);
        if (!ended) break;
      }
      reciting = false; reciteBtn.textContent = 'Recite the scene'; reciteBtn.removeAttribute('data-on');
    });
  }
</script>
