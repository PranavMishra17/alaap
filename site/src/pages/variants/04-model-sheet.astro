  .view { min-width: 0; }
  .view__frame { position: relative; border: var(--pencil) solid var(--blue); border-radius: 2px; padding: 1.9rem .6rem .6rem; background: rgba(140,203,227,.06); }
  .view__frame::before, .view__frame::after { content: ''; position: absolute; width: 9px; height: 9px; border: 1px solid var(--graphite); }
  .view__frame::before { left: -1px; top: -1px; border-width: 1px 0 0 1px; }
  .view__frame::after { right: -1px; bottom: -1px; border-width: 0 1px 1px 0; }
  .view__label { position: absolute; top: .45rem; left: .6rem; color: var(--graphite); font-weight: 700; }
  .view__wave { display: block; width: 100%; height: 72px; }
  .view--empty .view__frame { border-style: dashed; min-height: 8.6rem; background: none; }
  .view--empty p { font-size: 1rem; line-height: 1.3; }
  .view figcaption { margin-top: .55rem; display: grid; gap: .2rem; font-size: .95rem; line-height: 1.4; }
  .view figcaption q { font-weight: 500; }
  .view__meta, .row__meta { text-transform: none; letter-spacing: .02em; }
  .view__flag { font-size: .95rem; line-height: 1.25; }
  .is-playing .view__frame { border-color: var(--graphite); }

  .play { display: inline-flex; align-items: center; gap: .4rem; margin-top: .5rem; font: 600 .8rem/1 var(--body); text-transform: uppercase; letter-spacing: .06em; color: var(--graphite); background: var(--paper); border: var(--pencil) solid var(--graphite); border-radius: 999px; padding: .45rem .8rem .45rem .65rem; cursor: pointer; }
  .play svg, .turnbtn svg { width: .7rem; height: .7rem; fill: currentColor; }
  .play:hover, .turnbtn:hover { background: var(--graphite); color: var(--paper); }
  .is-playing .play { background: var(--carmine); border-color: var(--carmine); color: var(--paper); }
  .turnbtn { display: inline-flex; align-items: center; gap: .6rem; margin-top: 1rem; font: 700 1rem/1 var(--display); text-transform: uppercase; letter-spacing: .04em; font-size: 1.25rem; color: var(--paper); background: var(--graphite); border: var(--pencil) solid var(--graphite); border-radius: 999px; padding: .7rem 1.25rem .7rem 1rem; cursor: pointer; }
  .turnbtn.is-on { background: var(--carmine); border-color: var(--carmine); }
  .turnbtn.is-on:hover { background: var(--carmine); }
  audio { display: block; width: 100%; margin-top: .5rem; }
  .js audio, .js .character[hidden] { display: none; }
  html:not(.js) .play, html:not(.js) .turnbtn, html:not(.js) .view__wave, html:not(.js) .chart__range { display: none; }

  .margin-notes { margin-top: 2rem; padding-top: 1rem; border-top: var(--pencil) solid var(--graphite); display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 1rem 2.5rem; }
  .margin-notes p { max-width: 56ch; font-size: .98rem; }
  .margin-notes strong { font-weight: 600; }
  .caveats { margin-top: 1.5rem; padding-top: .9rem; border-top: 1px dashed rgba(43,45,42,.35); display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: .75rem 2.5rem; }
  .caveats__label { grid-column: 1 / -1; }
  .caveat { font-size: 1.05rem; line-height: 1.35; max-width: 48ch; }

  /* generic sheet head + ledgers */
  .sheet__head { display: grid; gap: .5rem; padding-bottom: 1.25rem; border-bottom: var(--pencil) solid var(--graphite); margin-bottom: 1.5rem; }
  .sheet__head h2 { font-size: clamp(2.4rem, 5vw, 3.8rem); }
  .lede { max-width: 62ch; font-size: 1.08rem; color: var(--graphite); }
  .ledger { display: grid; gap: 0; }
  .ledger > div { display: grid; grid-template-columns: minmax(12rem, 1fr) 2.2fr; gap: 1.5rem; padding: 1.25rem 0; border-bottom: 1px dashed rgba(43,45,42,.35); }
  .ledger > div:last-child { border-bottom: 0; }
  .ledger dt { font-size: 1.55rem; max-width: 18ch; }
  .ledger dd { max-width: 64ch; }
  .ledger dd .hand { display: block; margin-top: .35rem; font-size: 1.05rem; line-height: 1.35; }
