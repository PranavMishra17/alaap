---
// Variant 04 — model-sheet. A voice model sheet as an animation studio would draw one.
import { name, meaning, links, characters, scene, byCharacter, clipCaveats, languages } from '../../content/alaap';

const viewNames = ['Front', 'Three-quarter', 'Profile'];
const sheets = characters.map((ch) => ({ ...ch, clips: byCharacter(ch.id) }));

// Lineup chart geometry. Ground at y=300. No faces: construction circles and lines only.
const ground = 300;
const figureSpec = {
  mentor: { x: 68, top: 18, r: 15, sw: 46, hw: 32, lean: -7, action: 'M68 300 Q 44 160 76 24' },
  scout: { x: 180, top: 118, r: 14, sw: 34, hw: 24, lean: 6, action: 'M180 300 Q 214 210 174 124' },
  innkeeper: { x: 292, top: 66, r: 16, sw: 64, hw: 50, lean: 0, action: 'M292 300 Q 288 180 292 72' },
} as const;
const figures = characters.map((ch) => {
  const f = figureSpec[ch.id];
  const chin = f.top + f.r * 2;
  const sh = chin + f.r * 0.9;
  const hip = sh + (ground - sh) * 0.44;
  const knee = hip + (ground - hip) * 0.5;
  return { id: ch.id, ...f, headCx: f.x + f.lean, headCy: f.top + f.r, chin, sh, hip, knee };
});
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alaap — a voice model sheet</title>
    <meta name="description" content="Describe a character. Get a voice nobody has recorded. Keep it. A model sheet for the column a model sheet never had." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Big+Shoulders+Display:wght@700;800&family=Courier+Prime:wght@400;700&family=Kalam:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="desk">

      <!-- SHEET · MODEL — the hero is the artefact -->
      <section class="sheet sheet--model" aria-labelledby="model-title">
        <div class="pegs" aria-hidden="true"><i></i><i class="round"></i><i></i></div>

        <header class="tb">
          <div class="tb__name">
            <h1><span>{name.latin}</span> <span lang="hi" class="hand">{name.devanagari}</span></h1>
            <p class="tb__meaning"><span lang="hi" class="hand">{name.devanagari}</span>: {meaning}.</p>
          </div>
          <dl class="tb__fields">
            <div><dt>Sheet</dt><dd>Voice model</dd></div>
            <div><dt>Character</dt><dd data-field="character">mentor</dd></div>
            <div><dt>Rendered</dt><dd>2026-09-05, one laptop GPU, English</dd></div>
            <div><dt>Status</dt><dd>Research system, not a product</dd></div>
          </dl>
        </header>

        <div class="thesis">
          <h2 id="model-title" class="display">Model sheet: voice</h2>
          <p>A model sheet fixes a character on paper so that every hand that draws them draws the same person. This sheet fixes how a character sounds, so every line they say is the same person. It is the column a model sheet has never had.</p>
        </div>

        <!-- the "describe a voice" moment: the brief is the button -->
        <div class="briefs" role="group" aria-label="Briefs on file">
          <p class="typed briefs__label">Briefs on file, choose one</p>
          <div class="briefs__row">
            {characters.map((ch) => (
              <button type="button" class="brief" data-brief={ch.id} aria-pressed={ch.id === 'mentor' ? 'true' : 'false'}>
                <span class="hand brief__text">“{ch.description}”</span>
                <span class="typed brief__who">{ch.id}</span>
              </button>
            ))}
          </div>
          <p class="briefs__note">Three briefs, three sheets, all rendered on 2026-09-05. Choosing a brief rebuilds the sheet from that pre-rendered character and plays its seed clip. Nothing on this page generates live.</p>
        </div>

        <div class="board">
          <!-- lineup chart -->
          <figure class="lineup">
            <svg viewBox="0 0 360 330" role="img" aria-label="Lineup chart: three characters as construction figures, mentor tall and stooped, scout small and forward-leaning, innkeeper broad and upright.">
              <g class="lineup__lines">
                {figures.map((f) => <line x1="8" y1={f.top} x2="352" y2={f.top} />)}
                <line x1="8" y1={ground} x2="352" y2={ground} class="ground" />
              </g>
              {figures.map((f) => (
                <g class="fig" data-figure={f.id}>
                  <path d={f.action} class="fig__action" />
                  <line x1={f.x} y1={f.top - 6} x2={f.x} y2={ground} class="fig__axis" />
                  <circle cx={f.headCx} cy={f.headCy} r={f.r} />
                  <line x1={f.headCx - f.r} y1={f.headCy} x2={f.headCx + f.r} y2={f.headCy} class="thin" />
                  <line x1={f.headCx} y1={f.top} x2={f.headCx} y2={f.chin} class="thin" />
                  <line x1={f.headCx} y1={f.chin} x2={f.x} y2={f.sh} />
                  <line x1={f.x - f.sw / 2} y1={f.sh} x2={f.x + f.sw / 2} y2={f.sh} />
                  <path d={`M${f.x - f.sw / 2} ${f.sh} L${f.x - f.hw / 2} ${f.hip} L${f.x + f.hw / 2} ${f.hip} L${f.x + f.sw / 2} ${f.sh}`} />
                  <line x1={f.x - f.sw / 2} y1={f.sh} x2={f.x - f.sw / 2 - 6} y2={f.hip + 10} />
                  <line x1={f.x + f.sw / 2} y1={f.sh} x2={f.x + f.sw / 2 + 6} y2={f.hip + 10} />
                  <circle cx={f.x - f.sw / 2 - 6} cy={f.hip + 10} r="3" class="joint" />
                  <circle cx={f.x + f.sw / 2 + 6} cy={f.hip + 10} r="3" class="joint" />
                  <line x1={f.x - f.hw / 2 + 4} y1={f.hip} x2={f.x - f.hw / 2} y2={f.knee} />
                  <line x1={f.x + f.hw / 2 - 4} y1={f.hip} x2={f.x + f.hw / 2} y2={f.knee} />
                  <circle cx={f.x - f.hw / 2} cy={f.knee} r="3" class="joint" />
                  <circle cx={f.x + f.hw / 2} cy={f.knee} r="3" class="joint" />
                  <line x1={f.x - f.hw / 2} y1={f.knee} x2={f.x - f.hw / 2 - 2} y2={ground} />
                  <line x1={f.x + f.hw / 2} y1={f.knee} x2={f.x + f.hw / 2 + 2} y2={ground} />
                  <text x={f.x} y={ground + 20} text-anchor="middle" class="fig__name">{f.id}</text>
                </g>
              ))}
            </svg>
            <figcaption class="typed">Lineup chart. Size and stance are the designer's reading of each brief; the sheet fixes the voice, not the drawing.</figcaption>
          </figure>

          <!-- the voice turnaround -->
          <div class="turn">
            <div class="turn__head">
              <h3 class="display">Voice turnaround</h3>
              <p class="hand turn__note">one identity · three sentences · same person each time</p>
            </div>

            {sheets.map((s) => (
              <div class="character" data-character={s.id} hidden={s.id !== 'mentor'}>
                <p class="character__brief"><span class="typed">Brief</span> <span class="hand brief-line" data-brief-text={s.description}>{s.description}</span></p>
                <div class="views">
                  {viewNames.map((v, i) => {
                    const c = s.clips[i];
                    return c ? (
                      <figure class="view" data-view data-src={c.src} data-seconds={c.seconds}>
                        <div class="view__frame">
                          <span class="typed view__label">{v}</span>
                          <canvas class="view__wave" width="300" height="72" aria-hidden="true"></canvas>
                          <button type="button" class="play" data-play aria-label={`Play, ${c.text}`}>
                            <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1.5v9l8-4.5z" /></svg><span>Play</span>
                          </button>
                          <audio preload="none" controls src={c.src}></audio>
                        </div>
                        <figcaption>
                          <q>{c.text}</q>
                          <span class="typed view__meta">{c.seconds} s · {c.kind === 'seed' ? 'seed clip, stored with the identity' : 'scene line'}</span>
                          {c.experimentalEmotionSetting && <span class="hand view__flag">rendered with the experimental emotion setting, unvalidated</span>}
                        </figcaption>
                      </figure>
                    ) : (
                      <figure class="view view--empty">
                        <div class="view__frame"><span class="typed view__label">{v}</span><p class="hand">not drawn: this character has one scene line</p></div>
                      </figure>
                    );
                  })}
                </div>
                <button type="button" class="turnbtn" data-turn>
                  <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1.5v9l8-4.5z" /></svg>
                  <span data-turn-label>Turn: play the views in order</span>
                </button>
              </div>
            ))}
          </div>
        </div>

        <div class="margin-notes">
          <p><strong>What this is.</strong> You describe a character in ordinary language. You get back a voice that has never existed. Then you use that voice for any line of dialogue you write, and it stays the same character every time. The brief above is all the mentor was given: no recording, no actor, no upload.</p>
          <p><strong>Who it is for.</strong> People making games, animation, audio drama, dubbing, interactive fiction: anyone who needs many distinct speaking characters and cannot hire a cast for each one.</p>
        </div>
        <div class="caveats">
          <p class="typed caveats__label">Notes on the clips</p>
          <p class="hand caveat">{clipCaveats.watermark}</p>
          <p class="hand caveat">{clipCaveats.englishOnly}</p>
          <p class="hand caveat">{clipCaveats.emotionSetting}</p>
        </div>
      </section>

      <!-- SHEET · RULES — §4 -->
      <section class="sheet" aria-labelledby="rules-title">
        <div class="pegs" aria-hidden="true"><i></i><i class="round"></i><i></i></div>
        <header class="sheet__head">
          <p class="typed">Sheet · rules</p>
          <h2 id="rules-title" class="display">What the sheet fixes</h2>
          <p class="lede">On paper a model sheet fixes proportion, so nobody redraws the character from memory. This one fixes four things, and each is measured rather than hoped for.</p>
        </header>
        <dl class="ledger">
          <div>
            <dt class="display">A voice is a thing you keep, not a setting you re-guess</dt>
            <dd>Most tools generate a voice each time you ask. Here the character's voice is stored as an identity and re-used. The same character sounds like the same person across every line, every scene, and every session. That consistency is measured, not hoped for.</dd>
          </div>
          <div>
            <dt class="display">Who is speaking and what is being said are genuinely separate</dt>
            <dd>The system holds a character's identity apart from the words. That is why one character can say anything without their voice changing, and why changing the line never changes the person. This was verified rather than assumed: when the same audio content is played through two different identities, the words come out identically. The measured error between them was exactly zero on every line tested.</dd>
          </div>
          <div>
            <dt class="display">It does not need a recording of the character</dt>
            <dd>There is no voice cloning here, and no user uploads their own audio. Voices are created from a written description, the way a character is designed from a brief rather than traced from a photograph. That sidesteps the consent and impersonation problem entirely: you cannot accidentally clone a real person if the system never accepts a recording.</dd>
          </div>
          <div>
            <dt class="display">It knows what it does not know</dt>
            <dd>Every capability is measured against a control, and the honest limits are published alongside the results. Roughly twenty findings in this project were wrong on the first attempt and caught by a check, including one where an entire experiment produced fluent-sounding speech that was saying different words than requested, and nothing errored. That is written up publicly rather than quietly fixed. <span class="hand">A suspiciously good or suspiciously bad number is a bug report about your setup.</span></dd>
          </div>
        </dl>
        <aside class="why">
          <h3 class="display">Why Hindi, Bengali and Tamil first</h3>
          <p>The tools that do this well mostly do it in English. Indian-language creators either use a handful of stock voices that everyone else is also using, or they hire actors. This project treats Hindi, Bengali and Tamil as first-class, not as an afterthought port. Measured so far: {languages.join(', ')}. The Indian-language engine covers 22 Indian languages; four measured so far.</p>
        </aside>
      </section>

      <!-- SHEET · SCENE — §8 in order -->
      <section class="sheet" aria-labelledby="scene-title">
        <div class="pegs" aria-hidden="true"><i></i><i class="round"></i><i></i></div>
        <header class="sheet__head">
          <p class="typed">Sheet · scene</p>
          <h2 id="scene-title" class="display">Five lines, three characters, in order</h2>
          <p class="lede">The exposure sheet: the demo's scene in the order it was rendered, three invented voices from three briefs, one line after another.</p>
        </header>
        <button type="button" class="turnbtn" data-scene-play>
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1.5v9l8-4.5z" /></svg>
          <span data-scene-label>Play the scene in order</span>
        </button>
        <ol class="xsheet">
          {scene.map((c) => (
            <li class="row" data-view data-src={c.src} data-seconds={c.seconds}>
              <span class="typed row__who">{c.character}</span>
              <div class="row__body">
                <q>{c.text}</q>
                <span class="typed row__meta">{c.seconds} s · {c.experimentalEmotionSetting ? 'experimental emotion setting, unvalidated' : 'no direction given'}</span>
              </div>
              <button type="button" class="play" data-play aria-label={`Play, ${c.text}`}>
                <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1.5v9l8-4.5z" /></svg><span>Play</span>
              </button>
              <audio preload="none" controls src={c.src}></audio>
            </li>
          ))}
        </ol>
        <div class="caveats">
          <p class="typed caveats__label">Notes on the clips</p>
          <p class="hand caveat">{clipCaveats.watermark}</p>
          <p class="hand caveat">{clipCaveats.emotionSetting}</p>
          <p class="hand caveat">{clipCaveats.englishOnly}</p>
        </div>
      </section>

      <!-- SHEET · MEASUREMENTS — §5 -->
      <section class="sheet" aria-labelledby="measure-title">
        <div class="pegs" aria-hidden="true"><i></i><i class="round"></i><i></i></div>
        <header class="sheet__head">
          <p class="typed">Sheet · measurements</p>
          <h2 id="measure-title" class="display">Measured, with the caveat within reach</h2>
          <p class="lede">Each claim below passed a check against a control. The caveat sits next to it, in the designer's hand, because a claim without its caveat is a different claim.</p>
        </header>
        <dl class="ledger ledger--measure">
          <div>
            <dt class="display">It works end to end today</dt>
            <dd>On one laptop GPU, in English, Hindi, Bengali and Tamil. Describe a character, get a voice, render a scene of dialogue, and out comes watermarked audio plus a file a game engine can read. The demo mints 3 characters from text, renders a 5-line scene, watermarks everything and writes the manifest in about 4 minutes. The clips on this page are that run's output. <span class="hand">One 6 GB laptop GPU; a research system, not a service.</span></dd>
          </div>
          <div>
            <dt class="display">Minting a voice from a description costs nothing in clarity</dt>
            <dd>A described voice is just as intelligible as one taken from a real recording. The measured difference was tiny, leaned slightly in the invented voice's favour, and was smaller than the difference between two real speakers: that gap was six times larger. <span class="hand">Read as no detectable difference, not as invented voices being better. Control first: every version must come out the same length before any score is read, or the run aborts.</span></dd>
          </div>
          <div>
            <dt class="display">Invented voices are recognisably distinct people</dt>
            <dd>Verified by a separate speaker-recognition system that has never seen the generator: an independent check, not the system marking its own homework. Each invented voice also sits clearly apart from the nearest real voice the system learned from, so these are new voices, not real people wearing a label.</dd>
          </div>
          <div>
            <dt class="display">A character stays itself more consistently than a real person does</dt>
            <dd>Across different sentences, a stored voice holds together better than a real person does across different recordings, which is unsurprising once you think about it: a stored voice has no bad-throat day, no change of microphone, no mood.</dd>
          </div>
          <div>
            <dt class="display">A native speaker confirmed the Hindi says what it should</dt>
            <dd>A fluent Hindi speaker has confirmed one rendered line says the target sentence. They were told the sentence and asked “does it say this?”, not “does it sound right?”. That is the check an earlier batch of audio failed: it sounded fluent and was saying different words. The line: <span lang="hi" class="hand hindi">नमस्ते आप कैसे हैं आज मौसम बहुत अच्छा है</span> <span class="typed">our translation, not a project claim: “Hello, how are you? The weather is very nice today.”</span> <span class="hand">Still to be checked: the other three voices and the other two lines.</span></dd>
          </div>
          <div>
            <dt class="display">A blind listening test found and fixed a real problem</dt>
            <dd>A blind listening test with built-in controls found a real problem in how the system judged whether two voices were the same person: pairs the system called different were heard as the same person about half the time. The threshold was raised. That removed 10 duplicate voices from a set of 50 and cost 3 percent of measured variety. <span class="hand">Small test: 8 pairs, one listener, every control answered correctly. It found the problem; it does not settle the exact threshold, and the English threshold has not had its own listening test.</span></dd>
          </div>
          <div>
            <dt class="display">Watermarked and logged from the first render</dt>
            <dd>Every render is watermarked and logged, from the first output, not added later. The watermark is AudioSeal. Output includes a manifest a game engine can consume: this is built for a pipeline, not a demo button. The manifest's own disclosure line: <q>AI-generated synthetic speech. All audio carries an AudioSeal watermark.</q></dd>
          </div>
        </dl>

        <!-- pacing: a timing chart, bounded illustration -->
        <div class="timing">
          <div class="timing__head">
            <h3 class="display">Pacing is controllable within a measured range</h3>
            <p>You can slow a character to about two-thirds of normal speed or push them to about 1.4 times, and they stay the same person saying the same words. Outside that range the identity fades gradually rather than breaking. <span class="hand">Illustration only: nothing on this page re-times a clip.</span></p>
          </div>
          <div class="chart">
            <div class="chart__track" aria-hidden="true">
              <span class="chart__clean"></span>
              <i class="tick t-min"><b>0.67×</b></i><i class="tick t-lo"><b>0.8×</b></i><i class="tick t-one"><b>normal</b></i><i class="tick t-hi"><b>1.25×</b></i><i class="tick t-max"><b>1.43×</b></i>
            </div>
            <input type="range" class="chart__range" min="0.67" max="1.43" step="0.01" value="1" aria-label="Pacing, from about two-thirds to about 1.4 times normal speed" data-pace />
            <p class="chart__read hand" data-pace-read aria-live="polite">normal speed</p>
          </div>
        </div>

        <!-- invent or find -->
        <div class="cast">
          <h3 class="display">Two ways to answer a brief: invent, or find</h3>
          <p class="lede">Inventing gives you a character nobody else has; finding, in an existing library of voices, gives you higher accuracy and studio quality. Neither is strictly better, and the project has numbers for the trade-off.</p>
          <div class="cast__cols">
            <div>
              <p class="typed">Find, on a library of 141 real Hindi voices</p>
              <p>Two thirds of descriptions (65.6%) get a voice that matches on every trait named, and 87 percent land within one step. When the description names only a couple of traits, the way people actually write, a bit over half (53.8%) match exactly on the traits named. About one in five would by chance (about 20%). The same method on a library of 2,500 English voices reaches 88.5%, and it replicates in Bengali within a point or two.</p>
              <p class="hand">Finding cannot produce a voice the library does not contain, cannot guarantee a new character is unique, and the library is someone else's: every character in every project draws from the same shelf.</p>
            </div>
            <div>
              <p class="typed">Invent, and how much variety it reaches</p>
              <p>Finding reaches 87% of the variety the library actually holds; inventing reached 37% before two mis-set settings were fixed. The fix raised the invented catalogue from 14 to 22 distinct Hindi voices and from 23 to 41 English.</p>
              <p class="hand">The library measured was real recorded speakers standing in for a studio library, and no commercial system has been measured.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- SHEET · PIPELINE — §7 -->
      <section class="sheet" aria-labelledby="pipe-title">
        <div class="pegs" aria-hidden="true"><i></i><i class="round"></i><i></i></div>
        <header class="sheet__head">
          <p class="typed">Sheet · pipeline</p>
          <h2 id="pipe-title" class="display">How a brief becomes a voice</h2>
        </header>
        <ol class="flow">
          <li><span class="flow__what">your description</span></li>
          <li class="flow__box"><span class="flow__what">the mapper</span><span class="hand flow__note">the only part that learns</span></li>
          <li><span class="flow__what">a voice identity</span><span class="typed flow__sub">small, storable, versioned</span></li>
          <li class="flow__box"><span class="flow__what">the voice engine</span><span class="hand flow__note">never modified, swappable</span></li>
          <li><span class="flow__what">audio</span><span class="typed flow__sub">watermarked, logged</span></li>
        </ol>
        <dl class="ledger ledger--pipe">
          <div>
            <dt class="display">Only one small piece is trained</dt>
            <dd>The speech engine is used as-is and never altered, so a better engine can be swapped in without rebuilding everything.</dd>
          </div>
          <div>
            <dt class="display">The voice identity is a small, storable thing</dt>
            <dd>That is what makes a character persistent: it can be saved, versioned and handed to someone else. Each one is stored with a short seed clip and the engine version that made it. The identity is who the character is; each line is a separate performance.</dd>
          </div>
          <div>
            <dt class="display">The checker never sees inside the engine</dt>
            <dd>A separate speaker-recognition system does the checking. 114 automated checks guard the rules the project learned the hard way: never accept a user's audio; watermark from the first render; store timbre, not performance; do not start the next stage until this one is measured.</dd>
          </div>
        </dl>
      </section>

      <!-- SHEET · REVISIONS — §6, every item -->
      <section class="sheet sheet--rev" aria-labelledby="rev-title">
        <div class="pegs" aria-hidden="true"><i></i><i class="round"></i><i></i></div>
        <header class="sheet__head">
          <p class="typed">Sheet · revisions</p>
          <h2 id="rev-title" class="display">Not there yet</h2>
          <p class="lede">Red pencil. These are the notes that would come back on the sheet, stated plainly.</p>
        </header>
        <ul class="rev">
          <li><strong>Not a product.</strong> This is a working research system, not a product. There is no signup, no hosted service, no API.</li>
          <li><strong>Emotion is not solved.</strong> You can control pacing within a measured range. You cannot yet say “say this line apologetically” and have it work. That was tested thoroughly and does not work on the current engine, for reasons the project documented and reported upstream: the engine's documented emotion tags turn out not to be recognised by the engine at all, and a listener heard no difference between four tagged versions of the same line.</li>
          <li><strong>The catalogue is small.</strong> Tens of distinct voices per language so far, not hundreds: about 22 in Hindi and 41 in English by the project's own measure. The limit is understood and measured rather than mysterious: the real speakers the system learned from hold about 38 to 48 distinguishable voices, and the project measured exactly where its own method loses variety.</li>
          <li><strong>Cannot ship as a product, for licensing reasons.</strong> The Indian-language engine's training chain includes data licensed for non-commercial use, so no model weights and no Indian-language audio leave the repository. It is research-only today, deliberately, and the reasons are documented.</li>
          <li><strong>Very little has been listened to.</strong> Most results are automatic measurements. One listener, a handful of pairs.</li>
          <li><strong>No comparison against a commercial system.</strong></li>
          <li><strong>The clips on this page are English.</strong> Hindi renders exist and a native speaker has checked one, but the Indian-language engine's licence is research-only, so those clips do not ship, not even here.</li>
          <li><strong>Three of the five demo lines</strong> were rendered with an experimental emotion setting whose effect has not been validated on this engine. Listen to them as voice samples, not performances.</li>
        </ul>
      </section>

      <!-- footer title block: the only honest calls to action -->
      <footer class="sheet sheet--foot">
        <div class="pegs" aria-hidden="true"><i></i><i class="round"></i><i></i></div>
        <div class="foot">
          <div>
            <p class="typed">Production</p>
            <p class="display foot__name">{name.latin} <span lang="hi" class="hand">{name.devanagari}</span></p>
            <p class="typed">research pass 2026-09-02 · implementation and measurement 2026-09-05</p>
          </div>
          <div>
            <a class="cta" href={links.repo}>Read the research</a>
            <a class="cta cta--quiet" href={links.issues}>Corrections welcome</a>
            <p class="hand">If a claim here is wrong, an issue with a primary source is more useful than almost anything else.</p>
          </div>
          <div>
            <p class="typed">Licence</p>
            <p>Research and documentation under a Creative Commons attribution licence; code under MIT. No model weights and no generated Indian-language audio ship.</p>
          </div>
        </div>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --paper: #F4F6F3; --desk: #CBD3CE; --graphite: #2B2D2A; --smudge: #5F655F; --blue: #8CCBE3; --carmine: #C8322B;
