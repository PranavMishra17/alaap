  .hindi { font-size: 1.35rem; display: block; margin-top: .4rem; color: var(--graphite); }
  .why { margin-top: 1.75rem; padding: 1.25rem; border: var(--pencil) solid var(--blue); border-radius: 2px; display: grid; grid-template-columns: minmax(12rem, 1fr) 2.2fr; gap: 1.5rem; }
  .why h3 { font-size: 1.55rem; }
  .why p { max-width: 64ch; }

  /* exposure sheet */
  .xsheet { list-style: none; padding: 0; margin-top: 1.25rem; border-left: var(--pencil) solid var(--graphite); }
  .row { display: grid; grid-template-columns: 7rem minmax(0, 1fr) auto; gap: 1rem; align-items: center; padding: .8rem 0 .8rem 1rem; border-bottom: 1px dashed rgba(43,45,42,.35); position: relative; }
  .row::before { content: ''; position: absolute; left: -.3rem; top: 50%; width: .5rem; height: 1.5px; background: var(--graphite); }
  .row.is-playing { background: rgba(140,203,227,.14); }
  .row__who { color: var(--graphite); font-weight: 700; }
  .row__body { display: grid; gap: .15rem; }
  .row__body q { font-size: 1.1rem; font-weight: 500; }
  .row .play { margin-top: 0; }
  .row audio { grid-column: 1 / -1; }

  /* timing chart */
  .timing { margin-top: 2rem; padding-top: 1.5rem; border-top: var(--pencil) solid var(--graphite); display: grid; grid-template-columns: minmax(12rem, 1fr) 2.2fr; gap: 1.5rem; align-items: start; }
  .timing h3 { font-size: 1.55rem; max-width: 18ch; margin-bottom: .5rem; }
  .timing p { max-width: 60ch; }
  .timing p .hand { display: block; margin-top: .3rem; font-size: 1.05rem; }
  .chart { position: relative; padding: 2.1rem 0 .25rem; }
  .chart__track { position: relative; height: 22px; border: var(--pencil) solid var(--graphite); border-radius: 2px; background: repeating-linear-gradient(90deg, transparent 0 9px, rgba(140,203,227,.5) 9px 10px); }
  .chart__clean { position: absolute; top: -1.5px; bottom: -1.5px; left: 17.1%; width: 59.2%; background: rgba(140,203,227,.55); border: var(--pencil) solid var(--graphite); border-radius: 2px; }
  .tick { position: absolute; top: -1.5rem; transform: translateX(-50%); font-family: var(--typed); font-size: .78rem; color: var(--graphite); }
  .tick::after { content: ''; position: absolute; left: 50%; top: 1.15rem; height: .45rem; width: 1.5px; background: var(--graphite); }
  .t-min { left: 0; transform: none; } .t-min::after { left: 0; } .t-max { left: 100%; transform: translateX(-100%); } .t-max::after { left: auto; right: 0; }
  .t-lo { left: 17.1%; } .t-one { left: 43.4%; } .t-hi { left: 76.3%; }
  .chart__range { position: absolute; left: 0; right: 0; top: 2.1rem; width: 100%; height: 22px; margin: 0; background: transparent; -webkit-appearance: none; appearance: none; cursor: pointer; }
  .chart__range::-webkit-slider-runnable-track { height: 22px; background: transparent; }
  .chart__range::-moz-range-track { height: 22px; background: transparent; }
  .chart__range::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 6px; height: 36px; margin-top: -7px; background: var(--carmine); border: 0; border-radius: 1px; box-shadow: 0 0 0 2px var(--paper); }
  .chart__range::-moz-range-thumb { width: 6px; height: 36px; background: var(--carmine); border: 0; border-radius: 1px; box-shadow: 0 0 0 2px var(--paper); }
  .chart__read { margin-top: 1rem; font-size: 1.15rem; min-height: 1.5em; }
  html:not(.js) .chart__read { display: none; }

  /* invent or find */
  .cast { margin-top: 2rem; padding-top: 1.5rem; border-top: var(--pencil) solid var(--graphite); }
  .cast h3 { font-size: 1.9rem; margin-bottom: .5rem; }
  .cast__cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1.5rem 2.5rem; margin-top: 1.25rem; }
  .cast__cols > div { display: grid; gap: .6rem; align-content: start; border-left: var(--pencil) solid var(--blue); padding-left: 1rem; }
  .cast__cols .typed { color: var(--graphite); font-weight: 700; }
  .cast__cols .hand { font-size: 1.05rem; line-height: 1.35; }

  /* pipeline flow */
  .flow { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; align-items: start; margin: 1rem 0 2rem; }
  .flow li { position: relative; padding: .75rem 2rem .75rem 0; display: grid; gap: .25rem; }
  .flow li:not(:last-child)::after { content: ''; position: absolute; right: .5rem; top: 1.4rem; width: 1.1rem; height: 1.1rem; border-top: var(--pencil) solid var(--graphite); border-right: var(--pencil) solid var(--graphite); transform: translateY(-50%) rotate(45deg); }
  .flow li:not(:last-child)::before { content: ''; position: absolute; right: .5rem; top: 1.4rem; width: 1.6rem; height: 1.5px; background: var(--graphite); }
