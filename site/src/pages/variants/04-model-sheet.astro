  .brief { text-align: left; background: none; border: var(--pencil) dashed rgba(43,45,42,.35); border-radius: 2px; padding: .8rem .9rem .6rem; cursor: pointer; font: inherit; color: inherit; display: grid; gap: .25rem; transition: border-color .15s, background-color .15s; }
