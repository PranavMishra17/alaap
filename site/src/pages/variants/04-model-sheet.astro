  .desk { padding: clamp(.75rem, 2.5vw, 2rem) clamp(.5rem, 2vw, 1.5rem) 3rem; display: grid; gap: clamp(1rem, 2.5vw, 2rem); }
  .sheet { position: relative; background: var(--paper); max-width: 1180px; width: 100%; margin: 0 auto; border: var(--pencil) solid rgba(43,45,42,.55); border-radius: 2px;
    padding: 3.25rem clamp(1rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem); box-shadow: 0 1px 0 rgba(43,45,42,.25); }
  .pegs { position: absolute; top: .9rem; left: 0; right: 0; display: flex; justify-content: center; gap: clamp(2.5rem, 18vw, 16rem); }
