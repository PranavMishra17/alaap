  .flow__box { border: var(--pencil) solid var(--blue); background: rgba(140,203,227,.1); padding-left: .75rem !important; margin-right: 2.4rem; }
  .flow__box::before, .flow__box::after { right: -1.9rem !important; }
  .flow__note { font-size: 1.05rem; line-height: 1.25; }
  .flow__sub { text-transform: none; letter-spacing: 0; }

  /* revisions */
  .sheet--rev .sheet__head h2 { color: var(--carmine); }
  .rev { list-style: none; padding: 0; columns: 2; column-gap: 3rem; }
  .rev li { position: relative; padding-left: 2.2rem; margin-bottom: .9rem; break-inside: avoid; font-family: var(--hand); color: var(--carmine); font-size: 1.22rem; line-height: 1.35; }
  .rev li::before { content: '×'; position: absolute; left: .2rem; top: -.15rem; font-size: 1.9rem; line-height: 1; font-weight: 700; }
  .rev strong { font-weight: 700; }

  /* footer */
  .sheet--foot { padding-top: 3rem; }
  .foot { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1.5rem 2.5rem; align-items: start; }
  .foot > div { display: grid; gap: .5rem; align-content: start; }
  .foot__name { font-size: 2.6rem; }
  .foot__name .hand { font-size: .7em; text-transform: none; }
  .foot p:not(.typed) { max-width: 40ch; }
  .cta { display: inline-block; justify-self: start; font: 800 1.3rem/1 var(--display); text-transform: uppercase; letter-spacing: .03em; color: var(--paper); background: var(--graphite); text-decoration: none; padding: .8rem 1.2rem .7rem; border-radius: 999px; border: var(--pencil) solid var(--graphite); }
  .cta:hover { background: var(--carmine); border-color: var(--carmine); }
  .cta--quiet { background: none; color: var(--graphite); }
  .cta--quiet:hover { color: var(--paper); }

  @media (max-width: 900px) {
    .tb { grid-template-columns: 1fr; }
    .tb__name { border-right: 0; border-bottom: var(--pencil) solid var(--graphite); }
    .thesis, .board, .ledger > div, .why, .timing { grid-template-columns: 1fr; gap: .75rem; }
    .board .lineup { order: 2; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px dashed rgba(43,45,42,.35); }
    .views { grid-template-columns: 1fr; }
    .view__wave { height: 60px; }
    .flow { grid-template-columns: 1fr; margin-bottom: 1.5rem; }
    .flow li { padding: .6rem 0 1.6rem .75rem; }
    .flow li:not(:last-child)::before { right: auto; left: .75rem; top: auto; bottom: .2rem; width: 1.5px; height: 1.1rem; }
    .flow li:not(:last-child)::after { right: auto; left: .95rem; top: auto; bottom: .1rem; width: .7rem; height: .7rem; transform: translateX(-50%) rotate(135deg); }
    .flow__box { margin-right: 0; padding-left: .75rem !important; }
    .flow__box::before, .flow__box::after { right: auto !important; }
    .rev { columns: 1; }
  }
  @media (max-width: 560px) {
    body { font-size: 16px; }
    .tb__fields { grid-template-columns: 1fr 1fr; }
    .tb__fields > div:nth-child(odd) { border-left: 0; }
    .tb__fields > div { border-top: 1px dashed rgba(43,45,42,.35); }
    .tb__fields > div:nth-child(-n+2) { border-top: 0; }
    .row { grid-template-columns: 1fr; gap: .4rem; }
    .row .play { justify-self: start; }
    .pegs { gap: 3.5rem; }
    .sheet { padding-top: 2.75rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>

<script>
  const html = document.documentElement;
  html.classList.add('js');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const css = (n: string) => getComputedStyle(html).getPropertyValue(n).trim();
  const COL = { blue: css('--blue'), graphite: css('--graphite'), carmine: css('--carmine') };

  type View = { el: HTMLElement; audio: HTMLAudioElement; canvas: HTMLCanvasElement | null; seconds: number; peaks: Float32Array | null };
  const views: View[] = Array.from(document.querySelectorAll<HTMLElement>('[data-view]')).map((el) => ({
    el, audio: el.querySelector('audio')!, canvas: el.querySelector('canvas'), seconds: Number(el.dataset.seconds), peaks: null,
  }));
  let playing: View | null = null;
  let queue: View[] = [];
  let onQueueEnd: (() => void) | null = null;

  // --- waveforms: decode the real clip, draw min/max columns like a construction line
  const peakCache = new Map<string, Promise<Float32Array>>();
  function decodePeaks(src: string): Promise<Float32Array> {
    if (!peakCache.has(src)) {
      peakCache.set(src, (async () => {
        const buf = await (await fetch(src)).arrayBuffer();
        const ctx = new OfflineAudioContext(1, 44100, 44100);
        const audio = await ctx.decodeAudioData(buf);
        const data = audio.getChannelData(0);
        const N = 220, per = Math.floor(data.length / N), out = new Float32Array(N);
        for (let i = 0; i < N; i++) { let m = 0; for (let j = i * per, e = j + per; j < e; j++) { const v = Math.abs(data[j]); if (v > m) m = v; } out[i] = m; }
        const max = out.reduce((a, b) => Math.max(a, b), 0.001);
        for (let i = 0; i < N; i++) out[i] = out[i] / max;
        return out;
      })());
    }
    return peakCache.get(src)!;
  }
  function draw(v: View, progress = 0) {
    const c = v.canvas; if (!c) return;
    const ctx = c.getContext('2d')!; const dpr = window.devicePixelRatio || 1;
    const w = c.clientWidth || 300, h = c.clientHeight || 72;
    if (c.width !== Math.round(w * dpr) || c.height !== Math.round(h * dpr)) { c.width = Math.round(w * dpr); c.height = Math.round(h * dpr); }
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, w, h);
    const mid = h / 2;
    ctx.strokeStyle = COL.blue; ctx.lineWidth = 1; ctx.setLineDash([3, 3]);
    ctx.beginPath(); ctx.moveTo(0, mid); ctx.lineTo(w, mid); ctx.stroke(); ctx.setLineDash([]);
    if (!v.peaks) return;
    const N = v.peaks.length, step = w / N, played = Math.floor(progress * N);
    ctx.lineWidth = Math.max(1.2, step * 0.55); ctx.lineCap = 'round';
    for (let i = 0; i < N; i++) {
      const a = v.peaks[i] * (mid - 4) + 1, x = i * step + step / 2;
      ctx.strokeStyle = i < played ? COL.graphite : COL.blue;
      ctx.beginPath(); ctx.moveTo(x, mid - a); ctx.lineTo(x, mid + a); ctx.stroke();
    }
    if (progress > 0 && progress < 1) {
      ctx.strokeStyle = COL.carmine; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(progress * w, 2); ctx.lineTo(progress * w, h - 2); ctx.stroke();
    }
  }
  async function prime(v: View) {
    if (!v.canvas || v.peaks) return; draw(v);
    try { v.peaks = await decodePeaks(v.el.dataset.src!); draw(v); } catch { /* the flat construction line stays */ }
  }

  // --- playback: one clip at a time; a queue plays a list in order and tells its button when it ends
  function endQueue() { const done = onQueueEnd; onQueueEnd = null; queue = []; done?.(); }
  function stopAll() {
    endQueue();
    if (playing) { playing.audio.pause(); playing.el.classList.remove('is-playing'); draw(playing, 0); playing = null; }
  }
  function play(v: View) {
    if (playing && playing !== v) { playing.audio.pause(); playing.el.classList.remove('is-playing'); draw(playing, 0); }
    playing = v; v.el.classList.add('is-playing'); v.audio.currentTime = 0;
    v.audio.play().catch(() => { v.el.classList.remove('is-playing'); if (playing === v) playing = null; endQueue(); });
  }
  function advance() { const v = queue.shift(); if (v) play(v); else endQueue(); }
  function startQueue(list: View[], onEnd: () => void) { queue = list.slice(); onQueueEnd = onEnd; advance(); }
  function tick() {
    if (playing && !playing.audio.paused) {
      const d = playing.audio.duration || playing.seconds;
      draw(playing, Math.min(1, playing.audio.currentTime / d));
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
  for (const v of views) {
    v.audio.addEventListener('ended', () => {
      v.el.classList.remove('is-playing'); draw(v, 0); if (playing === v) playing = null;
      advance();
    });
    v.el.querySelector('[data-play]')?.addEventListener('click', () => {
      if (playing === v && !v.audio.paused) { stopAll(); return; }
      stopAll(); play(v);
    });
  }
  function setTurn(btn: HTMLElement, on: boolean) {
    btn.classList.toggle('is-on', on);
    const label = btn.querySelector('span')!; label.dataset.idle ??= label.textContent || '';
    label.textContent = on ? 'Stop' : label.dataset.idle;
  }
  function wireTurn(btn: HTMLElement, getList: () => View[]) {
    btn.addEventListener('click', () => {
      if (btn.classList.contains('is-on')) { stopAll(); return; }
      stopAll(); setTurn(btn, true); startQueue(getList(), () => setTurn(btn, false));
    });
  }

  // --- the sheets: one brief on file at a time
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.character'));
  const briefs = Array.from(document.querySelectorAll<HTMLElement>('[data-brief]'));
  const charField = document.querySelector<HTMLElement>('[data-field="character"]');
  const viewsOf = (panel: HTMLElement) => views.filter((v) => panel.contains(v.el));
  let typer = 0;
  function writeBrief(el: HTMLElement, text: string, then: () => void) {
    clearInterval(typer);
    if (reduce) { el.textContent = text; el.classList.remove('is-typing'); then(); return; }
    el.textContent = ''; el.classList.add('is-typing'); let i = 0;
    typer = window.setInterval(() => {
      i++; el.textContent = text.slice(0, i);
      if (i >= text.length) { clearInterval(typer); el.classList.remove('is-typing'); then(); }
    }, 22);
  }
  function showSheet(id: string, userInitiated: boolean) {
    stopAll();
    for (const b of briefs) b.setAttribute('aria-pressed', String(b.dataset.brief === id));
    for (const g of document.querySelectorAll<SVGElement>('[data-figure]')) g.classList.toggle('is-active', g.dataset.figure === id);
    if (charField) charField.textContent = id;
    for (const p of panels) {
      const on = p.dataset.character === id; p.hidden = !on;
      if (!on) continue;
      const list = viewsOf(p); for (const v of list) prime(v);
      const line = p.querySelector<HTMLElement>('.brief-line')!;
      const seed = list[0];
      if (userInitiated) writeBrief(line, line.dataset.briefText || '', () => { if (seed) play(seed); });
      else { line.textContent = line.dataset.briefText || ''; }
    }
  }
  for (const b of briefs) b.addEventListener('click', () => showSheet(b.dataset.brief!, true));
  for (const p of panels) { const btn = p.querySelector<HTMLElement>('[data-turn]'); if (btn) wireTurn(btn, () => viewsOf(p)); }
  const sceneBtn = document.querySelector<HTMLElement>('[data-scene-play]');
  if (sceneBtn) wireTurn(sceneBtn, () => views.filter((v) => v.el.classList.contains('row')));
  showSheet('mentor', false);
  // decode the other sheets' clips once the first is up, so switching draws instantly
  window.setTimeout(() => { for (const v of views) prime(v); }, 1200);
  let rt = 0;
  window.addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => { for (const v of views) if (!v.el.closest('[hidden]')) draw(v, 0); }, 120); });

  // --- pacing chart: bounded illustration, words only
  const pace = document.querySelector<HTMLInputElement>('[data-pace]');
  const read = document.querySelector<HTMLElement>('[data-pace-read]');
  if (pace && read) {
    const describe = (x: number) => {
      if (Math.abs(x - 1) < 0.015) return 'normal speed';
      if (x < 0.8) return 'slower, inside the measured range: same person, same words. A listener heard the slow extreme start to sound processed.';
      if (x <= 1.25) return x < 1 ? 'slower, inside the range a listener called clean' : 'faster, inside the range a listener called clean';
      return 'faster, inside the measured range: same person, same words';
    };
    const update = () => { read.textContent = describe(Number(pace.value)); };
    pace.addEventListener('input', update); update();
  }
</script>
