    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 22px;
  }
  .h2--sub { margin-top: clamp(30px, 4vw, 48px); }
  .who {
    font: 600 13.5px/1 var(--display);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .nowrap { white-space: nowrap; }

  /* FRONT: the tape sits beside the words on a wide card, and directly under the thesis on a narrow one */
  .front { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); grid-template-areas: 'head deck' 'body deck'; gap: 0 clamp(28px, 5vw, 64px); align-items: start; }
  .front-head { grid-area: head; }
  .front-body { grid-area: body; }
  .deck { grid-area: deck; }
  .title { display: grid; gap: 4px; margin: 0 0 14px; }
  .title-hi { font: 700 clamp(72px, 9.5vw, 116px)/0.95 var(--display); color: var(--red); }
  .title-latin { font: 700 clamp(30px, 4vw, 44px)/1 var(--display); letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink); padding-left: 3px; }
  .meaning { color: var(--ink-70); font-size: 16px; margin-bottom: 26px; max-width: 34em; }
  .statement { font: 600 clamp(30px, 3.4vw, 42px)/1.05 var(--display); margin: 0 0 20px; max-width: 12em; }
  .lede { font-size: 19px; line-height: 1.5; max-width: 30em; }
  .audience { color: var(--ink-70); max-width: 30em; margin-bottom: 0; }

  /* The cassette */
  .deck { position: relative; }
  .cassette { position: relative; width: 100%; aspect-ratio: 400 / 254; perspective: 1600px; container-type: inline-size; }
  .cassette-inner { position: absolute; inset: 0; transform-style: preserve-3d; transform: rotate(-1.2deg); transition: transform 0.85s cubic-bezier(0.45, 0, 0.2, 1); }
  .cassette.is-b .cassette-inner { transform: rotate(-1.2deg) rotateX(180deg); }
  .face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; transition: visibility 0s linear 0.42s; }
  .face--b { transform: rotateX(180deg); }
  /* Belt and braces: the hidden side is also visibility:hidden, swapped at the half-turn. */
  .cassette.is-b .face--a, .cassette:not(.is-b) .face--b { visibility: hidden; }
  .shell {
    position: absolute; inset: 0;
    background: linear-gradient(160deg, #35363A, var(--shell) 55%, #232427);
    border-radius: 4% / 6.5%;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14), inset 0 -3px 0 rgba(0, 0, 0, 0.45), 0 18px 30px -14px rgba(0, 0, 0, 0.7);
  }
  .screw { position: absolute; width: 3cqw; height: 3cqw; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #8a8a8f 0 28%, #3b3c40 30% 60%, #55565a 62%); box-shadow: inset 0 0 0 0.3cqw rgba(0, 0, 0, 0.5); }
  .screw--tl { left: 2%; top: 3.2%; } .screw--tr { right: 2%; top: 3.2%; }
