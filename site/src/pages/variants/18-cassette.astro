  .status { margin-top: 20px; padding: 12px 14px 8px; border: 1px solid var(--ink-line); border-radius: 3px; background: rgba(255, 255, 255, 0.28); min-height: 88px; }
  .status-meta { font: 600 13px/1.2 var(--display); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-70); margin: 0 0 6px; }
  .status-words { font-size: 19px; line-height: 1.4; margin: 0 0 6px; }
