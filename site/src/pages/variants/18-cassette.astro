</style>

<script>
  const $ = (s: string, r: ParentNode = document) => r.querySelector(s) as HTMLElement;
  const $$ = (s: string, r: ParentNode = document) => Array.from(r.querySelectorAll(s)) as HTMLElement[];

  interface Track { el: HTMLElement; audio: HTMLAudioElement; btn: HTMLButtonElement; side: 'A' | 'B'; index: number; who: string; text: string; desc: string; seconds: number; exp: boolean; kind: string; }

  const tracks: Track[] = $$('.track').map((el) => ({
    el,
    audio: el.querySelector('audio') as HTMLAudioElement,
    btn: el.querySelector('.track-play') as HTMLButtonElement,
    side: el.dataset.side as 'A' | 'B',
    index: Number(el.dataset.index),
    who: el.dataset.who || '',
    text: el.dataset.text || '',
    desc: el.dataset.desc || '',
    seconds: Number(el.dataset.seconds),
    exp: el.dataset.exp === '1',
    kind: el.dataset.kind || '',
  }));
  const sides = {
    A: tracks.filter((t) => t.side === 'A').sort((a, b) => a.index - b.index),
    B: tracks.filter((t) => t.side === 'B').sort((a, b) => a.index - b.index),
  };
  const total = { A: sides.A.reduce((s, t) => s + t.seconds, 0), B: sides.B.reduce((s, t) => s + t.seconds, 0) };

  const cassette = $('#cassette');
  const keyPlay = $('[data-act="play"]') as HTMLButtonElement;
  const keyFlip = $('[data-act="flip"]') as HTMLButtonElement;
  const stSide = $('[data-status-side]');
  const stWho = $('[data-status-who]');
  const stKind = $('[data-status-kind]');
  const stWords = $('[data-status-words]');
  const stNote = $('[data-status-note]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const R_MIN = 11, R_MAX = 28;
  const state = { side: 'A' as 'A' | 'B', i: 0, playing: false, ended: false };
  let raf = 0;

  const current = () => sides[state.side][state.i];

  function packs(face: 'A' | 'B', f: number) {
    const el = $(`.face[data-face="${face}"]`);
    const span = R_MAX * R_MAX - R_MIN * R_MIN;
    const rl = Math.sqrt(R_MAX * R_MAX - f * span);
    const rr = Math.sqrt(R_MIN * R_MIN + f * span);
    $('.pack--l', el).setAttribute('r', rl.toFixed(2));
    $('.pack--r', el).setAttribute('r', rr.toFixed(2));
  }

  function progress() {
    const t = current();
    const before = sides[state.side].slice(0, state.i).reduce((s, x) => s + x.seconds, 0);
    const pos = state.ended ? total[state.side] : before + Math.min(t.audio.currentTime || 0, t.seconds);
    packs(state.side, Math.max(0, Math.min(1, pos / total[state.side])));
  }

  function writeLabel(t: Track) {
    const line = $(`.face[data-face="${t.side}"] [data-hand-line]`);
    const next = t.side === 'A' ? t.desc : t.text;
    if (line.textContent === next) return;
    line.textContent = next;
    if (reduced) return;
    line.classList.remove('is-writing');
    void line.offsetWidth;
    line.classList.add('is-writing');
  }

  function render() {
    const t = current();
    stSide.textContent = state.ended ? `End of side ${state.side}` : `Side ${state.side}`;
    stWho.textContent = state.ended ? (state.side === 'A' ? 'turn over for the scene' : 'turn over for the voices') : t.who;
    stKind.textContent = state.ended ? '' : ` · ${t.kind === 'seed' ? 'seed clip' : 'line'} · ${t.seconds.toFixed(1)} s`;
    stWords.textContent = t.text;
    stNote.hidden = !t.exp;
    tracks.forEach((x) => {
      const isCur = x === t;
      x.el.classList.toggle('is-current', isCur);
      x.btn.setAttribute('aria-pressed', String(isCur && state.playing));
      x.btn.setAttribute('aria-label', `${isCur && state.playing ? 'Stop' : 'Play'} the ${x.who} ${x.kind === 'seed' ? 'seed clip' : 'line'}`);
    });
    keyPlay.setAttribute('aria-pressed', String(state.playing));
    keyPlay.classList.toggle('is-down', state.playing);
    keyFlip.setAttribute('aria-pressed', String(state.side === 'B'));
    cassette.classList.toggle('is-playing', state.playing);
    cassette.classList.toggle('is-b', state.side === 'B');
    writeLabel(t);
    progress();
  }

  function stopAll() {
    tracks.forEach((x) => { if (!x.audio.paused) x.audio.pause(); });
  }

  function loop() {
    progress();
    if (state.playing) raf = requestAnimationFrame(loop);
  }

  function load(side: 'A' | 'B', i: number) {
    const wasPlaying = state.playing;
    const t = current();
    stopAll();
    t.audio.currentTime = 0;
    state.side = side;
    state.i = i;
    state.playing = false;
    state.ended = false;
    render();
    return wasPlaying;
  }

  async function play() {
    if (state.ended) { load(state.side, 0); }
    const t = current();
    stopAll();
    try {
      await t.audio.play();
      state.playing = true;
      state.ended = false;
      render();
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(loop);
    } catch {
      state.playing = false;
      render();
    }
  }

  function stop() {
    const t = current();
    stopAll();
    t.audio.currentTime = 0;
    state.playing = false;
    state.ended = false;
    cancelAnimationFrame(raf);
    render();
  }

  function step(delta: number) {
    const list = sides[state.side];
    const next = Math.max(0, Math.min(list.length - 1, (state.ended ? list.length - 1 : state.i) + delta));
    const resume = load(state.side, next);
    if (resume) play();
  }

  function flip() {
    load(state.side === 'A' ? 'B' : 'A', 0);
    // A fresh side: tape fully on the left hub.
    packs(state.side, 0);
  }

  tracks.forEach((t) => {
    t.audio.addEventListener('ended', () => {
      if (t !== current()) return;
      const list = sides[state.side];
      if (state.i + 1 < list.length) {
        state.playing = false;
        cancelAnimationFrame(raf);
        window.setTimeout(() => { load(state.side, state.i + 1); play(); }, 380);
      } else {
        state.playing = false;
        state.ended = true;
        cancelAnimationFrame(raf);
        render();
      }
    });
    t.btn.addEventListener('click', () => {
      if (t === current() && state.playing) { stop(); return; }
      load(t.side, t.index);
      play();
    });
  });

  $$('.key').forEach((k) => {
    k.addEventListener('click', () => {
      const act = k.dataset.act;
      if (act === 'play') { if (!state.playing) play(); }
      else if (act === 'stop') stop();
      else if (act === 'prev') step(-1);
      else if (act === 'next') step(1);
      else if (act === 'flip') flip();
    });
  });

  packs('A', 0);
  packs('B', 0);
  render();
</script>
