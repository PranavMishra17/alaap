  /* BACK: tracks */
  .sides { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 4vw, 56px); }
  .side-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px 12px; font: 700 26px/1 var(--display); text-transform: uppercase; letter-spacing: 0.04em; padding-bottom: 10px; border-bottom: 2px solid var(--ink); margin-bottom: 4px; }
  .side-head small { font: 400 15px/1.3 var(--body); text-transform: none; letter-spacing: 0; color: var(--ink-70); flex-basis: 100%; }
  .side-badge { display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; border: 2.5px solid var(--red); color: var(--red); font-size: 20px; line-height: 1; vertical-align: middle; }
  .tracks { list-style: none; margin: 0; padding: 0; }
  .track { display: grid; grid-template-columns: 38px minmax(0, 1fr) auto; gap: 12px; align-items: start; padding: 12px 6px 12px 4px; border-bottom: 1px solid var(--ink-line); transition: background 0.2s ease; }
  .track.is-current { background: rgba(35, 74, 128, 0.09); box-shadow: inset 3px 0 0 var(--blue); }
  .track-play { width: 36px; height: 36px; border-radius: 50%; border: 1.5px solid var(--ink); background: transparent; color: var(--ink); cursor: pointer; display: grid; place-items: center; padding: 0; margin-top: 2px; }
  .track-play svg { width: 14px; height: 14px; fill: currentColor; }
  .track-play .ico-stop { display: none; }
  .track-play[aria-pressed='true'] { background: var(--ink); color: var(--card); }
  .track-play[aria-pressed='true'] .ico-play { display: none; }
