  }
  .side-mark {
    position: absolute; left: 3.6cqw; top: 3.2cqw;
    width: 8cqw; height: 8cqw; border-radius: 50%;
    border: 0.45cqw solid var(--red); color: var(--red);
    font: 700 5.2cqw/8cqw var(--display); text-align: center;
  }
  .hand { margin: 0; font-family: var(--hand); color: var(--blue); border-bottom: 1px solid rgba(35, 74, 128, 0.38); }
  .hand--title { font-size: 5cqw; line-height: 1.35; font-weight: 700; padding-left: 10.5cqw; padding-bottom: 0.3cqw; transform: rotate(-0.4deg); }
  .hand-side { font-weight: 400; font-size: 3.2cqw; margin-left: 1cqw; }
  .hand--line { font-size: 3.2cqw; line-height: 1.45; font-weight: 400; padding: 0.8cqw 0 0.2cqw 1cqw; min-height: 5cqw; }
  .hand--line.is-writing { animation: write 0.75s steps(28, end) both; }
  @keyframes write { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  .window { position: absolute; left: 25%; top: 40%; width: 50%; height: 25.5%; display: block; overflow: visible; }
  .hub { transform-box: fill-box; transform-origin: center; }
  .cassette.is-playing .hub { animation: spin 1.15s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .foot { position: absolute; left: 17%; right: 17%; bottom: 0; height: 21%; background: rgba(0, 0, 0, 0.28); border-radius: 12% 12% 0 0 / 40% 40% 0 0; display: flex; justify-content: space-between; align-items: flex-end; padding: 0 8% 3.2cqw; }
  .foot i { width: 3.6cqw; height: 3.6cqw; border-radius: 50%; background: radial-gradient(#0d0d10 55%, #45464b 60%); }
  .foot i:nth-child(2), .foot i:nth-child(3) { width: 2.4cqw; height: 2.4cqw; margin-bottom: 0.5cqw; }

  /* Deck keys, piano-key style */
  .keys { display: flex; gap: 6px; margin-top: 22px; }
  .key {
