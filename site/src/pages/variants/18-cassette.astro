  .no-js .track { grid-template-columns: minmax(0, 1fr) auto; }
  .no-js .track.is-current { background: none; box-shadow: none; }
  .track-notes { margin-top: 30px; padding-top: 18px; border-top: 2px solid var(--ink); font-size: 15.5px; line-height: 1.5; columns: 2; column-gap: 40px; }
  .track-notes p { break-inside: avoid; margin-bottom: 0.8em; }
  .track-notes strong { font-weight: 700; }
  .track-notes-small { color: var(--ink-70); }

  /* LINER NOTES */
  .prose p { max-width: 62em; }
  .notes-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px clamp(24px, 4vw, 56px); }
  .notes-grid--three { grid-template-columns: 1fr 1fr 1fr; margin-top: 34px; }
  .notes-grid article { border-top: 2px solid var(--ink); padding-top: 12px; }
  .notes-grid h3 { font: 700 23px/1.05 var(--display); text-transform: uppercase; letter-spacing: 0.02em; margin: 0 0 10px; color: var(--blue); }
  .notes-grid p { margin-bottom: 0; }
  .pencil { margin: 36px 0 0; font: 400 clamp(19px, 2.2vw, 24px)/1.35 var(--hand); color: rgba(26, 29, 38, 0.66); transform: rotate(-1.2deg); max-width: 28em; }
  .pencil-by { display: block; font-size: 0.75em; }

