  .deck-note { font-size: 14.5px; line-height: 1.5; color: var(--ink-70); margin: 12px 0 0; }

  /* SPINE */
  .panel--spine { padding-top: 14px; padding-bottom: 14px; background: rgba(26, 29, 38, 0.05); }
  .spine { margin: 0; font: 600 clamp(13px, 1.6vw, 17px)/1.4 var(--display); letter-spacing: 0.2em; text-transform: uppercase; text-align: center; color: var(--ink); overflow-wrap: anywhere; }
  .spine [lang='hi'] { color: var(--red); letter-spacing: 0.06em; font-size: 1.25em; vertical-align: -0.05em; }
  .spine-latin { color: var(--red); }
