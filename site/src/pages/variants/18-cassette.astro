  .panel { padding: clamp(28px, 5vw, 56px) clamp(18px, 5vw, 64px); }
  .panel-tag {
    font: 600 12px/1 var(--display);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--red);
    margin: 0 0 22px;
