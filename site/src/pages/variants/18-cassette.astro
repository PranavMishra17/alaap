  .measured { margin: 0; display: grid; gap: 22px; }
  .measured > div { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 8px clamp(20px, 4vw, 48px); padding-top: 14px; border-top: 1px solid var(--ink-line); }
  .measured dt { font: 600 21px/1.25 var(--body); }
  .measured dd { margin: 0; font-size: 16px; line-height: 1.55; color: var(--ink-70); }
  .measured dd p { margin-bottom: 0.8em; }
  .hindi { font-size: 1.1em; color: var(--ink); font-weight: 600; }
  /* Pacing: a bounded slider drawn in HTML so the scale stays legible at phone width */
  .pitch { margin: 10px 0 0; max-width: 560px; }
  .pitch-cap { position: relative; left: 17.1%; width: 59.2%; margin: 0 0 24px; text-align: center; font: 600 12px/1 var(--display); letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue); white-space: nowrap; }
  .pitch-bar { position: relative; height: 14px; border-radius: 7px; background: rgba(26, 29, 38, 0.12); box-shadow: inset 0 0 0 1px rgba(26, 29, 38, 0.4); }
  .pitch-clean { position: absolute; left: 17.1%; width: 59.2%; top: -8px; bottom: -8px; border-radius: 4px; background: rgba(35, 74, 128, 0.18); border: 1px dashed var(--blue); }
  .pitch-knob { position: absolute; left: 43.4%; top: -14px; width: 14px; height: 42px; margin-left: -7px; border-radius: 3px; background: #35363A; border: 1px solid #17181b; }
  .pitch-knob::after { content: ''; position: absolute; left: 50%; top: 6px; bottom: 6px; width: 2px; margin-left: -1px; background: #E8E4D8; }
  .pitch-scale { position: relative; height: 24px; margin: 16px 0 0; padding: 0; list-style: none; font: 600 14px/1 var(--display); color: var(--ink); }
  .pitch-scale li { position: absolute; left: var(--x); top: 4px; transform: translateX(-50%); white-space: nowrap; }
  .pitch-scale li::before { content: ''; position: absolute; left: 50%; top: -12px; width: 1.5px; height: 8px; background: rgba(26, 29, 38, 0.6); }
  .pitch-scale li:first-child { transform: none; }
  .pitch-scale li:first-child::before { left: 0; }
  .pitch-scale li:last-child { transform: translateX(-100%); }
  .pitch-scale li:last-child::before { left: auto; right: 0; }
  .pitch figcaption { font-size: 14px; line-height: 1.45; color: var(--ink-70); margin-top: 2px; }
  .prose-intro { max-width: 60em; }
  .ways { display: grid; grid-template-columns: 1fr 1fr; gap: 20px clamp(24px, 4vw, 56px); }
  .way { border-top: 2px solid var(--ink); padding-top: 12px; }
  .way h3 { font: 700 26px/1 var(--display); text-transform: uppercase; color: var(--blue); margin: 0 0 10px; }
  .way p { margin-bottom: 0.8em; }
  .way-limit { font-size: 16px; color: var(--ink-70); }
  .caveat { margin: 18px 0 0; font-size: 15.5px; color: var(--ink-70); }

  /* CHAIN */
  .chain { list-style: none; margin: 0 0 8px; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 18px; position: relative; }
  .chain::before { content: ''; position: absolute; left: 4%; right: 4%; top: 50%; height: 7px; margin-top: -3px; background: var(--oxide); box-shadow: 0 1px 0 rgba(255, 255, 255, 0.35); }
  .chain-step { position: relative; z-index: 1; background: var(--paper); border: 1px solid rgba(26, 29, 38, 0.35); border-radius: 3px; padding: 14px 14px 12px; display: grid; gap: 4px; box-shadow: 0 2px 0 rgba(26, 29, 38, 0.15); }
  .chain-step--trained { border: 2px dashed var(--red); }
  .chain-what { font: 700 20px/1.05 var(--display); text-transform: uppercase; letter-spacing: 0.02em; }
  .chain-step--trained .chain-what { color: var(--red); }
  .chain-note { font-size: 14.5px; color: var(--ink-70); line-height: 1.35; }

  /* NOTICE */
  .notice { border: 4px double var(--ink); padding: clamp(18px, 3vw, 32px) clamp(18px, 3.5vw, 40px); background: rgba(255, 255, 255, 0.18); }
  .notice .h2 { color: var(--red); }
  .notice-list { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: clamp(24px, 4vw, 56px); }
  .notice-list li { break-inside: avoid; margin: 0 0 14px; padding-left: 16px; border-left: 3px solid var(--red); font-size: 16.5px; line-height: 1.5; }
  .notice-list strong { font-weight: 700; color: var(--ink); }

  /* COLOPHON */
  .colophon { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 24px clamp(24px, 4vw, 56px); align-items: start; }
  .colophon-text p { font-size: 15.5px; color: var(--ink-70); max-width: 44em; }
  .colophon-quote { color: var(--ink); }
  .cta { display: grid; gap: 12px; justify-items: start; }
  .cta-link { display: inline-block; font: 700 22px/1 var(--display); text-transform: uppercase; letter-spacing: 0.06em; color: var(--card); background: var(--ink); text-decoration: none; padding: 12px 18px 10px; border-radius: 3px; box-shadow: 0 3px 0 #0b0c10; }
