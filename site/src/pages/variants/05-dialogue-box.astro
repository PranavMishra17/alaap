  .box:focus { outline: none; }
  .box h3 { font: 600 1.45rem/1.15 var(--display); letter-spacing: 0.01em; margin: 0 0 0.6rem; color: #fff; }
  .box b { font-weight: 700; color: #fff; }
  .plate {
    position: absolute; top: -1.05rem; left: 1.25rem;
    display: inline-flex; align-items: baseline; gap: 0.5rem;
