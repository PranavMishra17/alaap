  .portrait .empty { position: absolute; inset: auto 0 0.45rem; text-align: center; font: 600 0.62rem/1 var(--display); letter-spacing: 0.18em; text-transform: uppercase; color: var(--dim); transition: opacity 0.2s; }
  .is-speaking .portrait { border-color: var(--jade); }
