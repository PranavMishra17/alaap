  .stage-note { max-width: 36rem; color: var(--dim); margin: 0; }
  .hero-box { margin: 0 0 2.6rem; }
  .js:not(.rm) .hero-box .words, .js:not(.rm) .hero-box .meta, .js:not(.rm) .hero-box .player { animation: arrive 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) 2.2s both; }

  /* ───── The dialogue box ───── */
  .box {
    position: relative;
    background: var(--box);
    border: 2px solid var(--bone);
    border-radius: 8px;
    box-shadow: inset 0 0 0 3px var(--box), inset 0 0 0 4px var(--bone);
