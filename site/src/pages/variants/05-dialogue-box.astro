  /* voiced boxes: portrait slot left, the line right */
  .voiced { display: grid; grid-template-columns: 6.25rem 1fr; gap: 0 1.6rem; grid-template-areas: 'portrait words' 'portrait meta' 'portrait player'; align-items: start; }
  .portrait {
