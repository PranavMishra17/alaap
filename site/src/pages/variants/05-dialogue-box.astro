    font: 600 0.92rem/1 var(--display); letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--marigold); background: transparent; border: 2px solid var(--marigold); border-radius: 4px;
    padding: 0.55rem 0.95rem 0.45rem; transition: background 0.15s, color 0.15s;
  }
  .play:hover, .play[aria-pressed='true'] { background: var(--marigold); color: var(--night); }
  .play[hidden] { display: none; }
  .play .glyph { font-size: 0.8em; }
  html:not(.js) .scene-hint { display: none; }

  /* choices */
  .choices ul { list-style: none; margin: 0; padding: 0; }
  .choices .ask { font: 600 0.88rem/1.4 var(--display); letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim); margin: 0 0 0.75rem; }
  .choices li + li { margin-top: 0.15rem; }
  .choices li a {
    display: block; position: relative; padding: 0.4rem 0.6rem 0.4rem 2rem; border-radius: 4px;
    color: var(--bone); text-decoration: none; font-size: 1.08rem;
  }
  .choices li a::before { content: '▶'; position: absolute; left: 0.55rem; top: 0.55rem; color: var(--marigold); font: 700 0.85rem/1.5 var(--display); opacity: 0.35; transition: opacity 0.12s; }
  .choices li a:hover, .choices li a:focus-visible { color: #fff; }
  .choices li a:hover::before, .choices li a:focus-visible::before { opacity: 1; }
  .choices .meta { margin-top: 0.9rem; }
  .choices .ext { display: block; font: 400 0.78rem/1.5 var(--mono); color: var(--dim); }
  .back { margin: -0.9rem 0 0; }
  .back a { display: inline-block; font: 600 0.8rem/1 var(--display); letter-spacing: 0.18em; text-transform: uppercase; color: var(--dim); text-decoration: none; padding: 0.4rem 0; }
  .back a:hover { color: var(--marigold); }

  /* chapters */
  .branch { padding-top: 1.5rem; }
  .chapter { display: flex; align-items: center; gap: 1.2rem; margin: 2.2rem 0 2.6rem; font: 600 0.95rem/1 var(--display); letter-spacing: 0.26em; text-transform: uppercase; color: var(--bone); }
  .chapter::before, .chapter::after { content: ''; flex: 1; height: 1px; background: var(--line); }

  /* the Hindi line */
  .hindi { font-size: 1.5rem; line-height: 1.7; color: #fff; margin: 0.2rem 0 0; }

  /* pacing illustration, styled like an options-menu row */
  .pace { margin: 1.3rem 0 0.4rem; }
  .pace-row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; font: 600 0.82rem/1 var(--display); letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 0.7rem; }
  .pace-legend { color: var(--dim); display: inline-flex; gap: 0.5rem; align-items: center; letter-spacing: 0.1em; }
  .sw { display: inline-block; width: 0.8rem; height: 0.55rem; border-radius: 2px; margin-left: 0.6rem; }
  .sw.measured { background: rgba(111, 207, 191, 0.32); }
  .sw.clean { background: var(--jade); }
  .pace-track { position: relative; height: 16px; border: 1px solid var(--line); border-radius: 3px; }
  .pace-measured { position: absolute; top: 3px; bottom: 3px; left: 15.5%; width: 69%; background: rgba(111, 207, 191, 0.32); border-radius: 2px; }
  .pace-clean { position: absolute; top: 3px; bottom: 3px; left: 27.3%; width: 40.9%; background: var(--jade); border-radius: 2px; }
  .pace-one { position: absolute; top: -5px; bottom: -5px; left: 45.5%; width: 2px; background: var(--marigold); }
  .pace-labels { position: relative; height: 1.5em; margin-top: 0.4rem; font: 400 0.76rem/1.5 var(--mono); color: var(--dim); }
  .pace-labels span { position: absolute; transform: translateX(-50%); white-space: nowrap; }
  .pace-labels .one { color: var(--marigold); }

  /* invent / find */
  .twoway { display: grid; grid-template-columns: 1fr 1.4fr; gap: 1.4rem; margin: 0.4rem 0 0.9rem; }
  .way { border-left: 2px solid var(--line); padding-left: 1rem; }
  .way-name { font: 600 1.05rem/1 var(--display); letter-spacing: 0.16em; text-transform: uppercase; color: var(--marigold); margin: 0 0 0.6rem; }

  /* the flow: one column of nodes, the two annotations beside the nodes they belong to */
  .flow { display: grid; grid-template-columns: max-content 1fr; gap: 0.2rem 1rem; align-items: center; font: 400 0.86rem/1.35 var(--mono); margin: 0.3rem 0 1.3rem; }
  .node { grid-column: 1; padding: 0.5rem 0.75rem; border: 1px solid var(--bone); border-radius: 4px; color: #fff; }
  .node.trained { border-color: var(--jade); border-style: dashed; color: var(--jade); }
  .flow .arrow { grid-column: 1; text-align: center; color: var(--marigold); line-height: 1; }
  .flow .why { grid-column: 2; font-size: 0.74rem; color: var(--dim); }
  .flow .why.trained { color: var(--jade); }

  .cannot { margin-top: 0.2rem; }
  .endline { text-align: center; font: 600 0.78rem/1.7 var(--display); letter-spacing: 0.22em; text-transform: uppercase; color: var(--dim); margin: 2.5rem 0 4rem; }
  .endline > span { display: block; }
  .endline .dates span { white-space: nowrap; }
  .endline .dates span + span::before { content: '\00a0·  '; white-space: normal; }

  @keyframes blink { to { visibility: hidden; } }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(4px); } }
  @keyframes arrive { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  @media (max-width: 640px) {
    body { font-size: 16px; }
    .hud { padding-top: 0.9rem; }
    .hud-links { gap: 1rem; font-size: 0.72rem; }
    .hero { min-height: calc(100svh - 4.6rem); }
    .stage { padding: 1.5rem 0 1.3rem; }
    .stage-note { font-size: 0.95rem; }
    .box { padding: 1.6rem 1.15rem 1.9rem; margin: 1.9rem 0; }
    .thesis { margin-bottom: 1.3rem; }
    .plate { left: 0.9rem; font-size: 0.9rem; }
    /* portrait beside the line, the meta and the player full width below */
    .voiced { grid-template-columns: 4.6rem 1fr; grid-template-areas: 'portrait words' 'meta meta' 'player player'; gap: 0.5rem 0.9rem; }
    .voiced .meta { margin-top: 0.4rem; }
    .voiced .player { margin-top: 0.6rem; }
    .words { font-size: 1.18rem; }
    .box h3 { font-size: 1.3rem; }
    .twoway { grid-template-columns: 1fr; gap: 1rem; }
    .pace-row { flex-wrap: wrap; }
    .pace-labels { height: 2.8em; }
    .pace-labels span:nth-child(2), .pace-labels span:nth-child(4) { top: 1.3em; }
    .flow { gap: 0.2rem 0.7rem; }
    .endline { font-size: 0.72rem; letter-spacing: 0.18em; }
    .advance .hint { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>

<script>
  const root = document.documentElement;
  const rm = root.classList.contains('rm');
  const $ = (s: string, r: ParentNode = document) => r.querySelector(s) as HTMLElement | null;
  const $$ = (s: string, r: ParentNode = document) => Array.from(r.querySelectorAll(s)) as HTMLElement[];
  let repick = () => {}; // set in section 5; called when a box starts or stops speaking

  // ── 1. The stage types the description that minted the mentor. The box arrives on a CSS timer.
  const typed = $('.typed');
  if (typed && !rm) {
    const full = typed.dataset.text || typed.textContent || '';
    typed.textContent = '';
    let i = 0;
    const step = () => {
      i += 1;
      typed.textContent = full.slice(0, i);
      if (i < full.length) setTimeout(step, full[i - 1] === ',' ? 150 : 22);
    };
    setTimeout(step, 300);
  }

  // ── 2. Audio. One context, one analyser; the portrait slot shows the voice while it plays.
  let ctx: AudioContext | null = null;
  let analyser: AnalyserNode | null = null;
  const sources = new WeakMap<HTMLMediaElement, MediaElementAudioSourceNode>();
  const bins = new Uint8Array(64);
  const audioOk = (audio: HTMLMediaElement) => {
    try {
      const AC = window.AudioContext || (window as any).webkitAudioContext;
      if (!AC) return false;
      if (!ctx) {
        ctx = new AC();
        analyser = ctx.createAnalyser();
        analyser.fftSize = 128;
        analyser.smoothingTimeConstant = 0.72;
        analyser.connect(ctx.destination);
      }
      if (!sources.has(audio)) {
        const src = ctx.createMediaElementSource(audio);
        src.connect(analyser!);
        sources.set(audio, src);
      }
      if (ctx.state === 'suspended') ctx.resume();
      return true;
    } catch { return false; }
  };

  type Voice = { audio: HTMLAudioElement; play: () => void };
  const voices = new Map<HTMLElement, Voice>();
  const allAudio = $$('audio') as HTMLAudioElement[];

  for (const box of $$('.voiced')) {
    const audio = $('audio', box) as HTMLAudioElement | null;
    const btn = $('.play', box) as HTMLButtonElement | null;
    const txt = $('.txt', box);
    const canvas = $('canvas', box) as HTMLCanvasElement | null;
    if (!audio || !btn || !txt || !canvas) continue;
    audio.removeAttribute('controls');
    btn.hidden = false;

    const chars = Array.from(txt.textContent || '').map((ch) => {
      const s = document.createElement('span');
      s.className = 'ch';
      s.textContent = ch;
      return s;
    });
    txt.textContent = '';
    for (const s of chars) txt.append(s);

    const seconds = Number(box.dataset.seconds) || 3;
    const g = canvas.getContext('2d');
    let raf = 0;
    const lbl = $('.lbl', btn)!;
    const glyph = $('.glyph', btn)!;
    const setState = (playing: boolean) => {
      lbl.textContent = playing ? 'Pause' : 'Play';
      glyph.textContent = playing ? '❚❚' : '▶';
      btn.setAttribute('aria-pressed', String(playing));
    };
    const clear = () => { if (g) g.clearRect(0, 0, canvas.width, canvas.height); };
    const fit = () => {
      const r = canvas.getBoundingClientRect();
      const d = window.devicePixelRatio || 1;
      canvas.width = Math.max(1, Math.round(r.width * d));
      canvas.height = Math.max(1, Math.round(r.height * d));
    };
    const draw = () => {
      const p = Math.min(1, audio.currentTime / (audio.duration || seconds));
      const n = Math.round(p * chars.length);
      chars.forEach((c, k) => c.classList.toggle('on', k < n));
      if (g && analyser) {
        analyser.getByteFrequencyData(bins);
        const W = canvas.width, H = canvas.height, count = 14, w = W / count;
        g.clearRect(0, 0, W, H);
        g.fillStyle = '#6FCFBF';
        for (let k = 0; k < count; k++) {
          const v = bins[k + 1] / 255;
          const h = Math.max(2, v * H * 0.92);
          g.fillRect(k * w + w * 0.22, H - h, w * 0.56, h);
        }
      }
      raf = requestAnimationFrame(draw);
    };

    audio.addEventListener('play', () => {
      for (const other of allAudio) if (other !== audio && !other.paused) other.pause();
      box.classList.add('is-speaking');
      setState(true);
      cancelAnimationFrame(raf);
      if (!rm) { box.classList.add('revealing'); fit(); raf = requestAnimationFrame(draw); }
      repick();
    });
    audio.addEventListener('pause', () => {
      cancelAnimationFrame(raf);
      box.classList.remove('is-speaking');
      setState(false);
      clear();
      repick();
    });
    audio.addEventListener('ended', () => {
      box.classList.remove('revealing');
      for (const c of chars) c.classList.add('on');
    });
    btn.addEventListener('click', () => {
      if (audio.paused) { audioOk(audio); audio.play().catch(() => {}); } else audio.pause();
    });
    voices.set(box, {
      audio,
      play: () => { audioOk(audio); audio.currentTime = 0; audio.play().catch(() => {}); },
    });
  }

  // ── 3. Choices that name a description replay that character's stored seed clip.
  for (const a of $$('a[data-play]')) {
    a.addEventListener('click', () => {
      const target = $(a.getAttribute('href') || '');
      const v = target && voices.get(target);
      if (v) v.play();
    });
  }

  // ── 4. Play the scene: the five lines back to back, scrolling along.
  const sceneBtn = $('#play-scene') as HTMLButtonElement | null;
  const lines = $$('.voiced[data-line]');
  if (sceneBtn && lines.length) {
    sceneBtn.hidden = false;
    const sceneLbl = $('.lbl', sceneBtn)!;
    const sceneGlyph = $('.glyph', sceneBtn)!;
    let running = false;
    let at = -1;
    const idle = () => { sceneLbl.textContent = 'Play the scene'; sceneGlyph.textContent = '▶'; sceneBtn.setAttribute('aria-pressed', 'false'); };
    const stop = () => {
      running = false;
      idle();
      const v = at >= 0 && voices.get(lines[at]);
      if (v) v.audio.pause();
      at = -1;
    };
    const next = () => {
      at += 1;
      if (at >= lines.length) return stop();
      const box = lines[at];
      box.scrollIntoView({ block: 'center', behavior: rm ? 'auto' : 'smooth' });
      voices.get(box)?.play();
    };
    lines.forEach((box, k) => {
      const v = voices.get(box);
      if (!v) return;
      v.audio.addEventListener('ended', () => { if (running && at === k) setTimeout(next, 500); });
      v.audio.addEventListener('play', () => { if (running && at !== k) { running = false; idle(); } });
    });
    sceneBtn.addEventListener('click', () => {
      if (running) stop();
      else { running = true; sceneLbl.textContent = 'Stop'; sceneGlyph.textContent = '■'; sceneBtn.setAttribute('aria-pressed', 'true'); next(); }
    });
  }

  // ── 5. The current line carries the advance prompt. A box that is speaking is current; otherwise
  //       the first box, in reading order, that has not yet scrolled past the reading line near the
  //       top of the screen. A ▼ jump lands its target just under that line, so the target is current.
  const boxes = $$('.box');
  let queued = false;
  let current: HTMLElement | null = null;
  const pick = () => {
    queued = false;
    const H = window.innerHeight;
    const line = H * 0.2;
    let best: HTMLElement | null = null;
    const speaking = boxes.find((b) => b.classList.contains('is-speaking'));
    if (speaking) {
      const r = speaking.getBoundingClientRect();
      if (r.bottom > 0 && r.top < H) best = speaking;
    }
    if (!best) {
      for (const b of boxes) {
        const r = b.getBoundingClientRect();
        if (r.bottom <= line) continue;
        if (r.top >= H) break;
        best = b;
        break;
      }
    }
    current = best || current;
    for (const b of boxes) b.classList.toggle('is-active', b === current);
  };
  repick = pick;
  window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(pick); } }, { passive: true });
  window.addEventListener('resize', pick);
  pick();
</script>
