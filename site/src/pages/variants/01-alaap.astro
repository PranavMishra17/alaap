---
// Variant 01 · alaap. The page is an alaap: a drone that never stops, a voice entering on Sa,
// the range mapped one note at a time, pace gathering from vilambit to drut, the octave's return.
import { name, meaning, links, characters, clips, scene, seeds, clipCaveats } from '../../content/alaap';

const mentorSeed = clips.find((c) => c.id === 'mentor_seed')!;
const example = characters.find((c) => c.id === 'mentor')!;
const swaras = [
  { id: 'sa', dev: 'सा', lat: 'Sa', title: 'Alaap', gloss: 'the tonic. The voice enters.' },
  { id: 're', dev: 'रे', lat: 'Re', title: 'Who it is for', gloss: '' },
  { id: 'ga', dev: 'ग', lat: 'Ga', title: 'Three voices, five lines', gloss: '' },
  { id: 'ma', dev: 'म', lat: 'Ma', title: 'What makes it different', gloss: '' },
  { id: 'pa', dev: 'प', lat: 'Pa', title: 'How it works', gloss: 'the fifth, the second drone string.' },
  { id: 'dha', dev: 'ध', lat: 'Dha', title: 'What was measured', gloss: '' },
  { id: 'ni', dev: 'नि', lat: 'Ni', title: 'What is not there yet', gloss: 'the leading note. It does not resolve on its own.' },
  { id: 'sa2', dev: 'सां', lat: 'Sa', title: 'The return', gloss: 'the octave.' },
] as const;
const sw = (id: string) => swaras.find((s) => s.id === id)!;
const hindiLine = 'नमस्ते आप कैसे हैं आज मौसम बहुत अच्छा है';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alaap — describe a character, get a voice nobody has recorded, keep it</title>
    <meta name="description" content="Describe a character. Get a voice nobody has recorded. Keep it. A working research system for Indian-language character voices, with its limits stated plainly." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anek+Latin:wdth,wght@75..125,300..700&family=Eczar:wght@400..800&family=Xanh+Mono:ital@0;1&display=swap" rel="stylesheet" />
  </head>
  <body>
    <aside class="tanpura" aria-label="The tanpura: the sections of this page as the notes of the ascent">
      <div class="strings" aria-hidden="true">
        <i style="--n:0"></i><i style="--n:1"></i><i style="--n:2"></i><i style="--n:3"></i>
        <span class="bead"></span>
      </div>
      <nav class="swaras" aria-label="Sections">
        {swaras.map((s) => (
          <a href={`#${s.id}`} data-for={s.id} title={s.title}>
            <b lang="hi">{s.dev}</b><small>{s.lat}</small><span class="sr">{s.title}</span>
          </a>
        ))}
      </nav>
      <button class="drone" type="button" aria-pressed="false" hidden>
        <b lang="hi">तानपुरा</b> <span>tanpura</span> <em>off</em>
      </button>
    </aside>

    <main>
      <!-- सा · the voice enters -->
      <section class="raga" id="sa" data-laya="vilambit">
        <header class="mark swar">
          <span class="swara"><b lang="hi">{sw('sa').dev}</b> {sw('sa').lat} <i>· {sw('sa').gloss}</i></span>
        </header>
        <h1 class="swar"><span lang="hi" class="dev">{name.devanagari}</span><span class="lat">{name.latin}</span></h1>
        <p class="meaning swar">{meaning}</p>
        <p class="lead swar">You describe a character in ordinary language. You get back a voice that has never existed. Then you use that voice for any line of dialogue you write, and it stays the same character every time.</p>

        <div class="example swar">
          <p class="cue">The example. A description, then the voice it minted.</p>
          <p class="desc" lang="en">“{example.description}”</p>
          <button class="hear" type="button" hidden>Hear the example</button>
          <div class="clip" data-clip={mentorSeed.id} data-src={mentorSeed.src} data-who={mentorSeed.character}>
            <button class="play" type="button" aria-label={`Play: ${mentorSeed.text}`} hidden>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path class="tri" d="M4 2.5v11l9-5.5z" /><path class="bars" d="M3.5 2.5h3v11h-3zM9.5 2.5h3v11h-3z" /></svg>
            </button>
            <div class="meta"><span class="who">{mentorSeed.character}, seed clip</span><span class="len">{mentorSeed.seconds} s</span></div>
            <p class="words">“{mentorSeed.text}”</p>
            <canvas class="string" aria-hidden="true"></canvas>
            <audio controls preload="none" src={mentorSeed.src}></audio>
          </div>
          <p class="fine">This replays the seed clip the system stored when it minted the voice from that description, on 2026-09-05. Nothing on this page generates live. The tanpura, when you turn it on, is synthesised in your browser and stays under the clips.</p>
        </div>
      </section>

      <!-- रे -->
      <section class="raga" id="re" data-laya="vilambit">
        <header class="mark swar">
          <span class="swara"><b lang="hi">{sw('re').dev}</b> {sw('re').lat}</span>
          <h2>{sw('re').title}</h2>
        </header>
        <p class="lead swar">People making games, animation, audio drama, dubbing, interactive fiction: anyone who needs many distinct speaking characters and cannot hire a cast for each one.</p>
        <p class="swar">The tools that do this well mostly do it in English. Indian-language creators either use a handful of stock voices that everyone else is also using, or they hire actors. This project treats Hindi, Bengali and Tamil as first-class, not as an afterthought port. Indic is the stated reason the project exists.</p>
        <p class="swar">Proven so far in English, Hindi, Bengali and Tamil. The Indian-language engine it builds on covers 22 Indian languages; four are measured so far. In the project's own measurements the Hindi path scored higher than the English path on each of its identity checks, and the Indian-language speech data it builds on holds more distinct speakers than any English set it has, under a licence that allows commercial use.</p>
      </section>

      <!-- ग -->
      <section class="raga" id="ga" data-laya="madhya">
        <header class="mark swar">
          <span class="swara"><b lang="hi">{sw('ga').dev}</b> {sw('ga').lat}</span>
          <h2>{sw('ga').title}</h2>
        </header>
        <p class="lead swar">The demo mints three characters from text, renders a five-line scene, watermarks everything and writes the manifest in about four minutes, on one laptop GPU. These are its clips, rendered 2026-09-05.</p>

        <ul class="caveats swar" aria-label="Before you listen">
          <li>{clipCaveats.watermark}</li>
          <li>{clipCaveats.englishOnly}</li>
          <li>{clipCaveats.emotionSetting}</li>
        </ul>

        <h3 class="swar">Three characters, each minted from nothing but the description shown</h3>
        <div class="cast">
          {seeds.map((c) => (
            <div class="voice swar">
              <p class="desc">“{characters.find((x) => x.id === c.character)!.description}”</p>
              <div class="clip" data-clip={c.id} data-src={c.src} data-who={c.character}>
                <button class="play" type="button" aria-label={`Play: ${c.text}`} hidden>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path class="tri" d="M4 2.5v11l9-5.5z" /><path class="bars" d="M3.5 2.5h3v11h-3zM9.5 2.5h3v11h-3z" /></svg>
                </button>
                <div class="meta"><span class="who">{c.character}, seed clip</span><span class="len">{c.seconds} s</span></div>
                <p class="words">“{c.text}”</p>
                <canvas class="string" aria-hidden="true"></canvas>
                <audio controls preload="none" src={c.src}></audio>
              </div>
            </div>
          ))}
        </div>
        <p class="seq swar">All three seeds say the same sentence. <button type="button" class="run" data-seq="seed" hidden>Play the three in a row</button> <output class="now" aria-live="polite"></output></p>

        <h3 class="swar">The five-line scene, in order</h3>
        <div class="lines">
          {scene.map((c) => (
            <div class="clip swar" data-clip={c.id} data-src={c.src} data-who={c.character}>
              <button class="play" type="button" aria-label={`Play: ${c.text}`} hidden>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path class="tri" d="M4 2.5v11l9-5.5z" /><path class="bars" d="M3.5 2.5h3v11h-3zM9.5 2.5h3v11h-3z" /></svg>
              </button>
              <div class="meta"><span class="who">{c.character}</span><span class="len">{c.seconds} s</span>{c.experimentalEmotionSetting && <span class="tag">experimental emotion setting, unvalidated</span>}</div>
              <p class="words">“{c.text}”</p>
              <canvas class="string" aria-hidden="true"></canvas>
              <audio controls preload="none" src={c.src}></audio>
            </div>
          ))}
        </div>
        <p class="seq swar"><button type="button" class="run" data-seq="line" hidden>Play the scene in order</button> <output class="now" aria-live="polite"></output></p>
      </section>

      <!-- म -->
      <section class="raga" id="ma" data-laya="madhya">
        <header class="mark swar">
          <span class="swara"><b lang="hi">{sw('ma').dev}</b> {sw('ma').lat}</span>
          <h2>{sw('ma').title}</h2>
        </header>
        <div class="four">
          <div class="swar">
            <h3>A voice is a thing you keep, not a setting you re-guess</h3>
            <p>Most tools generate a voice each time you ask. Here the character's voice is stored as an identity and re-used. The same character sounds like the same person across every line, every scene, and every session. That consistency is measured, not hoped for.</p>
            <p class="seq"><button type="button" class="run" data-seq="mentor" hidden>Hear one character across three sentences</button> <output class="now" aria-live="polite"></output></p>
          </div>
          <div class="swar">
            <h3>Who is speaking and what is being said are genuinely separate</h3>
            <p>The system holds a character's identity apart from the words. That is why one character can say anything without their voice changing, and why changing the line never changes the person. This was verified rather than assumed: when the same audio content is played through two different identities, the words come out identically. The measured error between them was exactly zero on every line tested.</p>
          </div>
          <div class="swar">
            <h3>It does not need a recording of the character</h3>
            <p>There is no voice cloning here, and no user uploads their own audio. Voices are created from a written description. That sidesteps the consent and impersonation problem entirely: you cannot accidentally clone a real person if the system never accepts a recording.</p>
          </div>
          <div class="swar">
            <h3>It knows what it does not know</h3>
            <p>Every capability is measured against a control, and the honest limits are published alongside the results. Roughly twenty findings in this project were wrong on the first attempt and caught by a check, including one where an entire experiment produced fluent-sounding speech that was saying different words than requested, and nothing errored. That is written up publicly rather than quietly fixed.</p>
            <p class="rule">A suspiciously good or suspiciously bad number is a bug report about your setup.</p>
          </div>
        </div>
      </section>

      <!-- प -->
      <section class="raga" id="pa" data-laya="madhya">
        <header class="mark swar">
          <span class="swara"><b lang="hi">{sw('pa').dev}</b> {sw('pa').lat} <i>· {sw('pa').gloss}</i></span>
          <h2>{sw('pa').title}</h2>
        </header>
        <ol class="flow swar" aria-label="The shape of the system">
          <li><span>your description</span></li>
          <li class="box"><span>the mapper</span><small>the only part that learns</small></li>
          <li><span>a voice identity</span><small>small, storable, yours</small></li>
          <li class="box"><span>the voice engine</span><small>never modified, swappable</small></li>
          <li><span>audio</span><small>watermarked and logged from the first render</small></li>
        </ol>
        <div class="ideas">
          <p class="swar"><strong>Only one small piece is trained.</strong> The speech engine is used as-is and never altered, so a better engine can be swapped in without rebuilding everything.</p>
          <p class="swar"><strong>The voice identity is a small, storable thing.</strong> That is what makes a character persistent: it can be saved, versioned and handed to someone else. Each one is stored with a short seed clip and the engine version that made it. The identity is who the character is; each line is a separate performance.</p>
          <p class="swar"><strong>Two ways to answer a description, both measured.</strong> Invent a new voice, or find the closest match in an existing library. The numbers for that trade-off are under Dha.</p>
          <p class="swar"><strong>The checker is a separate system.</strong> A speaker-recognition system that has never seen the generator and never sees the engine's internals does the verifying. The output includes a manifest a game engine can consume: this is built for a pipeline, not a demo button. The manifest's own line reads: “AI-generated synthetic speech. All audio carries an AudioSeal watermark.”</p>
        </div>
      </section>

      <!-- ध -->
      <section class="raga" id="dha" data-laya="drut">
        <header class="mark swar">
          <span class="swara"><b lang="hi">{sw('dha').dev}</b> {sw('dha').lat}</span>
          <h2>{sw('dha').title}</h2>
          <p class="sub">Each result with its caveat within reach. Most of these are automatic measurements; see Ni.</p>
        </header>
        <dl class="measured">
          <div class="swar">
            <dt>It works end to end today</dt>
            <dd>On one 6 GB laptop GPU, in English, Hindi, Bengali and Tamil. Describe a character, get a voice, render a scene of dialogue, and out comes watermarked audio plus a file a game engine can read. The demo under Ga mints three characters, renders five lines, watermarks everything and writes the manifest in about four minutes.</dd>
          </div>
          <div class="swar">
            <dt>Minting a voice from a description costs nothing in clarity</dt>
            <dd>A described voice is just as intelligible as one taken from a real recording. The measured difference was tiny, leaned slightly in the invented voice's favour, and was smaller than the difference between two real speakers: that gap was six times larger. The project reads this as no detectable difference, not as invented voices being better. <span class="cav">The control that had to pass first: every version must come out the same length before any score is read, or the run aborts.</span></dd>
          </div>
          <div class="swar">
            <dt>Invented voices are recognisably distinct people</dt>
            <dd>Verified by a separate speaker-recognition system that has never seen the generator: an independent check, not the system marking its own homework. Each invented voice also sits clearly apart from the nearest real voice the system learned from, so these are new voices, not real people wearing a label.</dd>
          </div>
          <div class="swar">
            <dt>A character stays itself more consistently than a real person does</dt>
            <dd>Across different sentences, more consistently than a real person does across different recordings. Unsurprising once you think about it: a stored voice has no bad-throat day, no change of microphone, no mood.</dd>
          </div>
          <div class="swar">
            <dt>A native speaker confirmed the Hindi says what it should</dt>
            <dd>A fluent Hindi speaker has confirmed one rendered line says the target sentence. They were told the sentence and asked “does it say this?”, not “does it sound right?”. That is the check an earlier batch of faulty audio failed: fluent-sounding speech saying different words. <span class="cav">The other voices and lines are still to be checked.</span>
              <span class="hindi"><span lang="hi">{hindiLine}</span><small>Our plain translation, not a project claim: “Hello, how are you? The weather is very nice today.”</small></span></dd>
          </div>
          <div class="swar">
            <dt>A blind listening test found and fixed a real problem</dt>
            <dd>A blind listening test with built-in controls found a real problem in how the system judged whether two voices were the same person: pairs the system called different were heard as the same person about half the time. The threshold was raised. That removed 10 duplicate voices from a set of 50 and cost 3 percent of measured variety. <span class="cav">The test was small: 8 pairs and one listener, with every control answered correctly. It found the problem but does not settle the exact threshold, and the English threshold has not had its own listening test.</span></dd>
          </div>
          <div class="swar">
            <dt>Pacing is controllable within a measured range</dt>
            <dd>You can slow a character to about two-thirds of normal speed or push them to about 1.4 times, and they stay the same person saying the same words. Outside that range the identity fades gradually rather than breaking. <span class="cav">A listener noted the slow extreme starts to sound processed; the range they called clean is narrower, about 0.8 to 1.25 times.</span>
              <span class="laya">
                <label for="pace">The measured range, as a bounded illustration. Nothing is re-timed here.</label>
                <span class="scale" aria-hidden="true">
                  <span class="band outer"></span><span class="band inner"></span>
                  <span class="tick lo" style="--x:0.67">about two-thirds</span><span class="tick" style="--x:0.8">0.8×</span><span class="tick" style="--x:1">normal</span><span class="tick" style="--x:1.25">1.25×</span><span class="tick hi" style="--x:1.43">about 1.4×</span>
                </span>
                <input type="range" id="pace" min="50" max="160" value="100" step="1" aria-describedby="pace-out" />
                <output id="pace-out" for="pace">Normal speed. The same person saying the same words.</output>
              </span></dd>
          </div>
          <div class="swar">
            <dt>Two ways to answer a description, and the numbers for the trade-off</dt>
            <dd>Invent a new voice, or find the closest match in an existing library of voices. Inventing gives you a character nobody else has; finding gives you higher accuracy and studio quality. Neither is strictly better.
              <span class="pair">
                <span><b>Finding</b>, on a library of 141 real Hindi voices: two thirds of descriptions (65.6%) get a voice that matches on every trait named, and 87 percent land within one step. When the description names only a couple of traits, the way people actually write, a bit over half (53.8%) match exactly on the traits named. Chance would be about one in five (about 20%). The same method on a library of 2,500 English voices reaches 88.5%. It replicates in Bengali.</span>
                <span><b>Reach.</b> Finding reaches 87% of the variety the library actually holds; inventing reached 37% before mis-set settings were fixed, and the fix raised the invented catalogue from 14 to 22 distinct Hindi voices and from 23 to 41 English.</span>
                <span><b>What finding cannot do:</b> produce a voice the library does not contain; guarantee a new character is unique, since different descriptions can return the same voice; and the library is someone else's, so every character in every project draws from the same shelf.</span>
              </span>
              <span class="cav">The library measured was real recorded speakers standing in for a studio library, and no commercial system has been measured.</span></dd>
          </div>
          <div class="swar">
            <dt>Watermarked and logged from the first render</dt>
            <dd>Every render is watermarked and logged, from the first output, not added later. 114 automated checks guard the rules the project learned the hard way: never accept a user's audio; watermark from the first render; store timbre, not performance; do not start the next stage until this one is measured.</dd>
          </div>
        </dl>
      </section>

      <!-- नि · the light panel -->
      <section class="raga chaandni" id="ni" data-laya="drut">
        <header class="mark swar">
          <span class="swara"><b lang="hi">{sw('ni').dev}</b> {sw('ni').lat} <i>· {sw('ni').gloss}</i></span>
          <h2>{sw('ni').title}</h2>
        </header>
        <ul class="missing">
          <li class="swar"><b>Not a product.</b> This is a working research system, not a product. There is no signup, no hosted service, no API.</li>
          <li class="swar"><b>Emotion is not solved.</b> Emotional performance direction is not solved. You can control pacing within a measured range. You cannot yet say “say this line apologetically” and have it work. That was tested thoroughly and does not work on the current engine, for reasons the project documented and reported upstream: the engine's documented emotion tags turn out not to be recognised by the engine at all, and a listener heard no difference between tagged versions of the same line.</li>
          <li class="swar"><b>The catalogue is small.</b> Tens of distinct voices per language so far, not hundreds: about 22 in Hindi and 41 in English by the project's own measure. The limit is understood and measured rather than mysterious. The real speakers the system learned from hold about 38 to 48 distinguishable voices, and the project measured exactly where its own method loses variety.</li>
          <li class="swar"><b>Cannot ship as a product, for licensing reasons.</b> It cannot be shipped as a product in its current form, and the reasons are documented. The Indian-language engine's training chain includes data licensed for non-commercial use, so no model weights and no Indian-language audio leave the repository. It is research-only today, deliberately.</li>
          <li class="swar"><b>Very little has been listened to.</b> Most results are automatic measurements. One listener, a handful of pairs.</li>
          <li class="swar"><b>No comparison against a commercial system.</b> None has been measured.</li>
          <li class="swar"><b>The clips on this page are English.</b> {clipCaveats.englishOnly}</li>
          <li class="swar"><b>Three of the five demo lines</b> were rendered with an experimental emotion setting whose effect has not been validated on this engine. Listen to them as voice samples, not performances.</li>
        </ul>
      </section>

      <!-- सां · the return -->
      <section class="raga" id="sa2" data-laya="drut">
        <header class="mark swar">
          <span class="swara"><b lang="hi">{sw('sa2').dev}</b> {sw('sa2').lat} <i>· {sw('sa2').gloss}</i></span>
          <h2>{sw('sa2').title}</h2>
        </header>
        <p class="lead swar">Describe a character. Get a voice nobody has recorded. Keep it.</p>
        <p class="cta swar">
          <a class="go" href={links.repo}>Read the research</a>
          <a class="go quiet" href={links.issues}>Corrections welcome</a>
        </p>
        <p class="swar">If a claim here is wrong, an issue with a primary source is more useful than almost anything else. Code under the MIT licence; research and writing under a Creative Commons attribution licence. No model weights and no generated Indian-language audio ship. Clips on this page: Qwen3-TTS, Apache-licensed, English only.</p>
        <p class="fine swar">Research pass 2026-09-02. Implementation and measurement 2026-09-05.</p>
      </section>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --night: #1F1C33;   /* the baithak after dark: indigo, not black */
    --tumba: #2A2645;   /* the gourd's shadow: a lifted indigo for controls */
    --bone: #EAE2D0;    /* the jawari bridge: bone, the reading colour */
    --brass: #CD9A44;   /* the kharaj string: brass, everything active */
    --steel: #9298A8;   /* the three steel strings: secondary text and rules */
    --chaandni: #EEEBE3;/* the white floor sheet, lit: the panel for what is missing */
    --display: 'Eczar', 'Tiro Devanagari Hindi', Georgia, 'Noto Serif Devanagari', serif;
    --body: 'Anek Latin', 'Segoe UI', system-ui, -apple-system, sans-serif;
    --mono: 'Xanh Mono', 'Courier Prime', 'Courier New', monospace;
    --rail: 8.5rem;
    --gutter: clamp(1.25rem, 7vw, 7.5rem);
    --measure: 44rem;
  }
  * { box-sizing: border-box; }
  html { background: var(--night); scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--night); color: var(--bone); font: 400 1.0625rem/1.55 var(--body); font-variation-settings: 'wdth' 100; overflow-x: hidden; }
  [lang='hi'] { font-family: var(--display); }
  a { color: var(--brass); text-underline-offset: 0.18em; }
  :focus-visible { outline: 2px solid var(--brass); outline-offset: 3px; border-radius: 2px; }
  button { font: inherit; color: inherit; }
  [hidden] { display: none !important; } /* scripts off: the buttons that need them never render */
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ---- the tanpura: strings, swara rail, drone control ---- */
  .tanpura { position: fixed; inset: 0 auto 0 0; width: var(--rail); z-index: 5; display: grid; grid-template-columns: 4.25rem 1fr; background: var(--night); border-right: 1px solid color-mix(in oklab, var(--steel) 22%, transparent); }
  .strings { position: relative; height: 100%; }
  .strings i { position: absolute; top: 0; bottom: 0; width: 1px; left: calc(0.9rem + var(--n) * 0.8rem); background: var(--steel); opacity: 0.55; --dx: 0.9px; --dy: 0px; }
  .strings i:nth-child(4) { width: 2px; background: var(--brass); opacity: 0.8; }
  .strings i.ring { opacity: 1; filter: brightness(1.5); animation: ring 90ms linear infinite; }
  .drone-on .strings i { opacity: 0.85; }
  @keyframes ring { 0% { transform: translate(var(--dx), var(--dy)); } 50% { transform: translate(calc(var(--dx) * -1), calc(var(--dy) * -1)); } 100% { transform: translate(var(--dx), var(--dy)); } }
  .bead { position: absolute; left: calc(0.9rem + 0.8rem - 4px); top: calc(var(--p, 0) * (100% - 14px)); width: 9px; height: 14px; border-radius: 50%; background: var(--brass); box-shadow: 0 0 0 2px var(--night); }
  .swaras { display: flex; flex-direction: column; justify-content: space-between; padding: 1.5rem 0.5rem 5.5rem; }
  .swaras a { display: grid; grid-template-columns: auto 1fr; align-items: baseline; gap: 0.35rem; text-decoration: none; color: var(--steel); padding: 0.2rem 0.4rem; border-radius: 3px; }
