<script>
  const html = document.documentElement;
  html.classList.add('js');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = (s: string, r: ParentNode = document) => r.querySelector(s) as HTMLElement | null;
  const $$ = (s: string, r: ParentNode = document) => Array.from(r.querySelectorAll(s)) as HTMLElement[];

  /* ---- reveal: units that enter together are staggered at the section's pace ---- */
  const reveal = new IntersectionObserver((entries) => {
    let i = 0;
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const el = e.target as HTMLElement;
      el.style.setProperty('--i', String(i++));
      el.classList.add('sung');
      reveal.unobserve(el);
    }
  }, { threshold: 0.08, rootMargin: '0px 0px -6% 0px' });
  $$('.swar').forEach((el) => reveal.observe(el));

  /* ---- the rail: which swara is being sung, and the bead on the string ---- */
  const links = $$('.swaras a');
  const sections = $$('.raga');
  const which = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      links.forEach((a) => a.classList.toggle('on', a.dataset.for === e.target.id));
    }
  }, { rootMargin: '-38% 0px -55% 0px', threshold: 0 });
  sections.forEach((s) => which.observe(s));
  const rail = $('.tanpura')!;
  const bead = () => {
    const max = html.scrollHeight - innerHeight;
    rail.style.setProperty('--p', String(max > 0 ? Math.min(1, scrollY / max) : 0));
  };
  addEventListener('scroll', bead, { passive: true });
  addEventListener('resize', bead);
  bead();

  /* ---- players ---- */
  type Player = { el: HTMLElement; audio: HTMLAudioElement; canvas: HTMLCanvasElement; id: string; who: string; text: string; peaks: Float32Array | null; raf: number };
  const players: Player[] = [];
  let seq: { list: Player[]; i: number; out: HTMLOutputElement; current: Player | null } | null = null;
  const stopSeq = () => { if (seq) { seq.out.textContent = ''; seq = null; } };

  const draw = (p: Player) => {
    const c = p.canvas, dpr = devicePixelRatio || 1, w = c.clientWidth, h = c.clientHeight;
    if (!w) return;
    if (c.width !== w * dpr || c.height !== h * dpr) { c.width = w * dpr; c.height = h * dpr; }
    const g = c.getContext('2d')!;
    g.setTransform(dpr, 0, 0, dpr, 0, 0);
    g.clearRect(0, 0, w, h);
    const steel = getComputedStyle(html).getPropertyValue('--steel').trim();
    const brass = getComputedStyle(html).getPropertyValue('--brass').trim();
    const dur = p.audio.duration || Number(p.el.dataset.seconds) || 1;
    const frac = Math.max(0, Math.min(1, p.audio.currentTime / dur));
    const mid = h / 2;
    if (!p.peaks) {
      g.strokeStyle = steel; g.lineWidth = 1; g.globalAlpha = 0.6;
      g.beginPath(); g.moveTo(0, mid); g.lineTo(w, mid); g.stroke(); g.globalAlpha = 1;
      if (frac > 0) { g.strokeStyle = brass; g.beginPath(); g.moveTo(0, mid); g.lineTo(w * frac, mid); g.stroke(); }
      return;
    }
    const n = p.peaks.length, step = w / n;
    g.lineWidth = Math.max(1, step * 0.55);
    for (let i = 0; i < n; i++) {
      const a = p.peaks[i] * (mid - 2);
      g.strokeStyle = i / n <= frac ? brass : steel;
      g.globalAlpha = i / n <= frac ? 1 : 0.7;
      g.beginPath(); g.moveTo(i * step + step / 2, mid - Math.max(0.5, a)); g.lineTo(i * step + step / 2, mid + Math.max(0.5, a)); g.stroke();
    }
    g.globalAlpha = 1;
  };
  const tick = (p: Player) => { draw(p); if (!p.audio.paused) p.raf = requestAnimationFrame(() => tick(p)); };

  const decode = async (p: Player) => {
    try {
      const buf = await (await fetch(p.audio.currentSrc || p.el.dataset.src!)).arrayBuffer();
      const ac = new OfflineAudioContext(1, 8, 22050);
      const audio = await ac.decodeAudioData(buf);
      const data = audio.getChannelData(0), n = Math.max(80, Math.min(260, Math.floor(p.canvas.clientWidth / 3)));
      const peaks = new Float32Array(n), per = Math.floor(data.length / n);
      let top = 0;
      for (let i = 0; i < n; i++) { let m = 0; for (let j = i * per, e = j + per; j < e; j++) { const v = Math.abs(data[j]); if (v > m) m = v; } peaks[i] = m; if (m > top) top = m; }
      if (top > 0) for (let i = 0; i < n; i++) peaks[i] = Math.pow(peaks[i] / top, 0.8);
      p.peaks = peaks;
      draw(p);
    } catch { /* the string stays flat; the native audio still plays */ }
  };
  const lazy = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { lazy.unobserve(e.target); decode((e.target as any).__p); }
  }, { rootMargin: '320px 0px' });

  for (const el of $$('.clip')) {
    const audio = $('audio', el) as HTMLAudioElement, canvas = $('canvas', el) as HTMLCanvasElement, btn = $('.play', el) as HTMLButtonElement;
    const p: Player = { el, audio, canvas, id: el.dataset.clip!, who: el.dataset.who!, text: $('.words', el)!.textContent!.trim().replace(/^“|”$/g, ''), peaks: null, raf: 0 };
    el.dataset.seconds = ($('.len', el)!.textContent || '').replace(/[^\d.]/g, '');
    (el as any).__p = p;
    players.push(p);
    btn.hidden = false;
    lazy.observe(el);
    draw(p);
    btn.addEventListener('click', () => { if (audio.paused) { audio.play(); } else { audio.pause(); } });
    btn.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowRight' || ev.key === 'ArrowLeft') { ev.preventDefault(); audio.currentTime = Math.max(0, audio.currentTime + (ev.key === 'ArrowRight' ? 1 : -1)); draw(p); }
    });
    canvas.addEventListener('click', (ev) => { const r = canvas.getBoundingClientRect(); const f = (ev.clientX - r.left) / r.width; audio.currentTime = f * (audio.duration || Number(el.dataset.seconds)); draw(p); });
    audio.addEventListener('play', () => {
      players.forEach((o) => { if (o !== p && !o.audio.paused) o.audio.pause(); });
      if (seq && seq.current !== p) stopSeq();
      el.classList.add('playing'); btn.setAttribute('aria-label', `Pause: ${p.text}`);
      duck(true); cancelAnimationFrame(p.raf); tick(p);
    });
    audio.addEventListener('pause', () => {
      el.classList.remove('playing'); btn.setAttribute('aria-label', `Play: ${p.text}`);
      cancelAnimationFrame(p.raf); draw(p);
      if (!players.some((o) => !o.audio.paused)) duck(false);
      if (seq && seq.current === p && !audio.ended) stopSeq();
    });
    audio.addEventListener('ended', () => { audio.currentTime = 0; draw(p); });
  }
  addEventListener('resize', () => players.forEach(draw));

  const step = () => {
    if (!seq) return;
    if (seq.i >= seq.list.length) { stopSeq(); return; }
    const p = seq.list[seq.i];
    seq.current = p;
    seq.out.textContent = `${p.who}: “${p.text}”`;
    p.audio.currentTime = 0;
    p.audio.addEventListener('ended', () => { const s = seq; if (s && s.current === p) setTimeout(() => { if (seq === s) { s.i++; step(); } }, 420); }, { once: true });
    p.audio.play();
  };
  const first = (id: string) => players.find((p) => p.id === id && !p.el.closest('#sa'))!;
  const lists: Record<string, () => Player[]> = {
    seed: () => ['mentor_seed', 'scout_seed', 'innkeeper_seed'].map(first),
    line: () => ['mentor_line0', 'scout_line1', 'innkeeper_line2', 'mentor_line3', 'scout_line4'].map(first),
    mentor: () => ['mentor_seed', 'mentor_line0', 'mentor_line3'].map(first),
  };
  for (const b of $$('.run')) {
    b.hidden = false;
    b.addEventListener('click', () => {
      const out = b.parentElement!.querySelector('output') as HTMLOutputElement;
      stopSeq();
      seq = { list: lists[b.dataset.seq!](), i: 0, out, current: null };
      step();
    });
  }

  /* ---- the example: the description is sung word by word, then the voice enters ---- */
  const hear = $('.hear') as HTMLButtonElement, desc = $('#sa .desc')!;
  hear.hidden = false;
  const heroPlayer = players.find((p) => p.el.closest('#sa'))!;
  const words = desc.textContent!.trim().split(/\s+/);
  desc.replaceChildren(...words.flatMap((w, i) => { const s = document.createElement('span'); s.className = 'w'; s.textContent = w; return i ? [document.createTextNode(' '), s] : [s]; }));
  hear.addEventListener('click', () => {
    if (!heroPlayer.audio.paused) heroPlayer.audio.pause();
    heroPlayer.audio.currentTime = 0;
    const spans = $$('.w', desc);
    if (reduced) { heroPlayer.audio.play(); return; }
    desc.classList.add('singing');
    spans.forEach((s) => s.classList.remove('in'));
    void desc.offsetWidth;
    const gap = 200;
    spans.forEach((s, i) => setTimeout(() => s.classList.add('in'), 120 + i * gap));
    setTimeout(() => { heroPlayer.audio.play(); hear.textContent = 'Hear it again'; }, 120 + spans.length * gap + 500);
  });

  /* ---- pacing: a bounded illustration, no re-timing ---- */
  const pace = $('#pace') as HTMLInputElement | null, paceOut = $('#pace-out') as HTMLOutputElement | null;
  if (pace && paceOut) {
    const say = () => {
      const v = Number(pace.value) / 100;
      paceOut.textContent = v >= 0.995 && v <= 1.005 ? 'Normal speed. The same person saying the same words.'
        : v >= 0.8 && v <= 1.25 ? (v < 1 ? 'Slower. ' : 'Faster. ') + 'Inside the range a listener called clean: the same person, the same words.'
        : v >= 0.67 && v <= 1.43 ? (v < 1 ? 'Slow. Still the same person saying the same words by measurement; down here a listener said it starts to sound processed.' : 'Fast. Still the same person saying the same words by measurement, past the range a listener called clean.')
        : (v < 1 ? 'Slower than measured. ' : 'Faster than measured. ') + 'Outside the range: the identity fades gradually rather than breaking.';
    };
    pace.addEventListener('input', say);
    say();
  }

  /* ---- the tanpura: four strings synthesised, plucked Pa Sa Sa Sa, jawari on the bridge ---- */
  type Drone = { master: GainNode; pluck: (i: number, t: number) => void; cycle: number[]; period: number };
  const makeDrone = (ctx: BaseAudioContext, out: AudioNode): Drone => {
    const wave = (n: number, f: (k: number) => number) => { const re = new Float32Array(n + 1), im = new Float32Array(n + 1); for (let k = 1; k <= n; k++) im[k] = f(k); return ctx.createPeriodicWave(re, im); };
    const body = wave(7, (k) => 1 / k);
    const jawari = wave(28, (k) => (k < 3 ? 0.3 : 1 / Math.sqrt(k)));
    const irLen = Math.floor(ctx.sampleRate * 1.6), ir = ctx.createBuffer(2, irLen, ctx.sampleRate);
    for (let ch = 0; ch < 2; ch++) { const d = ir.getChannelData(ch); for (let i = 0; i < irLen; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / irLen, 3.2); }
    const verb = ctx.createConvolver(); verb.buffer = ir;
    const wet = ctx.createGain(); wet.gain.value = 0.22;
    const bus = ctx.createGain(), master = ctx.createGain(); master.gain.value = 0;
    const comp = ctx.createDynamicsCompressor(); comp.threshold.value = -20; comp.ratio.value = 3; comp.attack.value = 0.01; comp.release.value = 0.3;
    bus.connect(master); bus.connect(verb); verb.connect(wet); wet.connect(master); master.connect(comp); comp.connect(out);
    const SA = 146.83;
    const strings = [{ f: SA * 0.75, a: 0.3 }, { f: SA, a: 0.34 }, { f: SA * 1.0017, a: 0.34 }, { f: SA / 2, a: 0.32 }];
    const pluck = (i: number, t: number) => {
      const s = strings[i], f = s.f * (1 + (Math.random() - 0.5) * 0.002);
      const o1 = ctx.createOscillator(), g1 = ctx.createGain(); o1.setPeriodicWave(body); o1.frequency.value = f;
      g1.gain.setValueAtTime(0, t); g1.gain.linearRampToValueAtTime(s.a * 0.9, t + 0.006); g1.gain.setTargetAtTime(0, t + 0.006, 1.3);
      o1.connect(g1); g1.connect(bus);
      const o2 = ctx.createOscillator(), g2 = ctx.createGain(), lp = ctx.createBiquadFilter(); o2.setPeriodicWave(jawari); o2.frequency.value = f * 1.0005;
      lp.type = 'lowpass'; lp.Q.value = 1.1;
      lp.frequency.setValueAtTime(320, t); lp.frequency.exponentialRampToValueAtTime(3400, t + 0.55); lp.frequency.setTargetAtTime(750, t + 0.55, 1.7);
      g2.gain.setValueAtTime(0, t); g2.gain.linearRampToValueAtTime(s.a * 0.12, t + 0.02); g2.gain.linearRampToValueAtTime(s.a * 0.55, t + 0.5); g2.gain.setTargetAtTime(0, t + 0.5, 2.4);
      o2.connect(lp); lp.connect(g2); g2.connect(bus);
      o1.start(t); o2.start(t); o1.stop(t + 8); o2.stop(t + 8);
    };
    return { master, pluck, cycle: [0, 1.05, 2.1, 3.15], period: 4.4 };
  };

  const droneBtn = $('.drone') as HTMLButtonElement;
  const strings = $$('.strings i');
  let ctx: AudioContext | null = null, drone: Drone | null = null, timer = 0, on = false, ducked = false;
  const level = () => { if (drone && ctx) drone.master.gain.setTargetAtTime(on ? (ducked ? 0.14 : 0.5) : 0, ctx.currentTime, 0.25); };
  const duck = (d: boolean) => { ducked = d; level(); };
  const ring = (i: number) => { if (reduced) return; const s = strings[i]; s.classList.add('ring'); setTimeout(() => s.classList.remove('ring'), 900); };
  const start = async () => {
    if (!ctx) { ctx = new AudioContext(); drone = makeDrone(ctx, ctx.destination); }
    if (ctx.state !== 'running') await ctx.resume();
    on = true; level();
    let next = ctx.currentTime + 0.15, idx = 0;
    const gaps = [1.05, 1.05, 1.05, 1.25];
    timer = setInterval(() => {
      while (ctx && next < ctx.currentTime + 0.6) {
        const i = idx % 4, at = next;
        drone!.pluck(i, at);
        setTimeout(() => ring(i), Math.max(0, (at - ctx.currentTime) * 1000));
        next += gaps[i]; idx++;
      }
    }, 200);
  };
  const stop = () => { on = false; level(); clearInterval(timer); };
  if ('AudioContext' in window) {
    droneBtn.hidden = false;
    droneBtn.addEventListener('click', () => {
      const now = droneBtn.getAttribute('aria-pressed') !== 'true';
      droneBtn.setAttribute('aria-pressed', String(now));
      droneBtn.querySelector('em')!.textContent = now ? 'on' : 'off';
      html.classList.toggle('drone-on', now);
      if (now) start(); else stop();
    });
  }
  /* Offline render of the same synth, so the drone can be checked numerically: level, harmonics, no clipping. */
  (window as any).alaapDroneRender = async (secs = 6) => {
    const oc = new OfflineAudioContext(1, Math.floor(44100 * secs), 44100);
    const d = makeDrone(oc, oc.destination); d.master.gain.value = 0.5;
    const gaps = [1.05, 1.05, 1.05, 1.25];
    for (let t = 0.05, i = 0; t < secs; i++) { d.pluck(i % 4, t); t += gaps[i % 4]; }
    const buf = await oc.startRendering();
    return Array.from(buf.getChannelData(0));
  };
</script>
