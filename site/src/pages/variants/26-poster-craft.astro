  .slips { display: flex; flex-wrap: wrap; align-items: flex-start; gap: .5rem 1.4rem; margin-top: 1.8rem; }
  .slips .slip { margin-top: .4rem; max-width: 38ch; }
  .slip--tag { display: inline-block; margin: 0 0 0 .3rem; padding: .2rem .55rem .25rem; font-size: .85rem; line-height: 1.2; max-width: none; vertical-align: .1em; }

  /* one language for "this plays": a haldi block, a black triangle, a hard sindoor shadow */
  .play { display: inline-flex; align-items: center; gap: .5em; min-height: 2.75rem; padding: .45rem .95rem .4rem; background: var(--haldi); color: var(--kajal); border: 3px solid var(--kajal); box-shadow: 3px 3px 0 var(--sindoor); font: 700 1rem/1 var(--cond); text-transform: uppercase; letter-spacing: .06em; cursor: pointer; text-align: left; }
  .play:hover { background: var(--chuna); }
  .play[aria-pressed="true"] { background: var(--kajal); color: var(--haldi); border-color: var(--haldi); }
  .play--big { font-size: 1.15rem; padding: .65rem 1.3rem .6rem; box-shadow: 4px 4px 0 var(--sindoor); }
  .play-sub { font-weight: 500; letter-spacing: .04em; text-transform: none; }
  .play-sub::before { content: '· '; }
  .tri { display: inline-block; flex: none; width: 0; height: 0; border-left: .75em solid currentColor; border-top: .45em solid transparent; border-bottom: .45em solid transparent; }
  .play[aria-pressed="true"] .tri { width: .7em; height: .9em; border: 0; background: linear-gradient(to right, currentColor 0 38%, transparent 38% 62%, currentColor 62%); }
  .no-js .play, .no-js .wave, .no-js .deck, .no-js .langs, .no-js .pace-out { display: none; }
  .no-js .panel[hidden] { display: block; }
  .no-js .panel--text, .no-js .panel--hi { margin-top: 2rem; }
  .no-js .example audio, .no-js .line audio { grid-column: 1 / -1; }
  html:not(.no-js) [data-player] audio { display: none; }
  .no-js [data-player] audio { display: block; width: 100%; margin-top: .6rem; }
  .wave { display: block; width: 100%; height: 44px; }
  .words { font: 400 1.05rem/1.4 var(--body); }
  /* a clip that is not in this build: the player goes, the words stay */
  .missing { display: none; font: 500 .95rem/1.3 var(--cond); color: #B9B2A3; }
  .is-missing :is(.play, .wave, audio) { display: none !important; }
  .is-missing .missing { display: block; }

  /* 2 · cast */
  .stars { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.4rem; }
  .star { --ink: var(--kajal); --wave: var(--kajal); --wave-lit: var(--ch-lit); --focus: var(--kajal); display: flex; flex-direction: column; padding: 1.1rem 1.2rem 1.2rem; background: var(--ch); color: var(--kajal); }
  .star.is-playing { box-shadow: -6px 6px 0 0 var(--sindoor); transform: translate(3px, -3px); }
  .star.ch-scout.is-playing { box-shadow: -6px 6px 0 0 var(--haldi); }
  .star-name { font: 400 clamp(2.2rem, 3.6vw, 2.8rem)/1.1 var(--display); color: var(--kajal); text-shadow: .05em .05em 0 var(--ch-shadow); }
  .star .play { background: var(--kajal); color: var(--chuna); border-color: var(--kajal); box-shadow: 3px 3px 0 var(--ch-lit); }
  .star .play:hover, .star .play[aria-pressed="true"] { background: var(--chuna); color: var(--kajal); border-color: var(--kajal); }
  .star-desc { flex: 1; margin: .5rem 0 .9rem; font-size: 1.05rem; line-height: 1.4; }
  .star .play { align-self: flex-start; }
  .star .wave { height: 48px; margin: .8rem 0 .4rem; }
  .star .words { font-size: var(--t-small); }

  /* 3 · the scene: a language switch, then one instrument */
  .scene { padding-top: .4rem; }
  .langs { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1.2rem; margin-bottom: 1.6rem; }
  .langs-label { font: 600 1rem/1 var(--cond); text-transform: uppercase; letter-spacing: .08em; color: var(--haldi); }
  .tabs { display: flex; flex-wrap: wrap; gap: .5rem; }
  .tabs [role="tab"] { display: inline-flex; flex-direction: column; align-items: flex-start; gap: .2rem; padding: .45rem .9rem .5rem; background: transparent; color: var(--chuna); border: 3px solid rgba(244,238,221,.45); font: 700 1.05rem/1 var(--cond); cursor: pointer; text-align: left; }
  .tabs [role="tab"] [lang] { font-family: var(--cond), 'Nirmala UI', 'Bangla Sangam MN', 'Tamil Sangam MN', 'Noto Sans Bengali', 'Noto Sans Tamil', sans-serif; line-height: 1; }
  .tab-sub { font: 500 .8rem/1 var(--cond); letter-spacing: .04em; text-transform: uppercase; opacity: .85; }
  .tabs [role="tab"]:hover { border-color: var(--chuna); }
  .tabs [role="tab"][aria-selected="true"] { background: var(--haldi); color: var(--kajal); border-color: var(--haldi); box-shadow: 3px 3px 0 var(--sindoor); }
  .tabs [role="tab"][aria-selected="true"] .tab-sub { opacity: 1; }
  .panel--text { max-width: 66ch; }
  .panel--text .lead { color: var(--haldi); }
  .panel--text p + p:not(.slip) { margin-top: .8rem; }
  .deck { display: grid; grid-template-columns: auto 1fr; grid-template-areas: 'btn where' 'btn now'; gap: .35rem 1.4rem; align-items: center; margin-bottom: 1.2rem; }
  .deck .play { grid-area: btn; }
  .where { grid-area: where; display: flex; gap: .35rem; align-self: end; }
  .where li { width: 2.2rem; height: .85rem; border: 2px solid var(--ch, var(--haldi)); }
  .where li.is-done { background: rgba(242,180,30,.5); background: color-mix(in srgb, var(--ch, var(--haldi)) 50%, transparent); }
  .where li.is-now { background: var(--ch, var(--haldi)); }
  .now { grid-area: now; align-self: start; font: 500 1rem/1.35 var(--cond); color: var(--chuna); }
  .deck--pair { grid-template-areas: 'btn now'; }
  .deck--pair .now { align-self: center; }
  .lines { border-top: 3px solid var(--haldi); }
  .line { display: grid; grid-template-columns: 6.5rem 5.4rem minmax(0, 1fr); grid-template-areas: 'who play words' 'who play wave'; column-gap: 1rem; row-gap: .25rem; align-items: start; padding: .8rem 0; border-bottom: 3px solid var(--haldi); }
  .line { --wave: var(--ch, var(--haldi)); --wave-lit: var(--ch-lit, var(--gulabi)); }
  .line.ch-innkeeper, .line.ch-narrator { --wave-lit: var(--haldi); }
  .line.is-playing { background: rgba(242,180,30,.12); box-shadow: 0 0 0 .6rem rgba(242,180,30,.12); }
  .line.is-playing { background: color-mix(in srgb, var(--ch, var(--haldi)) 12%, transparent); box-shadow: 0 0 0 .6rem color-mix(in srgb, var(--ch, var(--haldi)) 12%, transparent); }
  .who { grid-area: who; font: 400 1.5rem/1.1 var(--display); color: var(--ch, var(--haldi)); text-shadow: .05em .05em 0 var(--who-shadow, var(--sindoor)); padding-top: .2rem; }
  .who small { display: block; margin-top: .3rem; font: 600 .72rem/1.2 var(--cond); letter-spacing: .08em; text-transform: uppercase; color: var(--chuna); text-shadow: none; }
  .line .play { grid-area: play; min-width: 5.4rem; justify-content: center; }
  .line .words { grid-area: words; font-size: 1.12rem; padding-top: .3rem; }
  .dur { font: 600 .9rem/1 var(--cond); letter-spacing: .05em; color: var(--chuna); white-space: nowrap; margin-left: .3rem; }
  .tag-plain { font: 500 .85rem/1 var(--cond); text-transform: uppercase; letter-spacing: .08em; color: #B9B2A3; white-space: nowrap; margin-left: .4rem; }
  .line .wave { grid-area: wave; height: 36px; margin-top: .15rem; }

  /* the Hindi panel: one description on two engines, then four voices, three lines each. Eczar carries the Devanagari at reading size; the matras need the taller line. */
  .panel--hi > .band-intro { margin-bottom: .6rem; }
  .panel--hi > .slip { margin-top: .6rem; max-width: 58ch; }
  .pair { margin-top: 1.8rem; padding-top: 1.2rem; border-top: 3px solid var(--haldi); }
  .pair .lead { color: var(--haldi); }
  .pair-desc { margin: .3rem 0 1rem; font: 500 1.15rem/1.4 var(--body); }
  .pair-desc q { color: var(--haldi); }
  .lines--pair { border-top-width: 0; }
  .lines--pair .line:last-child { border-bottom: 0; }
  .line--hi { grid-template-areas: 'who play words' 'who play gloss' 'who play missing' 'who play wave'; }
  .lines--hi .line--hi { grid-template-columns: 5.4rem minmax(0, 1fr); grid-template-areas: 'play words' 'play gloss' 'play missing' 'play wave'; }
  .line--hi .words { font-size: 1.15rem; }
  .line--hi .words [lang="hi"] { font-weight: 500; font-size: 1.3rem; line-height: 1.6; }
  .line--hi .slip--tag, .line--hi .tag-plain { vertical-align: .35em; }
  .gloss { grid-area: gloss; font: 400 var(--t-small)/1.4 var(--body); color: #D9D3C3; }
  .missing { grid-area: missing; }
  .hi-cast { display: grid; gap: 1.6rem; margin-top: 2rem; }
  .hv { display: grid; grid-template-columns: minmax(14rem, 1fr) minmax(0, 3fr); gap: .6rem 2rem; padding-top: 1.2rem; border-top: 3px solid var(--ch, var(--haldi)); }
  .hv-name { font-size: 2rem; }
  .hv-same { margin-top: .2rem; font: 600 .85rem/1.3 var(--cond); text-transform: uppercase; letter-spacing: .08em; color: var(--ch-ink, var(--ch, var(--haldi))); }
  .hv-desc { margin-top: .6rem; font-size: 1.05rem; line-height: 1.4; }
  .hv-head .slip { max-width: 30ch; font-size: .95rem; }
  .lines--hi { border-top: 0; }
  .lines--hi .line:first-child { padding-top: .2rem; }
  .lines--hi .line:last-child { border-bottom: 0; }

  /* 4 · billing */
  .entry { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: .8rem 3rem; padding: clamp(1.1rem, 2vw, 1.4rem) 0; border-top: 4px solid var(--haldi); align-items: start; }
  .entry:last-child { padding-bottom: 0; }
  .shout { font: 400 clamp(1.8rem, 3.2vw, 2.4rem)/1.1 var(--display); }
  .entry p { max-width: 68ch; }

  /* 5 · measured */
  .row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr); gap: .6rem 3rem; padding: clamp(1.1rem, 2vw, 1.4rem) 0; border-top: 4px solid var(--kajal); }
  .row:last-child { padding-bottom: 0; }
  .row-body p { max-width: 70ch; }
  .row-body p + p:not(.slip) { margin-top: .8rem; }
  .measured .lead { color: var(--neel); }
  .row--bill { grid-template-columns: 1fr; gap: .4rem; }
  .row--bill .row-body > p:first-child { max-width: 80ch; }
  .double { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem 3rem; margin-top: 1.2rem; }
  .half { padding-top: .5rem; border-top: 6px solid var(--sindoor); }
  .half + .half { border-top-color: var(--neel); }
  .half .shout { --shout: var(--sindoor); --shadow: var(--neel); --stroke: var(--kajal); font-size: clamp(2.2rem, 4.4vw, 3.2rem); }
  .half + .half .shout { --shout: var(--neel); --shadow: var(--sindoor); }
  .half p { margin-top: .6rem; }
  .pace { margin: 1.2rem 0 .3rem; max-width: 40rem; }
  .pace-label { display: block; font: 600 .95rem/1.3 var(--cond); color: var(--neel); margin-bottom: .6rem; }
  #pace { -webkit-appearance: none; appearance: none; width: 100%; height: 18px; margin: 0; background: linear-gradient(to right, var(--kajal) 0 17.1%, var(--sindoor) 17.1% 76.3%, var(--kajal) 76.3% 100%); cursor: pointer; }
  #pace::-webkit-slider-thumb { -webkit-appearance: none; width: 26px; height: 34px; background: var(--chuna); border: 3px solid var(--kajal); box-shadow: 2px 2px 0 var(--kajal); cursor: grab; }
  #pace::-moz-range-thumb { width: 20px; height: 28px; border-radius: 0; background: var(--chuna); border: 3px solid var(--kajal); box-shadow: 2px 2px 0 var(--kajal); }
  #pace::-moz-range-track { height: 18px; background: linear-gradient(to right, var(--kajal) 0 17.1%, var(--sindoor) 17.1% 76.3%, var(--kajal) 76.3% 100%); }
  .ticks { position: relative; height: 1.6rem; margin-top: .35rem; font: 600 .9rem/1 var(--cond); letter-spacing: .04em; }
  .ticks span { position: absolute; top: 0; transform: translateX(-50%); white-space: nowrap; }
  .ticks span::before { content: ''; display: block; width: 2px; height: 6px; background: var(--kajal); margin: 0 auto 3px; }
  .ticks span:nth-child(1) { left: 0; transform: none; }
  .ticks span:nth-child(1)::before { margin-left: 0; }
  .ticks span:nth-child(2) { left: 17.1%; }
  .ticks span:nth-child(3) { left: 43.4%; }
  .ticks span:nth-child(4) { left: 76.3%; }
  .ticks span:nth-child(5) { left: 100%; transform: translateX(-100%); text-align: right; }
  .ticks span:nth-child(5)::before { margin-right: 0; }
  .pace-out { display: block; margin-top: .4rem; font: 500 1.05rem/1.4 var(--body); color: var(--neel); min-height: 2.8em; }

  /* 6 · how it is done: one question, one chain of enamel blocks, and the door to the other side */
  .how-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2.2rem clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .hld { border-top: 4px solid var(--haldi); padding-top: 1rem; }
  .hld-q { font-size: clamp(1.7rem, 2.6vw, 2.1rem); margin-bottom: 1rem; }
  .chain { display: flex; flex-direction: column; max-width: 34rem; }
  .chain > li { display: flex; flex-direction: column; }
  .chain > li + li::before { content: ''; display: block; width: 2.6rem; height: 1.3rem; margin: .35rem auto; background: var(--haldi); -webkit-mask: var(--arrow) center / contain no-repeat; mask: var(--arrow) center / contain no-repeat; transform: rotate(90deg); }
  .hb { position: relative; isolation: isolate; padding: .6rem .9rem .55rem; font: 600 1.05rem/1.2 var(--cond); }
  .hb::before { content: ''; position: absolute; inset: 0; z-index: -1; filter: url(#brush-box); }
  .hb b { display: block; font-size: 1.15rem; text-transform: uppercase; letter-spacing: .04em; }
  .hb small { display: block; margin-top: .3rem; font: 500 .92rem/1.3 var(--cond); }
  .hb--part { color: var(--kajal); }
  .hb--part::before { background: var(--haldi); box-shadow: 4px 4px 0 var(--sindoor); }
  .hb--thing { color: var(--chuna); }
  .hb--thing::before { border: 3px solid var(--chuna); }
  .hb--keep { color: var(--chuna); }
  .hb--keep::before { background: var(--sindoor); border: 3px solid var(--kajal); box-shadow: 4px 4px 0 var(--kajal); }
  .hb--out { color: var(--kajal); }
  .hb--out::before { background: var(--chuna); box-shadow: 4px 4px 0 var(--kajal); }
  .side { position: relative; margin: .5rem 0 0 1.4rem; padding: .35rem 0 0 .8rem; font: 500 .92rem/1.35 var(--cond); color: var(--chuna); border-left: 3px solid var(--haldi); }
  .side::before { content: ''; position: absolute; left: -1.5rem; top: .1rem; width: 1.6rem; height: .8rem; background: var(--haldi); -webkit-mask: var(--arrow) center / contain no-repeat; mask: var(--arrow) center / contain no-repeat; transform: rotate(-90deg); }
  .side--loop::before { transform: rotate(180deg); }
  .hld-note { margin-top: 1rem; font-size: 1rem; line-height: 1.45; max-width: 34rem; }
  .door { position: sticky; top: calc(var(--prog-h) + 1.5rem); border-top: 4px solid var(--haldi); padding-top: 1rem; }
  .door-arrow { display: block; width: 7rem; height: 3.5rem; margin: .4rem 0 .6rem; background: var(--haldi); -webkit-mask: var(--arrow) center / contain no-repeat; mask: var(--arrow) center / contain no-repeat; filter: drop-shadow(.18rem .18rem 0 var(--sindoor)); }
  .door .shout { font-size: clamp(1.9rem, 3vw, 2.5rem); }
  .door p { margin-top: .8rem; max-width: 46ch; }
  .door .btn { margin-top: 1.2rem; }
  .rules { margin-top: 2rem; padding-top: 1rem; border-top: 4px solid var(--haldi); font: 500 1rem/1.5 var(--cond); letter-spacing: .02em; max-width: 80ch; }

  /* 7 · fine print, legible */
  .fine .bill-hi { --shout: var(--kajal); --shadow: var(--haldi); --stroke: transparent; }
  .fine-cols { columns: 2; column-gap: 3rem; font: 500 1rem/1.4 var(--cond); }
  .fine-cols p { break-inside: avoid; margin-bottom: .9rem; }
  .fine-cols strong { font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  @media (min-width: 1240px) { .fine-cols { columns: 3; column-gap: 2.5rem; } }

  /* 8 · booking */
  .booking { text-align: center; }
  .btn { display: inline-flex; align-items: center; gap: .3em .5em; padding: .85rem 1.5rem .8rem; font: 700 1.2rem/1 var(--cond); text-transform: uppercase; letter-spacing: .1em; text-decoration: none; border: 3px solid transparent; cursor: pointer; }
  .btn--haldi { background: var(--haldi); color: var(--kajal); border-color: var(--kajal); box-shadow: 4px 4px 0 var(--sindoor); }
  .btn--haldi:hover { background: var(--chuna); }
  .btn--line { background: transparent; color: var(--chuna); border-color: var(--chuna); box-shadow: 4px 4px 0 var(--haldi); }
  .btn--line:hover { background: var(--chuna); color: var(--kajal); }
  .cta { display: flex; justify-content: center; flex-wrap: wrap; gap: 1.2rem 1.6rem; }
  .quote { max-width: 46ch; margin: 2rem auto 0; font: 500 1.2rem/1.4 var(--body); color: var(--haldi); }
  .licence { margin-top: 1.4rem; font: 500 .9rem/1.5 var(--cond); letter-spacing: .04em; color: #D9D3C3; }
  .foot-door { margin-top: 1rem; font: 600 .95rem/1.4 var(--cond); letter-spacing: .04em; text-transform: uppercase; color: var(--haldi); }

  /* 9 · the technical map, finished in the poster's hand: painted lettering, brush-edged boxes, the same arrow, torn slips. Component rules come first; these win. */
  .tmap { --focus: var(--kajal); --tm-paper: var(--chuna); padding-top: clamp(2.2rem, 4.5vw, 3rem); }
  .tmap .tm-kicker { color: var(--sindoor); }
  .tmap .tm-title { color: var(--kajal); text-shadow: .06em .06em 0 var(--haldi); filter: url(#brush-soft); }
  .tmap .tm-title::before { content: 'नक्शा'; display: block; margin-bottom: -.1em; font-size: clamp(3rem, 7vw, 5.25rem); line-height: 1.15; color: var(--sindoor); -webkit-text-stroke: .035em var(--kajal); paint-order: stroke fill; text-shadow: .06em .06em 0 var(--neel); }
  .tmap .tm-lede { font-size: var(--t-intro); }
  .tmap .tm-nav a { border-width: 3px; box-shadow: 3px 3px 0 var(--haldi); }
  .tmap .tm-fig { border-top-width: 4px; scroll-margin-top: calc(var(--prog-h) + 1rem); }
  .tmap .tm-fig figcaption h3 { text-shadow: .05em .05em 0 var(--haldi); }
  .tmap .tm-node { isolation: isolate; background: transparent; border: 0; box-shadow: none; padding: .65rem .85rem .7rem; }
  .tmap .tm-node::after { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--chuna); border: 3px solid var(--kajal); box-shadow: 4px 4px 0 var(--haldi); filter: url(#brush-box); }
  .tmap .tm-node--learned, .tmap .tm-node--gate { color: var(--chuna); }
  .tmap .tm-node--learned::after { background: var(--sindoor); box-shadow: 4px 4px 0 var(--neel); }
  .tmap .tm-node--frozen::after { box-shadow: 4px 4px 0 var(--neel); background-image: repeating-linear-gradient(135deg, transparent 0 7px, rgba(23,20,15,.08) 7px 9px); }
  .tmap .tm-node--frozen::before { background: var(--neel); }
  .tmap .tm-node--gate::after { background: var(--kajal); box-shadow: 4px 4px 0 var(--sindoor); }
  .tmap .tm-node--gate::before { background: var(--haldi); color: var(--kajal); }
  .tmap .tm-node--proposal::after { border-color: var(--gulabi); }
  .tmap .tm-node--proposal::before { background: var(--gulabi); color: var(--kajal); }
  .tmap :is(.tm-node--key, .tm-node--done)::after { background-color: var(--haldi); }
  .tmap .tm-node--key::after { box-shadow: 4px 4px 0 var(--sindoor); }
  .tmap :is(.tm-node--proposal, .tm-node--dropped)::after { border-style: dashed; box-shadow: none; }
  .tmap .tm-node--dropped { opacity: .8; }
  .tmap .tm-node--sm::after { box-shadow: 3px 3px 0 var(--haldi); }
  .tmap .tm-node::before { z-index: 1; font-size: .66rem; }
  .tmap .tm-node i { opacity: 1; color: #3D382E; }
  .tmap :is(.tm-node--learned, .tm-node--gate) i { color: var(--chuna); }
  .tmap .tm-arr:not(.tm-arr--loop) { background: currentColor; -webkit-mask: var(--arrow) center / contain no-repeat; mask: var(--arrow) center / contain no-repeat; }
  .tmap .tm-arr:not(.tm-arr--loop) use { display: none; }
  .tmap .tm-lane { border-width: 3px; }
  .tmap .tm-lane--learned { border-color: var(--sindoor); }
  .tmap .tm-lane--learned .tm-lane-t { color: var(--sindoor); }
  .tmap .tm-lane--frozen { border-color: var(--neel); }
  .tmap .tm-lane-t { color: var(--neel); }
  .tmap .tm-slip { max-width: min(54ch, 100%); font-size: 1rem; filter: drop-shadow(2px 3px 0 rgba(0,0,0,.42)); }
  .tmap .tm-slip::before { background: #FFF9EA; clip-path: var(--torn); }
  .tmap .tm-slip::after { content: ''; position: absolute; inset: -2px -3px; z-index: -2; background: #FFFDF6; clip-path: var(--torn); }
  .tmap .tm-foot { border-top-width: 4px; }

  /* the share card (?og, 1200×630) and the touch icon (?og=icon, 180×180): hidden unless asked for */
  html[data-og] body { background: var(--haldi); overflow: hidden; }
  html[data-og] .poster, html[data-og] .skip, html[data-og] #live { display: none; }
  html[data-og] .ogcard { display: block; }
  .ogcard { position: relative; width: 1200px; height: 630px; padding: 34px 60px 0; background: var(--haldi); color: var(--kajal); text-align: center; overflow: hidden; }
  .og-top { display: flex; justify-content: space-between; font: 600 1.25rem/1.3 var(--cond); text-transform: uppercase; letter-spacing: .1em; color: var(--neel); border-bottom: 5px solid var(--kajal); padding-bottom: .5rem; }
  .og-tag { margin-top: 26px; font: 700 1.9rem/1.2 var(--cond); text-transform: uppercase; letter-spacing: .12em; }
  .og-title { margin-top: 0; line-height: 1; }
  .og-title .painted { display: block; font: 400 17rem/1.05 var(--display); --shout: var(--sindoor); --shadow: var(--neel); --stroke: var(--kajal); }
  .og-mark { display: none; }
  .og-lat { display: block; margin: 4px 0 0 .32em; font: 700 3.6rem/1 var(--cond); text-transform: uppercase; letter-spacing: .32em; }
  .og-foot { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; padding: 22px 60px 26px; background: var(--neel); color: var(--chuna); font: 600 1.35rem/1 var(--cond); text-transform: uppercase; letter-spacing: .1em; }
  .og-foot::before { content: ''; position: absolute; left: -40px; right: -40px; top: -18px; height: 36px; background: var(--neel); filter: url(#brush); }
  html[data-og="icon"] .ogcard { width: 180px; height: 180px; padding: 0; }
  html[data-og="icon"] .og-top, html[data-og="icon"] .og-tag, html[data-og="icon"] .og-title, html[data-og="icon"] .og-foot { display: none; }
  html[data-og="icon"] .og-mark { display: block; }
  .og-mark .painted { display: block; font: 400 8.4rem/180px var(--display); --shout: var(--sindoor); --shadow: var(--neel); --stroke: var(--kajal); -webkit-text-stroke: .03em var(--kajal); }

  @media (max-width: 1024px) {
    .stars { gap: 1rem; }
    .star { padding: .9rem 1rem 1rem; }
    .how-grid { gap: 2rem 2rem; }
  }
  @media (max-width: 900px) {
    .stars { grid-template-columns: 1fr; }
    .star { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'name play' 'desc play' 'wave wave' 'words words'; column-gap: 1.2rem; align-items: center; }
    .star-name { grid-area: name; }
    .star-desc { grid-area: desc; margin: .2rem 0 0; }
    .star .play { grid-area: play; align-self: center; }
    .star .wave { grid-area: wave; }
    .star .words { grid-area: words; }
    .lede { grid-template-columns: 1fr; gap: 1rem; }
    .entry, .row, .hv { grid-template-columns: 1fr; gap: .5rem; }
    .hv-head .slip { max-width: 46ch; }
    .fine-cols { columns: 1; }
    .how-grid { grid-template-columns: 1fr; gap: 2.4rem; }
    .door { position: static; }
  }
  @media (max-width: 640px) {
    :root { --prog-h: 3rem; }
    body { font-size: 1.03rem; }
    .topline { flex-direction: column; gap: .15rem; }
    .title-lat { letter-spacing: .2em; margin-left: .2em; }
    .example { grid-template-columns: 1fr; grid-template-areas: 'label' 'desc' 'btn' 'words'; gap: .5rem; }
    .example .play { justify-self: start; }
    .prog-top { padding: 0 .8rem; font-size: 1.4rem; }
    .prog-list a { padding: 0 .85rem; gap: .4rem; }
    .prog-list a [lang="hi"], .prog-list--tech a::before { font-size: 1.1rem; }
    .view { padding: 0 .8rem 0 .6rem; gap: .3rem; }
    .view-a { padding: .35rem .5rem .3rem; font-size: .72rem; letter-spacing: .05em; }
    .v-long { display: none; }
    .v-short { display: inline; }
    .star { grid-template-columns: 1fr; grid-template-areas: 'name' 'desc' 'play' 'wave' 'words'; }
    .star .play { justify-self: start; margin-top: .8rem; }
    .deck { grid-template-columns: 1fr; grid-template-areas: 'btn' 'where' 'now'; gap: .6rem; }
    .deck--pair { grid-template-areas: 'btn' 'now'; }
    .deck .play { justify-self: start; }
    .play--big { flex-wrap: wrap; row-gap: .3rem; }
    .play--big .play-sub { flex-basis: 100%; }
    .play--big .play-sub::before { content: none; }
    .line { grid-template-columns: 5.4rem minmax(0, 1fr); grid-template-areas: 'who who' 'play words' 'wave wave'; column-gap: .8rem; }
    .line--hi, .lines--hi .line--hi { grid-template-columns: 5.4rem minmax(0, 1fr); grid-template-areas: 'who who' 'play words' 'play gloss' 'play missing' 'wave wave'; }
    .line .words { padding-top: .1rem; }
    .who small { display: inline; margin: 0 0 0 .6rem; }
    .double { grid-template-columns: 1fr; }
    .slip { max-width: 100%; }
    .door-arrow { width: 5rem; height: 2.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
  /* more contrast: crisp edges, no paper grain, no dimmed ink, thicker rules */
  @media (prefers-contrast: more) {
    .poster::after { display: none; }
    .painted, .band::before, .band::after, .prog::after, .hb::before, .tmap .tm-node::after, .tmap .tm-title { filter: none; }
    .tag-plain, .missing, .licence, .gloss { color: var(--chuna); }
    .tmap .tm-node i { color: var(--kajal); }
    .tmap :is(.tm-node--learned, .tm-node--gate) i { color: var(--chuna); }
    .tmap .tm-node--dropped { opacity: 1; }
    .tabs [role="tab"], .prog-list a, .view-a, .prog-top, .view { border-color: var(--chuna); }
    .play, .tabs [role="tab"], .btn, .view-a { border-width: 4px; }
    .tab-sub { opacity: 1; }
    .where li.is-done { background: rgba(242,180,30,.7); background: color-mix(in srgb, var(--ch, var(--haldi)) 70%, transparent); }
  }
</style>

<script>
  // Players: one clip at a time, painted waveforms drawn from the real audio, two run-through instruments (the scene,
  // and the English-then-Hindi pair), a language switch, the programme strip following the reader, the two views, the pacing illustration.
  const players = Array.from(document.querySelectorAll('[data-player]')) as HTMLElement[];
  const peaks = new WeakMap<HTMLElement, number[]>();
  const live = document.getElementById('live');
  const say = (t: string) => { if (live) { live.textContent = ''; live.textContent = t; } };
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const moreContrast = window.matchMedia('(prefers-contrast: more)').matches;
  let current: HTMLAudioElement | null = null;

  function draw(p: HTMLElement) {
    const c = p.querySelector('canvas.wave') as HTMLCanvasElement | null;
    const src = peaks.get(p);
    if (!c || !src) return;
    const audio = p.querySelector('audio') as HTMLAudioElement;
    const dpr = window.devicePixelRatio || 1;
    const w = c.clientWidth, h = c.clientHeight;
    if (!w || !h) return;
    if (c.width !== Math.round(w * dpr)) { c.width = Math.round(w * dpr); c.height = Math.round(h * dpr); }
    const g = c.getContext('2d');
    if (!g) return;
    g.setTransform(dpr, 0, 0, dpr, 0, 0);
    g.clearRect(0, 0, w, h);
    const cs = getComputedStyle(p);
    const ink = cs.getPropertyValue('--wave').trim() || '#000';
    const lit = cs.getPropertyValue('--wave-lit').trim() || ink;
    const prog = audio.duration ? audio.currentTime / audio.duration : 0;
    const gap = 2, n = Math.max(24, Math.floor(w / 5)), bw = (w - gap * (n - 1)) / n;
    for (let i = 0; i < n; i++) {
      let v = 0;
      for (let j = Math.floor(i * src.length / n), end = Math.max(j + 1, Math.floor((i + 1) * src.length / n)); j < end; j++) v = Math.max(v, src[j]);
      const played = (i + .5) / n <= prog;
      g.globalAlpha = played || moreContrast ? 1 : 0.62;
      g.fillStyle = played ? lit : ink;
      const bh = Math.max(3, v * h * 0.94);
      g.fillRect(i * (bw + gap), (h - bh) / 2, bw, bh);
    }
  }

  // a clip that is not in this build (the deployed site carries no Hindi): the player goes, the words stay
  function missing(p: HTMLElement) { p.classList.add('is-missing'); const a = p.querySelector('audio'); if (a && !a.paused) a.pause(); }
  async function loadWave(p: HTMLElement) {
    const c = p.querySelector('canvas.wave');
    const audio = p.querySelector('audio') as HTMLAudioElement | null;
    if (!c || !audio) return;
    try {
      const res = await fetch(audio.getAttribute('src') || '');
      if (!res.ok) { missing(p); return; }
      const data = await new OfflineAudioContext(1, 1, 44100).decodeAudioData(await res.arrayBuffer());
      const ch = data.getChannelData(0);
      const n = 240, step = Math.max(1, Math.floor(ch.length / n));
      const out: number[] = [];
      for (let i = 0; i < n; i++) {
        let peak = 0;
        for (let j = i * step, end = Math.min(ch.length, (i + 1) * step); j < end; j += 2) { const v = Math.abs(ch[j]); if (v > peak) peak = v; }
        out.push(peak);
      }
      const max = Math.max(...out) || 1;
      peaks.set(p, out.map((v) => v / max));
      draw(p);
    } catch { /* the words and the player are still there; the drawing is a bonus */ }
  }
  const io = 'IntersectionObserver' in window
    ? new IntersectionObserver((entries) => { for (const e of entries) if (e.isIntersecting) { io!.unobserve(e.target); loadWave(e.target as HTMLElement); } }, { rootMargin: '240px' })
    : null;

  // two run-throughs, one instrument each: the scene (five lines, with where-we-are), and the pair (the English seed, then the Hindi line)
  type Run = { btn: HTMLButtonElement; list: HTMLElement[]; now: HTMLElement | null; idle: string; on: string; off: string; label: (i: number) => string };
  const where = Array.from(document.querySelectorAll('.where li')) as HTMLElement[];
  const lines = Array.from(document.querySelectorAll('#lang-en .line[data-player]')) as HTMLElement[];
  const pairLines = Array.from(document.querySelectorAll('.lines--pair .line[data-player]')) as HTMLElement[];
  const mkRun = (sel: string, list: HTMLElement[], on: string, off: string, label: (i: number) => string): Run | null => {
    const btn = document.querySelector(sel) as HTMLButtonElement | null;
    if (!btn || !list.length) return null;
    const now = btn.parentElement?.querySelector('.now') as HTMLElement | null;
    return { btn, list, now, idle: now?.textContent || '', on, off, label };
  };
  const scene = mkRun('[data-play-scene]', lines, 'Stop the scene', 'Play the scene', (i) => `Line ${i + 1} of ${lines.length} · ${lines[i].querySelector('.who')?.textContent || ''}`);
  const pair = mkRun('[data-play-pair]', pairLines, 'Stop the pair', 'Play the pair', (i) => i ? 'Now: Guru, in Hindi. The first of the three lines.' : 'Now: Mentor, in English. The seed clip.');
  let run: Run | null = null, qi = -1;
  const paintWhere = (i: number) => where.forEach((w, k) => { w.classList.toggle('is-done', i >= 0 && k < i); w.classList.toggle('is-now', k === i); });
  const setRunLabel = (r: Run, on: boolean) => { const t = r.btn.querySelector('.play-txt'); if (t) t.textContent = on ? r.on : r.off; r.btn.setAttribute('aria-pressed', String(on)); };
  function stopRun(quiet = false) {
    if (run) {
      const a = run.list[qi]?.querySelector('audio') as HTMLAudioElement | undefined; if (a && !a.paused) a.pause();
      setRunLabel(run, false); if (run.now) run.now.textContent = run.idle; if (run === scene) paintWhere(-1);
    }
    run = null; qi = -1; if (!quiet) say('Stopped.');
  }
  function playNext() {
    if (!run) return;
    const p = run.list[qi], a = p.querySelector('audio') as HTMLAudioElement;
    setRunLabel(run, true); if (run === scene) paintWhere(qi); if (run.now) run.now.textContent = run.label(qi);
    const r = p.getBoundingClientRect();
    if (r.top < 56 || r.bottom > window.innerHeight) p.scrollIntoView({ block: 'center', behavior: reduceMotion ? 'auto' : 'smooth' });
    a.play().catch(() => stopRun(true));
  }
  for (const r of [scene, pair]) r?.btn.addEventListener('click', () => { if (run === r) stopRun(); else { stopRun(true); run = r; qi = 0; playNext(); } });

  for (const p of players) {
    const audio = p.querySelector('audio') as HTMLAudioElement | null;
    const btn = p.querySelector('[data-play]') as HTMLButtonElement | null;
    if (!audio || !btn) continue;
    audio.controls = false;
    const txt = btn.querySelector('.play-txt') as HTMLElement | null;
    const label = btn.getAttribute('aria-label');
    const rest = label ? label.replace(/^Play\. /, '') : '';
    const name = () => p.querySelector('.who, .star-name')?.firstChild?.textContent || p.closest('.hv')?.querySelector('.hv-name')?.textContent || 'the example';
    const setState = (on: boolean) => {
      p.classList.toggle('is-playing', on); btn.setAttribute('aria-pressed', String(on));
      if (txt) txt.textContent = on ? 'Pause' : 'Play';
      if (label) btn.setAttribute('aria-label', `${on ? 'Pause' : 'Play'}. ${rest}`);
    };
    btn.addEventListener('click', () => { if (audio.paused) audio.play().catch(() => {}); else audio.pause(); });
    audio.addEventListener('error', () => { missing(p); setState(false); say(`${name()}: this clip is not in this build.`); });
    audio.addEventListener('play', () => {
      if (current && current !== audio && !current.paused) current.pause();
      current = audio;
      if (run && run.list[qi] !== p) stopRun(true);
      setState(true);
      say(run === scene ? `Playing line ${qi + 1} of ${lines.length}, ${name()}.` : `Playing ${name()}.`);
    });
    audio.addEventListener('pause', () => {
      setState(false); draw(p);
      if (!audio.ended) { if (run && run.list[qi] === p) stopRun(true); if (current === audio) say('Paused.'); }
    });
    audio.addEventListener('timeupdate', () => draw(p));
    audio.addEventListener('ended', () => {
      draw(p);
      if (run && run.list[qi] === p) { qi++; if (qi < run.list.length) playNext(); else { const done = run === scene ? 'Scene finished.' : 'Both played.'; stopRun(true); say(done); } }
    });
    if (io) io.observe(p); else loadWave(p);
  }

  // the language switch: English and Hindi play; the others say plainly what exists and what does not ship
  const tabs = Array.from(document.querySelectorAll('[role="tab"]')) as HTMLButtonElement[];
  function selectTab(tab: HTMLButtonElement, focus = false) {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls') || '');
      if (panel) panel.hidden = !on;
    }
    if (current && !current.paused) current.pause(); stopRun(true);
    players.forEach(draw);
    if (focus) tab.focus();
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => selectTab(t));
    t.addEventListener('keydown', (e) => {
      const k = e.key;
      const j = k === 'ArrowRight' ? (i + 1) % tabs.length : k === 'ArrowLeft' ? (i - 1 + tabs.length) % tabs.length : k === 'Home' ? 0 : k === 'End' ? tabs.length - 1 : -1;
      if (j >= 0) { e.preventDefault(); selectTab(tabs[j], true); }
    });
  });

  // the two sides of the sheet: the class mirrors the hash (the CSS :target rules already cover scripts-off), and the switch announces itself
  const html = document.documentElement;
  const viewLinks = Array.from(document.querySelectorAll('.view-a')) as HTMLAnchorElement[];
  function setView() {
    const tech = /^#technical/.test(location.hash), was = html.classList.contains('view-tech');
    html.classList.toggle('view-tech', tech);
    for (const a of viewLinks) { if (a.classList.contains('view-a--tech') === tech) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current'); }
    if (was === tech) return;
    if (current && !current.paused) current.pause(); stopRun(true);
    (document.getElementById(location.hash.slice(1)) || document.getElementById('top'))?.scrollIntoView({ block: 'start' });
    say(tech ? 'The technical map. Fourteen sections.' : 'The landing page.');
  }
  window.addEventListener('hashchange', setView); setView();

  // the programme strip follows the reader, on whichever side is showing
  const progLinks = Array.from(document.querySelectorAll('.prog-list a')) as HTMLAnchorElement[];
  const bands = progLinks.map((a) => document.getElementById(a.getAttribute('href')!.slice(1))).filter(Boolean) as HTMLElement[];
  if ('IntersectionObserver' in window && bands.length) {
    const seen = new Map<HTMLElement, boolean>();
    const mark = () => {
      const id = bands.find((b) => seen.get(b))?.id;
      for (const a of progLinks) {
        const on = a.getAttribute('href') === `#${id}`, list = a.closest('.prog-list') as HTMLElement;
        if (on) { a.setAttribute('aria-current', 'location'); list.scrollTo({ left: a.offsetLeft - list.clientWidth / 2 + a.offsetWidth / 2, behavior: reduceMotion ? 'auto' : 'smooth' }); }
        else a.removeAttribute('aria-current');
      }
      if (!id) document.querySelectorAll('.prog-list').forEach((l) => l.scrollTo({ left: 0, behavior: reduceMotion ? 'auto' : 'smooth' }));
    };
    const bio = new IntersectionObserver((entries) => { for (const e of entries) seen.set(e.target as HTMLElement, e.isIntersecting); mark(); }, { rootMargin: '-45% 0px -50% 0px' });
    bands.forEach((b) => bio.observe(b));
  }

  let rt: number | undefined;
  window.addEventListener('resize', () => { window.clearTimeout(rt); rt = window.setTimeout(() => players.forEach(draw), 120); });

  // pacing: a bounded illustration, text only
  const pace = document.getElementById('pace') as HTMLInputElement | null;
  const paceOut = document.getElementById('pace-out');
  const paceMsg = (v: number) =>
    v < 0.8 ? 'Measured as the same person saying the same words. A listener noted the slow extreme starts to sound processed.'
    : v > 1.25 ? 'Measured as the same person saying the same words, outside the narrower range a listener called clean.'
    : 'Inside the range a listener called clean: the same person, the same words.';
  pace?.addEventListener('input', () => { if (paceOut) paceOut.textContent = paceMsg(Number(pace.value)); });
</script>
