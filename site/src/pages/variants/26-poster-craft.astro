  /* the programme strip: a stencilled band that sticks once you scroll past the masthead; the switch at its end turns the sheet over */
  .prog { position: sticky; top: 0; z-index: 3; display: flex; align-items: stretch; height: var(--prog-h); background: var(--kajal); color: var(--chuna); --focus: var(--haldi); }
  .prog::after { content: ''; position: absolute; left: -40px; right: -40px; top: 100%; margin-top: -14px; height: 30px; background: var(--kajal); filter: url(#brush); pointer-events: none; }
  .prog-top { display: flex; align-items: center; padding: 0 1rem 0 var(--gutter); font: 400 1.6rem/1 var(--display); color: var(--haldi); text-decoration: none; border-right: 2px solid rgba(244,238,221,.25); }
  .prog-list { display: flex; flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: none; scroll-snap-type: x proximity; }
