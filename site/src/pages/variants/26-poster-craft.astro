  .example { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'label label' 'desc btn' 'words btn'; gap: .3rem 2.5rem; align-items: center; text-align: left; border-top: 4px solid var(--kajal); padding-top: 1rem; margin-top: 1.3rem; }
  .ex-label { grid-area: label; font: 600 1rem/1.2 var(--cond); color: var(--neel); }
