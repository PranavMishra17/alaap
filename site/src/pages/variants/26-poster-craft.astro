  .ch-innkeeper, .ch-narrator { --ch: var(--chuna); --ch-lit: var(--sindoor); --ch-shadow: var(--haldi); }
  .ch-elder { --ch: var(--sindoor); --ch-lit: var(--haldi); --ch-shadow: var(--kajal); --ch-ink: var(--haldi); --who-shadow: var(--haldi); }

  /* painted lettering: fill, a black brush outline, a hard offset shadow in a second enamel */
  .painted { color: var(--shout); -webkit-text-stroke: .035em var(--stroke); paint-order: stroke fill; text-shadow: .06em .06em 0 var(--shadow); filter: url(#brush-soft); }
