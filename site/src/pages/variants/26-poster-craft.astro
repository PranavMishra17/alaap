  @font-face { font-family: 'Khand Fallback'; src: local('Arial Narrow'); size-adjust: 97.3%; ascent-override: 107.9%; descent-override: 49.2%; line-gap-override: 0%; }
  @font-face { font-family: 'Yatra One Fallback'; src: local('Nirmala UI'); size-adjust: 102.8%; ascent-override: 96.4%; descent-override: 47.4%; line-gap-override: 0%; }

