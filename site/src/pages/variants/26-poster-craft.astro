  .view-a { padding: .4rem .65rem .35rem; border: 2px solid rgba(244,238,221,.45); font: 700 .78rem/1 var(--cond); text-transform: uppercase; letter-spacing: .08em; text-decoration: none; white-space: nowrap; }
  .view-a:hover { border-color: var(--chuna); }
  .v-short { display: none; }

  /* the two sides of the sheet. Scripts off: #technical shows when it, or a section inside it, is the :target. Scripts on: html.view-tech mirrors the hash. */
  #technical, .prog-list--tech, .tech-back { display: none; }
  .view-a--land { background: var(--haldi); color: var(--kajal); border-color: var(--haldi); box-shadow: 2px 2px 0 var(--sindoor); }
  html:is(.view-tech, :has(#technical:target), :has(#technical :target)) :is(.landing, .prog-list--land, .skip) { display: none; }
  html:is(.view-tech, :has(#technical:target), :has(#technical :target)) :is(#technical, .tech-back) { display: block; }
  html:is(.view-tech, :has(#technical:target), :has(#technical :target)) .prog-list--tech { display: flex; }
  html:is(.view-tech, :has(#technical:target), :has(#technical :target)) .view-a--land { background: transparent; color: var(--chuna); border-color: rgba(244,238,221,.45); box-shadow: none; }
  html:is(.view-tech, :has(#technical:target), :has(#technical :target)) .view-a--tech { background: var(--haldi); color: var(--kajal); border-color: var(--haldi); box-shadow: 2px 2px 0 var(--sindoor); }
  .tech-back { padding: 0 var(--gutter) clamp(2.4rem, 5vw, 3.5rem); background: var(--chuna); text-align: center; }

  /* pasted paper slips: a torn edge, a paler fibre edge behind it, a hard shadow */
  .slip { position: relative; isolation: isolate; display: block; width: fit-content; max-width: 46ch; margin-top: 1rem; padding: .55rem .9rem .6rem; color: var(--kajal); font: 500 1rem/1.35 var(--cond); transform: rotate(-1.1deg); filter: drop-shadow(2px 3px 0 rgba(0,0,0,.42)); }
  .slip::before, .slip::after { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--chuna); clip-path: var(--torn); }
  .slip::after { inset: -2px -3px; z-index: -2; background: #FFFCF2; }
