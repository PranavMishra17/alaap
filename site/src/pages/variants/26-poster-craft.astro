  .tagline { margin: clamp(1.2rem, 3vw, 2.2rem) auto 0; font: 700 clamp(1.05rem, 2vw, 1.4rem)/1.2 var(--cond); text-transform: uppercase; letter-spacing: .12em; color: var(--kajal); }
