  .title-lat { display: block; font: 700 clamp(1.8rem, 5vw, 3.4rem)/1 var(--cond); text-transform: uppercase; letter-spacing: .32em; margin: .2rem 0 0 .32em; color: var(--kajal); }
  .lede { display: grid; grid-template-columns: 2fr 3fr; gap: 1rem 3rem; margin-top: clamp(1.4rem, 3vw, 2.2rem); text-align: left; border-top: 4px solid var(--kajal); padding-top: 1.2rem; }
  .meaning { font: 500 clamp(1.05rem, 1.7vw, 1.25rem)/1.4 var(--body); color: var(--neel); }
