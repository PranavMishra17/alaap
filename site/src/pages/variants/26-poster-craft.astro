---
// Variant 26 — "poster · craft". Variant 12's hand-painted wall poster, re-cut by the craftsman:
// the same enamel, lettering and paper slips; tighter type and spacing, a sticky programme strip,
// the scene as one instrument, an honest language switch, full metadata.
// Round 2: the Hindi tab plays (review renders, marked on every player, text-only when a file is
// absent); the technical map is the other side of the sheet (Landing · Technical map, works with
// scripts off via :target); one diagram on the landing and a painted pointer to the rest.
import { existsSync, readFileSync } from 'node:fs';
import { name, meaning, links, characters, scene, seeds, clipCaveats } from '../../content/alaap';
import { indicVoices, indicClips, indicCaveat } from '../../content/indic-review';
import TechnicalMap from '../../components/TechnicalMap.astro';
const seedOf = (id: string) => seeds.find((s) => s.character === id)!;
const hiClip = (v: string, i: number) => indicClips.find((c) => c.voice === v && c.lineIndex === i)!;
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
// the technical map's fourteen sections, mirrored into the programme strip (ids from the component)
const tech = [['ctx', 'The whole system'], ['tower', 'Two towers'], ['mint', 'Minting'], ['render', 'Rendering'], ['gates', 'The gates'], ['rev', 'Checkable captions'], ['geom', 'The speaker space'],
  ['axes', 'What describes a voice'], ['backend', 'Two engines'], ['codec', 'Content and identity'], ['dir', 'Direction'], ['mods', 'Modules'], ['exp', 'Experiments'], ['stages', 'Plan status']];

const slug = '26-poster-craft';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ?? new URL('http://127.0.0.1:4322/');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(`${base}/og/${slug}.png`, site).href;
// the 180×180 touch icon is shot from ?og=icon into public/og/ and inlined here when present, so it survives the git-excluded folder
const touchFile = new URL(`../../../public/og/${slug}-touch.png`, import.meta.url);
const touchIcon = existsSync(touchFile) ? `data:image/png;base64,${readFileSync(touchFile).toString('base64')}` : `${base}/og/${slug}-touch.png`;
const title = 'Alaap — a voice from a description';
const description = 'Describe a character in ordinary language. Get back a voice that has never existed. Keep it for every line you write. English, Hindi, Bengali, Tamil.';
const ogAlt = 'Alaap, painted in Devanagari and Latin on a yellow wall poster, with the line: describe a character, get a voice nobody has recorded, keep it.';
const mark = (size: number) => 'data:image/svg+xml,' + encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" fill="#F2B41E"/><text x="32" y="${size === 64 ? 49 : 50}" font-family="Yatra One,Nirmala UI,Kohinoor Devanagari,Noto Sans Devanagari,sans-serif" font-size="44" text-anchor="middle" fill="#C6201A" stroke="#17140F" stroke-width="2.5" paint-order="stroke">आ</text></svg>`);
const ld = {
  '@context': 'https://schema.org', '@type': 'SoftwareSourceCode',
  name: 'Alaap', alternateName: 'आलाप', description, url: canonical, image: ogImage,
  codeRepository: links.repo, license: ['https://opensource.org/license/mit', 'https://creativecommons.org/licenses/by/4.0/'],
  inLanguage: 'en', dateModified: '2026-09-12',
};
---
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#F2B41E" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href={mark(64)} />
    <link rel="apple-touch-icon" sizes="180x180" href={touchIcon} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alaap" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Eczar:wght@400;500&family=Khand:wght@500;600;700&family=Yatra+One&display=swap" rel="stylesheet" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
    <script is:inline>(function (h) { h.classList.remove('no-js'); var m = /[?&]og(?:=([^&]*))?(?:&|$)/.exec(location.search); if (m) h.dataset.og = m[1] || 'card'; h.classList.toggle('view-tech', /^#technical/.test(location.hash)); })(document.documentElement);</script>
  </head>
  <body>
    <svg class="defs" aria-hidden="true" width="0" height="0" focusable="false">
      <filter id="brush" x="-5%" y="-100%" width="110%" height="300%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.006 0.05" numOctaves="3" seed="11" result="wave" />
        <feDisplacementMap in="SourceGraphic" in2="wave" scale="22" xChannelSelector="R" yChannelSelector="G" result="d1" />
        <feTurbulence type="turbulence" baseFrequency="0.03 0.25" numOctaves="1" seed="3" result="bristle" />
        <feDisplacementMap in="d1" in2="bristle" scale="3" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="brush-soft" x="-4%" y="-8%" width="108%" height="116%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="4" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="3.5" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="brush-box" x="-6%" y="-12%" width="112%" height="124%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.02 0.06" numOctaves="2" seed="9" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="5" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <div class="ogcard" hidden aria-hidden="true">
      <p class="og-top"><span>In English, Hindi, Bengali and Tamil</span><span>Measured 2026-09-05</span></p>
      <p class="og-tag">Describe a character. Get a voice nobody has recorded. Keep it.</p>
      <p class="og-title"><span class="painted" lang="hi">{name.devanagari}</span><span class="og-lat">{name.latin}</span></p>
      <p class="og-foot"><span>a voice from a description</span><span>github.com/PranavMishra17/alaap</span></p>
      <p class="og-mark"><span class="painted" lang="hi">आ</span></p>
    </div>

    <a class="skip" href="#cast">Skip to the voices</a>
    <main class="poster" id="top">
      <header class="band band--haldi masthead landing">
        <p class="topline"><span>In English, Hindi, Bengali and Tamil</span><span>Measured 2026-09-05</span></p>
        <p class="tagline">Describe a character. Get a voice nobody has recorded. Keep it.</p>
        <h1 class="title"><span class="title-dev painted" lang="hi">{name.devanagari}</span> <span class="title-lat">{name.latin}</span></h1>
        <div class="lede">
          <p class="meaning">“{meaning}”</p>
          <p class="oneliner">You describe a character in ordinary language. You get back a voice that has never existed. Then you use that voice for any line of dialogue you write, and it stays the same character every time.</p>
        </div>
        <div class="example" data-player>
          <p class="ex-label">The example. This is all the system was given:</p>
          <p class="ex-desc">“{characters[0].description}”</p>
          <button type="button" class="play play--big" data-play aria-pressed="false"><span class="tri" aria-hidden="true"></span><span class="play-txt">Play</span><span class="play-sub">the voice it minted · {seedOf('mentor').seconds} s</span></button>
          <p class="words">It says: “{seedOf('mentor').text}”</p>
          <audio preload="none" controls src={seedOf('mentor').src}></audio>
        </div>
        <p class="forwhom">For people making games, animation, audio drama, dubbing, interactive fiction: anyone who needs many distinct speaking characters and cannot hire a cast for each one.</p>
      </header>

      <!-- the programme strip: two lists (one per view) and the switch between the two sides of the sheet -->
      <nav class="prog" aria-label="Programme">
        <a class="prog-top" href="#top"><span lang="hi" aria-hidden="true">आ</span><span class="sr">Back to the top</span></a>
        <ol class="prog-list prog-list--land">
          <li><a href="#cast"><span lang="hi">कलाकार</span> <span class="prog-en">The cast</span></a></li>
          <li><a href="#scene"><span lang="hi">दृश्य</span> <span class="prog-en">The scene</span></a></li>
          <li><a href="#billing"><span lang="hi">खासियत</span> <span class="prog-en">Top billing</span></a></li>
          <li><a href="#measured"><span lang="hi">नापा गया</span> <span class="prog-en">Measured</span></a></li>
          <li><a href="#how"><span lang="hi">कैसे</span> <span class="prog-en">How it is done</span></a></li>
          <li><a href="#fine"><span lang="hi">अभी नहीं</span> <span class="prog-en">Not there yet</span></a></li>
        </ol>
        <ol class="prog-list prog-list--tech" aria-label="Sections of the technical map">
          {tech.map(([k, t]) => <li><a href={`#technical-${k}`}><span class="prog-en">{t}</span></a></li>)}
        </ol>
        <div class="view" role="group" aria-label="View">
          <a class="view-a view-a--land" href="#top">Landing</a>
          <a class="view-a view-a--tech" href="#technical"><span class="v-long">Technical map</span><span class="v-short" aria-hidden="true">Map</span></a>
        </div>
      </nav>

      <div class="landing">
      <section class="band band--kajal cast" id="cast" aria-labelledby="cast-h">
        <h2 class="bill" id="cast-h"><span class="bill-hi painted" lang="hi">कलाकार</span> <span class="bill-en">The cast: three voices, minted from nothing but the line under each name</span></h2>
        <p class="band-intro">Each name has a seed clip, the short reference recording the system stores with every identity when it is minted. Pre-rendered on 2026-09-05; nothing on this page generates a voice live.</p>
        <ul class="stars">
          {characters.map((ch) => { const s = seedOf(ch.id); return (
            <li class={`star ch-${ch.id}`} data-player>
              <h3 class="star-name" id={`${ch.id}-name`}>{cap(ch.id)}</h3>
              <p class="star-desc">Given only: <q>{ch.description}</q></p>
              <button type="button" class="play" id={`${ch.id}-play`} data-play aria-pressed="false" aria-labelledby={`${ch.id}-name ${ch.id}-play`}><span class="tri" aria-hidden="true"></span><span class="play-txt">Play</span><span class="play-sub">seed clip · {s.seconds} s</span></button>
              <canvas class="wave" aria-hidden="true"></canvas>
              <p class="words">It says: “{s.text}”</p>
              <audio preload="none" controls src={s.src}></audio>
            </li>
          ); })}
        </ul>
      </section>

      <section class="band band--kajal scene" id="scene" aria-labelledby="scene-h">
        <h2 class="bill" id="scene-h"><span class="bill-hi painted" lang="hi">दृश्य</span> <span class="bill-en">The scene: five lines, three characters, one run</span></h2>
        <p class="band-intro">Rendered together with the cast above in about four minutes on one laptop GPU: watermarked audio, plus a manifest a game engine can read.</p>
        <div class="langs">
          <p class="langs-label" id="langs-l">Language</p>
          <div class="tabs" role="tablist" aria-labelledby="langs-l">
            <button type="button" role="tab" id="tab-en" aria-selected="true" aria-controls="lang-en">English<span class="tab-sub">plays · ships</span></button>
            <button type="button" role="tab" id="tab-hi" aria-selected="false" aria-controls="lang-hi" tabindex="-1"><span lang="hi">हिन्दी</span><span class="tab-sub">plays · review only</span></button>
            <button type="button" role="tab" id="tab-bn" aria-selected="false" aria-controls="lang-bn" tabindex="-1"><span lang="bn">বাংলা</span><span class="tab-sub">measured, no clip</span></button>
            <button type="button" role="tab" id="tab-ta" aria-selected="false" aria-controls="lang-ta" tabindex="-1"><span lang="ta">தமிழ்</span><span class="tab-sub">measured, no clip</span></button>
          </div>
        </div>
        <div class="panel" id="lang-en" role="tabpanel" aria-labelledby="tab-en" tabindex="0">
          <div class="deck">
            <button type="button" class="play play--big" data-play-scene aria-pressed="false"><span class="tri" aria-hidden="true"></span><span class="play-txt">Play the scene</span><span class="play-sub">all five lines, in order</span></button>
            <ol class="where" aria-hidden="true">{scene.map((c) => <li class={`ch-${c.character}`}></li>)}</ol>
            <p class="now">Five lines. Each has its own play button; this one plays them in order.</p>
          </div>
          <ol class="lines">
            {scene.map((c) => (
              <li class={`line ch-${c.character}`} data-player>
                <span class="who">{cap(c.character)}</span>
                <button type="button" class="play" data-play aria-pressed="false" aria-label={`Play. ${cap(c.character)}: ${c.text}`}><span class="tri" aria-hidden="true"></span><span class="play-txt" aria-hidden="true">Play</span></button>
                <p class="words">“{c.text}” <span class="dur">{c.seconds} s</span> {c.experimentalEmotionSetting ? <span class="slip slip--tag">experimental emotion setting, unvalidated</span> : <span class="tag-plain">no direction</span>}</p>
                <canvas class="wave" aria-hidden="true"></canvas>
                <audio preload="none" controls src={c.src}></audio>
              </li>
            ))}
          </ol>
          <div class="slips">
            <p class="slip">{clipCaveats.watermark}</p>
            <p class="slip">{clipCaveats.emotionSetting}</p>
            <p class="slip">These clips are English, from the end-to-end demo, and the only audio that ships. The Hindi under <span lang="hi">हिन्दी</span> is a set of research renders, here for review only: the Indian-language engine is research-only under its licence.</p>
          </div>
        </div>

        <!-- Hindi: review renders. Every player carries the caveat; a missing file leaves the words and removes the player. -->
        <div class="panel panel--hi" id="lang-hi" role="tabpanel" aria-labelledby="tab-hi" tabindex="0" hidden>
          <p class="band-intro">Four voices minted on the Indian-language engine, each saying the same three lines. Three of them were minted from the very sentences the English cast came from, so one description can be heard answered by two engines. Bars are drawn from the clips, as in English.</p>
          <p class="slip" id="hi-caveat">{indicCaveat}</p>
          <section class="pair" aria-labelledby="pair-h">
            <h3 class="lead" id="pair-h">One description, two engines</h3>
            <p class="pair-desc">Both were given only: <q>{characters[0].description}</q></p>
            <div class="deck deck--pair">
              <button type="button" class="play play--big" data-play-pair aria-pressed="false" aria-describedby="hi-caveat"><span class="tri" aria-hidden="true"></span><span class="play-txt">Play the pair</span><span class="play-sub">Mentor in English, then Guru in Hindi</span></button>
              <p class="now">Two clips, one after the other. Each also has its own button.</p>
            </div>
            <ol class="lines lines--pair">
              <li class="line ch-mentor" data-player>
                <span class="who">Mentor<small>English · ships</small></span>
                <button type="button" class="play" data-play aria-pressed="false" aria-label={`Play. Mentor, the English seed clip: ${seedOf('mentor').text}`}><span class="tri" aria-hidden="true"></span><span class="play-txt" aria-hidden="true">Play</span></button>
                <p class="words">“{seedOf('mentor').text}” <span class="dur">{seedOf('mentor').seconds} s</span></p>
                <canvas class="wave" aria-hidden="true"></canvas>
                <audio preload="none" controls src={seedOf('mentor').src}></audio>
              </li>
              <li class="line line--hi ch-guru" data-player>
                <span class="who">Guru<small>Hindi · review only</small></span>
                <button type="button" class="play" data-play aria-pressed="false" aria-describedby="hi-caveat" aria-label={`Play. Guru, Hindi line 1, ${hiClip('guru', 0).seconds} seconds: ${hiClip('guru', 0).text}`}><span class="tri" aria-hidden="true"></span><span class="play-txt" aria-hidden="true">Play</span></button>
                <p class="words"><span lang="hi">“{hiClip('guru', 0).text}”</span> <span class="slip slip--tag">asked “does it say this?”, a fluent Hindi speaker said yes</span></p>
                <p class="gloss">Our translation, not a project claim: “{hiClip('guru', 0).english}”</p>
                <p class="missing">This clip is not in this build. The words above are what it says.</p>
                <canvas class="wave" aria-hidden="true"></canvas>
                <audio preload="none" controls src={hiClip('guru', 0).src}></audio>
              </li>
            </ol>
          </section>
          <div class="hi-cast">
            {indicVoices.map((v) => (
              <section class={`hv ch-${v.id}`} aria-labelledby={`hv-${v.id}`}>
                <header class="hv-head">
                  <h3 class="who hv-name" id={`hv-${v.id}`}>{cap(v.id)}</h3>
                  <p class="hv-same">{v.sameDescriptionAs ? <>same description as <b>{cap(v.sameDescriptionAs)}</b></> : 'Hindi only'}</p>
                  <p class="hv-desc">Given only: <q>{v.description}</q></p>
                  <p class="slip">{indicCaveat}</p>
                </header>
                <ol class="lines lines--hi">
                  {[0, 1, 2].map((i) => { const c = hiClip(v.id, i); return (
                    <li class={`line line--hi ch-${v.id}`} data-player>
                      <button type="button" class="play" data-play aria-pressed="false" aria-describedby="hi-caveat" aria-label={`Play. ${cap(v.id)}, Hindi line ${i + 1}, ${c.seconds} seconds: ${c.text}`}><span class="tri" aria-hidden="true"></span><span class="play-txt" aria-hidden="true">Play</span></button>
                      <p class="words"><span lang="hi">“{c.text}”</span>{c.nativeSpeakerChecked && <span class="slip slip--tag">checked by a fluent Hindi speaker: it says this</span>}</p>
                      <p class="gloss">Our translation: “{c.english}”</p>
                      <p class="missing">This clip is not in this build. The words above are what it says.</p>
                      <canvas class="wave" aria-hidden="true"></canvas>
                      <audio preload="none" controls src={c.src}></audio>
                    </li>
                  ); })}
                </ol>
              </section>
            ))}
          </div>
          <p class="slip">In the project's own measurements the Hindi path scored higher than the English path on all three identity checks. Only the guru's first line has been checked by a listener; the rest are unchecked.</p>
        </div>
        <div class="panel panel--text" id="lang-bn" role="tabpanel" aria-labelledby="tab-bn" tabindex="0" hidden>
          <h3 class="lead">Bengali: measured; renders do not ship</h3>
          <p>One of the four languages measured so far. The same research-only licence keeps its audio in the repository, so there is no Bengali clip on this page and no player pretending otherwise.</p>
        </div>
        <div class="panel panel--text" id="lang-ta" role="tabpanel" aria-labelledby="tab-ta" tabindex="0" hidden>
          <h3 class="lead">Tamil: measured; renders do not ship</h3>
          <p>One of the four languages measured so far. The same research-only licence keeps its audio in the repository, so there is no Tamil clip on this page and no player pretending otherwise.</p>
        </div>
      </section>

      <section class="band band--sindoor billing" id="billing" aria-labelledby="bill-h">
        <h2 class="bill" id="bill-h"><span class="bill-hi painted" lang="hi">खासियत</span> <span class="bill-en">Top billing: the four things that make it different</span></h2>
        <p class="band-intro">Indic is the stated reason the project exists. The tools that do this well mostly do it in English; Indian-language creators either use a handful of stock voices that everyone else is also using, or they hire actors. This project treats Hindi, Bengali and Tamil as first-class, not as an afterthought port.</p>
        <div class="entry">
          <h3 class="shout painted">A voice you keep</h3>
          <p>Most tools generate a voice each time you ask. Here the character's voice is stored as an identity and re-used: the same person across every line, every scene and every session. That consistency is measured, not hoped for.</p>
        </div>
        <div class="entry">
          <h3 class="shout painted">Who speaks is not what is said</h3>
          <p>The system holds who is speaking apart from what is said. One character can say anything without the voice changing, and changing the line never changes the person. Verified rather than assumed: the same audio content played through two different identities comes out with identical words. The measured error between them was exactly zero on every line tested.</p>
        </div>
        <div class="entry">
          <h3 class="shout painted">No recording. Ever.</h3>
          <p>There is no voice cloning here, and no user uploads their own audio. Voices come from a written description, which sidesteps the consent and impersonation problem entirely: you cannot accidentally clone a real person if the system never accepts a recording.</p>
        </div>
        <div class="entry">
          <h3 class="shout painted">It knows what it does not know</h3>
          <div>
            <p>Every capability is measured against a control, and the honest limits are published beside the results. Roughly twenty findings were wrong on the first attempt and caught by a check, including one where an entire experiment produced fluent-sounding speech that was saying different words than requested, and nothing errored. That is written up publicly rather than quietly fixed.</p>
            <p class="slip">House rule: “A suspiciously good or suspiciously bad number is a bug report about your setup.”</p>
          </div>
        </div>
      </section>

      <section class="band band--haldi measured" id="measured" aria-labelledby="meas-h">
        <h2 class="bill" id="meas-h"><span class="bill-hi painted" lang="hi">नापा गया</span> <span class="bill-en">Measured, with what each result does not say pasted over it</span></h2>
        <div class="row">
          <h3 class="lead">It works end to end today</h3>
          <div class="row-body">
            <p>On one 6 GB laptop GPU, in English, Hindi, Bengali and Tamil. Describe a character, get a voice, render a scene of dialogue, and out comes watermarked audio plus a file a game engine can read. The Indian-language engine covers 22 Indian languages; four are measured so far.</p>
          </div>
        </div>
        <div class="row">
          <h3 class="lead">Minting a voice costs nothing in clarity</h3>
          <div class="row-body">
            <p>A described voice is just as intelligible as one taken from a real recording. The measured difference was tiny, leaned slightly in the invented voice's favour, and was smaller than the difference between two real speakers: that gap was six times larger. Read it as no detectable difference, not as invented voices being better.</p>
            <p class="slip">The control that had to pass first: every version must come out the same length before any score is read, or the run aborts.</p>
          </div>
        </div>
        <div class="row">
          <h3 class="lead">Distinct people, and consistent ones</h3>
          <div class="row-body">
            <p>Verified by a separate speaker-recognition system that has never seen the generator: an independent check, not the system marking its own homework. Each invented voice sits clearly apart from the nearest real voice the system learned from, so these are new voices, not real people wearing a label.</p>
            <p>And a character stays itself across different sentences more consistently than a real person does across different recordings, which is unsurprising once you think about it: a stored voice has no bad-throat day, no change of microphone, no mood.</p>
          </div>
        </div>
        <div class="row">
          <h3 class="lead">A blind listening test found and fixed a real problem</h3>
          <div class="row-body">
            <p>Pairs the system called different voices were heard as the same person about half the time. The threshold was raised. That removed 10 duplicate voices from a set of 50 and cost 3 percent of measured variety.</p>
            <p class="slip">Small test: 8 pairs and one listener, with every control answered correctly. It found the problem but does not settle the exact threshold, and the English threshold has not had its own listening test.</p>
          </div>
        </div>
        <div class="row">
          <h3 class="lead">Pacing holds within a measured range</h3>
          <div class="row-body">
            <p>You can slow a character to about two-thirds of normal speed or push them to about 1.4 times, and they stay the same person saying the same words. Outside that range the identity fades gradually rather than breaking.</p>
            <div class="pace">
              <label class="pace-label" for="pace">Speed, as a bounded illustration. Nothing on this page re-times audio.</label>
              <input id="pace" type="range" min="0.67" max="1.43" step="0.01" value="1" aria-describedby="pace-out" />
              <div class="ticks" aria-hidden="true"><span>0.67×</span><span>0.8×</span><span>normal</span><span>1.25×</span><span>1.43×</span></div>
              <output for="pace" id="pace-out" class="pace-out">Inside the range a listener called clean: the same person, the same words.</output>
            </div>
            <p class="slip">A listener noted the slow extreme starts to sound processed; the range they called clean is narrower, about 0.8 to 1.25 times.</p>
          </div>
        </div>
        <div class="row row--bill">
          <h3 class="lead">Double bill: two ways to answer a description</h3>
          <div class="row-body">
            <p>Invent a new voice, or find the closest match in an existing library of voices. Inventing gives you a character nobody else has; finding gives you higher accuracy and studio quality. Neither is strictly better, and the project has numbers for the trade-off.</p>
            <div class="double">
              <div class="half">
                <h4 class="shout painted">Invent</h4>
                <p>A character nobody else has. Before two mis-set settings were fixed, inventing reached 37% of the variety available to it; the fix raised the invented catalogue from 14 to 22 distinct Hindi voices and from 23 to 41 English.</p>
              </div>
              <div class="half">
                <h4 class="shout painted">Find</h4>
                <p>On a library of 141 real Hindi voices, two thirds of descriptions (65.6%) get a voice that matches on every trait named, and 87% land within one step. When a description names only a couple of traits, the way people actually write, 53.8% match exactly; random chance is about 20%. On 2,500 English voices the same method reaches 88.5%; on 138 Bengali voices it replicates within a point or two. Finding reaches 87% of the variety the library holds.</p>
                <p>What finding cannot do: produce a voice the library does not contain; guarantee a new character is unique, since two descriptions can return the same voice; and the library is someone else's, so every character in every project draws from the same shelf.</p>
              </div>
            </div>
            <p class="slip">The library measured was real recorded speakers standing in for a studio library. No commercial system has been measured.</p>
          </div>
        </div>
        <div class="row">
          <h3 class="lead">Watermarked and logged from the first render</h3>
          <div class="row-body">
            <p>Every render is watermarked and logged from the first output, not added later. The watermark is AudioSeal. The output includes a manifest a game engine can consume: this is built for a pipeline, not a demo button. The manifest's own disclosure line: “AI-generated synthetic speech. All audio carries an AudioSeal watermark.” 114 automated checks guard the rules the project learned the hard way.</p>
          </div>
        </div>
      </section>

      <!-- how it is done: one painted diagram, and the door to the other side of the sheet -->
      <section class="band band--neel how" id="how" aria-labelledby="how-h">
        <h2 class="bill" id="how-h"><span class="bill-hi painted" lang="hi">कैसे</span> <span class="bill-en">How it is done: what goes in, what comes out</span></h2>
        <div class="how-grid">
          <figure class="hld" aria-labelledby="hld-a">
            <figcaption><h3 class="hld-q shout painted" id="hld-a">The whole thing, in one column</h3></figcaption>
            <ol class="chain">
              <li><div class="hb hb--thing">your description</div></li>
              <li><div class="hb hb--part"><b>the mapper</b><small>the only part that learns</small></div></li>
              <li><div class="hb hb--keep"><b>a voice identity</b><small>stored: the voice, a short seed clip, and the engine version that made it</small></div></li>
              <li><div class="hb hb--part"><b>the voice engine</b><small>never modified, swappable</small></div>
                <p class="side">Also into the engine: the script, line by line, and per-line direction. Direction means pacing, within a measured range; emotion is not solved.</p></li>
              <li><div class="hb hb--thing">audio, one file per line</div>
                <p class="side side--loop"><b>The checker</b> listens to each render and asks whether it is the voice that was asked for. It is a separate speaker-recognition system that has never seen the engine's internals.</p></li>
              <li><div class="hb hb--part"><b>watermark</b><small>every file, from the first render</small></div></li>
              <li><div class="hb hb--thing hb--out">the audio files, plus a manifest a game engine can read</div></li>
            </ol>
            <p class="hld-note">Only one small piece is trained, so a better engine can be swapped in without rebuilding everything. The identity is a small, storable thing: it can be saved, versioned and handed to someone else. Performance never enters it; that is why the same character stays the same person, line after line.</p>
          </figure>
          <aside class="door">
            <span class="door-arrow" aria-hidden="true"></span>
            <h3 class="shout painted">The rest is on the other side</h3>
            <p>Fourteen more pictures, with the model names, thresholds and numbers this poster leaves out: how a voice is minted and gated, why the two engines differ, which measurements describe a voice, what was tried and what failed, and how far along it honestly is.</p>
            <a class="btn btn--haldi" href="#technical">Open the technical map</a>
            <p class="rules">The rules, one line each: never accept a user's audio · watermark from the first render · store timbre, not performance · do not start the next stage until this one is measured.</p>
          </aside>
        </div>
      </section>

      <section class="band band--chuna fine" id="fine" aria-labelledby="fine-h">
        <h2 class="bill" id="fine-h"><span class="bill-hi painted" lang="hi">अभी नहीं</span> <span class="bill-en">Not there yet: the fine print, in full</span></h2>
        <div class="fine-cols">
          <p><strong>Not a product.</strong> This is a working research system, not a product. There is no signup, no hosted service, no API.</p>
          <p><strong>Emotion is not solved.</strong> You can control pacing within a measured range. You cannot yet say “say this line apologetically” and have it work. That was tested thoroughly and does not work on the current engine, for reasons the project documented and reported upstream: the engine's documented emotion tags turn out not to be recognised by the engine at all, and a listener heard no difference between tagged versions of the same line.</p>
          <p><strong>The catalogue is small.</strong> Tens of distinct voices per language so far, not hundreds: about 22 in Hindi and 41 in English by the project's own measure. The limit is understood and measured rather than mysterious: the real speakers the system learned from hold about 38 to 48 distinguishable voices, and the project measured exactly where its own method loses variety.</p>
          <p><strong>Cannot ship as a product, for licensing reasons.</strong> The Indian-language engine's training chain includes data licensed for non-commercial use, so no model weights and no Indian-language audio leave the repository. It is research-only today, deliberately, and the reasons are documented.</p>
          <p><strong>Very little has been listened to.</strong> Most results are automatic measurements. One listener, a handful of pairs.</p>
          <p><strong>No comparison against a commercial system.</strong> None has been measured.</p>
          <p><strong>The clips that ship are English.</strong> Hindi renders exist and a native speaker has checked one; they play under <span lang="hi">हिन्दी</span> in the scene for review only, because the Indian-language engine's licence is research-only, so they do not ship.</p>
          <p><strong>Three of the five demo lines</strong> were rendered with an experimental emotion setting whose effect has not been validated on this engine. Listen to them as voice samples, not performances.</p>
        </div>
      </section>

      <footer class="band band--kajal booking" id="booking">
        <div class="cta">
          <a class="btn btn--haldi" href={links.repo}>Read the research</a>
          <a class="btn btn--line" href={links.issues}>Corrections welcome</a>
        </div>
        <p class="quote">“If a claim here is wrong, an issue with a primary source is more useful than almost anything else.”</p>
        <p class="licence">Research and documentation CC-BY-4.0 · code MIT · no model weights and no generated Indian-language audio ship · <a href={links.repo}>github.com/PranavMishra17/alaap</a></p>
        <p class="foot-door"><a href="#technical">For engineers: the technical map, the other side of this sheet</a></p>
      </footer>
      </div>

      <!-- the other side of the sheet: hidden until switched to; #technical (or any section in it) works with scripts off -->
      <TechnicalMap id="technical" heading="The technical map" />
      <p class="tech-back"><a class="btn btn--haldi" href="#top">Back to the poster</a></p>
    </main>
    <p class="sr" id="live" aria-live="polite"></p>
  </body>
</html>

<style is:global>
  /* tokens */
