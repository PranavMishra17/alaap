---
// Variant 25 — "poster, for the reader". Variant 12's hand-painted wall poster, re-cut so it tells
// its story top to bottom in fewer words: the first voice above the fold, a pinned programme strip
// as the contents, the scene as one instrument, an honest language switch, and three painted
// diagrams of how it is done. Same enamel, same lettering, same paper slips.
// Round 2: the Hindi tab plays (review renders, marked), the technical map is a second view of the
// same page (Landing · Technical map, works with scripts off via :target), one diagram on the landing.
import { name, meaning, links, characters, scene, seeds, clipCaveats } from '../../content/alaap';
import { indicVoices, indicClips, indicCaveat } from '../../content/indic-review';
import TechnicalMap from '../../components/TechnicalMap.astro';
const seedOf = (id: string) => seeds.find((s) => s.character === id)!;
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
const hindiClipsOf = (id: string) => indicClips.filter((c) => c.voice === id);
const guruLine0 = indicClips.find((c) => c.voice === 'guru' && c.lineIndex === 0)!;
const slug = '25-poster-reader';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ?? new URL('http://127.0.0.1:4322/');
const canonical = new URL(`${base}/variants/${slug}`, site).href;
const ogImage = new URL(`${base}/og/${slug}.png`, site).href;
const title = 'Alaap — a voice from a description';
const description = 'Describe a character in ordinary language. Get back a voice that has never existed, and keep it: the same character across every line you write.';
const favicon = 'data:image/svg+xml,' + encodeURIComponent(
  `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' fill='#F2B41E'/><text x='31' y='50' font-family='Yatra One,Nirmala UI,Mangal,sans-serif' font-size='46' font-weight='700' text-anchor='middle' fill='#C6201A' stroke='#17140F' stroke-width='2.5' paint-order='stroke fill'>आ</text></svg>`,
);
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'SoftwareSourceCode', name: 'Alaap', alternateName: 'आलाप', description, url: canonical, image: ogImage,
  codeRepository: links.repo, license: ['https://opensource.org/license/mit', 'https://creativecommons.org/licenses/by/4.0/'], inLanguage: 'en',
});
const programme = [
  { id: 'top', hi: 'आलाप', en: 'Alaap' },
  { id: 'cast', hi: 'कलाकार', en: 'The cast' },
  { id: 'scene', hi: 'दृश्य', en: 'The scene' },
  { id: 'why', hi: 'खासियत', en: 'Why it differs' },
  { id: 'how', hi: 'कैसे', en: 'How it is done' },
  { id: 'measured', hi: 'नापा गया', en: 'Measured' },
  { id: 'not-yet', hi: 'अभी नहीं', en: 'Not there yet' },
  { id: 'read', hi: 'शोध', en: 'The research' },
];
// the technical map's fourteen sections, as the strip shows them in the other view (ids from the component)
const techProgramme = [
  ['ctx', 'The whole system'], ['tower', 'Two towers'], ['mint', 'Minting'], ['render', 'Rendering'], ['gates', 'The gates'],
  ['rev', 'Checkable captions'], ['geom', 'The speaker space'], ['axes', 'What describes a voice'], ['backend', 'Two engines'],
  ['codec', 'Content and identity'], ['dir', 'Direction'], ['mods', 'Modules'], ['exp', 'Experiments'], ['stages', 'Plan status'],
];
---
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F2B41E" />
    <meta name="robots" content="index,follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A hand-painted poster in yellow, red and blue: the word Alaap in Devanagari, and the line: describe a character, get a voice nobody has recorded, keep it." />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content="Alaap" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Eczar:wght@400;500;700&family=Khand:wght@400;500;600;700&family=Yatra+One&display=swap" rel="stylesheet" />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
    <script is:inline>document.documentElement.classList.remove('no-js'); if (/[?&]og(?:[=&]|$)/.test(location.search)) document.documentElement.classList.add('og');</script>
  </head>
  <body>
    <svg class="defs" aria-hidden="true" width="0" height="0" focusable="false">
      <filter id="brush" x="-5%" y="-60%" width="110%" height="220%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.009 0.09" numOctaves="2" seed="11" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="16" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="brush-soft" x="-4%" y="-8%" width="108%" height="116%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="4" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="3.5" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <symbol id="arr" viewBox="0 0 48 48"><path d="M5 25 C 15 21, 27 26, 40 23 M29 12 L42 23 L30 36" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" /></symbol>
    </svg>

    <!-- the share card: shown only with ?og, for the 1200×630 image -->
    <div class="card band--haldi" aria-hidden="true">
      <p class="topline"><span>In English · Hindi · Bengali · Tamil</span><span>Measured 2026-09-05</span></p>
      <p class="card-dev painted" lang="hi">{name.devanagari}</p>
      <p class="card-lat">{name.latin}</p>
      <p class="card-tag">Describe a character. Get a voice nobody has recorded. Keep it.</p>
      <p class="card-ex"><span class="card-exl">The example. All the system was given:</span>“{characters[0].description}”</p>
      <p class="card-foot"><span>a voice from a description</span><span>github.com/PranavMishra17/alaap</span></p>
    </div>

    <main class="poster">
      <!-- the programme strip: a cinema poster's listing band, pinned. It is the contents. -->
      <nav class="programme" aria-label="Contents">
        <div class="view-switch" role="group" aria-label="View">
          <a href="#top" class="view-btn view-btn--landing" aria-current="true">Landing</a>
          <a href="#technical" class="view-btn view-btn--tech"><span class="vb-long">Technical map</span><span class="vb-short" aria-hidden="true">Tech map</span></a>
        </div>
        <ol class="prog prog--landing">
          {programme.map((p, i) => (
            <li><a href={`#${p.id}`} data-target={p.id} class={i === 0 ? 'is-here' : undefined} aria-current={i === 0 ? 'location' : undefined}><span lang="hi">{p.hi}</span><span>{p.en}</span></a></li>
          ))}
        </ol>
        <ol class="prog prog--tech">
          {techProgramme.map(([k, t], i) => (
            <li><a href={`#technical-${k}`} data-target={`technical-${k}`} class={i === 0 ? 'is-here' : undefined}><span class="prog-n" aria-hidden="true"></span><span>{t}</span></a></li>
          ))}
        </ol>
      </nav>

      <div class="landing">
      <!-- 1 · masthead: the name, and the first voice -->
      <header class="band band--haldi masthead" id="top">
        <p class="topline"><span>In English · Hindi · Bengali · Tamil</span><span>Measured 2026-09-05</span></p>
        <div class="mast">
          <div class="mast-left">
            <h1 class="title">
              <span class="title-dev painted" lang="hi">{name.devanagari}</span>
              <span class="title-lat">{name.latin}</span>
            </h1>
            <p class="meaning">“{meaning}”</p>
          </div>
          <div class="mast-right">
            <p class="tagline">Describe a character. Get a voice nobody has recorded. Keep it.</p>
            <p class="oneliner">You describe a character in ordinary language. You get back a voice that has never existed. Then you use that voice for any line of dialogue you write, and it stays the same character every time.</p>
            <p class="forwhom">For games, animation, audio drama, dubbing, interactive fiction: anyone who needs many distinct speaking characters and cannot hire a cast for each one.</p>
          </div>
        </div>
        <div class="example" data-player>
          <div class="ex-main">
            <p class="ex-label">The example. All the system was given:</p>
            <p class="ex-desc">“{characters[0].description}”</p>
            <canvas class="wave" aria-hidden="true"></canvas>
            <p class="words">It says: “{seedOf('mentor').text}”</p>
          </div>
          <div class="ex-side">
            <button type="button" class="btn btn--sindoor" data-play aria-pressed="false"><span class="tri" aria-hidden="true"></span><span class="play-txt">Play</span><span class="btn-sub">the voice it minted · {seedOf('mentor').seconds} s</span></button>
            <p class="slip">Pre-rendered on 2026-09-05. Nothing here generates a voice live.</p>
          </div>
          <audio preload="none" controls src={seedOf('mentor').src}></audio>
        </div>
      </header>

      <!-- 2 · the cast -->
      <section class="band band--neel cast" id="cast" aria-labelledby="cast-h">
        <h2 class="bill" id="cast-h"><span class="bill-hi painted" lang="hi">कलाकार</span><span class="bill-en">The cast · three voices from three descriptions</span></h2>
        <p class="band-intro">Press a name to hear its seed clip, the short recording stored with every identity when it is minted. The line under each name is all it was given.</p>
        <ul class="stars">
          {characters.map((ch) => { const s = seedOf(ch.id); return (
            <li class="star" data-player>
              <button type="button" class="star-btn" data-play aria-pressed="false">
                <span class="star-name">{cap(ch.id)}</span>
                <span class="star-hint"><span class="tri" aria-hidden="true"></span><span class="play-txt">Play</span> the seed clip · {s.seconds} s</span>
              </button>
              <p class="star-desc">Given only: <q>{ch.description}</q></p>
              <canvas class="wave" aria-hidden="true"></canvas>
              <p class="words">Seed clip says: “{s.text}”</p>
              <audio preload="none" controls src={s.src}></audio>
            </li>
          ); })}
        </ul>
      </section>

      <!-- 3 · the scene, as one instrument; then the languages -->
      <section class="band band--kajal scene" id="scene" aria-labelledby="scene-h">
        <h2 class="bill" id="scene-h"><span class="bill-hi painted" lang="hi">दृश्य</span><span class="bill-en">The scene · five lines, three characters, one run</span></h2>
        <p class="band-intro">Rendered with the cast in about four minutes on one 6 GB laptop GPU. Out came watermarked audio and a manifest a game engine can read.</p>
        <div class="transport">
          <button type="button" class="btn btn--haldi scene-btn" data-play-scene aria-pressed="false"><span class="tri" aria-hidden="true"></span><span class="scene-txt">Play the scene</span><span class="btn-sub">five lines, in order</span></button>
          <div class="now-box">
            <ol class="pips" aria-hidden="true">{scene.map(() => <li class="pip"></li>)}</ol>
            <p class="now" aria-live="polite">Nothing playing. Press play for all five, or one line below.</p>
          </div>
        </div>
        <ol class="lines">
          {scene.map((c, i) => (
            <li class="line" data-player data-who={cap(c.character)} data-n={i + 1}>
              <span class="who">{cap(c.character)}</span>
              <button type="button" class="play" data-play aria-pressed="false" aria-label={`Play line ${i + 1}, ${cap(c.character)}: ${c.text}`}><span class="tri" aria-hidden="true"></span><span class="play-txt" aria-hidden="true">Play</span></button>
              <p class="words">“{c.text}”</p>
              <canvas class="wave" aria-hidden="true"></canvas>
              <span class="dur">{c.seconds} s</span>
              {c.experimentalEmotionSetting ? <span class="slip slip--tag">experimental emotion setting, unvalidated</span> : <span class="tag-plain">no direction</span>}
              <audio preload="none" controls src={c.src}></audio>
            </li>
          ))}
        </ol>
        <div class="slips">
          <p class="slip">{clipCaveats.watermark}</p>
          <p class="slip">{clipCaveats.emotionSetting}</p>
          <p class="slip">These clips are English, from the end-to-end demo. The Hindi under हिन्दी below is a set of research renders, shown for review only: the Indian-language engine is research-only under its licence, so they do not ship.</p>
        </div>

        <div class="langs" id="languages">
          <h3 class="lead">Languages</h3>
          <p class="langs-intro">Two engines behind one interface. English: open licence, ships; these clips. Indian-language: covers 22 Indian languages, four measured so far; research-only, because its training chain includes non-commercial data. Enforced in code, not just in a README.</p>
          <div class="tabs" role="tablist" aria-label="Language">
            <button type="button" class="tab" role="tab" id="tab-en" aria-controls="panel-en" aria-selected="true">English</button>
            <button type="button" class="tab" role="tab" id="tab-hi" aria-controls="panel-hi" aria-selected="false" tabindex="-1" lang="hi">हिन्दी</button>
            <button type="button" class="tab" role="tab" id="tab-bn" aria-controls="panel-bn" aria-selected="false" tabindex="-1" lang="bn">বাংলা</button>
            <button type="button" class="tab" role="tab" id="tab-ta" aria-controls="panel-ta" aria-selected="false" tabindex="-1" lang="ta">தமிழ்</button>
          </div>
          <div class="panel is-on" role="tabpanel" id="panel-en" aria-labelledby="tab-en">
            <p class="panel-lang">English</p>
            <p><strong>Plays; ships.</strong> Every demo clip on this page is English: the three seeds and the five lines above.</p>
          </div>
          <div class="panel panel--hi" role="tabpanel" id="panel-hi" aria-labelledby="tab-hi">
            <p class="panel-lang" lang="hi">हिन्दी</p>
            <p><strong>Plays here, for review only; does not ship.</strong> Four voices minted on the Indian-language engine, each saying the same three lines. Three of them were minted from the very sentences the English cast came from, so you can hear one description answered by two engines.</p>
            <p class="slip">{indicCaveat}</p>

            <!-- the comparison: one description, two engines, one tap -->
            <div class="pair">
              <h4 class="lead">One description, two engines</h4>
              <p class="pair-desc">“{characters[0].description}”</p>
              <div class="pair-transport">
                <button type="button" class="btn btn--haldi" data-play-pair aria-pressed="false"><span class="tri" aria-hidden="true"></span><span class="pair-txt">Hear both</span><span class="btn-sub">English first, then Hindi</span></button>
                <p class="now pair-now" aria-live="polite">Two voices from the same sentence. Or press either one below.</p>
              </div>
              <div class="pair-cols">
                <div class="pair-half" data-player data-pair="0">
                  <p class="pair-who"><span class="pair-name">Mentor</span> · English engine · the seed clip</p>
                  <button type="button" class="play" data-play aria-pressed="false" aria-label="Play Mentor, English engine, the seed clip"><span class="tri" aria-hidden="true"></span><span class="play-txt" aria-hidden="true">Play</span></button>
                  <canvas class="wave" aria-hidden="true"></canvas>
                  <p class="words">“{seedOf('mentor').text}”</p>
                  <audio preload="none" controls src={seedOf('mentor').src}></audio>
                </div>
                <div class="pair-half" data-player data-pair="1" data-hi>
                  <p class="pair-who"><span class="pair-name">Guru</span> · Hindi engine · line 1</p>
                  <button type="button" class="play" data-play aria-pressed="false" aria-label="Play Guru, Hindi engine, line 1"><span class="tri" aria-hidden="true"></span><span class="play-txt" aria-hidden="true">Play</span></button>
                  <canvas class="wave" aria-hidden="true"></canvas>
                  <p class="words" lang="hi">{guruLine0.text}</p>
                  <p class="gloss">Our translation: “{guruLine0.english}”</p>
                  <p class="missing">Clip not in this build; the words stand.</p>
                  <audio preload="none" controls src={guruLine0.src}></audio>
                </div>
              </div>
            </div>

            <!-- the four Hindi voices, three lines each -->
            <ul class="hcast">
              {indicVoices.map((v) => (
                <li class="hvoice">
                  <h4 class="hv-name">{cap(v.id)}</h4>
                  <p class="hv-desc">Given only: <q>{v.description}</q></p>
                  <p class="hv-same">{v.sameDescriptionAs ? <>The same sentence that minted <strong>{cap(v.sameDescriptionAs)}</strong> in the English cast.</> : 'Its own description; no English twin.'}</p>
                  <ol class="hlines">
                    {hindiClipsOf(v.id).map((c) => (
                      <li class="hline" data-player data-hi>
                        <button type="button" class="play" data-play aria-pressed="false" aria-label={`Play ${cap(v.id)}, Hindi, line ${c.lineIndex + 1}`}><span class="tri" aria-hidden="true"></span><span class="play-txt" aria-hidden="true">Play</span></button>
                        <p class="words" lang="hi">{c.text}</p>
                        <p class="gloss">Our translation: “{c.english}”</p>
                        <canvas class="wave" aria-hidden="true"></canvas>
                        <span class="dur" data-dur></span>
                        {c.nativeSpeakerChecked && <span class="slip slip--tag">Checked by a fluent Hindi speaker: it says these words</span>}
                        <p class="missing">Clip not in this build; the words stand.</p>
                        <audio preload="none" controls src={c.src}></audio>
                      </li>
                    ))}
                  </ol>
                  <p class="slip">{indicCaveat}</p>
                </li>
              ))}
            </ul>
            <p class="small">Only the first line of Guru has been checked by a fluent Hindi speaker, asked “does it say this?”, not “does it sound right?”. The other eleven clips have not been checked. In the project's own measurements the Hindi path scored higher than the English path on all three identity checks.</p>
          </div>
          <div class="panel" role="tabpanel" id="panel-bn" aria-labelledby="tab-bn">
            <p class="panel-lang" lang="bn">বাংলা</p>
            <p><strong>Measured; renders do not ship.</strong> Same engine, same licence rule.</p>
          </div>
          <div class="panel" role="tabpanel" id="panel-ta" aria-labelledby="tab-ta">
            <p class="panel-lang" lang="ta">தமிழ்</p>
            <p><strong>Measured; renders do not ship.</strong> Same engine, same licence rule.</p>
          </div>
        </div>
      </section>

      <!-- 4 · top billing: the four differentiators -->
      <section class="band band--sindoor billing" id="why" aria-labelledby="why-h">
        <h2 class="bill" id="why-h"><span class="bill-hi painted" lang="hi">खासियत</span><span class="bill-en">Top billing · the four things that make it different</span></h2>
        <p class="band-intro">Indic is the stated reason the project exists. The tools that do this well mostly do it in English, so Indian-language creators use the same handful of stock voices as everyone else, or hire actors. Here Hindi, Bengali and Tamil are first-class.</p>
        <div class="entry">
          <h3 class="shout painted">A voice you keep</h3>
          <p>Most tools generate a voice each time you ask. Here it is stored as an identity and re-used: the same character sounds like the same person across every line, scene and session. That consistency is measured, not hoped for.</p>
        </div>
        <div class="entry">
          <h3 class="shout painted">Who speaks is not what is said</h3>
          <p>Identity is held apart from the words, so a character can say anything without the voice changing, and a new line never changes the person. Verified: the same audio content played through two different identities came out with identical words. The measured error was exactly zero on every line tested.</p>
        </div>
        <div class="entry">
          <h3 class="shout painted">No recording. Ever.</h3>
          <p>No voice cloning; nobody uploads audio. Voices come from a written description, which sidesteps the consent and impersonation problem entirely: you cannot accidentally clone a real person if the system never accepts a recording.</p>
        </div>
        <div class="entry">
          <h3 class="shout painted">It knows what it does not know</h3>
          <div>
            <p>Every capability is measured against a control, and the limits are published beside the results. Roughly twenty findings were wrong on the first attempt and caught by a check, including an entire experiment that produced fluent-sounding speech saying different words than requested, with nothing erroring. Written up publicly, not quietly fixed.</p>
            <p class="slip">House rule: “A suspiciously good or suspiciously bad number is a bug report about your setup.”</p>
          </div>
        </div>
      </section>

      <!-- 5 · how it is done: one painted diagram, and the door to the technical map -->
      <section class="band band--neel how" id="how" aria-labelledby="how-h">
        <h2 class="bill" id="how-h"><span class="bill-hi painted" lang="hi">कैसे</span><span class="bill-en">How it is done · end to end, in seven steps</span></h2>
        <p class="band-intro">Painted solid: what this project made. Outlined: the voice engine, used as-is and never altered, so a better one can be swapped in.</p>

        <figure class="hld">
          <figcaption><h3 class="lead">What happens, end to end?</h3></figcaption>
          <ol class="hgrid">
            <li class="pn pn--plain"><b class="n" aria-hidden="true"></b><strong>your description</strong><small>ordinary language</small><svg class="arr" aria-hidden="true"><use href="#arr" /></svg></li>
            <li class="pn pn--haldi"><b class="n" aria-hidden="true"></b><strong>the mapper</strong><small>the only part that learns</small><svg class="arr" aria-hidden="true"><use href="#arr" /></svg></li>
            <li class="pn pn--plain"><b class="n" aria-hidden="true"></b><strong>a voice identity</strong><small>stored: the voice, a short seed clip, the engine version that made it</small><svg class="arr" aria-hidden="true"><use href="#arr" /></svg></li>
            <li class="pn pn--line"><b class="n" aria-hidden="true"></b><strong>the voice engine</strong><small>never modified, swappable</small>
              <span class="under">Also in: the script, and per-line direction. Pacing, within a measured range; emotion is not solved.</span><svg class="arr arr--wrap" aria-hidden="true"><use href="#arr" /></svg></li>
            <li class="ret" aria-hidden="true"><svg viewBox="0 0 100 10" preserveAspectRatio="none"><path d="M100 0 V5 H0 V10" fill="none" stroke="currentColor" stroke-width="5" vector-effect="non-scaling-stroke" /></svg><i></i></li>
            <li class="pn pn--plain"><b class="n" aria-hidden="true"></b><strong>audio</strong><small>one file per line</small><svg class="arr" aria-hidden="true"><use href="#arr" /></svg></li>
            <li class="pn pn--haldi"><b class="n" aria-hidden="true"></b><strong>watermark</strong><small>every file, from the first render</small><svg class="arr" aria-hidden="true"><use href="#arr" /></svg></li>
            <li class="pn pn--plain"><b class="n" aria-hidden="true"></b><strong>the audio files</strong><small>plus a manifest a game engine can read</small></li>
            <li class="pn pn--check"><strong>the checker</strong><small>Listens to every render. A separate speaker-recognition system, never shown the engine's internals, asks: is this the voice that was asked for?</small></li>
          </ol>
        </figure>

        <div class="door">
          <div class="door-text">
            <h3 class="lead">Want the engineer's version?</h3>
            <p>The technical map is the other side of this page: fourteen painted diagrams with the model names, thresholds and numbers the poster leaves out. How a voice is minted and gated, why the same character stays the same person, why the two engines differ, what was tried and what failed.</p>
          </div>
          <a class="btn btn--haldi door-btn" href="#technical">Open the technical map<span class="btn-sub">fourteen diagrams</span></a>
        </div>
      </section>

      <!-- 6 · measured -->
      <section class="band band--haldi measured" id="measured" aria-labelledby="meas-h">
        <h2 class="bill" id="meas-h"><span class="bill-hi painted" lang="hi">नापा गया</span><span class="bill-en">Measured · and, pasted over each result, what it does not say</span></h2>
        <div class="ledger">
        <div class="row">
          <h3 class="lead">Minting a voice costs nothing in clarity</h3>
          <div class="row-body">
            <p>A described voice is as intelligible as one taken from a real recording. The measured difference was tiny, leaned slightly the invented voice's way, and the gap between two real speakers was six times larger. Read that as no detectable difference, not as invented voices being better.</p>
            <p class="slip">The control that had to pass first: every version must come out the same length before any score is read, or the run aborts.</p>
          </div>
        </div>

        <div class="row">
          <h3 class="lead">Invented voices are distinct people</h3>
          <div class="row-body">
            <p>Verified by a separate speaker-recognition system that has never seen the generator: not the system marking its own homework. Each invented voice also sits clearly apart from the nearest real voice it learned from: new voices, not real people wearing a label.</p>
          </div>
        </div>

        <div class="row">
          <h3 class="lead">A character stays itself more than a real person does</h3>
          <div class="row-body">
            <p>Across sentences a character stays itself more consistently than a real person does across recordings. Unsurprising once you think about it: a stored voice has no bad-throat day, no change of microphone, no mood.</p>
          </div>
        </div>

        <div class="row">
          <h3 class="lead">A blind listening test found and fixed a real problem</h3>
          <div class="row-body">
            <p>Pairs the system called different were heard as the same person about half the time. The threshold was raised, which removed 10 duplicate voices from a set of 50 and cost 3 percent of measured variety.</p>
            <p class="slip">Small test: 8 pairs, one listener, every control answered correctly. It found the problem; it does not settle the exact threshold, and the English threshold has not had its own listening test.</p>
          </div>
        </div>

        <div class="row">
          <h3 class="lead">Pacing holds within a measured range</h3>
          <div class="row-body">
            <p>Slow a character to about two-thirds of normal speed or push them to about 1.4 times, and they stay the same person saying the same words. Outside that range the identity fades gradually rather than breaking.</p>
            <div class="pace" role="img" aria-label="A painted scale from about two-thirds to about 1.4 times normal speed, the measured range; inside it, from about 0.8 to 1.25 times, the narrower range a listener called clean.">
              <div class="pace-bar"><span class="pace-clean"></span></div>
              <div class="ticks"><span>0.67×</span><span>0.8×</span><span>normal</span><span>1.25×</span><span>1.43×</span></div>
              <p class="pace-key"><span class="key-item"><span class="key key--sindoor"></span>measured: same person, same words</span> <span class="key-item"><span class="key key--chuna"></span>called clean by a listener</span></p>
            </div>
            <p class="slip">A listener said the slow extreme starts to sound processed; the range they called clean is narrower, about 0.8 to 1.25 times.</p>
          </div>
        </div>

        <div class="row">
          <h3 class="lead">Watermarked and logged from the first render</h3>
          <div class="row-body">
            <p>Every render is watermarked (AudioSeal) and logged from the first output, not added later. The manifest says so itself: “AI-generated synthetic speech. All audio carries an AudioSeal watermark.” 114 automated checks guard the rules learned the hard way.</p>
          </div>
        </div>

        <div class="row row--bill">
          <h3 class="lead">Double bill: two ways to answer a description</h3>
          <div class="row-body">
            <p>Invent a new voice, or find the closest match in an existing library. Inventing gives a character nobody else has; finding gives higher accuracy and studio quality. Neither is strictly better; the numbers say so.</p>
            <div class="double">
              <div class="half">
                <h4 class="shout painted">Invent</h4>
                <p>Before two mis-set settings were fixed, inventing reached 37% of the variety available to it. The fix raised the catalogue from 14 to 22 distinct Hindi voices and from 23 to 41 English.</p>
              </div>
              <div class="half">
                <h4 class="shout painted">Find</h4>
                <p>On a library of 141 real Hindi voices, two thirds of descriptions (65.6%) get a voice matching every trait named and 87% land within one step; chance is about one in five. On 2,500 English voices the same method reaches 88.5%. Finding cannot produce a voice the library does not hold, cannot guarantee a character is unique, and the shelf is someone else's: every project draws from it.</p>
              </div>
            </div>
            <p class="slip">The library measured was real recorded speakers standing in for a studio library. No commercial system has been measured.</p>
          </div>
        </div>

        </div>
      </section>

      <!-- 7 · fine print -->
      <section class="band band--chuna fine" id="not-yet" aria-labelledby="fine-h">
        <h2 class="bill" id="fine-h"><span class="bill-hi painted" lang="hi">अभी नहीं</span><span class="bill-en">Not there yet · the fine print, in full</span></h2>
        <div class="fine-cols">
          <p><strong>Not a product.</strong> A working research system: no signup, no hosted service, no API.</p>
          <p><strong>Emotion is not solved.</strong> Pacing is controllable within a measured range, but you cannot yet say “say this line apologetically” and have it work. Tested thoroughly on the current engine, documented and reported upstream: the engine's own emotion tags are not recognised by it, and a listener heard no difference between tagged versions of the same line.</p>
          <p><strong>The catalogue is small.</strong> Tens of distinct voices per language, not hundreds: about 22 in Hindi and 41 in English. The limit is measured, not mysterious: the real speakers it learned from hold about 38 to 48 distinguishable voices, and the project measured where its method loses variety.</p>
          <p><strong>Cannot ship as a product, for licensing reasons,</strong> which are documented: the Indian-language engine's training chain includes data licensed for non-commercial use, so no model weights and no Indian-language audio leave the repository. Research-only today, deliberately.</p>
          <p><strong>Very little has been listened to.</strong> Most results are automatic measurements: one listener, a handful of pairs.</p>
          <p><strong>No comparison against a commercial system.</strong> None has been measured.</p>
          <p><strong>The demo clips are English.</strong> Hindi renders exist and are shown under हिन्दी for review only, one of them checked by a native speaker; the Indian-language engine's licence is research-only, so they do not ship.</p>
          <p><strong>Three of the five demo lines</strong> were rendered with an experimental emotion setting whose effect has not been validated on this engine. Listen to them as voice samples, not performances.</p>
        </div>
      </section>

      <!-- 8 · booking -->
      <footer class="band band--kajal booking" id="read">
        <div class="cta">
          <a class="btn btn--haldi" href={links.repo}>Read the research</a>
          <a class="btn btn--line" href={links.issues}>Corrections welcome</a>
        </div>
        <p class="quote">“If a claim here is wrong, an issue with a primary source is more useful than almost anything else.”</p>
        <p class="licence">Research and documentation CC-BY-4.0 · code MIT · no model weights and no generated Indian-language audio ship · <a href={links.repo}>github.com/PranavMishra17/alaap</a></p>
        <p class="foot-door"><a href="#technical">The technical map</a> · the engineer's view of the same page, fourteen diagrams</p>
      </footer>
      </div>

      <!-- the other view: the technical map. Hidden until switched to; #technical works with scripts off. -->
      <TechnicalMap id="technical" heading="The technical map" />
      <p class="tech-back"><a class="btn btn--haldi" href="#top">Back to the landing page</a></p>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --haldi: #F2B41E; --sindoor: #C6201A; --neel: #1F3E92; --kajal: #17140F; --chuna: #F4EEDD; --gulabi: #E4437F; --wall: #2B2E36;
