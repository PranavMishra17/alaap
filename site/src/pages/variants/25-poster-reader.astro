  .pair-half .play { grid-area: play; }
  .pair-half .words { grid-area: words; font-size: 1.15rem; padding-top: .3rem; }
  .pair-half .words[lang="hi"] { font-size: 1.25rem; }
  .pair-half .gloss { grid-area: gloss; }
  .pair-half .wave { grid-area: wave; height: 32px; margin: .2rem 0 0; }
  .pair-half .missing { grid-area: miss; }
  /* the four voices, three lines each */
  .hcast { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem 2rem; margin-top: 1.6rem; }
  .hvoice { display: flex; flex-direction: column; padding: 1rem 1.1rem 1.2rem; background: rgba(255,255,255,.06); }
  .hv-name { font: 400 clamp(1.8rem, 3vw, 2.3rem)/1.1 var(--display); color: var(--haldi); text-shadow: .05em .05em 0 var(--sindoor); }
  .hv-desc { margin-top: .4rem; font-size: 1.02rem; line-height: 1.4; }
