  .card-lat { font: 700 40px/1 var(--cond); text-transform: uppercase; letter-spacing: .32em; margin: 6px 0 0 .32em; }
  .card-tag { margin-top: 22px; font: 700 26px/1.2 var(--cond); text-transform: uppercase; letter-spacing: .12em; }
  .card-ex { align-self: center; font: 500 34px/1.25 var(--body); color: var(--sindoor); }
  .card-exl { display: block; margin-bottom: 8px; font: 600 15px/1.2 var(--cond); text-transform: uppercase; letter-spacing: .14em; color: var(--neel); }
  .card-foot { display: flex; justify-content: space-between; margin: 0 -56px; padding: 14px 56px; background: var(--kajal); color: var(--chuna); font: 600 17px/1.2 var(--cond); text-transform: uppercase; letter-spacing: .12em; }

  @media (max-width: 900px) {
    .stars { grid-template-columns: 1fr; }
