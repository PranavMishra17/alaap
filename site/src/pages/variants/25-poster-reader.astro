  .pair-half { display: grid; grid-template-columns: 5.6rem minmax(0, 1fr); grid-template-areas: 'who who' 'play words' 'play gloss' 'wave wave' 'miss miss'; column-gap: .8rem; row-gap: .25rem; padding-top: .7rem; border-top: 3px solid var(--haldi); }
  .pair-half.is-playing { background: rgba(242,180,30,.12); box-shadow: 0 0 0 .6rem rgba(242,180,30,.12); }
  .pair-who { grid-area: who; font: 600 .9rem/1.3 var(--cond); text-transform: uppercase; letter-spacing: .08em; opacity: .9; }
