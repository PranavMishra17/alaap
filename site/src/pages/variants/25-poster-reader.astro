  /* 4 · billing */
  .entry { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 1rem 3rem; padding: clamp(1.1rem, 2.4vw, 1.6rem) 0; border-top: 4px solid var(--haldi); align-items: start; }
