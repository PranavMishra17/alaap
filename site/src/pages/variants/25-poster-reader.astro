    .topline { flex-direction: column; }
    .example { flex-direction: column; gap: .6rem; }
    .ex-side { align-items: flex-start; padding-top: 0; }
    .view-switch { padding-left: .6rem; padding-right: .5rem; gap: .25rem; }
