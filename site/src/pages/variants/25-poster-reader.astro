  .pn .n { position: absolute; top: -.8rem; left: -.5rem; z-index: 1; width: 1.7rem; height: 1.7rem; display: grid; place-items: center; background: var(--sindoor); color: var(--chuna); font: 400 1.05rem/1 var(--display); box-shadow: 2px 2px 0 var(--kajal); }
  .pn strong { display: block; font: 700 1.08rem/1.15 var(--cond); text-transform: uppercase; letter-spacing: .05em; }
  .pn small { display: block; margin-top: .3rem; font-size: .92rem; line-height: 1.3; opacity: .92; }
  .pn--haldi { --pn-paint: var(--haldi); --pn-shadow: var(--sindoor); color: var(--kajal); }
  .pn--plain { --pn-paint: rgba(0,0,0,.34); --pn-shadow: transparent; color: var(--chuna); }
