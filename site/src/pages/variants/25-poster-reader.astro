  .view-btn:focus-visible { outline-color: var(--haldi); outline-offset: 2px; }
  .vb-short { display: none; }
  .prog { position: relative; flex: 1 1 0; min-width: 0; display: flex; align-items: stretch; overflow-x: auto; scrollbar-width: none; padding: 0 calc(var(--gutter) - .8rem) 0 .3rem; }
