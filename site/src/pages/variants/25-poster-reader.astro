<script>
  // Players: one clip at a time, painted waveforms drawn from the real audio, the scene as one
  // instrument, the programme strip following the reader, and the language switch.
  const players = Array.from(document.querySelectorAll('[data-player]')) as HTMLElement[];
  const bars = new WeakMap<HTMLElement, number[]>();
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let current: HTMLAudioElement | null = null;

  function draw(p: HTMLElement) {
    const c = p.querySelector('canvas.wave') as HTMLCanvasElement | null;
    const b = bars.get(p);
    if (!c || !b || c.hidden) return;
    const audio = p.querySelector('audio') as HTMLAudioElement;
    const dpr = window.devicePixelRatio || 1;
    const w = c.clientWidth, h = c.clientHeight;
    if (!w || !h) return;
    if (c.width !== Math.round(w * dpr)) { c.width = Math.round(w * dpr); c.height = Math.round(h * dpr); }
    const g = c.getContext('2d');
    if (!g) return;
    g.setTransform(dpr, 0, 0, dpr, 0, 0);
    g.clearRect(0, 0, w, h);
    const cs = getComputedStyle(p);
    const ink = cs.getPropertyValue('--wave').trim() || '#000';
    const lit = cs.getPropertyValue('--wave-lit').trim() || ink;
    const prog = audio.duration ? audio.currentTime / audio.duration : 0;
    const n = b.length, gap = 2, bw = (w - gap * (n - 1)) / n;
    for (let i = 0; i < n; i++) {
      const played = i / n < prog;
      const bh = Math.max(3, b[i] * h * 0.94);
      g.globalAlpha = played ? 1 : 0.6;
      g.fillStyle = played ? lit : ink;
      g.fillRect(i * (bw + gap), (h - bh) / 2, bw, bh);
    }
  }

  async function loadWave(p: HTMLElement) {
    const c = p.querySelector('canvas.wave') as HTMLCanvasElement | null;
    const audio = p.querySelector('audio') as HTMLAudioElement | null;
    if (!c || !audio) return;
    try {
      const res = await fetch(audio.getAttribute('src') || '');
      if (!res.ok) throw new Error(String(res.status));
      const buf = await res.arrayBuffer();
      const off = new OfflineAudioContext(1, 1, 44100);
      const data = await off.decodeAudioData(buf);
      const dur = p.querySelector('[data-dur]');
      if (dur) dur.textContent = `${data.duration.toFixed(1)} s`;
      const ch = data.getChannelData(0);
      const n = 72, step = Math.max(1, Math.floor(ch.length / n));
      const out: number[] = [];
      for (let i = 0; i < n; i++) {
        let peak = 0;
        for (let j = i * step, end = Math.min(ch.length, (i + 1) * step); j < end; j += 3) { const v = Math.abs(ch[j]); if (v > peak) peak = v; }
        out.push(peak);
      }
      const max = Math.max(...out) || 1;
      bars.set(p, out.map((v) => v / max));
      draw(p);
    } catch { if ('hi' in p.dataset) markMissing(p); else c.hidden = true; }
  }
  function markMissing(p: HTMLElement) {
    p.classList.add('is-missing');
    const a = p.querySelector('audio'); if (a && !a.paused) a.pause();
    if (p.dataset.pair === '1') { pairBtn?.closest('.pair-transport')?.classList.add('is-gone'); }
  }

  const io = 'IntersectionObserver' in window
    ? new IntersectionObserver((entries) => { for (const e of entries) if (e.isIntersecting) { io!.unobserve(e.target); loadWave(e.target as HTMLElement); } }, { rootMargin: '240px' })
    : null;

  // the scene: play all, play one, and where we are
  const sceneBtn = document.querySelector('[data-play-scene]') as HTMLButtonElement | null;
  const sceneTxt = sceneBtn?.querySelector('.scene-txt') as HTMLElement | null;
  const now = document.querySelector('.now') as HTMLElement | null;
  const pips = Array.from(document.querySelectorAll('.pip')) as HTMLElement[];
  const lines = Array.from(document.querySelectorAll('.line[data-player]')) as HTMLElement[];
  const total = lines.length;
  let sceneIdx = -1;
  const idle = 'Nothing playing. Press play for all five, or one line below.';
  function setNow(text: string, on: number, doneBefore: number) {
    if (now) now.textContent = text;
    pips.forEach((p, i) => { p.classList.toggle('is-on', i === on); p.classList.toggle('is-done', i < doneBefore); });
    lines.forEach((l, i) => l.classList.toggle('is-done', i < doneBefore));
  }
  function setSceneLabel(on: boolean) { if (sceneTxt) sceneTxt.textContent = on ? 'Stop the scene' : 'Play the scene'; sceneBtn?.setAttribute('aria-pressed', String(on)); }
  function stopScene(finished = false) {
    if (sceneIdx >= 0 && sceneIdx < total) { const a = lines[sceneIdx].querySelector('audio') as HTMLAudioElement; if (!a.paused) { a.dataset.stopped = '1'; a.pause(); } }
    sceneIdx = -1; setSceneLabel(false);
    setNow(finished ? 'Done: all five lines, in order.' : idle, -1, finished ? total : 0);
  }
  function playLine() {
    const a = lines[sceneIdx].querySelector('audio') as HTMLAudioElement;
    setSceneLabel(true);
    if (sceneIdx > 0) lines[sceneIdx].scrollIntoView({ block: 'nearest', behavior: reduceMotion ? 'auto' : 'smooth' });
    a.play().catch(() => stopScene());
  }
  sceneBtn?.addEventListener('click', () => { if (sceneIdx >= 0) stopScene(); else { sceneIdx = 0; playLine(); } });

  // the comparison: one description, two engines. English seed first, then the Hindi line, one tap.
  const pairBtn = document.querySelector('[data-play-pair]') as HTMLButtonElement | null;
  const pairTxt = pairBtn?.querySelector('.pair-txt') as HTMLElement | null;
  const pairNow = document.querySelector('.pair-now') as HTMLElement | null;
  const pairHalves = Array.from(document.querySelectorAll('[data-pair]')) as HTMLElement[];
  const pairIdle = 'Two voices from the same sentence. Or press either one below.';
  let pairIdx = -1;
  function setPair(on: boolean, text: string) { pairBtn?.setAttribute('aria-pressed', String(on)); if (pairTxt) pairTxt.textContent = on ? 'Stop' : 'Hear both'; if (pairNow) pairNow.textContent = text; }
  function stopPair() {
    if (pairIdx >= 0) { const a = pairHalves[pairIdx]?.querySelector('audio') as HTMLAudioElement | null; if (a && !a.paused) { a.dataset.stopped = '1'; a.pause(); } }
    pairIdx = -1; setPair(false, pairIdle);
  }
  function playPairHalf() {
    const a = pairHalves[pairIdx]?.querySelector('audio') as HTMLAudioElement | null;
    if (!a || pairHalves[pairIdx].classList.contains('is-missing')) { stopPair(); return; }
    setPair(true, pairIdx === 0 ? 'Now: Mentor, the English engine. Next: Guru, the Hindi engine.' : 'Now: Guru, the Hindi engine, from the same sentence.');
    a.play().catch(() => stopPair());
  }
  pairBtn?.addEventListener('click', () => { if (pairIdx >= 0) stopPair(); else { pairIdx = 0; playPairHalf(); } });

  for (const p of players) {
    const audio = p.querySelector('audio') as HTMLAudioElement | null;
    const btn = p.querySelector('[data-play]') as HTMLButtonElement | null;
    if (!audio || !btn) continue;
    audio.controls = false;
    const txt = btn.querySelector('.play-txt') as HTMLElement | null;
    const isLine = lines.includes(p);
    const n = Number(p.dataset.n), who = p.dataset.who;
    btn.addEventListener('click', () => { if (audio.paused) audio.play().catch(() => {}); else audio.pause(); });
    const pairN = p.dataset.pair === undefined ? -1 : Number(p.dataset.pair);
    if ('hi' in p.dataset) audio.addEventListener('error', () => markMissing(p));
    audio.addEventListener('play', () => {
      if (current && current !== audio && !current.paused) current.pause();
      current = audio;
      if (isLine && sceneIdx >= 0 && lines[sceneIdx] !== p) stopScene();
      if (pairIdx >= 0 && pairN !== pairIdx) stopPair();
      p.classList.add('is-playing'); btn.setAttribute('aria-pressed', 'true'); if (txt) txt.textContent = 'Pause';
      if (isLine) setNow(sceneIdx >= 0 ? `Playing line ${n} of ${total} · ${who}` : `Playing line ${n} · ${who}`, n - 1, sceneIdx >= 0 ? n - 1 : 0);
    });
    audio.addEventListener('pause', () => {
      p.classList.remove('is-playing'); btn.setAttribute('aria-pressed', 'false'); if (txt) txt.textContent = 'Play';
      draw(p);
      if (audio.dataset.stopped) { delete audio.dataset.stopped; return; }
      if (!audio.ended && pairIdx >= 0 && pairN === pairIdx) stopPair();
      if (!audio.ended && isLine) { if (sceneIdx >= 0 && lines[sceneIdx] === p) stopScene(); else if (sceneIdx < 0) setNow(`Paused on line ${n} · ${who}`, n - 1, 0); }
    });
    audio.addEventListener('timeupdate', () => draw(p));
    audio.addEventListener('ended', () => {
      draw(p);
      if (sceneIdx >= 0 && lines[sceneIdx] === p) { sceneIdx++; if (sceneIdx < total) playLine(); else stopScene(true); }
      else if (isLine) setNow(idle, -1, 0);
      if (pairIdx >= 0 && pairN === pairIdx) { pairIdx++; if (pairIdx < pairHalves.length) playPairHalf(); else { pairIdx = -1; setPair(false, 'Done: the same sentence, two engines. Press again to hear it once more.'); } }
    });
    if (io) io.observe(p); else loadWave(p);
  }

  let rt: number | undefined;
  window.addEventListener('resize', () => { window.clearTimeout(rt); rt = window.setTimeout(() => players.forEach(draw), 120); });

  // the programme strip follows the reader
  const strips = Array.from(document.querySelectorAll('.programme .prog')) as HTMLElement[];
  const html = document.documentElement;
  const isTech = () => html.classList.contains('view-tech');
  let ticking = false;
  function updateHere() {
    ticking = false;
    const strip = strips[isTech() ? 1 : 0];
    if (!strip) return;
    const stops = Array.from(strip.querySelectorAll('a[data-target]')) as HTMLAnchorElement[];
    const targets = stops.map((a) => document.getElementById(a.dataset.target || ''));
    const line = window.innerHeight * 0.38;
    let cur = 0;
    targets.forEach((t, i) => { if (t && t.getBoundingClientRect().top <= line) cur = i; });
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) cur = targets.length - 1;
    stops.forEach((a, i) => { const on = i === cur; a.classList.toggle('is-here', on); if (on) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current'); });
    if (strip.scrollWidth > strip.clientWidth + 1) {
      const a = stops[cur];
      strip.scrollTo({ left: a.offsetLeft - strip.clientWidth / 2 + a.offsetWidth / 2, behavior: reduceMotion ? 'auto' : 'smooth' });
    }
  }
  window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(updateHere); } }, { passive: true });
  window.addEventListener('resize', updateHere);

  // the two views: Landing · Technical map. The hash is the state, so the switch also works with scripts off (:target).
  const viewBtns = Array.from(document.querySelectorAll('.view-btn')) as HTMLAnchorElement[];
  function syncView() {
    const tech = location.hash.startsWith('#technical');
    if (tech !== isTech() && current && !current.paused) current.pause();
    html.classList.toggle('view-tech', tech);
    // the browser scrolled to the target before the other view was hidden; land on it again now that the page has its final shape
    const target = location.hash.length > 1 ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    if (target) target.scrollIntoView({ block: 'start' });
    viewBtns.forEach((b) => { const on = b.classList.contains('view-btn--tech') === tech; if (on) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current'); });
    players.forEach(draw);
    updateHere();
  }
  window.addEventListener('hashchange', syncView);
  syncView();

  // the language switch: real tabs, arrow keys move between them
  const tabs = Array.from(document.querySelectorAll('.tab[role="tab"]')) as HTMLButtonElement[];
  function selectTab(i: number) {
    tabs.forEach((t, j) => {
      const on = i === j;
      t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls') || '')?.classList.toggle('is-on', on);
    });
    players.forEach(draw);
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => selectTab(i));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      const k = (i + d + tabs.length) % tabs.length; selectTab(k); tabs[k].focus();
    });
  });
</script>
