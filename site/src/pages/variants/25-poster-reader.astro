  .tri { display: inline-block; width: 0; height: 0; border-left: .75em solid currentColor; border-top: .45em solid transparent; border-bottom: .45em solid transparent; vertical-align: -.02em; margin-right: .45em; }
  [aria-pressed="true"] .tri { border: 0; width: .7em; height: .8em; border-left: .25em solid currentColor; border-right: .25em solid currentColor; }
  .wave { display: block; width: 100%; height: 54px; margin: .6rem 0 .4rem; }
