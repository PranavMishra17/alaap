  .ticks span { position: absolute; top: 0; transform: translateX(-50%); white-space: nowrap; }
  .ticks span::before { content: ''; display: block; width: 2px; height: 6px; background: var(--kajal); margin: 0 auto 3px; }
  .ticks span:nth-child(1) { left: 0; transform: none; text-align: left; }
  .ticks span:nth-child(1)::before { margin-left: 0; }
  .ticks span:nth-child(2) { left: 17.1%; }
  .ticks span:nth-child(3) { left: 43.4%; }
