  /* the pacing scale: a painted illustration, not a control */
  .pace { margin: 1.2rem 0 .4rem; max-width: 40rem; }
  .pace-bar { position: relative; height: 18px; background: var(--sindoor); box-shadow: 3px 3px 0 var(--kajal); }
  .pace-clean { position: absolute; top: 3px; bottom: 3px; left: 17.1%; width: 59.2%; background: var(--chuna); }
