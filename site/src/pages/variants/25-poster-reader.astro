  /* 2 · cast */
  .stars { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.4rem; }
  .star { --wave: var(--haldi); --wave-lit: var(--chuna); display: flex; flex-direction: column; padding: 1.1rem 1.2rem 1.3rem; background: rgba(0,0,0,.28); }
  .star.is-playing { background: var(--haldi); color: var(--kajal); --wave: var(--neel); --wave-lit: var(--sindoor); --ink: var(--kajal); }
  .star-btn { display: block; width: 100%; text-align: left; background: none; border: 0; padding: 0; color: inherit; cursor: pointer; }
  .star-name { display: block; font: 400 clamp(2.3rem, 4vw, 3rem)/1.1 var(--display); color: var(--haldi); text-shadow: .05em .05em 0 var(--sindoor); }
  .is-playing .star-name { color: var(--kajal); text-shadow: .05em .05em 0 var(--chuna); }
  .star-hint { display: inline-block; margin-top: .35rem; font: 600 1rem/1.2 var(--cond); text-transform: uppercase; letter-spacing: .08em; border-bottom: 2px solid currentColor; }
  .star-desc { flex: 1; margin-top: .9rem; font-size: 1.05rem; line-height: 1.4; }
  .star .words { font-size: .95rem; opacity: .9; }

  /* 3 · scene: one instrument */
  .transport { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2.2rem; margin-bottom: 1.3rem; }
  .now-box { display: flex; flex-direction: column; gap: .45rem; min-width: 0; }
  .pips { display: flex; gap: .4rem; }
  .pip { width: 1.6rem; height: .9rem; border: 3px solid var(--haldi); background: transparent; }
  .pip.is-done { background: rgba(242,180,30,.45); }
  .pip.is-on { background: var(--haldi); box-shadow: 2px 2px 0 var(--sindoor); }
  .now { font: 600 1rem/1.3 var(--cond); text-transform: uppercase; letter-spacing: .06em; color: var(--haldi); }
  .lines { border-top: 3px solid var(--haldi); }
  .line { display: grid; grid-template-columns: 7.5rem 5.6rem minmax(0, 1fr) 4rem; grid-template-areas: 'who play words dur' 'who play wave wave' 'who play tag tag'; column-gap: 1rem; row-gap: .2rem; align-items: start; padding: .75rem 0; border-bottom: 3px solid var(--haldi); }
  .line.is-playing { background: rgba(242,180,30,.12); box-shadow: 0 0 0 .6rem rgba(242,180,30,.12); }
  .line.is-done .who { opacity: .7; }
  .who { grid-area: who; font: 400 1.5rem/1.1 var(--display); color: var(--haldi); text-shadow: .05em .05em 0 var(--sindoor); padding-top: .15rem; }
  .play { grid-area: play; display: inline-flex; align-items: center; justify-content: center; height: 2.6rem; min-width: 5.2rem; padding: 0 .6rem; background: var(--haldi); color: var(--kajal); border: 0; font: 700 1rem/1 var(--cond); text-transform: uppercase; letter-spacing: .06em; cursor: pointer; box-shadow: 2px 2px 0 var(--sindoor); }
  .play:hover, .play[aria-pressed="true"] { background: var(--chuna); }
