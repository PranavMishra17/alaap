  .view-switch { flex: 0 0 auto; display: flex; align-items: center; gap: .35rem; padding: 0 .8rem 0 calc(var(--gutter) - .2rem); border-right: 3px solid rgba(244,238,221,.25); }
  .view-btn { display: inline-flex; align-items: center; height: 2rem; padding: 0 .7rem; border: 2px solid var(--chuna); color: var(--chuna); text-decoration: none; white-space: nowrap; font: 700 .78rem/1 var(--cond); text-transform: uppercase; letter-spacing: .08em; }
  .view-btn:hover { background: rgba(244,238,221,.14); }
