  .pn .arr { position: absolute; top: .55rem; right: calc(var(--g) * -1 + .1rem); width: calc(var(--g) - .2rem); height: 2.2rem; color: var(--haldi); }
  .pn .arr--wrap { display: none; }
  .ret { position: relative; grid-column: 1 / -1; height: 2.6rem; margin: .2rem calc((100% - 3 * var(--g)) / 8) .4rem; color: var(--haldi); }
