  .hgrid { counter-reset: step; --g: 2.4rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--g); row-gap: .6rem; align-items: start; }
  .pn { position: relative; isolation: isolate; min-width: 0; padding: .8rem .85rem .75rem; font: 500 .95rem/1.3 var(--cond); }
  .pn::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--pn-paint); filter: url(#brush-soft); box-shadow: 3px 3px 0 var(--pn-shadow); }
  .pn { counter-increment: step; }
