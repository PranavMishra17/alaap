  .hld .slip { --ink: var(--kajal); }
  .door { display: flex; align-items: center; justify-content: space-between; gap: 1rem 2.5rem; margin-top: clamp(1.6rem, 3vw, 2.4rem); padding: clamp(1rem, 2.4vw, 1.6rem) clamp(1rem, 2.4vw, 1.8rem); background: rgba(0,0,0,.28); box-shadow: 5px 5px 0 var(--haldi); }
  .door-text { max-width: 60ch; }
  .door .lead { color: var(--haldi); margin-bottom: .4rem; }
  .door-btn { flex: 0 0 auto; }

  /* 6 · measured */
  .ledger { display: grid; grid-template-columns: 1fr 1fr; column-gap: 3rem; border-top: 4px solid var(--kajal); }
  .row { padding: clamp(1.1rem, 2.4vw, 1.5rem) 0 clamp(1.2rem, 2.6vw, 1.7rem); border-bottom: 4px solid var(--kajal); }
  .row--bill { grid-column: 1 / -1; }
