  .gloss { font: 400 .95rem/1.35 var(--body); opacity: .85; }
  .missing { display: none; font: 500 .9rem/1.3 var(--cond); text-transform: uppercase; letter-spacing: .06em; color: var(--haldi); }
  .is-missing .play, .is-missing .wave, .is-missing .dur, .is-missing .pair-transport { display: none; }
  .is-missing .missing { display: block; }
  .pair-transport.is-gone { display: none; }
  /* the comparison: one description, two engines */
  .pair { margin-top: 1.6rem; padding: 1.1rem 1.2rem 1.3rem; background: rgba(242,180,30,.1); border: 3px solid var(--haldi); }
