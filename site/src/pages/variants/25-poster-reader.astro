  .hv-same strong { font-weight: 700; }
  .hlines { margin-top: .8rem; border-top: 3px solid var(--haldi); }
  .hline { display: grid; grid-template-columns: 5.6rem minmax(0, 1fr) 3.5rem; grid-template-areas: 'play words dur' 'play gloss gloss' 'wave wave wave' 'tag tag tag' 'miss miss miss'; column-gap: .8rem; row-gap: .2rem; align-items: start; padding: .65rem 0; border-bottom: 3px solid var(--haldi); }
  .hline.is-playing { background: rgba(242,180,30,.12); box-shadow: 0 0 0 .5rem rgba(242,180,30,.12); }
  .hline .play { grid-area: play; }
  .hline .words { grid-area: words; font-size: 1.2rem; padding-top: .3rem; }
  .hline .gloss { grid-area: gloss; }
  .hline .wave { grid-area: wave; height: 28px; margin: .2rem 0 0; }
  .hline .dur { grid-area: dur; padding-top: .5rem; }
  .hline .slip--tag { grid-area: tag; justify-self: start; width: max-content; max-width: 100%; margin-top: .3rem; }
