  .tab[lang] { font-family: var(--display); font-weight: 400; font-size: 1.15rem; letter-spacing: 0; text-transform: none; }
  .tab[lang="bn"] { font-family: 'Nirmala UI', 'Noto Sans Bengali', 'Vrinda', sans-serif; font-weight: 700; }
