  .prog a { position: relative; display: flex; flex-direction: column; justify-content: center; gap: .3rem; height: 100%; padding: 0 .85rem .15rem; text-decoration: none; white-space: nowrap; font: 600 .72rem/1 var(--cond); text-transform: uppercase; letter-spacing: .1em; color: var(--chuna); }
  .prog a > span:first-child { font: 400 1.1rem/1 var(--display); text-transform: none; letter-spacing: 0; color: var(--haldi); }
  .prog a::after { content: ''; position: absolute; left: .6rem; right: .6rem; bottom: 0; height: 7px; background: var(--sindoor); clip-path: polygon(0 40%, 8% 0, 30% 30%, 55% 0, 80% 35%, 100% 10%, 100% 100%, 0 100%); transform: scaleX(0); transform-origin: left; transition: transform .18s; }
  .prog a.is-here::after, .prog a:hover::after { transform: none; }
  .prog a.is-here { color: var(--haldi); }
  .prog a:focus-visible { outline-color: var(--haldi); outline-offset: -4px; }
  .prog--tech { display: none; counter-reset: tm; }
  .prog--tech li { counter-increment: tm; }
  .prog-n::before { content: counter(tm); }
  @media (min-width: 1100px) { .prog { justify-content: space-between; } }
  .no-js .programme { position: static; }

  /* the two views. Scripts off: #technical shows when it, or anything inside it, is the :target. Scripts on: html.view-tech mirrors the hash. */
  #technical { display: none; }
  #technical:target, #technical:has(:target), html.view-tech #technical { display: block; }
  html:has(#technical:target) .landing, html:has(#technical :target) .landing, html.view-tech .landing { display: none; }
  html:has(#technical:target) .prog--landing, html:has(#technical :target) .prog--landing, html.view-tech .prog--landing { display: none; }
  html:has(#technical:target) .prog--tech, html:has(#technical :target) .prog--tech, html.view-tech .prog--tech { display: flex; }
  html:has(#technical:target) .view-btn--landing, html:has(#technical :target) .view-btn--landing, html.view-tech .view-btn--landing { background: transparent; color: var(--chuna); border-color: var(--chuna); box-shadow: none; }
  html:has(#technical:target) .view-btn--tech, html:has(#technical :target) .view-btn--tech, html.view-tech .view-btn--tech { background: var(--haldi); color: var(--kajal); border-color: var(--haldi); box-shadow: 2px 2px 0 var(--sindoor); }
  .tech-back { display: none; padding: 0 var(--gutter) clamp(2.6rem, 5.5vw, 4rem); background: var(--chuna); }
  html:has(#technical:target) .tech-back, html:has(#technical :target) .tech-back, html.view-tech .tech-back { display: block; }
  .foot-door { margin-top: 1.2rem; font: 600 .95rem/1.4 var(--cond); text-transform: uppercase; letter-spacing: .08em; color: var(--haldi); }

  /* 1 · masthead */
  .masthead { padding-top: 1rem; }
  .topline { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .3rem 1.5rem; font: 600 .95rem/1.3 var(--cond); text-transform: uppercase; letter-spacing: .12em; color: var(--neel); border-bottom: 4px solid var(--kajal); padding-bottom: .55rem; }
  .topline span { white-space: nowrap; }
  .mast { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 1rem 3rem; align-items: center; margin-top: clamp(1rem, 2.5vw, 1.6rem); }
  .title { line-height: 1; }
  .title-dev { display: block; font: 400 clamp(6.2rem, 13.5vw, 11.5rem)/1.06 var(--display); --shout: var(--sindoor); --shadow: var(--neel); --stroke: var(--kajal); letter-spacing: .01em; }
  .title-lat { display: block; font: 700 clamp(1.7rem, 4.5vw, 3rem)/1 var(--cond); text-transform: uppercase; letter-spacing: .32em; margin: .3rem 0 0 .25em; color: var(--kajal); }
  .meaning { max-width: 40ch; margin-top: .9rem; font: 500 clamp(1rem, 1.6vw, 1.15rem)/1.35 var(--body); color: var(--neel); }
  .tagline { font: 700 clamp(1.05rem, 2vw, 1.35rem)/1.2 var(--cond); text-transform: uppercase; letter-spacing: .12em; color: var(--kajal); }
  .oneliner { margin-top: .9rem; font-size: clamp(1.1rem, 1.7vw, 1.25rem); line-height: 1.45; }
  .forwhom { margin-top: .8rem; font: 500 1.02rem/1.4 var(--cond); color: var(--neel); }
  .example { display: flex; align-items: flex-start; gap: 1rem 2.5rem; border-top: 4px solid var(--kajal); padding-top: 1.1rem; margin-top: clamp(1.2rem, 3vw, 1.8rem); }
  .ex-main { flex: 1 1 0; min-width: 0; }
  .ex-side { flex: 0 0 auto; display: flex; flex-direction: column; align-items: flex-end; gap: .2rem; padding-top: .5rem; }
  .ex-label { font: 600 .95rem/1.2 var(--cond); text-transform: uppercase; letter-spacing: .12em; color: var(--neel); }
  .ex-desc { margin-top: .3rem; font: 500 clamp(1.5rem, 2.5vw, 1.9rem)/1.25 var(--body); color: var(--sindoor); }
  .example .wave { height: 48px; margin: .5rem 0 .25rem; }
  .example .words { font-size: 1rem; color: var(--neel); }
  .example .slip { max-width: 26ch; font-size: .92rem; }
  .btn--sindoor { background: var(--sindoor); color: var(--chuna); border-color: var(--kajal); box-shadow: 4px 4px 0 var(--neel); }
  .btn--sindoor:hover, .btn--sindoor[aria-pressed="true"] { background: var(--kajal); }
