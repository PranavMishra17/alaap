    .pair-half .play { justify-self: start; }
    .hline { grid-template-columns: 5.6rem minmax(0, 1fr) 3.5rem; grid-template-areas: 'play words dur' 'gloss gloss gloss' 'wave wave wave' 'tag tag tag' 'miss miss miss'; }
  }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }

  /* the technical map, repainted in this poster's hand: the brush edge, the painted title, the sindoor numerals, the slips */
  .poster .tmap { position: relative; padding-top: clamp(2.2rem, 5vw, 3.6rem); }
  .poster .tmap::before { content: ''; position: absolute; left: -40px; right: -40px; top: -18px; height: 36px; background: var(--chuna); filter: url(#brush); pointer-events: none; }
