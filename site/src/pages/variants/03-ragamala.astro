  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
    html { scroll-behavior: auto; }
  }
</style>

<script>
  const players = Array.from(document.querySelectorAll<HTMLElement>('.player'));
  const audioOf = (p: HTMLElement) => p.querySelector('audio') as HTMLAudioElement;
  const barOf = (p: HTMLElement) => p.querySelector('.bar i') as HTMLElement;
  let queue: string[] = [];

  const setState = (p: HTMLElement, on: boolean) => {
    p.classList.toggle('is-playing', on);
    p.querySelector('.play')?.setAttribute('aria-pressed', String(on));
    const fig = p.closest('.leafling, .hero-leaf')?.querySelector('.figure');
    fig?.classList.toggle('is-singing', on);
  };

  const paint = (f: Element | null) => f?.classList.remove('unpainted');

  const stopOthers = (keep: HTMLElement) => {
    for (const p of players) {
      if (p === keep) continue;
      const a = audioOf(p);
      if (!a.paused) a.pause();
      a.currentTime = 0;
      barOf(p).style.transform = 'scaleX(0)';
      setState(p, false);
    }
  };

  const play = (p: HTMLElement) => {
    stopOthers(p);
    paint(p.closest('.leafling, .hero-leaf')?.querySelector('.figure') ?? null);
    const a = audioOf(p);
    a.play().then(() => setState(p, true)).catch(() => setState(p, false));
  };
  const playId = (id: string) => {
    const p = players.find((x) => x.dataset.clip === id);
    if (p) play(p);
  };

  for (const p of players) {
    const a = audioOf(p);
    p.querySelector('.play')?.addEventListener('click', () => {
      if (a.paused) { queue = []; play(p); } else { a.pause(); }
    });
    a.addEventListener('timeupdate', () => {
      if (a.duration) barOf(p).style.transform = `scaleX(${a.currentTime / a.duration})`;
    });
    a.addEventListener('pause', () => setState(p, false));
    a.addEventListener('ended', () => {
      setState(p, false);
      barOf(p).style.transform = 'scaleX(0)';
      const next = queue.shift();
      if (next) playId(next);
    });
  }

  // Cue buttons: play a list of clips back to back.
  for (const b of document.querySelectorAll<HTMLElement>('.cue')) {
    b.addEventListener('click', () => {
      const ids = (b.dataset.queue ?? '').split(',').filter(Boolean);
      queue = ids.slice(1);
      if (ids[0]) playId(ids[0]);
    });
  }

  // Painting. Every panel starts as an underdrawing; the hero paints itself once it is seen,
  // the cast panels paint when their description is chosen (or when the panel is clicked).
  const figures = Array.from(document.querySelectorAll<HTMLElement>('.figure[data-paint]'));
  for (const f of figures) f.classList.add('unpainted');

  const hero = document.getElementById('hero-figure');
  if (hero) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { window.setTimeout(() => paint(hero), 400); io.disconnect(); }
      }
    }, { threshold: 0.3 });
    io.observe(hero);
  }

  const verses = Array.from(document.querySelectorAll<HTMLButtonElement>('.verse-band'));
  const chooseVerse = (b: HTMLButtonElement) => {
    for (const v of verses) v.setAttribute('aria-pressed', String(v === b));
    paint(document.getElementById(b.dataset.for ?? ''));
    queue = [];
    if (b.dataset.clip) playId(b.dataset.clip);
  };
  for (const b of verses) b.addEventListener('click', () => chooseVerse(b));

  for (const f of figures) {
    if (f === hero) continue;
    f.addEventListener('click', () => {
      const b = verses.find((v) => v.dataset.for === f.id);
      if (b) chooseVerse(b); else paint(f);
    });
  }
</script>
