---
// Variant 03 — ragamala. A folio album: every section is a bordered leaf with an orpiment caption
// band; the three characters are painted panels that go from underdrawing to pigment when chosen.
import { name, meaning, links, characters, clips, scene, clipCaveats, type Clip } from '../../content/alaap';

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const clip = (id: string) => clips.find((c) => c.id === id)!;
const desc = (id: string) => characters.find((c) => c.id === id)!.description;

// One player: custom button + exact words + native <audio> as the no-script fallback.
const player = (c: Clip, label: string) => `
<div class="player" data-clip="${c.id}" data-char="${c.character}">
  <button class="play" type="button" aria-pressed="false" aria-label="Play: ${esc(c.text)}">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path class="ic-play" d="M7 4l13 8-13 8z"/><path class="ic-pause" d="M6 4h4v16H6zM14 4h4v16h-4z"/></svg>
  </button>
  <div class="ptext">
    <p class="words">“${esc(c.text)}”</p>
    <p class="meta">${label} · ${c.seconds} s${c.experimentalEmotionSetting ? ' · <em class="flag">experimental emotion setting</em>' : ''}</p>
    <span class="bar" aria-hidden="true"><i></i></span>
  </div>
  <audio preload="none" controls src="${c.src}"></audio>
</div>`;

// The three painted panels, drawn flat in the manner of a Rajput ragamala leaf. Four pigment
// layers (.l1 ground, .l2 forms, .l3 figure, .l4 gold); strokes stay as the underdrawing.
const panels: Record<string, string> = {
  mentor: `
<g class="pig l1"><rect x="0" y="0" width="300" height="270" fill="#C0381E"/><rect x="0" y="270" width="300" height="130" fill="#2F6A50"/><path d="M0 352Q75 340 150 352T300 352V400H0Z" fill="#234E3B"/></g>
