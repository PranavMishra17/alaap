  <rect x="236" y="282" width="7" height="40" fill="#5A3A1E"/>
  <path d="M212 292C208 262 236 250 250 262C270 254 286 272 276 292C286 300 268 312 252 306C238 316 214 306 212 292Z" fill="#1F4A36"/>
</g>
<g class="pig l3">
  <path d="M112 350C112 322 128 300 150 300C170 300 186 318 184 350Z" fill="#F1E6CB"/>
  <path d="M132 322C142 330 160 330 172 322L176 334C160 340 142 340 128 334Z" fill="#B5321C"/>
  <circle cx="152" cy="288" r="13" fill="#C58B5A"/>
  <path d="M138 286C140 272 164 270 167 284C160 280 146 280 138 286Z" fill="#E9C24B"/>
  <path d="M190 266V352" stroke="#5A3A1E" stroke-width="3"/>
</g>
<g class="pig l4">
  <circle cx="248" cy="52" r="15" fill="#E9C24B"/>
  <path d="M248 28V20M248 84V76M224 52H216M280 52H272M231 35L225 29M271 35L265 29M231 69L225 75M271 69L265 75" stroke="#E9C24B" stroke-width="1.5"/>
  <path d="M0 270C20 215 55 200 80 232C95 190 140 178 165 218C185 185 225 182 245 224C265 205 290 210 300 236" fill="none" stroke="#E9C24B" stroke-width="1"/>
  <path d="M20 374q4-9 8 0M64 382q4-9 8 0M110 378q4-9 8 0M204 384q4-9 8 0M272 376q4-9 8 0" fill="none" stroke="#E9C24B"/>
</g>`,
  scout: `
<g class="pig l1"><rect x="0" y="0" width="300" height="250" fill="#1F2E63"/><rect x="0" y="250" width="300" height="150" fill="#8C5A2B"/><path d="M0 340Q80 326 150 340T300 340V400H0Z" fill="#6E4520"/></g>
<g class="pig l2">
  <path d="M0 250L40 226L70 236L110 206L140 222L175 200L205 218L240 204L270 226L300 214V250Z" fill="#A4622F"/>
  <path d="M118 208C108 196 118 182 130 186C126 170 146 164 150 178C160 168 174 180 166 192C178 196 170 212 156 208C150 218 128 218 118 208Z" fill="#9A9AA3"/>
  <path d="M136 176C130 160 150 150 156 162C166 150 184 160 176 172C186 176 178 190 166 186C160 194 140 190 136 176Z" fill="#B9B7BE"/>
  <path d="M232 212C222 200 232 186 244 190C240 174 262 170 264 184C276 176 288 190 278 200C288 206 278 220 264 214C258 224 240 222 232 212Z" fill="#9A9AA3"/>
  <path d="M250 182C246 166 266 158 272 170C282 162 296 174 288 182C294 190 282 198 272 192C264 198 250 194 250 182Z" fill="#B9B7BE"/>
</g>
<g class="pig l3">
  <path d="M66 350L70 292H92L96 350Z" fill="#B5321C"/>
  <rect x="70" y="350" width="8" height="18" fill="#F1E6CB"/><rect x="84" y="350" width="8" height="18" fill="#F1E6CB"/>
  <path d="M92 300L124 286L127 292L94 308Z" fill="#C58B5A"/>
  <circle cx="81" cy="278" r="11" fill="#C58B5A"/>
  <path d="M68 276C70 264 92 262 95 274C88 270 76 270 68 276Z" fill="#E9C24B"/>
</g>
<g class="pig l4">
  <path d="M62 52A20 20 0 1 0 74 84A16 16 0 1 1 62 52Z" fill="#E9C24B"/>
  <circle cx="150" cy="40" r="2" fill="#E9C24B"/><circle cx="196" cy="70" r="2" fill="#E9C24B"/><circle cx="238" cy="36" r="2" fill="#E9C24B"/><circle cx="110" cy="96" r="1.6" fill="#E9C24B"/><circle cx="270" cy="110" r="1.6" fill="#E9C24B"/><circle cx="168" cy="118" r="1.6" fill="#E9C24B"/>
  <path d="M0 250L40 226L70 236L110 206L140 222L175 200L205 218L240 204L270 226L300 214" fill="none" stroke="#E9C24B" stroke-width="1"/>
</g>`,
  innkeeper: `
<g class="pig l1"><rect x="0" y="0" width="300" height="400" fill="#C0381E"/><rect x="28" y="96" width="244" height="304" fill="#F1E6CB"/><rect x="28" y="330" width="244" height="70" fill="#2F6A50"/></g>
<g class="pig l2">
  <path d="M20 96H280L272 82H28Z" fill="#A87E24"/><rect x="28" y="70" width="244" height="12" fill="#F1E6CB"/>
  <path d="M150 118C120 118 100 138 96 168C88 160 78 168 82 178C74 174 66 180 70 190V300H230V190C234 180 226 174 218 178C222 168 212 160 204 168C200 138 180 118 150 118Z" fill="#26397A"/>
  <path d="M150 132C126 132 110 150 108 176V296H192V176C190 150 174 132 150 132Z" fill="#3B52A3"/>
  <rect x="40" y="110" width="12" height="220" fill="#B5321C"/><rect x="248" y="110" width="12" height="220" fill="#B5321C"/>
</g>
<g class="pig l3">
  <rect x="64" y="290" width="88" height="10" fill="#5A3A1E"/><rect x="70" y="300" width="6" height="30" fill="#5A3A1E"/><rect x="140" y="300" width="6" height="30" fill="#5A3A1E"/>
  <ellipse cx="86" cy="286" rx="12" ry="5" fill="#A87E24"/><ellipse cx="130" cy="286" rx="12" ry="5" fill="#A87E24"/>
  <path d="M100 290C104 296 114 296 118 290Z" fill="#A87E24"/><path d="M109 272C105 280 105 286 109 289C113 286 113 280 109 272Z" fill="#E9C24B"/>
  <path d="M176 330C176 302 192 286 212 286C232 286 248 302 246 330Z" fill="#E9C24B"/>
  <circle cx="214" cy="274" r="12" fill="#C58B5A"/>
  <path d="M200 272C202 260 226 258 229 270C222 266 208 266 200 272Z" fill="#B5321C"/>
</g>
<g class="pig l4">
  <path d="M20 96H280" stroke="#E9C24B" stroke-width="1.5"/>
  <circle cx="150" cy="128" r="2.5" fill="#E9C24B"/><circle cx="118" cy="146" r="2" fill="#E9C24B"/><circle cx="182" cy="146" r="2" fill="#E9C24B"/><circle cx="96" cy="184" r="2" fill="#E9C24B"/><circle cx="204" cy="184" r="2" fill="#E9C24B"/>
  <path d="M40 352H260M40 368H260" stroke="#E9C24B" stroke-width="1" fill="none"/>
</g>`,
};
const figure = (id: string, domId = `fig-${id}`) =>
  `<div class="figure" id="${domId}" data-paint><svg viewBox="0 0 300 400" role="img" aria-label="A painted panel for the ${id}, in the manner of a ragamala miniature">${panels[id]}</svg></div>`;

const mentorSeed = clip('mentor_seed');
const scoutSeed = clip('scout_seed');
const innkeeperSeed = clip('innkeeper_seed');
const cast = [
  { id: 'mentor', seed: mentorSeed },
  { id: 'scout', seed: scoutSeed },
  { id: 'innkeeper', seed: innkeeperSeed },
] as const;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alaap · आलाप</title>
    <meta name="description" content="Describe a character. Get a voice nobody has recorded. Keep it." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Martel+Sans:wght@400;700&family=Martel:wght@300;400;700&family=Rozha+One&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <header class="strip">
      <a class="strip-name" href="#top"><span lang="hi">{name.devanagari}</span><span>{name.latin}</span></a>
      <a class="strip-link" href={links.repo}>Repository ↗</a>
    </header>

    <main class="album" id="top">

      <!-- Leaf 1: the thesis. A verse, and the figure it produced. -->
      <article class="folio hero" aria-labelledby="h-name">
        <header class="band">
          <span class="band-hi" lang="hi">{name.devanagari}</span>
          <h1 class="band-en" id="h-name">{name.latin}</h1>
          <span class="band-note">{meaning}</span>
        </header>
        <div class="leaf hero-leaf">
          <Fragment set:html={figure('mentor', 'hero-figure')} />
          <div class="hero-text">
            <p class="eyebrow">The description, and nothing else</p>
            <p class="verse">“{desc('mentor')}”</p>
            <Fragment set:html={player(mentorSeed, 'seed clip · the voice this description produced')} />
            <p class="thesis">Ragamala painters were handed a verse that described a raga as a person, and painted the person. Alaap is handed a description of a character in ordinary language, and returns a voice that has never existed. Then you use that voice for any line of dialogue you write, and it stays the same character every time.</p>
            <p>For people making games, animation, audio drama, dubbing, interactive fiction: anyone who needs many distinct speaking characters and cannot hire a cast for each one. It works end to end today, on one laptop GPU, in English, Hindi, Bengali and Tamil.</p>
            <p class="cta-row"><a class="cta" href={links.repo}>Read the research ↗</a></p>
          </div>
        </div>
        <div class="leaf margin-note">
          <h2 class="small-h">Why Indian languages</h2>
          <p>The tools that do this well mostly do it in English. Indian-language creators either use a handful of stock voices that everyone else is also using, or they hire actors. This project treats Hindi, Bengali and Tamil as first-class, not as an afterthought port. The Indian-language engine covers 22 Indian languages; four are measured so far.</p>
        </div>
      </article>

      <!-- Leaf 2: three verses, three figures. The visitor paints. -->
      <article class="folio" aria-labelledby="h-cast">
        <header class="band">
          <span class="band-hi" lang="hi">चित्र</span>
          <h2 class="band-en" id="h-cast">Three descriptions, three figures</h2>
        </header>
        <div class="leaf">
          <p class="lede">Choose a description. Its figure is painted, and its seed clip plays: the short recording the system stores beside every voice identity when it is minted. <strong>Every clip here was rendered by the demo run on 2026-09-05 and is replayed as it is. Nothing on this page generates a voice live.</strong></p>
          <div class="cast">
            {cast.map((m) => (
              <div class="leafling">
                <button class="verse-band" type="button" data-for={`fig-${m.id}`} data-clip={m.seed.id} aria-pressed="false">
                  <span class="verse-who">{m.id}</span>
                  <span class="verse-text">“{desc(m.id)}”</span>
                  <span class="verse-do">Paint and play</span>
                </button>
                <Fragment set:html={figure(m.id)} />
                <Fragment set:html={player(m.seed, 'seed clip')} />
              </div>
            ))}
          </div>
        </div>
      </article>

      <!-- Leaf 3: the five-line scene, in order. -->
      <article class="folio" aria-labelledby="h-scene">
        <header class="band">
          <span class="band-hi" lang="hi">दृश्य</span>
          <h2 class="band-en" id="h-scene">The scene</h2>
        </header>
        <div class="leaf">
          <p class="lede">Three characters minted from the descriptions above, a five-line scene rendered end to end in about four minutes on one laptop GPU, every clip watermarked, plus a file a game engine can read. These are that run's lines, in the order they were written.</p>
          <p class="cues">
            <button class="cue" type="button" data-queue="mentor_line0,scout_line1,innkeeper_line2,mentor_line3,scout_line4">Play the scene in order</button>
            <button class="cue" type="button" data-queue="mentor_seed,mentor_line0,mentor_line3">One character, three sentences</button>
          </p>
          <ol class="lines">
            {scene.map((c) => (
              <li><Fragment set:html={player(c, c.character)} /></li>
            ))}
          </ol>
          <div class="caveats">
            <p><span class="cap-label">Watermark</span>{clipCaveats.watermark}</p>
            <p><span class="cap-label">Language</span>{clipCaveats.englishOnly}</p>
            <p><span class="cap-label">Marked lines</span>{clipCaveats.emotionSetting}</p>
          </div>
        </div>
      </article>

      <!-- Leaf 4: the four differences. -->
      <article class="folio" aria-labelledby="h-diff">
        <header class="band">
          <span class="band-hi" lang="hi">चार बातें</span>
          <h2 class="band-en" id="h-diff">What makes it different</h2>
        </header>
        <div class="leaf four">
          <section>
            <h3>A voice is a thing you keep, not a setting you re-guess.</h3>
            <p>Most tools generate a voice each time you ask. Here the character's voice is stored as an identity and re-used. The same character sounds like the same person across every line, every scene, and every session. That consistency is measured, not hoped for.</p>
          </section>
          <section>
            <h3>Who is speaking and what is being said are genuinely separate.</h3>
            <p>The system holds a character's identity apart from the words. One character can say anything without the voice changing, and changing the line never changes the person. This was verified rather than assumed: when the same audio content is played through two different identities, the words come out identically. The measured error between them was exactly zero on every line tested.</p>
          </section>
          <section>
            <h3>It does not need a recording of the character.</h3>
            <p>There is no voice cloning here, and no user uploads their own audio. Voices are created from a written description. That sidesteps the consent and impersonation problem entirely: you cannot accidentally clone a real person if the system never accepts a recording.</p>
          </section>
          <section>
            <h3>It knows what it does not know.</h3>
            <p>Every capability is measured against a control, and the honest limits are published alongside the results. Roughly twenty findings in this project were wrong on the first attempt and caught by a check, including one where an entire experiment produced fluent-sounding speech that was saying different words than requested, and nothing errored. That is written up publicly rather than quietly fixed.</p>
            <p class="rule">“A suspiciously good or suspiciously bad number is a bug report about your setup.”</p>
          </section>
        </div>
      </article>

      <!-- Leaf 5: what was measured, each with its caveat beside it. -->
      <article class="folio" aria-labelledby="h-measured">
        <header class="band">
          <span class="band-hi band-sentence" lang="hi">नमस्ते आप कैसे हैं आज मौसम बहुत अच्छा है</span>
          <h2 class="band-en" id="h-measured">What was measured</h2>
        </header>
        <div class="leaf">
          <p class="lede">The band above is one rendered Hindi line that a fluent Hindi speaker confirmed says exactly that sentence. They were told the sentence and asked “does it say this?”, not “does it sound right?”: the check that an earlier batch of fluent-sounding but wrong audio had failed. The remaining voices and lines are still to be checked. Our own translation, not a project claim: “Hello, how are you? The weather is very nice today.”</p>

          <div class="findings">
            <section>
              <h3>Minting a voice from a description costs nothing in clarity.</h3>
              <p>A described voice is just as intelligible as one taken from a real recording. The measured difference was tiny, leaned slightly in the invented voice's favour, and was smaller than the difference between two real speakers: the gap between two real speakers was six times larger.</p>
              <p class="caveat">Read as no detectable difference, not as invented voices being better. Every version had to come out the same length before any score was read, or the run aborted.</p>
            </section>
            <section>
              <h3>Invented voices are recognisably distinct people.</h3>
              <p>Verified by a separate speaker-recognition system that has never seen the generator: an independent check, not the system marking its own homework. Each invented voice also sits clearly apart from the nearest real voice the system learned from, so these are new voices, not real people wearing a label.</p>
            </section>
            <section>
              <h3>A character stays itself more consistently than a real person does.</h3>
              <p>Across different sentences, a character holds together more consistently than a real person does across different recordings, which is unsurprising once you think about it: a stored voice has no bad-throat day, no change of microphone, no mood.</p>
            </section>
            <section>
              <h3>A blind listening test found and fixed a real problem.</h3>
              <p>Pairs the system called different were heard as the same person about half the time. The threshold was raised. That removed 10 duplicate voices from a set of 50 and cost 3 percent of measured variety.</p>
              <p class="caveat">The test was small: 8 pairs, one listener, every control answered correctly. It found the problem but does not settle the exact threshold, and the English threshold has not had its own listening test.</p>
            </section>
            <section>
              <h3>Watermarked and logged from the first render.</h3>
              <p>Every render is watermarked and logged from the first output, not added later. The output includes a manifest a game engine can consume: built for a pipeline, not a demo button. The manifest's own disclosure line: “AI-generated synthetic speech. All audio carries an AudioSeal watermark.”</p>
            </section>
            <section>
              <h3>Pacing is controllable within a measured range.</h3>
              <p>You can slow a character to about two-thirds of normal speed or push them to about 1.4 times, and they stay the same person saying the same words. Outside that range the identity fades gradually rather than breaking.</p>
              <p class="caveat">A listener noted the slow extreme starts to sound processed; the range they called clean is narrower, about 0.8 to 1.25 times.</p>
            </section>
          </div>

          <figure class="tempo" aria-labelledby="tempo-cap">
            <div class="scale">
              <div class="measured"><span>measured: same person, same words</span></div>
              <div class="clean"><span>heard as clean</span></div>
              <span class="tick" style="left:0%">two-thirds</span>
              <span class="tick low" style="left:17.1%">0.8×</span>
              <span class="tick" style="left:43.4%">normal</span>
              <span class="tick low" style="left:76.3%">1.25×</span>
              <span class="tick" style="left:100%">1.4×</span>
            </div>
            <figcaption id="tempo-cap">An illustration of the measured pacing range, not a control. Nothing on this page re-times a clip.</figcaption>
          </figure>

          <h3 class="pair-h">Two ways to answer a description, and the numbers for the trade-off</h3>
          <div class="pair">
            <section>
              <h4>Invent</h4>
              <p>A character nobody else has. Inventing reached 37 percent of the variety available before two mis-set settings were fixed; the fix raised the invented catalogue from 14 to 22 distinct Hindi voices and from 23 to 41 English.</p>
            </section>
            <section>
              <h4>Find</h4>
              <p>Higher accuracy and studio quality, from a library of 141 real Hindi voices: two thirds of descriptions (65.6 percent) get a voice that matches on every trait named, and 87 percent land within one step. When a description names only a couple of traits, the way people actually write, a bit over half (53.8 percent) match exactly. Chance is about one in five. The same method on 2,500 English voices reaches 88.5 percent, and it replicates in Bengali within a point or two. Finding reaches 87 percent of the variety the library actually holds.</p>
              <p class="caveat">Finding cannot produce a voice the library does not contain, cannot guarantee a new character is unique, and the library is someone else's, so every character in every project draws from the same shelf.</p>
            </section>
          </div>
          <p class="caveat wide">Neither is strictly better. The library measured was real recorded speakers standing in for a studio library, and no commercial system has been measured.</p>
        </div>
      </article>

      <!-- Leaf 6: how it works. -->
      <article class="folio" aria-labelledby="h-how">
        <header class="band">
          <span class="band-hi" lang="hi">कैसे</span>
          <h2 class="band-en" id="h-how">How it works</h2>
        </header>
        <div class="leaf">
          <ol class="procession">
            <li><b>your description</b><small>ordinary language</small></li>
            <li class="learns"><b>the mapper</b><small>the only part that learns</small></li>
            <li><b>a voice identity</b><small>small, storable, versioned</small></li>
            <li class="frozen"><b>the voice engine</b><small>never modified, swappable</small></li>
            <li><b>audio</b><small>watermarked and logged from the first render</small></li>
          </ol>
          <div class="ideas">
            <section><h3>Only one small piece is trained.</h3><p>The speech engine is used as it is and never altered, so a better engine can be swapped in without rebuilding everything.</p></section>
            <section><h3>The voice identity is a small, storable thing.</h3><p>That is what makes a character persistent: it can be saved, versioned and handed to someone else. Each one is stored with a short seed clip and the engine version that made it. The identity is who the character is; each line is a separate performance.</p></section>
            <section><h3>The checker never sees the engine.</h3><p>Distinctness and consistency are verified by a separate speaker-recognition system that never sees the engine's internals. 114 automated checks guard the rules the project learned the hard way: never accept a user's audio; watermark from the first render; store timbre, not performance; do not start the next stage until this one is measured.</p></section>
          </div>
        </div>
      </article>

      <!-- Leaf 7: not there yet. Every item, plainly. -->
      <article class="folio" aria-labelledby="h-not">
        <header class="band">
          <span class="band-hi" lang="hi">अभी नहीं</span>
          <h2 class="band-en" id="h-not">What is honestly not there yet</h2>
        </header>
        <div class="leaf">
          <ol class="not-yet">
            <li><b>Not a product.</b> This is a working research system, not a product. There is no signup, no hosted service, no API.</li>
            <li><b>Emotion is not solved.</b> Emotional performance direction is not solved. You can control pacing within a measured range. You cannot yet say “say this line apologetically” and have it work. That was tested thoroughly and does not work on the current engine, for reasons the project documented and reported upstream: the engine's documented emotion tags turn out not to be recognised by the engine at all, and a listener heard no difference between tagged versions of the same line.</li>
            <li><b>The catalogue is small.</b> Tens of distinct voices per language so far, not hundreds: about 22 in Hindi and 41 in English by the project's own measure. The limit is understood and measured rather than mysterious: the real speakers the system learned from hold about 38 to 48 distinguishable voices, and the project measured exactly where its own method loses variety.</li>
            <li><b>Cannot ship as a product, for licensing reasons.</b> It cannot be shipped as a product in its current form for licensing reasons, which are documented. The Indian-language engine's training chain includes data licensed for non-commercial use, so no model weights and no Indian-language audio leave the repository. It is research-only today, deliberately.</li>
            <li><b>Very little has been listened to.</b> Most results are automatic measurements. One listener, a handful of pairs.</li>
            <li><b>No comparison against a commercial system.</b> None has been measured.</li>
            <li><b>The clips on this page are English.</b> {clipCaveats.englishOnly}</li>
            <li><b>Three of the five demo lines</b> were rendered with an experimental emotion setting whose effect has not been validated on this engine. Listen to them as voice samples, not performances.</li>
          </ol>
        </div>
      </article>

      <!-- Colophon. -->
      <article class="folio colophon" aria-labelledby="h-col">
        <header class="band">
          <span class="band-hi" lang="hi">पुष्पिका</span>
          <h2 class="band-en" id="h-col">Colophon</h2>
        </header>
        <div class="leaf col-leaf">
          <div>
            <p>Research pass 2026-09-02. Implementation and measurement 2026-09-05; the clips on this page are that day's end-to-end demo render, three characters and five lines.</p>
            <p>Research and documentation under a Creative Commons attribution licence; code under MIT. No model weights and no generated Indian-language audio ship.</p>
          </div>
          <div class="col-links">
            <a class="cta" href={links.repo}>Read the research ↗</a>
            <a class="cta secondary" href={links.issues}>Corrections welcome ↗</a>
            <p class="small">“If a claim here is wrong, an issue with a primary source is more useful than almost anything else.” Get in touch through the repository or its issues.</p>
          </div>
        </div>
      </article>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --lapis: #1F2E63; --lapis-deep: #152047;
    --wasli: #DDBE7E; --wasli-deep: #C9A55C;
    --vermilion: #B5321C; --vermilion-ink: #8A2313;
    --orpiment: #E9C24B; --gold: #A87E24;
    --ink: #1B1510; --ink-soft: #4A3A2A;
    --malachite: #2F6A50; --lead: #F1E6CB;
    --display: 'Rozha One', 'Tiro Devanagari Hindi', Georgia, 'Times New Roman', serif;
    --body: 'Martel', 'Noto Serif Devanagari', Georgia, serif;
    --util: 'Martel Sans', 'Noto Sans Devanagari', system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; background: var(--lapis); color: var(--ink); font: 400 1.0625rem/1.7 var(--body); }
  h1, h2, h3, h4 { font-family: var(--display); font-weight: 400; line-height: 1.2; margin: 0; }
  p { margin: 0 0 1em; }
  a { color: var(--vermilion-ink); text-decoration-thickness: 1px; text-underline-offset: .18em; }
  :focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
  .strip a:focus-visible, .procession .frozen :focus-visible { outline-color: var(--orpiment); }
  button { font: inherit; color: inherit; }
  [lang="hi"] { font-family: var(--display); }

  /* Album strip on the lapis cloth */
  .strip { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; max-width: 1180px; margin: 0 auto; padding: 1rem clamp(14px, 4vw, 48px) 0; color: var(--wasli); font: 700 .72rem/1.4 var(--util); letter-spacing: .12em; text-transform: uppercase; }
  .strip a { color: inherit; text-decoration: none; display: inline-flex; align-items: baseline; gap: .6rem; }
  .strip a:hover, .strip a:focus-visible { color: var(--orpiment); }
  .strip [lang="hi"] { font: 400 1.35rem/1 var(--display); text-transform: none; letter-spacing: 0; }

  .album { max-width: 1180px; margin: 0 auto; padding: clamp(18px, 3.5vw, 40px) clamp(14px, 4vw, 48px) clamp(40px, 6vw, 72px); display: grid; gap: clamp(30px, 5vw, 60px); }

  /* The leaf: burnished wasli inside a layered hashiya border */
  .folio { position: relative; padding: 9px; background: var(--wasli); border: 8px solid transparent;
    background: linear-gradient(var(--wasli), var(--wasli)) padding-box,
      radial-gradient(circle at 50% 50%, var(--orpiment) 1.1px, transparent 1.7px) 0 0 / 8px 8px border-box, var(--vermilion) border-box;
    outline: 2px solid var(--gold); box-shadow: 0 0 0 4px var(--lapis-deep); }
  .folio::before { content: ""; position: absolute; inset: 4px; border: 1px solid var(--gold); pointer-events: none; }
  .folio::after { content: ""; position: absolute; inset: 0; border: 1px solid var(--gold); pointer-events: none; }

  .band { position: relative; display: flex; align-items: baseline; flex-wrap: wrap; gap: .1em 1.1em; background: var(--orpiment); padding: .6rem clamp(1rem, 3vw, 2rem) .45rem; border-bottom: 1px solid var(--gold); box-shadow: inset 0 0 0 1px var(--wasli); }
  .band-hi { font: 400 clamp(1.7rem, 2.6vw, 2.2rem)/1.25 var(--display); }
  .band-sentence { font-size: clamp(1.25rem, 2vw, 1.7rem); }
  .band-en { font-size: clamp(1.05rem, 1.6vw, 1.3rem); }
  .band-note { flex: 1 1 22rem; font: 300 .95rem/1.5 var(--body); color: var(--ink-soft); max-width: 44rem; }
  .hero .band-en { font-size: clamp(1.4rem, 2.4vw, 2rem); }

  .leaf { padding: clamp(1.4rem, 3vw, 2.6rem) clamp(1.1rem, 3.5vw, 3rem); }
  .leaf + .leaf { border-top: 1px solid var(--gold); }
  .margin-note { display: grid; grid-template-columns: minmax(10rem, 16rem) 1fr; gap: 1.5rem; padding-top: 1.2rem; padding-bottom: 1.2rem; }
  .margin-note p { margin: 0; }
  .small-h { font-size: 1.15rem; padding-top: .25em; }
  .eyebrow, .meta, .cap-label, .verse-who, .verse-do, .tick, .procession small, .flag { font: 700 .68rem/1.5 var(--util); letter-spacing: .1em; text-transform: uppercase; }
