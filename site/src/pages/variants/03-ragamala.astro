  html:not(.js) .verse-band { cursor: default; }
  .verse-band:hover, .verse-band:focus-visible { background: #F0CD5C; }
  .verse-band[aria-pressed="true"] { background: var(--ink); color: var(--orpiment); border-color: var(--ink); box-shadow: none; }
  .verse-who { color: var(--vermilion-ink); }
  .verse-band[aria-pressed="true"] .verse-who, .verse-band[aria-pressed="true"] .verse-do { color: var(--wasli); }
  .verse-text { font: 400 1.15rem/1.3 var(--display); }
  .verse-do { display: none; margin-top: .2rem; color: var(--ink-soft); }
  .js .verse-do { display: block; }
  .js .verse-do::before { content: "▶ "; }

  /* Players */
  .player { display: grid; grid-template-columns: auto 1fr; gap: .35rem .85rem; align-items: start; margin: .5rem 0 .9rem; }
  .play { display: none; width: 2.6rem; height: 2.6rem; border-radius: 50%; border: 2px solid var(--ink); background: var(--lead); cursor: pointer; padding: 0; place-items: center; }
  .play svg { width: 1.05rem; height: 1.05rem; fill: var(--ink); }
  .ic-pause { display: none; }
  .is-playing .ic-pause { display: block; } .is-playing .ic-play { display: none; }
  .is-playing .play { background: var(--vermilion); border-color: var(--vermilion); }
  .is-playing .play svg { fill: var(--lead); }
  .play:hover { background: var(--orpiment); }
  .js .play { display: grid; }
  .player audio { grid-column: 1 / -1; width: 100%; max-width: 26rem; }
  .js .player audio { display: none; }
  .words { margin: 0; font-size: 1.05rem; line-height: 1.5; }
  .meta { color: var(--vermilion-ink); margin: .1rem 0 0; }
  .flag { color: var(--ink); font-style: normal; border-bottom: 2px solid var(--vermilion); }
  .bar { display: block; height: 2px; background: rgba(27, 21, 16, .18); margin-top: .35rem; max-width: 26rem; }
  .bar i { display: block; height: 100%; background: var(--vermilion); transform: scaleX(0); transform-origin: left; transition: transform .2s linear; }
  [data-char="mentor"] .play { border-color: var(--vermilion); }
  [data-char="scout"] .play { border-color: var(--lapis); }
  [data-char="innkeeper"] .play { border-color: var(--malachite); }
  [data-char="scout"].is-playing .play { background: var(--lapis); }
  [data-char="innkeeper"].is-playing .play { background: var(--malachite); }

  /* Scene */
  .cues { display: none; gap: .6rem; flex-wrap: wrap; margin: 0 0 1rem; }
  .js .cues { display: flex; }
  .cue { background: var(--lead); border: 1px solid var(--ink); padding: .45rem .9rem .35rem; cursor: pointer; font: 700 .72rem/1.5 var(--util); letter-spacing: .1em; text-transform: uppercase; text-align: left; }
  .cue:hover, .cue:focus-visible { background: var(--orpiment); }
  .cue::before { content: "▶  "; }
  .lines { list-style: none; margin: 0; padding: 0; max-width: 60rem; }
  .lines li { border-top: 1px solid var(--wasli-deep); }
  .lines .player { margin: .7rem 0; }
  .caveats { margin-top: 1.6rem; display: grid; gap: .5rem; max-width: 60rem; border-top: 1px solid var(--gold); padding-top: 1rem; }
  .caveats p { margin: 0; display: grid; grid-template-columns: 7.5rem 1fr; gap: .8rem; font-size: .95rem; line-height: 1.55; }
  .cap-label { color: var(--vermilion-ink); padding-top: .2em; }

  /* Four things */
  .four { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.4rem, 3vw, 2.6rem) clamp(1.5rem, 4vw, 3.5rem); }
  .four h3, .findings h3, .ideas h3 { font-size: 1.35rem; margin-bottom: .5rem; text-wrap: balance; }
  .four p:last-child { margin-bottom: 0; }
  .rule { font-family: var(--display); font-size: 1.05rem; color: var(--vermilion-ink); border-left: 3px solid var(--vermilion); padding-left: .8rem; }

  /* Measured */
  .findings { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem clamp(1.5rem, 4vw, 3.5rem); margin-top: 1.6rem; }
  .findings section { border-top: 1px solid var(--gold); padding-top: .9rem; }
  .caveat { font-size: .92rem; line-height: 1.55; color: var(--ink-soft); border-left: 3px solid var(--orpiment); padding-left: .7rem; margin-bottom: 0; }
  .caveat.wide { max-width: 60rem; margin-top: 1rem; }
  .tempo { margin: 2.2rem 0 0; max-width: 60rem; }
  .scale { position: relative; height: 5.8rem; margin: 0 2.4rem 0 2.6rem; }
  .measured { position: absolute; left: 0; right: 0; top: 1.2rem; height: 1.9rem; border: 1px solid var(--ink); background: var(--lead); }
  .clean { position: absolute; left: 17.1%; width: 59.2%; top: 1.55rem; height: 1.2rem; background: var(--orpiment); border: 1px solid var(--gold); }
  .measured span, .clean span { position: absolute; left: .5rem; top: 50%; transform: translateY(-50%); font: 700 .66rem/1 var(--util); letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
  .measured span { left: 0; top: -.7rem; transform: none; color: var(--ink-soft); }
  .tick { position: absolute; top: 3.6rem; transform: translateX(-50%); color: var(--ink-soft); white-space: nowrap; }
  .tick::before { content: ""; position: absolute; left: 50%; top: -.55rem; height: .4rem; border-left: 1px solid var(--ink); }
  .tempo figcaption { font-size: .92rem; color: var(--ink-soft); margin-top: .6rem; }
  .pair-h { font-size: 1.35rem; margin: 2.2rem 0 .6rem; border-top: 1px solid var(--gold); padding-top: 1.2rem; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem clamp(1.5rem, 4vw, 3.5rem); }
  .pair h4 { font-size: 1.15rem; color: var(--vermilion-ink); margin-bottom: .3rem; }

  /* How it works */
  .procession { list-style: none; margin: 0 0 1.8rem; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.6rem; counter-reset: none; }
  .procession li { position: relative; background: var(--lead); border: 1px solid var(--ink); padding: .8rem .9rem .7rem; display: grid; gap: .15rem; align-content: start; }
  .procession li + li::before { content: "→"; position: absolute; left: -1.35rem; top: .7rem; font-family: var(--display); color: var(--gold); font-size: 1.2rem; }
  .procession b { font: 400 1.15rem/1.25 var(--display); }
  .procession small { color: var(--ink-soft); }
  .procession .learns { background: var(--orpiment); }
  .procession .frozen { background: var(--lapis); color: var(--lead); border-color: var(--lapis-deep); }
  .procession .frozen small { color: var(--wasli); }
  .ideas { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem clamp(1.2rem, 3vw, 2.5rem); }
  .ideas p:last-child { margin-bottom: 0; }

  /* Not yet */
  .not-yet { margin: 0; padding-left: 1.4rem; max-width: 62rem; display: grid; gap: .9rem; }
  .not-yet li { padding-left: .4rem; }
  .not-yet li::marker { font: 700 .8rem var(--util); color: var(--vermilion-ink); }
  .not-yet b { font-family: var(--display); font-weight: 400; font-size: 1.15rem; }

  /* Colophon */
  .col-leaf { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2rem; }
  .col-links { display: grid; gap: .7rem; align-content: start; justify-items: start; }
  .col-links .small { font-size: .92rem; color: var(--ink-soft); margin: .4rem 0 0; }

  @media (max-width: 960px) {
    .hero-leaf { grid-template-columns: minmax(14rem, 20rem) 1fr; }
    .findings, .four, .pair { grid-template-columns: 1fr; }
    .procession { grid-template-columns: 1fr 1fr; }
    .procession li + li::before { content: none; }
    .ideas { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .hero-leaf { grid-template-columns: 1fr; }
    .hero-leaf .figure { max-width: 22rem; }
    .cast { grid-template-columns: 1fr; max-width: 24rem; }
    .margin-note { grid-template-columns: 1fr; gap: .4rem; }
    .col-leaf { grid-template-columns: 1fr; }
    .procession { grid-template-columns: 1fr; gap: .6rem; }
    .caveats p { grid-template-columns: 1fr; gap: .1rem; }
    .scale { margin: 0 1.4rem 0 2.7rem; height: 7rem; }
    .measured span { font-size: .6rem; }
    .tick.low { top: 4.9rem; }
    .tick.low::before { top: -1.85rem; height: 1.7rem; }
    .band-sentence { font-size: 1.15rem; }
  }
  @media (max-width: 420px) {
    .player { grid-template-columns: auto 1fr; }
    .strip { font-size: .64rem; }
