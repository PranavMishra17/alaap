  .thesis { font-size: 1.15rem; margin-top: 1.4rem; }
  .cta-row { margin: 1.4rem 0 0; }
  .cta { display: inline-block; background: var(--ink); color: var(--wasli); text-decoration: none; padding: .55rem 1.1rem .45rem; font: 700 .78rem/1.5 var(--util); letter-spacing: .1em; text-transform: uppercase; border: 1px solid var(--ink); }
  .cta:hover, .cta:focus-visible { background: var(--vermilion); border-color: var(--vermilion); color: var(--lead); }
  .cta.secondary { background: transparent; color: var(--ink); }
