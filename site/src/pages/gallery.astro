---
// The design lab: every variant live in two iframes, desktop and phone, with the designer's notes.
// Lives on the design-lab branch and is published under /alaap/lab/.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const files = Object.keys(import.meta.glob('./variants/*.astro'));
const slugs = files
  .map((p) => p.replace('./variants/', '').replace(/\.astro$/, ''))
  .filter((s) => !s.startsWith('_'))
  .sort();
const notes = import.meta.glob('../../notes/*.md', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const noteFor = (slug: string) => {
  const key = Object.keys(notes).find((k) => k.endsWith(`/${slug}.md`));
  return key ? notes[key] : '';
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alaap · design lab</title>
    <style>
      :root { color-scheme: light; }
      body { margin: 0; background: #e9e6df; color: #1c1b18; font: 15px/1.5 system-ui, sans-serif; }
      header { padding: 1.25rem 2rem; border-bottom: 1px solid #cfcabd; display: flex; gap: 1.5rem; align-items: baseline; flex-wrap: wrap; }
      header h1 { margin: 0; font-size: 1.1rem; font-weight: 600; }
      header nav a { margin-right: 0.9rem; color: #1c1b18; }
      section { padding: 2rem; border-bottom: 1px solid #cfcabd; }
      section h2 { margin: 0 0 0.25rem; font-size: 1.4rem; }
      section h2 a { color: inherit; text-decoration: none; }
      section h2 a:hover { text-decoration: underline; }
      .frames { display: grid; grid-template-columns: minmax(0, 1fr) 390px; gap: 1.5rem; align-items: start; margin-top: 1rem; }
      .desktop { width: 100%; aspect-ratio: 1440 / 900; border: 1px solid #bdb7a8; background: #fff; overflow: hidden; }
      .desktop iframe { width: 1440px; height: 900px; border: 0; transform-origin: 0 0; }
      .phone { width: 390px; height: 844px; border: 1px solid #bdb7a8; background: #fff; }
      .phone iframe { width: 390px; height: 844px; border: 0; }
      details { margin-top: 1rem; }
      details pre { white-space: pre-wrap; font: 13px/1.5 ui-monospace, monospace; background: #f4f2ec; padding: 1rem; border: 1px solid #cfcabd; }
      @media (max-width: 1100px) { .frames { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <header>
      <h1>Alaap · design lab · {slugs.length} variants</h1><p style="margin:0;color:#6b665a">Every landing-page variant tried, oldest first. The winner ships at <a href="https://pranavmishra17.github.io/alaap/">pranavmishra17.github.io/alaap</a>.</p>
      <nav>{slugs.map((s) => <a href={`#${s}`}>{s}</a>)}</nav>
    </header>
    {slugs.map((s) => (
      <section id={s}>
        <h2><a href={`${base}/variants/${s}`} target="_blank" rel="noopener">{s} ↗</a></h2>
        <div class="frames">
          <div class="desktop"><iframe src={`${base}/variants/${s}`} title={`${s} desktop`} loading="lazy"></iframe></div>
          <div class="phone"><iframe src={`${base}/variants/${s}`} title={`${s} phone`} loading="lazy"></iframe></div>
        </div>
        {noteFor(s) && <details><summary>designer's notes</summary><pre>{noteFor(s)}</pre></details>}
      </section>
    ))}
    <script>
      // Scale each desktop iframe to fit its container width.
      const fit = () => {
        document.querySelectorAll<HTMLElement>('.desktop').forEach((box) => {
          const f = box.querySelector('iframe') as HTMLElement | null;
          if (f) f.style.transform = `scale(${box.clientWidth / 1440})`;
        });
      };
      fit();
      addEventListener('resize', fit);
    </script>
  </body>
</html>
